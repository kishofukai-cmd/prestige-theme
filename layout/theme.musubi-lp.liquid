<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ page_description }}">
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap" rel="stylesheet">
  
  {%- render 'css-variables' -%}
  {%- render 'js-variables' -%}
  <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
  <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
  {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  <style>
    /* PC でも sticky bar を下部固定に統一（上部固定による余白を除去） */
    @media screen and (min-width: 700px) {
      .product-sticky-bar {
        inset-block: auto 0 !important;
        border-block-end-width: 0;
        border-block-start-width: 1px;
      }
    }
  </style>
</head>
<body>
  {{ content_for_layout }}
  
  {%- sections 'footer-group' -%}

</body>
</html>

