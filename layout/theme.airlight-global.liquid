<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- EDITABLE: 検索避け。広告・正式ローンチ開始時にこの1行を削除すること -->
  <meta name="robots" content="noindex, nofollow">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Designed in Tokyo, Japan. Kapok-powered warmth, zero compromise.' }}">

  <!-- OGP -->
  <meta property="og:title" content="{{ page_title }} | {{ shop.name }}">
  <meta property="og:description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Designed in Tokyo, Japan. Kapok-powered warmth, zero compromise.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/24_ba67f3cc-bda9-4080-b25f-8f8b653d054f.png?v=1759313538&width=1200">
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {%- render 'css-variables' -%}
  {%- render 'js-variables' -%}
  <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
  <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
  {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}

  {% comment %} ── Hide Channel Talk chat widget on this LP ── {% endcomment %}
  <style>
    /* Channel Talk — all known selectors */
    #ch-plugin,
    #ch-plugin-core,
    #ch-plugin-entry,
    #ch-plugin-script,
    #channel-io-plugin,
    [id^="ch-plugin"],
    [id^="channel-io"],
    .ch-messenger-frame,
    .ch-btn-launcher,
    .ch-desktop,
    .ch-mobile,
    iframe[title*="Channel"],
    iframe[title*="channel"],
    iframe[src*="channel.io"],
    div[class*="ChannelIO"],
    div[data-ch-testid] {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
      width: 0 !important;
      height: 0 !important;
      max-width: 0 !important;
      max-height: 0 !important;
      overflow: hidden !important;
      position: fixed !important;
      z-index: -9999 !important;
    }
  </style>
  <script>
    (function() {
      /* 1) API-level hide (if ChannelIO SDK loaded) */
      function tryHideChannelIO() {
        if (typeof ChannelIO === 'function') {
          try {
            ChannelIO('hideChannelButton');
            ChannelIO('hideMessenger');
          } catch(e) {}
        }
        if (typeof window.ChannelIOInitialized !== 'undefined' || typeof window.ChannelIO === 'function') {
          try { window.ChannelIO('shutdown'); } catch(e) {}
        }
      }

      /* 2) DOM removal — nuke any Channel Talk elements */
      function removeChannelElements() {
        var selectors = [
          '#ch-plugin', '#ch-plugin-core', '#ch-plugin-entry',
          '#channel-io-plugin', '[id^="ch-plugin"]', '[id^="channel-io"]',
          'iframe[src*="channel.io"]', 'iframe[title*="Channel"]',
          'iframe[title*="channel"]', 'div[class*="ChannelIO"]',
          '.ch-btn-launcher', 'div[data-ch-testid]'
        ];
        selectors.forEach(function(sel) {
          document.querySelectorAll(sel).forEach(function(el) {
            el.remove();
          });
        });
      }

      /* 3) MutationObserver — catch late-injected elements */
      function watchForChannel() {
        if (typeof MutationObserver === 'undefined') return;
        var observer = new MutationObserver(function(mutations) {
          var found = false;
          mutations.forEach(function(m) {
            m.addedNodes.forEach(function(node) {
              if (node.nodeType !== 1) return;
              var id = (node.id || '').toLowerCase();
              var cls = (node.className || '').toString().toLowerCase();
              if (id.indexOf('ch-plugin') !== -1 || id.indexOf('channel-io') !== -1 ||
                  cls.indexOf('channelio') !== -1 || cls.indexOf('ch-btn') !== -1) {
                node.remove();
                found = true;
              }
              /* Also check iframes */
              if (node.tagName === 'IFRAME') {
                var src = (node.src || '').toLowerCase();
                var title = (node.title || '').toLowerCase();
                if (src.indexOf('channel.io') !== -1 || title.indexOf('channel') !== -1) {
                  node.remove();
                  found = true;
                }
              }
            });
          });
          if (found) tryHideChannelIO();
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });

        /* Auto-stop after 30s to save resources */
        setTimeout(function() { observer.disconnect(); }, 30000);
      }

      /* Run on DOMContentLoaded + delayed retries */
      document.addEventListener('DOMContentLoaded', function() {
        tryHideChannelIO();
        removeChannelElements();
        watchForChannel();
      });
      /* Retry multiple times as Channel Talk loads async */
      [500, 1500, 3000, 5000, 8000].forEach(function(ms) {
        setTimeout(function() {
          tryHideChannelIO();
          removeChannelElements();
        }, ms);
      });
    })();
  </script>
</head>
<body style="margin:0; padding:0;">
  {{ content_for_layout }}
  {%- section 'cart-drawer' -%}

  <!-- Minimal LP Footer -->
  <footer style="background:#1a2640; color:rgba(255,255,255,0.45); text-align:center; padding:24px 20px; font-family:'Outfit',sans-serif; font-size:12px; line-height:1.8;">
    <p style="margin:0 0 6px;">© {{ 'now' | date: '%Y' }} KAPOK KNOT. All rights reserved.</p>
    <p style="margin:0;">
      <a href="{{ shop.url }}/policies/privacy-policy" style="color:rgba(255,255,255,0.45); text-decoration:underline; text-underline-offset:2px;">Privacy Policy</a>
      &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/terms-of-service" style="color:rgba(255,255,255,0.45); text-decoration:underline; text-underline-offset:2px;">Terms of Service</a>
      &nbsp;·&nbsp;
      <a href="{{ shop.url }}/policies/refund-policy" style="color:rgba(255,255,255,0.45); text-decoration:underline; text-underline-offset:2px;">Refund Policy</a>
    </p>
  </footer>

</body>
</html>
