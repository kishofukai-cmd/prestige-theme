<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Japan Material Innovation. Plant-based warmth, zero compromise.' }}">

  <!-- OGP -->
  <meta property="og:title" content="{{ page_title }} | {{ shop.name }}">
  <meta property="og:description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Japan Material Innovation. Plant-based warmth, zero compromise.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://ucarecdn.com/d7a640a6-76bb-47b6-8fd8-9fe27a5ce497/-/format/auto/-/preview/1200x630/-/quality/lighter/_240802_KAPOKKNOT2156-2.jpg">
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {%- render 'css-variables' -%}
  {%- render 'js-variables' -%}
  <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
  <script type="module" src="{{ 'theme.js' | asset_url }}"></script>
  {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
</head>
<body style="margin:0; padding:0;">
  {{ content_for_layout }}

  {%- sections 'footer-group' -%}

  <!-- Sticky CTA Bar -->
  <div id="ag-sticky-cta" style="
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: rgba(26,38,64,0.97);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 -2px 24px rgba(0,0,0,0.15);
    padding: 12px 20px;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  ">
    <div style="max-width: 600px; margin: 0 auto; display: flex; align-items: center; gap: 12px;">
      <div style="flex: 1; min-width: 0;">
        <div style="font-family: 'Outfit', sans-serif; font-size: 11px; color: rgba(255,255,255,0.6); line-height: 1.3;">From $198 — Free Worldwide Shipping</div>
        <div style="font-family: 'Outfit', sans-serif; font-size: 10px; color: rgba(255,255,255,0.4); margin-top: 2px;">✓ Plant-Based　✓ Machine Washable　✓ 500g</div>
      </div>
      <a href="#ag-products" style="
        display: inline-block;
        background: linear-gradient(135deg, #c29d66, #d4b78a);
        color: #2c2825;
        font-family: 'Outfit', sans-serif;
        font-size: 13px;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 100px;
        text-decoration: none;
        white-space: nowrap;
        letter-spacing: 0.04em;
      ">Shop Now</a>
    </div>
  </div>
  <script>
    (function() {
      var cta = document.getElementById('ag-sticky-cta');
      var shown = false;
      window.addEventListener('scroll', function() {
        var shouldShow = window.scrollY > 600;
        if (shouldShow !== shown) {
          shown = shouldShow;
          cta.style.transform = shown ? 'translateY(0)' : 'translateY(100%)';
        }
      });
    })();
  </script>
</body>
</html>
