/* ============================================================
   JavaScript Reveal Script
   ============================================================ */
</style>

<script>
(function() {
  /* Intersection Observer for reveal */
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('al-revealed');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('[data-al-reveal]').forEach(el => observer.observe(el));

  /* FAQ accordion */
  document.querySelectorAll('.al-faq__question').forEach(btn => {
    btn.addEventListener('click', function() {
      const answer = this.nextElementSibling;
      const isOpen = answer.classList.contains('open');
      // close all
      document.querySelectorAll('.al-faq__answer').forEach(a => a.classList.remove('open'));
      document.querySelectorAll('.al-faq__question').forEach(b => b.classList.remove('active'));
      if (!isOpen) {
        answer.classList.add('open');
        this.classList.add('active');
      }
    });
  });

  /* Progress bar animate */
  const fills = document.querySelectorAll('.al-cta__progress-fill');
  const progObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.width = e.target.dataset.pct + '%';
        progObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  fills.forEach(f => { f.style.width = '0'; progObs.observe(f); });
})();
</script>
