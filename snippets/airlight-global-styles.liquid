<style>
/* ============================================================
   KAPOK KNOT — AirLight Jacket | Global LP Stylesheet
   和モダン (Wa-Modern) — Japan Material Innovation
   Mobile-first / English overseas market
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap');

:root {
  /* Colors — 和モダン: 墨色 + 金 パレット */
  --ag-bg:          #faf8f5;
  --ag-bg-warm:     #f2ede5;
  --ag-bg-cream:    #f7f3ec;
  --ag-bg-dark:     #2c2825;
  --ag-bg-dark2:    #3a3530;
  --ag-text:        #2c2825;
  --ag-text-sub:    #6b635a;
  --ag-text-light:  #faf8f5;
  --ag-accent:      #c29d66;
  --ag-accent-light:#d4c2ab;
  --ag-gold:        #c29d66;
  --ag-platinum:    #b8b0a4;
  --ag-border:      #e0dcd1;
  --ag-tag-bg:      #ece7da;
  --ag-tag-text:    #6b5a3e;
  --ag-card:        #fff;

  /* Typography */
  --ag-font-display: 'Cormorant Garamond', Georgia, serif;
  --ag-font-body:    'Outfit', 'Helvetica Neue', sans-serif;
  --ag-font-head:    'Outfit', sans-serif;

  /* Spacing */
  --ag-section-gap: clamp(80px, 14vw, 160px);
  --ag-gap-tight:   clamp(40px, 8vw, 80px);
  --ag-max:         960px;
  --ag-narrow:      680px;
  --ag-pad:         clamp(16px, 5vw, 40px);

  /* Motion */
  --ag-ease: cubic-bezier(0.16, 1, 0.3, 1);
  --ag-dur:  0.7s;
}

/* === Reset === */
*,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  font-size: 16px;
  overflow-x: hidden;
}
body {
  font-family: var(--ag-font-body);
  color: var(--ag-text);
  background: var(--ag-bg);
  line-height: 1.85;
  overflow-x: hidden;
  max-width: 100vw;
  width: 100%;
}
img { max-width:100%; height:auto; display:block; }
a { color:inherit; text-decoration:none; }
button { font-family:inherit; }

/* === Scrollbar === */
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-thumb { background:var(--ag-accent-light); border-radius:2px; }

/* === Container === */
.ag-container {
  max-width: var(--ag-max);
  margin: 0 auto;
  padding: 0 var(--ag-pad);
}
.ag-container--narrow {
  max-width: var(--ag-narrow);
  margin: 0 auto;
  padding: 0 var(--ag-pad);
}

/* === Reveal === */
[data-ag-reveal] {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity var(--ag-dur) var(--ag-ease), transform var(--ag-dur) var(--ag-ease);
}
[data-ag-reveal].ag-revealed { opacity:1; transform:translateY(0); }
[data-ag-reveal].ag-delay-1 { transition-delay: 0.1s; }
[data-ag-reveal].ag-delay-2 { transition-delay: 0.2s; }
[data-ag-reveal].ag-delay-3 { transition-delay: 0.3s; }

/* === Section Label (Pill) === */
.ag-label {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ag-tag-text);
  background: var(--ag-tag-bg);
  padding: 6px 14px;
  border-radius: 100px;
  margin-bottom: 18px;
}
.ag-label--light {
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
}
.ag-label--gold {
  color: var(--ag-gold);
  background: rgba(194,157,102,0.1);
  border: 1px solid rgba(194,157,102,0.2);
}

/* ============================================================
   AG-HERO — Full viewport, 和モダン
   ============================================================ */
.ag-hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: var(--ag-bg-dark);
  color: var(--ag-text-light);
  overflow: hidden;
}
.ag-hero__img-wrapper {
  position: absolute;
  inset: 0;
  z-index: 1;
}
.ag-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  opacity: 0.8;
}
.ag-hero__img-wrapper::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(44,40,37,0.92) 0%,
    rgba(44,40,37,0.5) 45%,
    rgba(44,40,37,0.1) 100%
  );
}
.ag-hero__content {
  position: relative;
  z-index: 2;
  padding: 0 var(--ag-pad) clamp(40px, 10vw, 80px);
  max-width: 720px;
  margin: 0 auto;
  width: 100%;
  text-align: center;
}
.ag-hero__eyebrow {
  font-family: var(--ag-font-head);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--ag-gold);
  margin-bottom: 20px;
}
.ag-hero__title {
  font-family: var(--ag-font-display);
  font-size: clamp(2.4rem, 9vw, 4.5rem);
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.01em;
  margin-bottom: 20px;
  text-shadow: 0 4px 24px rgba(0,0,0,0.5);
}
.ag-hero__title em {
  font-style: italic;
  color: var(--ag-gold);
}
.ag-hero__sub {
  font-size: clamp(1rem, 3.5vw, 1.2rem);
  color: rgba(250,248,245,0.82);
  line-height: 1.75;
  margin-bottom: 40px;
  font-weight: 300;
}
/* Proof bar */
.ag-hero__proof {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 100px;
  padding: 18px 0;
  max-width: 480px;
  margin: 0 auto 32px;
}
.ag-hero__proof-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 0 12px;
}
.ag-hero__proof-num {
  font-family: var(--ag-font-display);
  font-size: clamp(1.1rem, 4vw, 1.4rem);
  font-weight: 500;
  color: #fff;
  letter-spacing: 0.02em;
}
.ag-hero__proof-label {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.6);
  letter-spacing: 0.06em;
  margin-top: 3px;
  text-transform: uppercase;
}
.ag-hero__proof-div {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,0.15);
}
/* Hero CTA */
.ag-hero__cta-wrap { text-align:center; }
.ag-hero__cta-btn {
  display: inline-block;
  padding: 16px 52px;
  font-family: var(--ag-font-head);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--ag-bg-dark);
  background: linear-gradient(135deg, var(--ag-gold) 0%, #d4b78a 100%);
  border-radius: 100px;
  box-shadow: 0 4px 24px rgba(194,157,102,0.4);
  transition: all 0.3s var(--ag-ease);
}
.ag-hero__cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(194,157,102,0.55);
}
.ag-hero__cta-note {
  margin-top: 14px;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.04em;
}
.ag-hero__cta-note strong { color: rgba(255,255,255,0.85); font-weight:500; }

/* ============================================================
   AG-TRUST-BAR
   ============================================================ */
.ag-trust-bar {
  background: var(--ag-bg);
  border-bottom: 1px solid var(--ag-border);
  padding: 22px 0;
}
.ag-trust-bar__list {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px 40px;
}
.ag-trust-bar__item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.ag-trust-bar__icon {
  color: var(--ag-gold);
  flex-shrink: 0;
}
.ag-trust-bar__icon svg { width:20px; height:20px; }
.ag-trust-bar__text {
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--ag-text);
  white-space: nowrap;
}
@media (min-width: 768px) {
  .ag-trust-bar { padding: 28px 0; }
  .ag-trust-bar__icon svg { width:22px; height:22px; }
  .ag-trust-bar__text { font-size: 0.9rem; }
}

/* ============================================================
   AG-BRAND (ブランドストーリー / 和モダンダーク)
   ============================================================ */
.ag-brand {
  padding: var(--ag-section-gap) 0;
  background: var(--ag-bg-dark);
  color: var(--ag-text-light);
  text-align: center;
}
.ag-brand__kicker {
  font-family: var(--ag-font-head);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ag-gold);
  margin-bottom: 24px;
}
.ag-brand__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(2rem, 7vw, 3.5rem);
  font-weight: 500;
  line-height: 1.35;
  margin-bottom: 32px;
}
.ag-brand__heading em {
  font-style: italic;
  color: var(--ag-gold);
}
.ag-brand__body {
  font-size: clamp(1rem, 2.5vw, 1.1rem);
  color: rgba(250,248,245,0.72);
  line-height: 1.9;
  max-width: 600px;
  margin: 0 auto 48px;
  font-weight: 300;
}
/* Tags */
.ag-brand__tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}
.ag-brand__tag {
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  padding: 8px 18px;
  border-radius: 100px;
}

/* ============================================================
   AG-PAIN (共感)
   ============================================================ */
.ag-pain {
  padding: var(--ag-section-gap) 0;
  background: var(--ag-bg-warm);
}
.ag-pain__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(1.8rem, 6vw, 2.8rem);
  font-weight: 500;
  text-align: center;
  margin-bottom: 48px;
  line-height: 1.4;
}
.ag-pain__items {
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-width: 520px;
  margin: 0 auto 48px;
}
.ag-pain__item {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  background: rgba(255,255,255,0.6);
  border: 1px solid rgba(194,157,102,0.2);
  border-radius: 16px;
  padding: 20px 22px;
}
.ag-pain__item-icon {
  font-size: 1.4rem;
  flex-shrink: 0;
  margin-top: 2px;
}
.ag-pain__item-text {
  font-size: 1rem;
  color: var(--ag-text);
  line-height: 1.65;
}
.ag-pain__bridge {
  text-align: center;
  margin: 0 auto;
  max-width: 600px;
}
.ag-pain__bridge-line {
  font-size: 2rem;
  color: var(--ag-gold);
  margin-bottom: 28px;
  animation: ag-bounce 2s infinite;
}
@keyframes ag-bounce {
  0%,100%{transform:translateY(0)}
  40%{transform:translateY(-10px)}
  60%{transform:translateY(-5px)}
}
.ag-pain__bridge-text {
  font-family: var(--ag-font-display);
  font-size: clamp(1.4rem, 5vw, 2rem);
  font-weight: 500;
  line-height: 1.5;
  color: var(--ag-text);
}
.ag-pain__bridge-text strong {
  color: var(--ag-gold);
  display: block;
  font-size: 1.2em;
  margin-top: 6px;
}

/* ============================================================
   AG-FEATURES (5大特徴)
   ============================================================ */
.ag-features {
  padding: var(--ag-section-gap) 0;
  background: var(--ag-bg);
}
.ag-features__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(1.8rem, 6vw, 2.8rem);
  font-weight: 500;
  text-align: center;
  margin-bottom: clamp(48px, 8vw, 72px);
  line-height: 1.4;
}
.ag-features__cards {
  display: flex;
  flex-direction: column;
  gap: var(--ag-section-gap);
}
.ag-feature-card {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.ag-feature-card__img {
  width: 100%;
  aspect-ratio: 4/5;
  overflow: hidden;
  background: var(--ag-bg-warm);
  margin-bottom: 32px;
}
.ag-feature-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s var(--ag-ease);
}
.ag-feature-card__img:hover img { transform: scale(1.03); }
.ag-feature-card__body {
  padding: 0 var(--ag-pad);
  max-width: var(--ag-narrow);
  margin: 0 auto;
  width: 100%;
}
.ag-feature-card__tag {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ag-tag-text);
  background: var(--ag-tag-bg);
  padding: 5px 12px;
  border-radius: 100px;
  margin-bottom: 14px;
}
.ag-feature-card__num {
  font-family: var(--ag-font-display);
  font-size: clamp(3rem, 10vw, 5rem);
  line-height: 1;
  color: var(--ag-accent);
  opacity: 0.2;
  display: block;
  margin-left: -4px;
}
.ag-feature-card__title {
  font-family: var(--ag-font-display);
  font-size: clamp(1.6rem, 5.5vw, 2.2rem);
  font-weight: 500;
  margin-top: -20px;
  position: relative;
  z-index: 2;
  margin-bottom: 16px;
  line-height: 1.3;
}
.ag-feature-card__desc {
  font-size: 1rem;
  color: var(--ag-text-sub);
  line-height: 1.9;
}
.ag-feature-card__stat {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  margin-top: 20px;
  background: var(--ag-tag-bg);
  border-radius: 12px;
  padding: 14px 20px;
}
.ag-feature-card__stat-num {
  font-family: var(--ag-font-display);
  font-size: 1.8rem;
  font-weight: 500;
  color: var(--ag-accent);
  line-height: 1;
}
.ag-feature-card__stat-label {
  font-size: 0.8rem;
  color: var(--ag-text-sub);
  font-weight: 500;
}
@media (min-width: 768px) {
  .ag-feature-card {
    flex-direction: row;
    align-items: center;
    gap: 64px;
    max-width: var(--ag-max);
    margin: 0 auto;
    padding: 0 var(--ag-pad);
  }
  .ag-feature-card:nth-child(even) { flex-direction: row-reverse; }
  .ag-feature-card__img {
    flex: 1;
    aspect-ratio: 1/1;
    border-radius: 20px;
    margin-bottom: 0;
  }
  .ag-feature-card__body {
    flex: 1;
    padding: 0;
  }
}

/* ============================================================
   AG-MATERIAL (素材ストーリー — ダーク)
   ============================================================ */
.ag-material {
  padding: var(--ag-section-gap) 0;
  background: var(--ag-bg-dark);
  color: var(--ag-text-light);
}
.ag-material__inner {
  display: flex;
  flex-direction: column;
  gap: 48px;
}
.ag-material__img {
  width: 100%;
  aspect-ratio: 4/3;
  overflow: hidden;
  border-radius: 0;
  background: var(--ag-bg-dark2);
}
.ag-material__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.ag-material__content { padding: 0 var(--ag-pad); }
.ag-material__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(1.8rem, 6vw, 2.8rem);
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 24px;
}
.ag-material__heading em { font-style:italic; color:var(--ag-gold); }
.ag-material__body {
  font-size: 1rem;
  color: rgba(250,248,245,0.72);
  line-height: 1.9;
  margin-bottom: 32px;
  font-weight: 300;
}
.ag-material__specs {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.ag-material__spec {
  display: flex;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  font-size: 0.92rem;
}
.ag-material__spec-key {
  color: rgba(250,248,245,0.55);
  font-weight: 400;
}
.ag-material__spec-val {
  color: rgba(250,248,245,0.9);
  font-weight: 500;
}
@media (min-width: 768px) {
  .ag-material__inner {
    flex-direction: row;
    align-items: center;
    gap: 64px;
    max-width: var(--ag-max);
    margin: 0 auto;
    padding: 0 var(--ag-pad);
  }
  .ag-material__img {
    flex: 1;
    aspect-ratio: 1/1;
    border-radius: 20px;
  }
  .ag-material__content { flex: 1; padding: 0; }
}

/* ============================================================
   AG-CTA (ゴールドCTA)
   ============================================================ */
.ag-cta {
  padding: var(--ag-gap-tight) 0;
  background: var(--ag-bg-cream);
  text-align: center;
}
.ag-cta__eyebrow {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ag-gold);
  margin-bottom: 16px;
}
.ag-cta__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(1.6rem, 5vw, 2.4rem);
  font-weight: 500;
  margin-bottom: 12px;
  line-height: 1.4;
}
.ag-cta__sub {
  font-size: 0.95rem;
  color: var(--ag-text-sub);
  margin-bottom: 32px;
}
/* Progress bar */
.ag-cta__progress {
  max-width: 360px;
  margin: 0 auto 28px;
}
.ag-cta__progress-bar {
  height: 6px;
  background: var(--ag-border);
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 8px;
}
.ag-cta__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--ag-gold), #d4b78a);
  border-radius: 3px;
  transition: width 1.2s var(--ag-ease);
}
.ag-cta__progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  color: var(--ag-text-sub);
}
/* Offer */
.ag-cta__offer {
  background: rgba(194,157,102,0.08);
  border: 1px solid rgba(194,157,102,0.2);
  border-radius: 14px;
  padding: 16px 20px;
  max-width: 420px;
  margin: 0 auto 28px;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--ag-text);
}
.ag-cta__offer-note {
  font-size: 0.75rem;
  color: var(--ag-text-sub);
  font-weight: 400;
  margin-top: 4px;
}
.ag-cta__btn {
  display: inline-block;
  padding: 16px 56px;
  font-family: var(--ag-font-head);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--ag-bg-dark);
  background: linear-gradient(135deg, var(--ag-gold), #d4b78a);
  border-radius: 100px;
  box-shadow: 0 4px 20px rgba(194,157,102,0.4);
  transition: all 0.3s var(--ag-ease);
}
.ag-cta__btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(194,157,102,0.5);
}
.ag-cta__micros {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px 16px;
  margin-top: 16px;
  font-size: 0.75rem;
  color: var(--ag-text-sub);
}

/* ============================================================
   AG-COMPARISON (比較表)
   ============================================================ */
.ag-comparison {
  padding: var(--ag-section-gap) 0;
  background: var(--ag-bg-warm);
}
.ag-comparison__heading {
  font-family: var(--ag-font-display);
  font-size: clamp(1.8rem, 6vw, 2.8rem);
  font-weight: 500;
  text-align: center;
  margin-bottom: clamp(36px, 6vw, 56px);
  line-height: 1.4;
}
.ag-comparison__table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 16px;
}
.ag-comparison__table {
  width: 100%;
  min-width: 540px;
  border-collapse: collapse;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 24px rgba(44,40,37,0.08);
}
.ag-comparison__table thead tr {
  background: var(--ag-bg-dark);
  color: var(--ag-text-light);
}
.ag-comparison__table th {
  padding: 18px 16px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
}
.ag-comparison__table th:first-child { text-align: left; }
.ag-comparison__table th.ag-comparison__th--hero {
  background: var(--ag-gold);
  color: var(--ag-bg-dark);
  position: relative;
}
.ag-comparison__table th.ag-comparison__th--hero::after {
  content: '★ OUR PICK';
  display: block;
