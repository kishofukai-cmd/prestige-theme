        "features_grid_95": {
          "type": "features_grid",
          "settings": {
            "icon_size": "large",
            "columns_desktop": 2,
            "image_url_1": "https://ucarecdn.com/613a6d58-fd7d-48de-9679-7bf5fd438a28/-/format/auto/-/preview/3000x3000/-/quality/lighter/3.jpg",
            "image_url_2": "https://ucarecdn.com/000e45da-aeca-4004-80cc-d770d53fd832/-/format/auto/-/preview/3000x3000/-/quality/lighter/5.jpg",
