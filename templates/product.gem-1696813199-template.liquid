%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202023-10-12%2012.25.21.png" alt="" class="gf_image" data-gemlang="en" width="1198" height="650" data-width="100%" data-height="auto" title="" natural-width="1198" natural-height="650"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1614054350458" data-id="1614054350458"><div data-label="Heading" data-key="heading" id="e-1614055165688" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1614055165688"><div class="elm text-edit gf-elm-center gf-elm-left-md gf-elm-left-sm gf-elm-left-lg gf-elm-left-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><font face="optima, 游ゴシック体, YuGothic, 游ゴシック Medium, Yu Gothic Medium, 游ゴシック, Yu Gothic, sans-serif"><b>これからのダウンのスタンダードへ。</b></font></h2></div></div><div data-label="Text Block" data-key="text-block" id="e-1614055165731" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1614055165731"><div class="elm text-edit gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-gemlang="en" data-exc=""><p>「2030年、ダウンのスタンダードはどうなっているのだろうか」</p><p>そんな近未来を予想しながら開発を続けてきた、</p><p>KAPOK KNOTオリジナルの100% 植物由来のコート。</p></div></div></div></div><div data-label="Row" data-key="row" id="r-1614055165685" class="gf_row" data-icon="gpicon-row" data-id="1614055165685" data-extraclass=""><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1614054300329" data-id="1614054300329"><div data-label="Image" data-key="image" id="e-1614055165657" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1614055165657" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/c5c61d48-0c1b-41bf-91c2-9890c9eca4f8/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202023-10-12%2012.17.36.png" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" natural-width="1068" natural-height="776" width="1068" height="776"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1614054314332" data-id="1614054314332"><div data-label="Heading" data-key="heading" id="e-1614055165750" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1614055165750"><div class="elm text-edit gf-elm-center gf-elm-left-md gf-elm-left-sm gf-elm-left-lg gf-elm-left-xs gf_gs-text-heading-2" data-gemlang="en" data-exc=""><b>技術とデザインを兼ね備える</b></div></div><div data-label="Text Block" data-key="text-block" id="e-1614055165689" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1614055165689"><div class="elm text-edit gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-gemlang="en" data-exc="">細番手でありながら、高級感を感じさせる日本ならではの合繊技術と植物由来の融合。<div><br></div><div>Flareは、その名の通り裾と袖の独特なフレアが特徴。</div><div><br></div><div>ギャザーとフレアが絶妙なバランスで融合した至極の逸品。</div></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" class="gf_row" id="r-1611384474582" data-icon="gpicon-row" data-id="1611384474582"><div class="gf_column gf_col-lg-12" id="c-1611384474538" data-id="1611384474538"><div data-label="Heading" data-key="heading" id="e-1611384491683" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1611384491683"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><strong>「farm to fashion」一緒に旅してみませんか？</strong></h2></div></div></div></div><!--gfsplit--><div data-label="Row" class="gf_row" id="r-1611385005456" data-icon="gpicon-row" data-id="1611385005456"><div class="gf_column gf_col-lg-12" id="c-1611385005578" data-id="1611385005578"><div data-label="Text Block" data-