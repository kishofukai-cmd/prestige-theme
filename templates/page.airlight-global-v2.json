      "block_order": ["value_block_1", "value_block_2", "value_block_3"],
      "settings": {
        "kicker": "A Message From Our Founder",
        "founder_name": "Kisho Fukai, Founder & CEO of KAPOK KNOT",
        "founder_image_url": "https://ucarecdn.com/ee2273fb-34e1-4d2b-b443-bb4b32c0b2ff/-/format/auto/-/preview/3000x3000/-/quality/lighter/image%2069.png",
        "founder_body": "<p>I'm Kisho Fukai, founder of KAPOK KNOT — and the fourth generation of a Japanese textile family.</p><p>Growing up inside the apparel industry, I saw its mass-production, mass-waste system up close. Then I found kapok, and knew instantly: this is the material I want to spend my life on.</p><p>We seriously believe this fiber can help save the world. Every piece we make carries that conviction — with the consumer, the producer, and the planet all in view.</p>",
        "values_heading": "What KAPOK KNOT Stands For"
      }
    },
    "faq": {
      "type": "airlight2025-faq",
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "How does international sizing work?",
            "answer": "<p>Our sizing follows Japanese standards, which run smaller than US/AU/EU sizing — Japanese S is roughly an international XS. We recommend ordering one size up from what you'd normally wear.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "What's your shipping and return policy?",
            "answer": "<p>Orders ship from Japan within 3–5 business days; delivery to Australia typically takes 7–14 days. If your item arrives faulty or not as described, we'll replace or refund it at our cost — your rights under Australian Consumer Law always apply.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Where are your products made?",
            "answer": "<p>The heart of every jacket — our EthicalDown Kapok™ insulation fabric — is developed and made in Japan, from kapok grown in Southeast Asia. Each AirLight Jacket is designed and engineered in Tokyo.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "What does the logo mean?",
            "answer": "<p>“Knot” refers to a bond, a tie. Our mark uses the “ayamusubi” knot — a Japanese cord style known for how strong and lasting it is, symbolizing our approach to sustainability.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "How do I hand-wash it?",
            "answer": "<p>Press-wash gently in lukewarm water (below 30°C) with a neutral detergent. Skip the dryer — lay flat in a shaded, ventilated spot.</p>"
          }
        }
      },
      "block_order": ["faq_item_1", "faq_item_2", "faq_item_3", "faq_item_4", "faq_item_5"],
      "settings": {
        "kicker": "FAQ",
