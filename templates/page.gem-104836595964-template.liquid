nter-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/119eb432-6270-4c03-b317-88eb31ff64af/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_7260.jpg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1055" height="1875" natural-width="1055" natural-height="1875"></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1700534615960" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1700534615960"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p>チェックチェスターコート　¥58,000</p></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703123973822" class="gf_row" data-icon="gpicon-row" data-id="1703123973822"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1665464482228" data-id="1665464482228"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703123973818" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703123973818" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/c8a1c3cc-74ce-4af7-b5f4-752171093895/-/format/auto/-/preview/3000x3000/-/quality/lighter/Blurtheline-8%201.png" alt="" class="gf_image" data-gemlang="en" width="1372" height="250" data-width="100%" data-height="auto" title="" natural-width="1372" natural-height="250"></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703123973789" class="gf_row" data-icon="gpicon-row" data-id="1703123973789" data-layout-lg="12" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1661830614049" data-id="1661830614049"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703123973826" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703123973826" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/0b47d8e3-7900-4627-ad6e-f2a3da533453/-/format/auto/-/preview/3000x3000/-/quality/lighter/kapokwarm.png" alt="" class="gf_image" data-gemlang="en" width="1136" height="708" data-width="100%" data-height="auto" title="" natural-width="1136" natural-height="708"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1703131864682" data-id="1703131864682"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1703123973800" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1703123973800"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2">水鳥の羽を一切使用せず、ダウンの暖かさを実現</h2></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703123973810" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703123973810"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>カポックは、空気の層が湿気を吸って暖かくなる吸湿発熱という機能を持っています。そのため「木に実るダウン」とも呼ばれています。</p><p><br></p><p>水鳥の羽を使用せずにダウンの暖かさを実現できたのは、カポックのおかげなのです。</p></div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703123973849" class="gf_row" data-icon="gpicon-row" data-id="1703123973849" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1661830614049" data-id="1661830614049"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1703123973792" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1703123973792"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2">動物にも優しいアニマルフリー</h2></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703123973711" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703123973711"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>従来のダウンは水鳥の羽が使用されていました。一説には、１つのダウンジャケットには約30羽分の羽毛が使われているといわれています。</p><p>羽毛の採取方法にもいくつかありますが、ライブハンドピッキング法は質の良い羽毛を採取できる方法としても知られています。<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">実際、採取方法を表明していない企業も存在しています。</span><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">カポックノットの商品で使用するカポックは木の実由来ですから、その事実に心を痛める必要はありません。</span></p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1661830616571" data-id="1661830616571"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703123973738" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703123973738" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/7195ca1b-4376-4352-a81c-f6aad630623d/-/format/auto/-/preview/3000x3000/-/quality/lighter/image%20139.png" alt="動物にも優しいアニマルフリー" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="580" height="288" natural-width="580" natural-height="288"></div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703143923034" class="gf_row" data-icon="gpicon-row" data-id="1703143923034" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1703143923072" data-id="1703143923072"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1703132635524" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1703132635524" style=""><div class="elm text-edit gf-elm-center gf-elm-center-md gf-elm-center-sm gf-elm-center-lg gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2"><span style="color: rgb(255, 255, 255);">こんな方におすすめ！</span></h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703132635457" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703132635457" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf-elm-center-lg" data-gemlang="en" data-exc=""><p><span style="font-family: inherit; font-size: inherit; text-align: inherit; color: rgb(255, 255, 255);"><strong style="">① 着膨れをなるべく避け、<br>　薄手アウターで寒さを我慢している方。</strong></span></p></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703132635487" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703132635487" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf-elm-center-lg" data-gemlang="en" data-exc=""><p><strong style="color: rgb(255, 255, 255);"><span style="font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0.3px;">②見た目のビジネスコートらしさを求め</span><span style="font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0.3px;">、</span><br></strong></p><p><strong style="color: rgb(255, 255, 255);"><span style="font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0.3px;">　おしゃれなデザイン</span><span style="font-family: inherit; font-size: inherit; letter-spacing: 0.3px; text-align: inherit;">を諦めている方。</span></strong></p></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703132635519" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703132635519" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf-elm-center-lg" data-gemlang="en" data-exc=""><p><span style="font-family: inherit; font-size: inherit; letter-spacing: 0.3px; text-align: inherit; color: rgb(255, 255, 255);"><strong style="">③アウターはお手入れがしずらいと悩んでいる方。</strong></span><br></p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1703143933373" data-id="1703143933373"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1703143979002" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1703143979002" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/182b6b9c-815f-4c4a-abc7-fef947420bcc/-/format/auto/-/preview/3000x3000/-/quality/lighter/231218_KK_coat_research_comp-02.png" alt="" class="gf_image" data-gemlang="en" width="2362" height="1316" data-width="100%" data-height="auto" title="" natural-width="2362" natural-height="1316"></div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703132635475" class="gf_row" data-icon="gpicon-row" data-id="1703132635475" data-layout-lg="12" data-extraclass="" data-layout-md="12" data-layout-sm="12" data-layout-xs="12"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1699950866835" data-id="1699950866835"><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1703132635556" class="gf_row" data-icon="gpicon-row" data-id="1703132635556" data-extraclass=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1700115078506" data-id="1700115078506"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1703132635529" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1703132635529"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p><span style="font-family: inherit; font-size: inherit; text-align: inherit; color: rgb(255, 255, 255);">KAOK KNOTのアウターは、デザイン面も機能面も両立させ、ビジネスシーンの通勤でおしゃれを楽しめるアウター。</span></p><p><span style="font-family: inherit; font-size: inherit; text-align: inherit; color: rgb(255, 255, 255);">また、着用シーン選ばないので、通勤やビジネスシーンにはもちろん、休日のお出かけにも羽織ることができて一石二鳥です。</span><br></p></div></div></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1699951780901" class="gf_row" data-icon="gpicon-row" data-id="1699951780901" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1699951780859" data-id="1699951780859"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1699951849127" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1699951849127" style="display: block;"><div class="elm text-edit gf-elm-center gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><span style="text-decoration-line: underline;">通勤時のスタイルに。</span></h2></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1700117819412" class="gf_row" data-icon="gpicon-row" data-id="1700117819412"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1700117819373" data-id="1700117819373"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1700117831042" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1700117831042"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>今日の午後は時間をかけて準備をした重要なプレゼンが控えている。いつもより身体に緊張が走るが、このカポックダウンのアウターを羽織っていると、暖かいのはもちろん、アウターだが身体が硬らず心にゆとりができる。よし、気合を入れて臨もう。</p></div></div></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1699951807782" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1699951807782" data-resolution="3000x3000" style="display: block;"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/8046778e-cd02-4890-8fc2-76876ef1c951/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_7263%202.jpg" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="1052" height="1871" natural-width="1052" natural-height="1871"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1700536309706" data-id="1700536309706"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1702382943401" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1702382943401"><div class="elm text-edit gf-elm-center gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><span style="text-decoration-line: underline;">休日のお出かけシーンにも。</span></h2></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1702382917651" class="gf_row" data-icon="gpicon-row" data-id="1702382917651"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1700117819373" data-id="1700117819373"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1702382917550" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1702382917550"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>楽しみにしていた友人と休日のランチ。外での待ち時間が発生しても、ふんわり軽くいアウターなら身体に負担がなく待ち続けられる。お店でアウターを脱いでも、薄くて軽いのでかさばらず、スマートに掛けられるのがうれしい。<br></p></div></div></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1699951875044" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1699951875044" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/bae878bd-cbf4-46a4-ab56-80465317f135/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_6933%20_1_%202.jpg" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="1687" height="3000" natural-width="1687" natural-height="3000"></div></div></div></div><!--gfsplit--><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1700536154587" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1700536154587" style=""><div class="elm text-edit gf-elm-center gf-elm-center-md gf-elm-center-sm gf-elm-center-lg gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><span style="color: rgb(255, 255, 255);">商品紹介</span></h2></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1699952007423" class="gf_row" data-icon="gpicon-row" data-id="1699952007423" data-layout-lg="4+8" data-extraclass="" data-layout-md="4+8" data-layout-sm="4+8" data-layout-xs="12+12"><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-4 gf_col-xs-12" id="c-1699952007597" data-id="1699952007597"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1699952198944" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1699952198944" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/9f0155ad-7e1f-4ada-8ecb-d09fd11