    "founder": {
      "type": "airlight2025-founder",
      "blocks": {
        "value_block_1": {
          "type": "value_block",
          "settings": {
            "title": "次世代に託す地球環境への還元",
            "body": "サステナブルな素材を活用し、持続可能なビジネスを展開し、その利益の一部で地球環境再生に貢献します。"
