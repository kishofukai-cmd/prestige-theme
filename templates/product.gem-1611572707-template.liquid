a-height="auto" title="" width="3000" height="535" natural-width="3000" natural-height="535"></a></div></div><div data-label="Heading" data-key="heading" id="e-1611381798060" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1611381798060"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h2 class="gf_gs-text-heading-2"><b>たった5mmで、ダウンの暖かさ。</b></h2></div></div><div data-label="Text Block" data-key="text-block" id="e-1611382681300" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1611382681300"><div class="elm text-edit gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-gemlang="en" data-exc=""><p>膝上丈のクラシカルなステンカラーコート。軽い着心地と程よいハリ感・光沢を抑えたマットな質感で、オン・オフ問わずに様々なシーンで着れる一枚。</p><p><br></p><p>ジャケットの上に羽織れるようにサイズに余裕がある作りになっています。生地はシワになりずらく、ケアラブルなコットン/ポリエステルツイル。</p></div></div></div><div class="gf_clearfix"></div>{% unless product == empty %}{% for variant in product.variants %}<input type="hidden" id="gf-hidden-variant{{variant.id}}" value="{{variant.id}}" data-compare-price="{{ variant.compare_at_price | money | strip_html }}" data-price="{{ variant.price | money | strip_html }}">{% endfor %}<script type="text/plain" class="product-json" id="product-json{{product.id}}">{{ product | json }}</script>{% endunless %}{% endform %}{% endunless %}</div>{% assign product = currentProduct %}</div><div data-label="Accordion" data-key="accordion" id="m-1611382311548" class="module-wrap" data-icon="gpicon-accordion" data-ver="2" data-id="1611382311548"><div data-accordion-group="" class="module " data-opendefault="1" data-opentab="1" data-single="1" data-bordercolor="#cecece" data-bordersize="1px"><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="1" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Text Block" id="e-1611388897008" class="element-wrap" data-icon="gpicon-textblock" data-id="1611388897008" data-ver="1"><div class="elm text-edit gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-exc=""><p><b>サイズ詳細</b></p></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="1" data-key="content1" class="item-content"><div data-label="Image" data-key="image" id="e-1611389092260" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1611389092260" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/e7e4036c-3802-4d31-bff2-0c9d59f4a0f1/-/format/auto/-/preview/3000x3000/-/quality/lighter/" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" natural-width="640" natural-height="534"></div></div></article></div></div><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="2" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Text Block" id="e-1611382311548-1" class="element-wrap" data-icon="gpicon-textblock" data-id="1611382311548-1" data-ver="1"><div class="elm text-edit gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-exc=""><p><b>素材</b></p></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="2" data-key="content1" class="item-content"><div data-label="Text Block" data-key="text-block" id="e-1611382369227" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1611382369227"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>表地：ポリエステル63%、コットン34%、ポリウレタン3%</p><p>中綿：リサイクルポリエステル70％、植物繊維（カポック）30％</p><p>裏地：キュプラ100％</p></div></div></article></div></div><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="3" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Text Block" id="e-1644416822755" class="element-wrap" data-icon="gpicon-textblock" data-id="1644416822755" data-ver="1"><div class="elm text-edit gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-exc=""><p><b>カーボンフットプリント</b></p></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="3" data-key="content1" class="item-content"><div data-label="Text Block" data-key="text-block" id="e-1644416822819" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1644416822819"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>メンズステンカラーコートのカーボンフットプリントは18.28kg-CO2です。</p><p>レディースステンカラーコートのカーボンフットプリントは16.30kg-CO2です。</p><p><br></p><p>KAPOK KNOTは素材、製造、消費者の使用による使用のカーボンフットプリントを算出しています。</p><p></p></div></div></article></div></div><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="4" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Text Block" id="e-1611382311548-2" class="element-wrap" data-icon="gpicon-textblock" data-id="1611382311548-2" data-ver="1"><div class="elm text-edit gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-exc=""><p><b>お手入れ方法</b></p></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="4" data-key="content1" class="item-content"><div data-label="Image" data-key="image" id="e-1611382459927" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1611382459927" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/79011912-a3ae-4dc8-98e0-05ba8f33107a/-/format/auto/-/preview/3000x3000/-/quality/lighter/" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" natural-width="469" natural-height="59"></div></div><div data-label="Text Block" data-key="text-block" id="e-1611382436656" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1611382436656"><div class="elm text-edit gf-elm-left gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-gemlang="en" data-exc=""><p>洗濯時はネットを使用し、アイロンはあて布を使用してください。</p><p><br></p><p>柔軟剤の使用はなるべくお避けください。 型崩れや縫目滑脱の原因になります。 長時間洗液に浸しておいたり、水や汗に濡れたままの状態で放置しますと、色落ちや色移りの原因になりますのでお避けください。 素材の特性上、洗濯や着用により、中わたが吹き出したり、細やかな繊維が表に飛び出ることがあります。 吹き出した中わたは引っ張らずにハサミでカットしてください。</p></div></div></article></div></div><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="5" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Text Block" id="e-1611382311548-3" class="element-wrap" data-icon="gpicon-textblock" data-id="1611382311548-3" data-ver="1"><div class="elm text-edit gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs gf_gs-text-paragraph-1" data-exc=""><p><b>配送と返品</b></p></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="5" data-key="content1" class="item-content"><div data-label="Text Block" data-key="text-block" id="e-1611382753531" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1611382753531"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>お客様からオーダーを頂いてから、基本的には3日以内にお届けしております。</p><p>（ただし、物流状況に準じますことをご了承ください。）</p><p><br></p><p>また、お客様のお手元に商品が届いてから2週間以内でしたら、返品、交換が可能になります。商品に不良がない限り、商品タグを外して以降の返品、交換は基本的に対応致しかねますので、商品タグは切らずにご試着ください。</p></div></div></article></div></div></div></div><div data-label="Image" data-key="image" id="e-1611383050287" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1611383050287" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/blogs/news/try_kapok_on" target="" aria-describedby="a11y-external-message"><img src="https://ucarecdn.com/8e5b242b-0020-4cea-996f-e258f3774168/-/format/auto/-/preview/3000x3000/-/quality/lighter/220601_KK_trykapokon_banner.png" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" natural-width="1145" natural-height="267" width="1145" height="267"></a></div></div><div data-label="Liquid" data-key="liquid" id="m-1611391713901" class="module-wrap" data-icon="gpicon-liquid" data-ver="1.0" data-id="1611391713901" data-name="Right click on the module, then choose Edit Html / Liquid option to start writing your custom code." style="background-image: none;"><div class="module gf_module- gf_module--lg gf_module--md gf_module--sm gf_module--xs {{extraClass}}"><div class="klaviyo-form-WVJ2QL"><