    "material": {
      "type": "airlight2025-material",
      "settings": {
        "section_id": "en-material",
        "bg_color": "#faf9f6",
        "label": "The Material",
        "heading": "<p>A fiber from a tree.<em> Engineered in Japan.</em></p>",
        "intro": "Kapok grows on trees. Hollow at the core — by nature. It took 5 years of collaboration with Japan's top textile engineers to turn it into Ethical Down Kapok™: the world's first kapok insulation sheet. The result is 500g of warmth that replaces down."
      },
      "blocks": {
        "m1": {
          "type": "material_block",
          "settings": {
            "title": "1/8 the weight of cotton",
            "body": "<p>Hollow at the core. Kapok's natural air-trapping structure is nature's answer to synthetic fill — at almost no weight.</p>",
            "image_url": "https://ucarecdn.com/dea0315a-8b99-48e9-b01e-e5cc3d6e4cef/",
            "image_position": "full"
          }
        },
        "m2": {
          "type": "material_block",
          "settings": {
            "title": "Breathes. Warms. Adapts.",
            "body": "<p>Warm when still. Ventilated when active. Kapok self-regulates in ways synthetic insulation simply can't.</p>",
            "image_url": "https://ucarecdn.com/0fd37cb2-ccc2-4e42-b90b-cb33f4bcf6f1/-/format/auto/-/preview/3000x3000/-/quality/lighter/_240802_KAPOKKNOT2157_re-2.jpg",
            "image_position": "full"
          }
        },
        "m3": {
          "type": "material_block",
          "settings": {
            "title": "Zero animals. Zero compromise.",
            "body": "<p>No feathers. No live plucking. Kapok pods grow on trees, harvested without harm. Same warmth. None of the cost.</p>",
            "image_url": "https://ucarecdn.com/07e530d0-b408-4caa-80f6-d6248d549785/-/format/auto/-/preview/3000x3000/-/quality/lighter/25.png",
            "image_position": "full"
          }
        }
      },
