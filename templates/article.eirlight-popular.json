rder":true,"content_width":"sm","text_position":"center","remove_vertical_spacing":false}},"rich_text_qdXQjb":{"type":"rich-text","settings":{"color_scheme":"","separate_section_with_border":true,"content_width":"sm","text_position":"center","remove_vertical_spacing":false}},"slideshow_kcEnwr":{"type":"slideshow","settings":{"allow_transparent_header":true,"show_next_section_button":true,"media_size":"auto","autoplay":true,"autoplay_pause_on_video":true,"cycle_speed":5,"background":"#000000","controls_color":"#ffffff"}},"image_with_text_n964VP":{"type":"image-with-text","blocks":{"heading_prQhmz":{"type":"heading","settings":{"text":"","heading_tag":"h1"}},"richtext_AchkXD":{"type":"richtext","settings":{"content":"<h5><strong>POINT①<\/strong><br\/>傘の20倍の耐水圧！植物由来のコーティングで、全天候で使用可能の撥水機能。<\/h5><h5><strong>POINT②<\/strong><br\/>首元を覆うジップで、寒い冬もマフラー要らず。またフード付きのため急な降雨や寒い日も頭をカバー。<\/h5><h5><strong>POINT③<\/strong><br\/>ポケットに便利なファスナー付き<br\/>スマートフォンや財布などの小物を入れても落ちる心配がありません。<\/h5><h5><strong>POINT④<\/strong><br\/>左腕には、外側から見えるKAPOK KNOTのロゴが施されています。<\/h5>"}}},"block_order":["heading_prQhmz","richtext_AchkXD"],"settings":{"color_scheme":"","separate_section_with_border":true,"image":"shopify:\/\/shop_images\/3836ab26710de76d5b999b17b11af6bf.png","reveal_on_scroll":true,"image_position":"start","content_width":"sm","remove_vertical_spacing":true}},"rich_text_eXtRVH":{"type":"rich-text","blocks":{"heading_dQdUTq":{"type":"heading","settings":{"text":"傘の20倍の耐水圧！","heading_tag":"h1"}},"heading_UedMUi":{"type":"heading","settings":{"text":"特殊コーティングで全天候使用可能","heading_tag":"h1"}},"video_tqGmQ4":{"type":"video","settings":{}},"image_rHaf4w":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/detail_11953_15994823328357.gif","width_mode":"custom","max_width":600,"mobile_max_width":400}},"richtext_dxb6RR":{"type":"richtext","settings":{"content":"<p>従来のダウンは雨に濡れてしまうと<br\/>1～2日乾かさなければ<br\/>羽毛がヘタってしまい、<br\/>防寒能力が著しく低下してしまします。<\/p><p>しかし、カポックノットのジャケットは<br\/><strong>特殊4層構造で雨がしみにくく<\/strong>、<br\/>傘の20倍の耐水圧で水滴を弾くため、<br\/><strong>防寒能力を維持<\/strong>できるのです。<\/p>"}},"image_VfrTUi":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/detail_11953_15997005361742.webp","width_mode":"custom","max_width":600,"mobile_max_width":400}},"image_fc9XdT":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/detail_11953_15992754136438.webp","width_mode":"custom","max_width":600,"mobile_max_width":400}},"image_Dn9VDb":{"type":"image","settings":{"width_mode":"custom","max_width":600,"mobile_max_width":400}},"subheading_HVha6r":{"type":"subheading","settings":{"text":"▶︎ カポックコットンを特殊技術で加工したシート"}}},"block_order":["heading_dQdUTq","heading_UedMUi","video_tqGmQ4","image_rHaf4w","richtext_dxb6RR","image_VfrTUi","image_fc9XdT","image_Dn9VDb","subheading_HVha6r"],"settings":{"color_scheme":"","separate_section_with_border":true,"content_width":"sm","text_position":"center","remove_vertical_spacing":false}},"slideshow_BGnDqw":{"type":"slideshow","settings":{"allow_transparent_header":true,"show_next_section_button":true,"media_size":"auto","autoplay":true,"autoplay_pause_on_video":true,"cycle_speed":5,"background":"#000000","controls_color":"#ffffff"}},"rich_text_Rnabwm":{"type":"rich-text","blocks":{"heading_zeQkFR":{"type":"heading","settings":{"text":"2.とにかく軽くて、暖かい","heading_tag":"h1"}}},"block_order":["heading_zeQkFR"],"settings":{"color_scheme":"","separate_section_with_border":true,"content_width":"sm","text_position":"center","remove_vertical_spacing":false}},"multiple_media_with_text_epUhjU":{"type":"multiple-media-with-text","blocks":{"image_PTkc8i":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/149bef95aeb0acb344e47b2a0e88ead2.jpg","rotation":0}}},"block_order":["image_PTkc8i"],"settings":{"color_scheme":"","reveal_on_scroll":true,"separate_section_with_border":true,"media_position_desktop":"before_text","media_position_mobile":"before_text","media_layout":"overlap","media_alignment":"center","media_alignment_offset":0,"media_mobile_alignment_offset":0,"text_alignment":"center","subheading":"-雪山でも春の暖かさも問題なし-","title":"<strong>気候に合わせて体温調節可能な「エアーライトジャケット」<\/strong>","content":"","button_1_text":"","button_1_link":"","button_1_style":"solid","button_2_text":"","button_2_link":"","button_2_style":"solid"}},"rich_text_ibbVAG":{"type":"rich-text","blocks":{"heading_EzN8Qh":{"type":"heading","settings":{"text":"","heading_tag":"h1"}},"richtext_YjAWK8":{"type":"richtext","settings":{"content":"<h5><strong>【吸湿発熱効果】<\/strong><\/h5><h5>軽さの秘密でもある繊維の空洞。 寒い時には湿気を吸い、暖かく発熱します。暑い時には、湿気を放出し、涼しく快適にします。<\/h5>"}},"richtext_i6RVnJ":{"type":"richtext","settings":{"content":"<h5>ブランド名にもなっている、「カポック」。<br\/>私たちは特殊な加工技術で<strong>カポックをシート状に加工<\/strong>し、中綿として使用しています。<\/h5>"}},"richtext_qdCkb3":{"type":"richtext","settings":{"content":"<h3><strong>・従来のダウンジャケット<br\/>- 約800g~1kg<br\/>・KAPOK KNOTのエアーライトジャケット - 約500g<\/strong><\/h3><h5>なんと、<strong>従来のダウンより遥かに軽い<\/strong>んです。その軽さなんと<strong>ペットボトル1本分！<\/strong><br\/>ではこれが<strong>どれだけ暖かいか<\/strong>というと...？<\/h5>"}},"image_ixcnEL":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/detail_11953_15991336202625.webp","width_mode":"custom","max_width":600,"mobile_max_width":400}},"image_aEUxbz":{"type":"image","settings":{"width_mode":"custom","max_width":600,"mobile_max_width":400}},"richtext_abrVdG":{"type":"richtext","settings":{"content":"<h5><strong>KAPOK KNOTの製品が、ダウンと同じだけ暖かい<\/strong>のが一目瞭然ですね！<\/h5>"}},"image_QDAEiN":{"type":"image","settings":{"width_mode":"custom","max_width":600,"mobile_max_width":400}},"heading_fMzinL":{"type":"heading","settings":{"text":"<strong>とにかく軽い！コットンの約1\/8<\/strong>","heading_tag":"h1"}},"richtext_pNNX3Y":{"type":"richtext","settings":{"content":"<p>このエシカルダウンカポック™はとにかく<strong>軽くて暖かい<\/strong>。カポック繊維は中が空洞(中空)になっており、なんと、<strong>コットンの1\/8の軽さ<\/strong>と言われています。<\/p><p>見てください！<br\/>この<strong>ふわっふわのカポックコットン！！！<\/strong><\/p>"}},"image_rczgMk":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/detail_11953_15991244396987.gif","width_mo