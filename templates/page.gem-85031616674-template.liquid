2 gf_col-sm-12 gf_col-xs-12" id="c-1629950992597" data-id="1629950992597"><div data-label="Separator" data-key="separator" id="e-1629972284778" class="element-wrap" data-icon="gpicon-separator" data-ver="1.0" data-id="1629972284778"><div class="elm gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-align="left" data-exc=""><hr class="gf_separator"></div></div><div data-label="Heading" data-key="heading" id="e-1629972303581" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629972303581"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1>試着レビュー</h1></div></div><div data-label="Separator" data-key="separator" id="e-1629967503426" class="element-wrap" data-icon="gpicon-separator" data-ver="1.0" data-id="1629967503426"><div class="elm gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-align="left" data-exc=""><hr class="gf_separator"></div></div><div data-label="Row" data-key="row" id="r-1629951023777" class="gf_row" data-icon="gpicon-row" data-id="1629951023777" data-layout-lg="4+4+4" data-extraclass="" data-layout-md="4+4+4" data-layout-sm="12+12+12" data-layout-xs="12+12+12"><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1629951023827" data-id="1629951023827"><div data-label="Image" data-key="image" id="e-1629951033164" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629951033164" data-resolution="240x240"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/90c40761-a36b-4676-a5c6-ae79a1eb9cf0/-/format/auto/-/preview/240x240/-/quality/lighter/jeremy.jpg" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" width="240" height="240" natural-width="240" natural-height="240"></div></div><div data-label="Heading" data-key="heading" id="e-1630030552011" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1630030552011"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc="">Jeremyさん</div></div><div data-label="Text Block" data-key="text-block" id="e-1629951133048" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1629951133048"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">思った以上に薄手ですごく着やすかった上に、アウトドアでもフォーマルでも色んな場面で着れるし、リバーシブルで気分に合わせて色を変えて楽しめるのもいいなと思いました！</span><br></p></div></div></div><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1629951027867" data-id="1629951027867"><div data-label="Image" data-key="image" id="e-1630391802947" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1630391802947" data-resolution="240x240"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/46350811-73ac-4cd1-96fa-b99f75038146/-/format/auto/-/preview/240x240/-/quality/lighter/%E3%81%99%E3%81%BF%E3%81%8B%E3%81%95%E3%82%93.jpg" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" width="240" height="240" natural-width="240" natural-height="240"></div></div><div data-label="Heading" data-key="heading" id="e-1629977201298" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629977201298"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc="">佐藤純華さん</div></div><div data-label="Text Block" data-key="text-block" id="e-1630030599865" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1630030599865"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">薄いのにあったかく、ファッション性も高いため荷物がかさばりがちな旅行などに持っていくには最適だなと思いました。羽織として、ボタンを閉めてシャツとして、など何通りもの着方で楽しめるのも魅力だと思います。ちょっとそこまで！の羽織に使うにも軽くて使いやすいのに、オシャレなのも◎です！</span><br></p></div></div></div><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1630391790827" data-id="1630391790827"><div data-label="Image" data-key="image" id="e-1629951090469" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629951090469" data-resolution="240x240"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/b4a72e9e-f104-472e-be20-43a7d986958b/-/format/auto/-/preview/240x240/-/quality/lighter/iOS%20%E3%81%AE%E7%94%BB%E5%83%8F%20_3_.png" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" width="240" height="240" natural-width="240" natural-height="240"></div></div><div data-label="Heading" data-key="heading" id="e-1630391817239" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1630391817239"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc="">白川くるみさん</div></div><div data-label="Text Block" data-key="text-block" id="e-1630391821843" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1630391821843"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">今季のデザインは洋服とアウターの間のような感じです。秋や春先にも良いし、真冬はアウターの中に着てもかさむことなく、夏も冷房の効きすぎの室内で羽織ったり年中着られるのはすごくうれしい。ふわっと軽くて薄いので本当に温かいのかな？と思うのですが、段々と体温と共に温かくなっていきます！</span><br></p></div></div></div></div><div data-label="Row" data-key="row" id="r-1630391908291" class="gf_row" data-icon="gpicon-row" data-id="1630391908291" data-layout-lg="12" data-extraclass="" data-layout-md="12" data-layout-sm="12" data-layout-xs="12"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1629951023827" data-id="1629951023827"><div data-label="Image" data-key="image" id="e-1630391908241" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1630391908241" data-resolution="240x240"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/b51c30a0-b0fd-49d8-b1f0-da45a227e0d3/-/format/auto/-/preview/240x240/-/quality/lighter/iOS%20%E3%81%AE%E7%94%BB%E5%83%8F%20_4_.png" alt="" class="gf_image" data-gemlang="en" data-width="auto" data-height="auto" title="" width="240" height="240" natural-width="240" natural-height="240"></div></div><div data-label="Heading" data-key="heading" id="e-1630391908309" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1630391908309"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc="">伊奈博之さん</div></div><div data-label="Text Block" data-key="text-block" id="e-1630391908228" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1630391908228"><div class="elm text-edit gf-elm-left gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">薄くて暖かいので、会社員にもピッタリだなと思いました。<br></span>オフィスワークでも使えるし、アウトドアでも使えるなら、<br><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;">とてもお得なのでめちゃくちゃありがたいです。</span></p></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" id="r-1629961916607" class="gf_row" data-icon="gpicon-row" data-id="1629961916607"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1629948198299" data-id="1629948198299"><div data-label="Liquid" data-key="liquid" id="m-1629961916667" class="module-wrap" data-icon="gpicon-liquid" data-ver="1.1" data-id="1629961916667" data-name="Right click on this, and choose Edit Code."><div class="module gf_module- gf_module--lg gf_module--md gf_module--sm gf_module--xs {{extraClass}}"><div class="klaviyo-form-TgutaT"></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" id="r-1629962341768" class="gf_row" data-icon="gpicon-row" data-id="1629962341768"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1629962341694" data-id="1629962341694"><div data-label="Separator" data-key="separator" id="e-1629967479446" class="element-wrap" data-icon="gpicon-separator" data-ver="1.0" data-id="1629967479446"><div class="elm gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-align="left" data-exc=""><hr class="gf_separator"></div></div><div data-label="Heading" data-key="heading" id="e-1629962168805" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629962168805"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1>KAPOK KNOT代表からのメッセージ</h1></div></div><div data-label="Separator" data-key="separator" id="e-1629972480062" class="element-wrap" data-icon="gpicon-separator" data-ver="1.0" data-id="1629972480062"><div class="elm gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-align="left" data-exc=""><hr class="gf_separator"></div></div><div data-label="Row" data-key="row" id="r-1629962411801" class="gf_row gf_equal-height" data-icon="gpicon-row" data-id="1629962411801" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12" style="display: flex; flex-wrap: wrap; visibility: visible;"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948358818" data-id="1629948358818" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Image" data-key="image" id="e-1629962411809" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629962411809" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/4559b17d-76ed-4ba8-8105-184bd53d5240/-/format/auto/-/preview/3000x3000/-/quality/lighter/DSC00764.jpg" alt="" class="gf_image" data-gemlang="en" width="2048" height="1365" data-width="auto" data-height="auto" title="" natural-width="2048" natural-height="1365"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948367673" data-id="1629948367673" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Heading" data-key="heading" id="e-1629962411836" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629962411836"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1>KAPOK KNOT代表　深井喜翔</h1></div></div><div data-label="Text Block" data-key="text-block" id="e-1629962411869" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1629962411869"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p>お待たせしました！今年もKAPOKの季節がやってきました！<br>今年の新商品はシャツダウンです！シャツダウンってあまり聞きなれない言葉ですよね？でもこれが、KAPOKの良さを引き出す最高のアイテムなんです！<br>KAPOK KNOTのシャツダウン「3シーズンを快適にするジャケット」<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">は、3シーズンも使える万能型！</span><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">春先や秋口は、アウターとしてさっとTシャツの上に羽織って、冬はコートの下にミドルウェアとしてお使いいただけます。</span></p><p>薄くて暖かいダウンシャツは、コートの中に着ていてもストレスなく、どんな時でもずっと着ていたくなる、<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">これ一枚でいつでもどんな時でも暖かくストレスフリーを実現する製品です。<br>KAPOKはサステナブルな素材として非常に大きな可能性を秘めているのですが、まだまだ知られておらず世に広がっていません。</span></p><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">何とかこの商品を世に送り出し、多くの人にKAPOKを知っていただきたいので、<br>是非応援してください！</span></p></div></div></div></div><div data-label="Row" data-key="row" id="r-1629962129302" class="gf_row gf_equal-height" data-icon="gpicon-row" data-id="1629962129302" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12" style="display: flex; flex-wrap: wrap; visibility: visible;"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948358818" data-id="1629948358818" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Heading" data-key="heading" id="e-1629962129425" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629962129425"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1>CONCEPT</h1></div></div><div data-label="Text Block" data-key="text-block" id="e-1629962129376" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1629962129376"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p>KAPOK　KNOTは、「Farm to Fashion ～農園からこころよい暮らしを～」というコンセプトのもと、2019年Makuakeにてデビューしたブランドです。リリースからわずか1か月でテレビ出演をし、<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">SDGsに関心が集まる中で非常に多くの注目をいただいています。</span></p><p>これからのアパレル業界を持続可能にしていくために、是非、皆さんのお力をお貸しください。</p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948367673" data-id="1629948367673" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Image" data-key="image" id="e-1629962129375" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629962129375" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b9a1dc8f-64c6-41d7-b638-53e2634700a2/-/format/auto/-/preview/3000x3000/-/quality/lighter/kapokknot_logo_black.png" alt="" class="gf_image" data-gemlang="en" width="2851" height="2851" data-width="auto" data-height="auto" title="" natural-width="2851" natural-height="2851"></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" id="r-1629963208410" class="gf_row" data-icon="gpicon-row" data-id="1629963208410"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1629962341694" data-id="1629962341694"><div data-label="Heading" data-key="heading" id="e-1629963208502" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1629963208502"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1>KAPOK農園からFarm to Fashionという独自のサプライチェーンでお届けしています。</h1></div></div><div data-label="Row" data-key="row" id="r-1629963208463" class="gf_row gf_equal-height" data-icon="gpicon-row" data-id="1629963208463" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12" style="display: flex; flex-wrap: wrap; visibility: visible;"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948358818" data-id="1629948358818" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Image" data-key="image" id="e-1629963208369" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629963208369" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/afdfb91c-c4e1-4a01-9f2b-4b69db203a8c/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E2%91%A3.jpeg" alt="" class="gf_image" data-gemlang="en" width="480" height="320" data-width="auto" data-height="auto" title="" natural-width="480" natural-height="320"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948367673" data-id="1629948367673" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Text Block" data-key="text-block" id="e-1629963208471" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1629963208471"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p>私たちは「Farm to Fashion」を掲げ、原料の調達からお手元に届くまでのプロセスをカポックノット独自のサプライチェーンで構築しています。</p><p>インドネシアのカポック農園やカポックの研究施設、カポックシートの開発、製品のデザイン、縫製工場に到るまで。誰がどのように考え、どのような形で関わりながら製品を作り上げているのかを把握し、自分たちの手でお客様へ届けます。</p><p>従来の下請け、孫請けが慣例化したアパレル業界の分業制ではなく、短期的なコストだけでの選択をせず、長期的に関わる人たちが幸せになる新しい仕組みの構築にチャレンジしています。</p></div></div></div></div><div data-label="Row" data-key="row" id="r-1629963208494" class="gf_row gf_equal-height" data-icon="gpicon-row" data-id="1629963208494" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12" style="display: flex; flex-wrap: wrap; visibility: visible;"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948358818" data-id="1629948358818" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Text Block" data-key="text-block" id="e-1629963208492" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1629963208492"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p>縫製は、日本の青森の縫製工場。従業員の方達が、1着1着、丁寧に作り上げていきます。</p><p>多くの工場で行われている分業型とは違い、この縫製工場では「丸縫い」という、すべての工程をひとりで仕上げることを習得し、初めて1人前とされます。</p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1629948367673" data-id="1629948367673" style="display: flex; flex-direction: column; justify-content: center; min-height: auto;"><div data-label="Image" data-key="image" id="e-1629963208453" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1629963208453" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/09fa32c5-cf2c-485e-a400-9a994a07add2/-/format/auto/-/preview/3000x3000/-/quality/lighter/top-about-4_1080x.jpeg" alt="" class="gf_image" data-gemlang="en" width="1080" height="720" data-width="auto" data-height="auto" title="" natural-width="1080" natural-height="720"></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" id="r-1629965928527" class="gf_row" data-icon="gpicon-row" data-id="1629965928527"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1629948198299" data-id="1629948198299"><div data-label="Liquid" data-key="liquid" id="m-1629965928476" class="module-wrap" data-icon="gpicon-liquid" data-ver="1.1" data-id="1629965928476" data-name="Right click on this, and choose Edit Code."><div class="module gf_module- gf_module--lg gf_module--md gf_module--sm gf_module--xs {{extraClass}}"><div class="klaviyo-form-TgutaT"></div></div></div></div></div><!--gfsplit--><div data-label="Row" class="gf_row" id="r-1630156170740" data-icon="gpicon-row" data-id="1630156170740"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1630156170685" data-id="1630156170685"><div data-label="Image" data-key="image" id="e-1630156174482" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1630156174482" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/5055258f-49c4-43db-8c5d-cd620d60a97f/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202021-08-28%20165658.png" alt="" class="gf_image" data-gemlang="en" width="1165" height="493" data-width="auto" data-height="auto" title="" natural-width="1165" natural-height="493"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1630156170798" data-id="1630156170798"><div data-label="Heading" data-key="heading" id="e-1630156203276" class="element-wrap" data-icon="gpicon-heading" data-ver="1" data-id="1630156203276"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1>1044人の声から生まれた新商品</h1><div><br></div></div></div><div data-label="Text Block" data-key="text-block" id="e-1630156372473" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1630156372473"><div class="elm text-edit gf-elm-left" data-gemlang="en"><p><br></p><p>信頼のMakuake実績！</p><p>デビュー以来、2年間でなんと、</p><p>1044人の方から、累計3000万円以上の支援を<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">いただいております！</span></p><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">その皆様のお声から生まれたのが、今回のシャツダウンです！</span></p></div></div></div></div><!--gfsplit--><script>window.__gemStoreData = {};window.__gemStoreData.gemKeyValid = {};window.__gemStoreData.gemKeyValid.bestWayAddToCart = 1;</script></div><div id="divContentBk"></div><!--End_Gem_Page_Main_Editor-->
