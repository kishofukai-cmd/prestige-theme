image_with_text_r4tMeQ":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Minami_Takahashi.webp","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_Ttajgm":{"type":"image_with_text","settings":{"title":"高橋　南　Minami Takahashi","heading_tag":"h3","content":"<p>クーピーペンシルやクレヨンを塗り重ねることで作り上げられた作品は、一見すると、素早い鉛筆の動きを要する激しい制作態度を連想させる。しかし実は、彼女の制作は非常にゆっくりと穏やかである。彼女の描き出すひとつひとつの色は、お互いに交じり合うことなく、それぞれにその美しさを主張しながら画面の上に現れ、激しさと静けさが不思議に同居しており、心を惹きつけられずにはいられない。<\/p>","link_url":"","link_text":""}}},"block_order":["image_with_text_8VyRzf","image_with_text_r4tMeQ","image_with_text_Ttajgm"],"settings":{"color_scheme":"","separate_section_with_border":true,"columns_per_row":3,"stack_on_mobile":false,"overlap_image":false,"content_alignment":"start","text_alignment":"start","spacing":"md","subheading":"作品・作家プロフィール","title":"<strong>風のロンド<\/strong>","content":""}},"multi_column_4FXxQN":{"type":"multi-column","blocks":{"image_with_text_kt46Rw":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/26_01_Miyuki_Higo_12_800x_7afc43bf-6dc9-4e8e-bc3b-fe75ac01e145.webp","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_dVbeMt":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/miyuki_higo_800x_eb536dc5-1eba-4c78-9e23-f847efa3c755.jpg","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_6hi7tm":{"type":"image_with_text","settings":{"title":"肥後　深雪　Miyuki Higo","heading_tag":"h3","content":"<p>アトリエやっほぅ!!（京都府）在籍<\/p><p>アトリエやっほぅ!!ではみんなのお姉さん的存在で、その時の気分で色鉛筆、水彩絵具、刺繍糸などを使い分けて自由な作品制作をしている。作品に登場する生き物や植物は可愛らしいものか作者本人にもわからない不思議なものまで様々。どの作品も優しさがにじみ出るカラフルな世界が広がっている。<\/p>","link_url":"","link_text":""}}},"block_order":["image_with_text_kt46Rw","image_with_text_dVbeMt","image_with_text_6hi7tm"],"settings":{"color_scheme":"","separate_section_with_border":true,"columns_per_row":3,"stack_on_mobile":false,"overlap_image":false,"content_alignment":"start","text_alignment":"start","spacing":"md","subheading":"作品・作家プロフィール","title":"<strong>しかくとまるとさんかく<\/strong>","content":""}},"multi_column_3BJkmP":{"type":"multi-column","blocks":{"image_with_text_dRJVE7":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/03_01_Sanae_Sasaki_14_800x_de61aa09-1eef-4d90-8952-f1d6cb4c8271.jpg","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_iM7bQx":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/Sanae_Sasaki_800x_d2f5c70e-8372-416c-b6a4-e0756c60f0b0.webp","title":"","heading_tag":"h3","content":"","link_url":"","link_text":""}},"image_with_text_jGHNmH":{"type":"image_with_text","settings":{"title":"佐々木　早苗　Sanae Sasaki","heading_tag":"h3","content":"<p>絵のみならず織り物、切り紙、刺繍など、いずれも緻密で色彩と構成の妙に富む様々な表現をおこなって来た。そして現在彼女が打ち込んでいるのは、通販カタログを１ページずつ、ボールペンの不思議な書き込みでじわじわと埋め尽くしていくこと。彼女は一つの仕事に数か月から数年集中して取り組んだあと、不意にやめて別の仕事に移るのが常。<\/p>","link_url":"","link_text":""}}},"block_order":["image_with_text_dRJVE7","image_with_text_iM7bQx","image_with_text_jGHNmH"],"settings":{"color_scheme":"","separate_section_with_border":true,"columns_per_row":3,"stack_on_mobile":false,"overlap_image":false,"content_alignment":"start","text_alignment":"start","spacing":"md","subheading":"作品・作家プロフィール","title":"<strong>(無題)（丸）<\/strong>","content":""}},"16971215467058db84":{"type":"apps","blocks":{"ed5f3e99-8a64-41e6-b236-b5922e8ee623":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/preview_badge\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}},"eeeaac1f-2bf3-4c88-94bb-6abc516d684b":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"review_data":"sample_data","max_width":1200}}},"block_order":["ed5f3e99-8a64-41e6-b236-b5922e8ee623","eeeaac1f-2bf3-4c88-94bb-6abc516d684b"],"settings":{"color_scheme":"","separate_section_with_border":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false}},"170010