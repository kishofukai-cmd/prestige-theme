{% comment %}
  Mother's Day 2026 Rich Article Template
  Assign to: /blogs/magazine/happymothersday2024
  Mobile-first (375px baseline), Tailwind via CDN.
{% endcomment %}

{%- comment -%}
  ========================================================================
  EDITABLE TEXT VARIABLES — 本文コピーを編集する時はここだけを触ればOK
  HTML構造は下のblockに触らず、このassign値を変えてpushしてください
  ========================================================================
{%- endcomment -%}

{%- liquid
  # --- ブランド/イベント基本情報 ---
  assign brand = 'KAPOK KNOT'
  assign event_date = '2026-05-10'

  # --- 価格（kapok-knot.comの最新値に同期）---
  assign musubi_pon_price = '¥8,900'
  assign musubi_en_nap_price = '¥29,800'
  assign musubi_en_sleep_price = '¥39,800'
  assign musubi_on_price = '¥44,800'

  # --- 画像URL（差し替え時はShopify Filesにアップし、ここを書き換え）---
  assign kv_main_image = 'https://kapok-knot.com/cdn/shop/files/happy-mothers-day-kv.png'
  assign hero_lifestyle_image = 'https://kapok-knot.com/cdn/shop/files/250423_MUSUBI_1664.jpg?v=1750302860&width=1600'
  assign cloud_white_image = 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/196_a197d0e1-4f5d-4991-a947-8778a84bb42d.png?v=1771395913&width=800'
  assign blossom_peach_image = 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/192_bf2a982d-4623-44d9-9cac-ef00709c8eda.png?v=1771395913&width=800'

  # --- ヒーローコピー ---
  assign hero_eyebrow = 'MOTHER''S DAY 2026'
  assign hero_heading_line1 = '今年の母の日は、'
  assign hero_heading_line2 = 'やさしい「重み」を贈る。'
  assign hero_date_note = '2026年5月10日（日）- 母の日ギフト特集'
  assign hero_body_line1 = '感謝の気持ちを、植物由来のぬくもりに込めて。'
  assign hero_body_line2 = 'KAPOK KNOTが届ける、ふたつの特別な選択。'

  # --- カウントダウンバナー ---
  assign countdown_prefix = '母の日（5月10日）まで あと'
  assign countdown_suffix = '日｜当日お届けは5月7日（木）中のご発送まで'

  # --- 推しカラー訴求（在庫/母の日キャンペーン用）---
  assign featured_colors_label = '母の日におすすめの2色'
  assign featured_color_1_name = 'Cloud White'
  assign featured_color_1_desc = '清潔感のある上品な白。どんなお部屋にも馴染む定番色。'
  assign featured_color_2_name = 'Blossom Peach'
  assign featured_color_2_desc = '母の日らしいやさしいピーチ。贈り物にふさわしい華やかさ。'

  # --- 各H2見出し ---
  assign h2_ranking = '2026年、母の日ギフトの新しい選択肢'
  assign h2_why = 'なぜ、KAPOK KNOTか'
  assign h2_musubi = '眠りを贈る。リカバリー加重ブランケット「MUSUBI」'
  assign h2_giftcard = '自由を贈る。KAPOK KNOT ギフトカード'
  assign h2_compare = 'お母さまに、いちばん合うものを'
  assign h2_voices = 'お客さまの声'
  assign h2_next_step = '去年、リカバリーウェアを贈った方へ'
  assign h2_delivery = '母の日当日に、確実に届ける'
  assign h2_faq = 'よくあるご質問'
  assign h2_final_cta = '今年の母の日、どちらを選びますか'

  # --- 配送 ---
  assign delivery_cutoff = '5月7日（木）中のご発送で、母の日当日（5月10日）のお届けが可能です。'
-%}

<script src="https://cdn.tailwindcss.com"></script>
<script>
  /* FIX: preflight: false にしないと親テーマのHeader/Footerスタイルを破壊し、モバイルナビドロワーが展開状態になる */
  tailwind.config = {
    corePlugins: { preflight: false },
    theme: {
      extend: {
        colors: {
          'md-cream': '#F7F3EC',
          'md-beige': '#E8DFD1',
          'md-navy':  '#1F2A44',
          'md-ink':   '#2B2B2B',
          'md-accent':'#B97A5C',
          'md-muted': '#6B6B6B'
        },
        fontFamily: {
          'jp': ['"Noto Serif JP"','"Yu Mincho"','serif'],
          'sans-jp': ['"Noto Sans JP"','"Yu Gothic"','sans-serif']
        }
      }
    }
  }
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  .md-body { font-family: 'Noto Sans JP', sans-serif; color: #2B2B2B; font-size: 16px; line-height: 1.9; background: #F7F3EC; }
  .md-body h1, .md-body h2, .md-body h3 { font-family: 'Noto Serif JP', serif; letter-spacing: 0.02em; }
  .md-body p { font-size: 16px; line-height: 1.9; }
  .md-fade { opacity: 0; transform: translateY(24px); transition: opacity .9s ease-out, transform .9s ease-out; }
  .md-fade.is-visible { opacity: 1; transform: translateY(0); }
  .md-btn { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding: 14px 28px; font-weight:500; letter-spacing:.04em; transition: all .25s ease; }
  .md-btn-primary { background:#1F2A44; color:#fff; }
  .md-btn-primary:hover { background:#2a3657; }
  .md-btn-secondary { background:#fff; color:#1F2A44; border:1px solid #1F2A44; }
  .md-btn-secondary:hover { background:#1F2A44; color:#fff; }
  .md-image-placeholder { background:#E8DFD1; display:flex; align-items:center; justify-content:center; color:#6B6B6B; font-size:12px; text-align:center; padding:16px; min-height:240px; }
  .md-section { padding: 72px 20px; }
  @media (min-width:768px){ .md-section { padding: 120px 40px; } }
  .md-divider { width:48px; height:1px; background:#B97A5C; margin: 24px auto; }
  .md-quote { border-left: 3px solid #B97A5C; padding: 16px 20px; background: #fff; color:#6B6B6B; font-size:14px; line-height:1.8; }
  .md-faq summary { list-style:none; cursor:pointer; padding: 20px 16px; border-bottom:1px solid #E8DFD1; font-weight:500; display:flex; justify-content:space-between; align-items:center; min-height:60px; }
  .md-faq summary::-webkit-details-marker { display:none; }
  .md-faq summary::after { content:'+'; font-size:24px; color:#B97A5C; transition: transform .25s; }
  .md-faq[open] summary::after { content:'−'; }
  .md-faq-body { padding: 0 16px 24px; color:#4B4B4B; line-height:1.9; }
  .md-sticky-cta { position: fixed; left:0; right:0; bottom:0; z-index: 50; background: rgba(255,255,255,0.97); backdrop-filter: blur(8px); border-top:1px solid #E8DFD1; padding: 10px 12px; display:flex; gap:8px; }
  @media (min-width: 1024px){ .md-sticky-cta { display:none; } }
  .md-sticky-cta a { flex:1; min-height:48px; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:500; border-radius:2px; }
  .md-body a { min-height:44px; }
  .md-table { width:100%; border-collapse: collapse; font-size:15px; }
  .md-table th, .md-table td { padding: 14px 12px; border-bottom:1px solid #E8DFD1; text-align:left; vertical-align: top; }
  .md-table th { background:#E8DFD1; font-weight:500; }
  .md-product-card { background:#fff; padding:28px 20px; border:1px solid #E8DFD1; }
  .md-recommend-badge { display:inline-block; background:#B97A5C; color:#fff; font-size:12px; padding:4px 10px; letter-spacing:.1em; margin-bottom:8px; }
  .md-caution-box { background:#fff; border:1px solid #E8DFD1; padding: 24px; border-left:3px solid #B97A5C; }
  .count-up { font-variant-numeric: tabular-nums; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .md-definition { background:#fff; border-left:3px solid #B97A5C; padding:16px 20px; margin: 16px 0 32px; font-size:15px; color:#2B2B2B; line-height:1.85; }
  .md-definition strong { color:#1F2A44; }
  .md-countdown-banner { background:#1F2A44; color:#fff; padding: 14px 16px; text-align:center; font-size:14px; letter-spacing:.05em; }
  .md-countdown-banner strong { color:#E8DFD1; font-size:18px; margin: 0 4px; }
  .md-toc { background:#fff; padding:24px; margin: 24px 0; border:1px solid #E8DFD1; }
  .md-toc summary { font-weight:500; color:#1F2A44; cursor:pointer; padding:4px 0; list-style:none; display:flex; justify-content:space-between; align-items:center; }
  .md-toc summary::-webkit-details-marker { display:none; }
  .md-toc summary::after { content:'▼'; font-size:10px; color:#B97A5C; transition:transform .25s; }
  .md-toc[open] summary::after { transform: rotate(180deg); }
  .md-toc ol { list-style: none; counter-reset: toc; padding: 16px 0 0; margin: 0; }
  .md-toc ol li { counter-increment: toc; padding: 8px 0; border-bottom: 1px solid #F7F3EC; }
  .md-toc ol li::before { content: counter(toc, decimal-leading-zero); color:#B97A5C; margin-right:12px; font-size:13px; }
  .md-toc a { color:#2B2B2B; text-decoration:none; font-size:14px; }
  .md-toc a:hover { color:#B97A5C; }
  .md-aspect-16-9 { aspect-ratio: 16/9; object-fit: cover; width:100%; height:auto; }
  .md-aspect-4-3 { aspect-ratio: 4/3; object-fit: cover; width:100%; height:auto; }
  .md-aspect-1-1 { aspect-ratio: 1/1; object-fit: cover; width:100%; height:auto; }
  .md-urgent-badge { display:inline-block; background:#C23B22; color:#fff; font-size:11px; padding:3px 8px; letter-spacing:.08em; font-weight:500; }
  .md-voice-card { background:#fff; padding:20px; border-radius:2px; border-top:3px solid #B97A5C; font-size:14px; line-height:1.9; }
  .md-voice-card .who { color:#6B6B6B; font-size:12px; margin-top:12px; display:block; }
  .md-faq-group h3 { font-family:'Noto Sans JP', sans-serif; font-size:15px; letter-spacing:.08em; color:#B97A5C; margin: 32px 0 8px; padding:0; }
  @media (max-width: 1023px){ article.md-body { padding-bottom: 80px; } }

  /* 【FIX ⑤】text-justify崩れ対策 — 親テーマのglobal text-align:justifyを打ち消す */
  .md-body, .md-body p, .md-body li, .md-body h1, .md-body h2, .md-body h3, .md-body h4, .md-body span, .md-body div { text-align: left; text-justify: none; word-spacing: normal; letter-spacing: normal; }
  .md-body .text-center, .md-body .text-center * { text-align: center !important; }
  .md-body ul, .md-body ol { list-style: none; padding-left: 0; }
  .md-body li { display: block; }
  .md-body li.flex { display: flex; }
  .md-body h1, .md-body h2, .md-body h3, .md-body h4 { letter-spacing: 0.02em; }

  /* 【FIX ④】スマホでのlayout isolation — 親テーマのフローティング要素干渉を隔離 */
  article.md-body { position: relative; z-index: 1; isolation: isolate; }

  /* Preflight無効化の代替reset — 記事内スコープのみに適用 */
  .md-body img { display: block; max-width: 100%; }
  .md-body h1, .md-body h2, .md-body h3, .md-body h4 { margin: 0; font-weight: 500; }
  .md-body p { margin: 0; }
  .md-body ul, .md-body ol { margin: 0; }
  .md-body a { color: inherit; text-decoration: none; }
  .md-body button { cursor: pointer; background: transparent; border: 0; padding: 0; }
  .md-body *, .md-body *::before, .md-body *::after { box-sizing: border-box; }

  /* 推しカラーカード */
  .md-color-card { background:#fff; padding:16px; border:1px solid #E8DFD1; text-align:center; }
  .md-color-card img { aspect-ratio: 1/1; object-fit: cover; width:100%; height:auto; margin-bottom:12px; }
  .md-color-card .color-name { font-family:'Noto Serif JP', serif; color:#1F2A44; font-size:15px; margin-bottom:6px; display:block; }
  .md-color-card .color-desc { font-size:12px; color:#6B6B6B; line-height:1.7; }

  /* KV（Key Visual）新規デザイン */
  .md-kv { background:#F7E6E4; padding: 32px 20px; text-align:center; }
  .md-kv img { max-width: 720px; width:100%; height:auto; margin: 0 auto; display:block; }

  /* お客様の声EDITABLEエリア */
  .editable-area { position: relative; }
  .editable-area::before { content:'[編集エリア]'; position:absolute; top:-8px; left:0; font-size:10px; color:transparent; }
</style>

<article class="md-body">

  <!-- Countdown Banner -->
  <div class="md-countdown-banner" id="md-countdown">
    {{ countdown_prefix }} <strong id="md-days">—</strong> {{ countdown_suffix }}
  </div>

  <!-- KV (Key Visual) -->
  <!-- EDITABLE: KVはShopify Filesに "happy-mothers-day-kv.png" 等でアップロードし、冒頭のkv_main_image変数を書き換えてください -->
  <section class="md-kv" aria-label="母の日2026キービジュアル">
    <img src="{{ kv_main_image }}"
         alt="HAPPY MOTHER'S DAY｜KAPOK KNOT 2026"
         width="1600" height="800"
         onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
         loading="eager" fetchpriority="high">
    <div style="display:none; padding:48px 16px;">
      <p class="font-jp" style="font-size:32px; color:#C23B22; letter-spacing:0.08em; margin-bottom:8px;">HAPPY MOTHER'S DAY</p>
      <p style="font-size:12px; color:#B97A5C;">※KV画像をShopify Filesにアップロードして差し替えてください</p>
    </div>
  </section>

  <!-- 1. HERO -->
  <section class="md-section text-center" style="padding-top:40px;" aria-labelledby="hero-heading">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm tracking-[0.3em] text-md-accent mb-3">{{ hero_eyebrow }}</p>
      <h1 id="hero-heading" class="font-jp text-[28px] md:text-[44px] leading-[1.6] text-md-navy mb-6 md-fade">
        {{ hero_heading_line1 }}<br>{{ hero_heading_line2 }}
      </h1>
      <p class="text-md-muted text-sm mb-6">{{ hero_date_note }}</p>

      <img src="{{ hero_lifestyle_image }}"
           alt="リカバリー加重ブランケットMUSUBIをかけてくつろぐシーン｜2026年母の日ギフト"
           width="1600" height="900"
           class="md-aspect-16-9 mb-8" loading="eager" fetchpriority="high">

      <p class="text-md-ink text-base md:text-lg mb-10 leading-loose md-fade">
        {{ hero_body_line1 }}<br>{{ hero_body_line2 }}
      </p>

      <!-- 推しカラー訴求（母の日2026キャンペーン） -->
      <!-- EDITABLE: 推しカラー訴求は featured_color_* 変数を編集 -->
      <div class="text-left mb-6">
        <p class="text-sm tracking-[0.2em] text-md-accent text-center mb-4">— {{ featured_colors_label }} —</p>
        <div class="grid grid-cols-2 gap-3 md:gap-6 max-w-xl mx-auto mb-6 md-fade">
          <a href="https://kapok-knot.com/products/musubi-en?variant=cloud-white" class="md-color-card block">
            <img src="{{ cloud_white_image }}" alt="MUSUBI -en- Cloud White" width="400" height="400" loading="lazy">
            <span class="color-name">{{ featured_color_1_name }}</span>
            <span class="color-desc">{{ featured_color_1_desc }}</span>
          </a>
          <a href="https://kapok-knot.com/products/musubi-en?variant=blossom-peach" class="md-color-card block">
            <img src="{{ blossom_peach_image }}" alt="MUSUBI -en- Blossom Peach" width="400" height="400" loading="lazy">
            <span class="color-name">{{ featured_color_2_name }}</span>
            <span class="color-desc">{{ featured_color_2_desc }}</span>
          </a>
        </div>
        <p class="text-xs text-md-muted text-center">※在庫状況により、ご注文時期によっては欠品する可能性があります。</p>
      </div>

      <!-- FV 3商品プレビュー -->
      <div class="grid grid-cols-3 gap-2 md:gap-4 max-w-xl mx-auto mb-8 md-fade">
        <a href="#pon" class="block text-center">
          <img src="https://kapok-knot.com/cdn/shop/files/3_c02cc721-a87a-47e2-8500-9f136361e732.png?v=1763104224&width=400" alt="MUSUBI -PON-" width="400" height="400" class="md-aspect-1-1" loading="lazy">
          <p class="text-[11px] md:text-xs mt-2 text-md-navy">MUSUBI -PON-<br><span class="text-md-muted">{{ musubi_pon_price }}〜</span></p>
        </a>
        <a href="#en" class="block text-center">
          <img src="https://kapok-knot.com/cdn/shop/files/250423_MUSUBI_1208.jpg?v=1771395913&width=400" alt="MUSUBI -en-" width="400" height="400" class="md-aspect-1-1" loading="lazy">
          <p class="text-[11px] md:text-xs mt-2 text-md-navy">MUSUBI -en-<br><span class="text-md-muted">{{ musubi_en_nap_price }}〜</span></p>
        </a>
        <a href="#giftcard" class="block text-center">
          <img src="https://kapok-knot.com/cdn/shop/files/45_5258c5b7-fdd2-47d8-a57b-10aac5d651a8.png?v=1763708950&width=400" alt="ギフトカード" width="400" height="400" class="md-aspect-1-1" loading="lazy">
          <p class="text-[11px] md:text-xs mt-2 text-md-navy">ギフトカード<br><span class="text-md-muted">任意金額</span></p>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto">
        <a href="#musubi" class="md-btn md-btn-primary flex-1">MUSUBIを見る →</a>
        <a href="#giftcard" class="md-btn md-btn-secondary flex-1">ギフトカードを見る →</a>
      </div>

      <!-- 目次 -->
      <details class="md-toc text-left mt-10 md-fade">
        <summary>この記事の目次</summary>
        <ol>
          <li><a href="#ranking">2026年、母の日ギフトの新しい選択肢</a></li>
          <li><a href="#why">なぜ、KAPOK KNOTか</a></li>
          <li><a href="#musubi">選択肢01｜MUSUBI（加重ブランケット）</a></li>
          <li><a href="#giftcard">選択肢02｜ギフトカード</a></li>
          <li><a href="#compare">お母さまに合うものを（比較表）</a></li>
          <li><a href="#voices">お客さまの声</a></li>
          <li><a href="#next-step">去年リカバリーウェアを贈った方へ</a></li>
          <li><a href="#delivery">母の日当日に、確実に届ける</a></li>
          <li><a href="#faq">よくあるご質問</a></li>
        </ol>
      </details>
    </div>
  </section>

  <!-- 2. 問いかけ -->
  <section class="md-section text-center bg-white">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-jp text-[26px] md:text-[36px] leading-[1.7] text-md-navy mb-6 md-fade">
        「ありがとう」を、<br>どんな形で伝えますか。
      </h2>
      <div class="md-divider"></div>
      <p class="md-fade">
        お母さまの日常を、ほんの少し豊かにする贈り物。<br>
        今年は、いつもと違う選択肢をご用意しました。
      </p>
    </div>
  </section>

  <!-- 3. ランキング -->
  <section id="ranking" class="md-section">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-jp text-[24px] md:text-[32px] text-md-navy mb-6 md-fade">2026年、母の日ギフトの新しい選択肢</h2>
      <p class="mb-10 md-fade">
        母の日のギフトは、「花」だけの時代から変わりはじめています。2026年の調査では、お母さまが本当に欲しいと思うのは、日々の暮らしを豊かにする"実用的で特別なもの"。下記は2026年版・母の日に贈りたいギフトランキングです。
      </p>

      <div class="bg-white p-6 md:p-10 space-y-4 md-fade">
        {%- assign ranks = 'ranking_items' -%}
        <div class="flex items-center justify-between border-b border-md-beige pb-3">
          <span class="text-md-ink">食品・グルメ</span>
          <span class="count-up text-md-navy font-medium text-xl" data-target="26.1">26.1%</span>
        </div>
        <div class="flex items-center justify-between border-b border-md-beige pb-3">
          <span>お花・観葉植物</span>
          <span class="count-up text-md-muted text-lg" data-target="20.5">20.5%</span>
        </div>
        <div class="flex items-center justify-between border-b border-md-beige pb-3">
          <span>スイーツ</span>
          <span class="count-up text-md-muted text-lg" data-target="17.2">17.2%</span>
        </div>
        <div class="flex items-center justify-between border-b border-md-beige pb-3 bg-md-cream -mx-6 md:-mx-10 px-6 md:px-10 py-4">
          <span class="text-md-accent font-medium">健康・生活雑貨 <span class="text-xs ml-1">← 注目</span></span>
          <span class="count-up text-md-accent font-medium text-xl" data-target="7.8">7.8%</span>
        </div>
        <div class="flex items-center justify-between border-b border-md-beige pb-3">
          <span>ファッション</span>
