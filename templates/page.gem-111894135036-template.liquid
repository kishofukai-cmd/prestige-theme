78348-6f6a-44b8-9bc8-8ebf0f270215/-/format/auto/-/preview/3000x3000/-/quality/lighter/n_3.png" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="580" height="870" natural-width="580" natural-height="870"></div></div></div></div></div><div class="gf-carousel-loading"><div class="gf-caousel-ripple"><div></div><div></div></div></div></div></div></div><!--gfsplit--><div data-label="Separator" data-key="separator" data-atomgroup="element" id="e-1728277226787" class="element-wrap" data-icon="gpicon-separator" data-ver="1.0" data-id="1728277226787" style=""><div class="elm gf-elm-center" data-align="left"><hr class="gf_separator"></div></div><!--gfsplit--><div data-label="Parallax" data-key="parallax" data-atomgroup="module" id="m-1728289124010" class="module-wrap" data-icon="gpicon-parallax" data-ver="2" data-id="1728289124010" style=""><div class="gf_parallax-container"><div class="gf_parallax-bg"></div></div><div class="module gf_parallax " data-image="https://ucarecdn.com/3ae67790-d478-4bc0-b1d5-4e5fbe4e1963/-/format/auto/-/preview/3000x3000/-/quality/lighter/eee.jpg" data-speed-xs="1" data-speed-sm="1" data-speed-md="0.5" data-option="" data-speed-lg="0.5"><span data-index="1" class="item-content"><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728286770867" class="gf_row" data-icon="gpicon-row" data-id="1728286770867" style="display: block;"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1728277277488" data-id="1728277277488"><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728286770914" class="gf_row" data-icon="gpicon-row" data-id="1728286770914" data-extraclass=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1665548884330" data-id="1665548884330"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728286770953" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728286770953" style=""><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">コレクションテーマは</h1><h1 class="gf_gs-text-heading-2">「アニマルライツ×モード」</h1></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728286770896" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728286770896" style=""><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">新しい時代の豊かさは</h1><h1 class="gf_gs-text-heading-2">アニマルライツ×モード</h1><h1 class="gf_gs-text-heading-2">に込めた想像力</h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1728286770816" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1728286770816"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;">「アニマルフリーなファッションには、もっとデザインの幅が出てきていいのではないか」と前々から課題に感じていた二階堂氏。従来、動物や自然環境に配慮した素材でものづくりを行う際、耐久性が弱くなったり、デザインに制限があったりと、結果的にサステナブル＝シンプルという印象が根付いています。<br style="border-color: rgb(var(--border-color));"><br style="border-color: rgb(var(--border-color));"></p><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;">本コラボレーションでは、耐久性や機能性も兼ね備え、遊びごころのあるデザインで環境負荷の低い新しい形のモードファッションを目指し、アニマルフリー素材を用いたアウターをデザインしました。</p><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;"><br></p><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;"><br></p></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728289817132" class="gf_row" data-icon="gpicon-row" data-id="1728289817132" data-extraclass=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1665548884330" data-id="1665548884330"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728289817057" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728289817057" style=""><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">世界のファッションを取り入れた<br>タイムレスなデザイン</h1></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728289817122" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728289817122"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">新しい時代の豊かさは</h1><h1 class="gf_gs-text-heading-2">アニマルライツ×モード</h1><h1 class="gf_gs-text-heading-2">に込めた想像力</h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1728289817082" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1728289817082"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;">近年問題視されている、大量生産・大量廃棄を繰り返すファッション業界。トレンドをその課題に対し、KAPOK KNOTはサステナブルな素材を活用しながら、トレンドに囚われず長く着用してもらえる「タイムレスなデザイン」を大切にしています。その想いから、今回のコラボレーションでは世界のファッションを「アウター」に落とし込み、サステナブル新素材のカポックを使って表現した、全3型を共同制作しました。</p><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;"><br></p><p data-mce-fragment="1" style="border-color: rgb(var(--border-color)); font-size: 14px; font-family: &quot;Optima nova&quot;, sans-serif; text-align: start; color: rgb(28, 28, 28); letter-spacing: normal; margin-block-start: 1.25rem;"><br></p></div></div></div></div></div></div></div></div></span></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728288885620" class="gf_row" data-icon="gpicon-row" data-id="1728288885620"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1728288885676" data-id="1728288885676"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728289094885" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728289094885"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">「<span style="text-align: inherit; background-color: rgb(var(--background)); color: rgb(var(--text-color)); letter-spacing: var(--text-letter-spacing);">Animal Free Down：SCARF」</span></h1></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728288890643" class="gf_row" data-icon="gpicon-row" data-id="1728288890643" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728288890652" data-id="1728288890652"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1728288902815" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1728288902815" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>シックにまとまったシンプルなモード系アウターで、アウターが主役のファッションを楽しめる「Animal Free Down: SCARF」</p><p><br></p><p>たとえマフラーを忘れてしまっても大丈夫。首元をあたためるマフラーがアウターと一体化した新しいデザインで、全身がカポックのぬくもりに包まれます。</p><p><br></p><p>裾に向かって広がるAラインシルエットで、中に着るものを選ばず、どんなシーンでも着用しやすいアウターに。</p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728288892687" data-id="1728288892687"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1728288898227" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1728288898227" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-lg gf-elm-center-xs" data-exc=""><a href="https://kapok-knot.com/products/unisex-animal-free-down-scarf" target=""><img src="https://ucarecdn.com/62c70083-db23-4876-ae10-2f2a98a814d7/-/format/auto/-/preview/3000x3000/-/quality/lighter/111.jpg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1024" height="682" natural-width="1024" natural-height="682"></a></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728289388559" class="gf_row" data-icon="gpicon-row" data-id="1728289388559"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1728289388555" data-id="1728289388555"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728289397588" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728289397588"><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">Animal Free Down：CHINA DRESS</h1></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728289063411" class="gf_row" data-icon="gpicon-row" data-id="1728289063411" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728288885676" data-id="1728288885676"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1728289084396" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1728289084396" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/products/women-animal-free-down-chinadress" target=""><img src="https://ucarecdn.com/1d0338b8-bf4b-4649-b804-33ebe5b86831/-/format/auto/-/preview/3000x3000/-/quality/lighter/222.jpg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1024" height="682" natural-width="1024" natural-height="682"></a></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728289079911" data-id="1728289079911"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1728289088869" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1728289088869"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>チャイナドレスに欠かせない、紐を結んで作ったこだわりのチャイナボタンは、フロントにはもちろん、袖口にも。またファスナーは、上下どちらからも動かせるフロントのダブルジップと、スリットとして開けられる両サイドにデザイン。</p><p><br></p><p>フロントのファスナーを首元まで上げ、チャイナボタンを閉じれば、見た目がまるでドレスのチャイナドレスとして、チャイナボタンは閉じたままファスナーを開ける着こなしもおすすめ。</p><p><br></p><p>中にスカートを合わせる日は、お好みでサイドジップを開けて、スカートのデザインを覗かせるコーディネートが楽しめます。</p></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728289369913" class="gf_row" data-icon="gpicon-row" data-id="1728289369913"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1728288885676" data-id="1728288885676"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728289369903" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1728289369903" style=""><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">Animal Free Down：TRENCH</h1></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728289369912" class="gf_row" data-icon="gpicon-row" data-id="1728289369912" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="12+12"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728288890652" data-id="1728288890652"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1728289369932" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1728289369932" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p style="margin-bottom: 1em; line-height: 1.4; text-align: start;"><span style="letter-spacing: 0px; background-color: rgb(var(--background));">フレアが大きく広がり、思わずくるくるとターンをしたくなるような、高揚感を覚えるドレスデザイン。「Animal Free Down: TRENCH」を身に纏えば、シンプルなデザインながらも優雅さが漂い、コートが主役のファッションに。</span></p><p style="margin-bottom: 1em; line-height: 1.4; text-align: start;"><span style="color: rgb(0, 0, 0); font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; letter-spacing: 0px; background-color: rgb(var(--background));"><br></span></p><p style="margin-bottom: 1em; line-height: 1.4; text-align: start;"><span style="color: rgb(0, 0, 0); font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; letter-spacing: 0px; background-color: rgb(var(--background));">着丈は長く、ロングスカートやワンピースはもちろん、綺麗目なパンツスタイルに合わせてコーディネートを組んでも。</span></p><p style="margin-bottom: 1em; line-height: 1.4; text-align: start;"><span style="color: rgb(0, 0, 0); font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; letter-spacing: 0px; background-color: rgb(var(--background));"><br></span></p><p style="margin-bottom: 1em; line-height: 1.4; text-align: start;"><span style="color: rgb(0, 0, 0); font-family: &quot;Helvetica Neue&quot;, Helvetica, Arial, sans-serif; font-size: 15px; letter-spacing: 0px; background-color: rgb(var(--background));">また、従来のアウターだと重く見えてしまい、秋口や春先での着用はやや抵抗がありますが、この「Animal Free Down: TRENCH」は薄くて軽く、トレンチコートの形をしたアウターのため、冬場を超えての着用もおすすめです。寒くなり始める秋口や、冬の寒さが残る春先など、3シーズンに渡り長くお楽しみいただけます。ドジップを開けて、スカートのデザインを覗かせるコーディネートが楽しめます。</span><br></p></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1728288892687" data-id="1728288892687"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1728289369969" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1728289369969" data-resolution="3000x3000" style=""><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/products/women-animal-free-down-trench" target=""><img src="https://ucarecdn.com/c85926e0-d487-4231-b175-58ee32ee32e8/-/format/auto/-/preview/3000x3000/-/quality/lighter/333.jpg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1024" height="682" natural-width="1024" natural-height="682"></a></div></div></div></div></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1728276499472" class="gf_row" data-icon="gpicon-row" data-id="1728276499472" data-extraclass=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1665548884330" data-id="1665548884330"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1728276499390" class="element-wrap" data-ic