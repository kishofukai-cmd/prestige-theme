            "image_url_2": "https://ucarecdn.com/a4f59429-fed2-40f6-8008-d820a213fff6/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E5%90%B8%E6%B9%BF%E7%99%BA%E7%86%B1_%E6%A9%9F%E8%83%BD%E3%82%A2%E3%82%A4%E3%82%B3%E3%83%B3.png",
