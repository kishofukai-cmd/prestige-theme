        "lightness_image": {
          "type": "image_text",
          "settings": {
            "layout": "left",
            "image_url": "https://ucarecdn.com/9b2ed1bc-35ff-4f24-97e3-ded6d5e207ec/-/format/auto/-/preview/3000x3000/-/quality/lighter/Mask%20Group%20_1_.png",
            "heading": "コットンの約1/8の軽さ",
            "text": "<p>カポックの特徴は、軽さにあります。カポックは従来のコットンの1/8の軽さです。繊維がストロー状で空洞になっていることで、カポックはふわふわと宙を舞うくらい軽く、着心地の良いアウターが出来上がります。</p>",
            "margin_bottom": 80
          }
        },
        "thermograph_content": {
          "type": "image_text",
          "settings": {
            "layout": "right",
            "image_url": "https://ucarecdn.com/bbdf6a42-3a07-4b56-8342-f0df4b6da65b/-/format/auto/-/preview/3000x3000/-/quality/lighter/kapok_comparison_image.png",
            "heading": "サーモグラフィー比較",
            "text": "<p>一般的な防寒着と比較しても、カポックの優れた保温層が熱を逃さないことが実証されています。</p>",
            "margin_bottom": 80
          }
        },
        "animal_free": {
          "type": "image_text",
          "settings": {
            "layout": "left",
            "image_url": "https://ucarecdn.com/7195ca1b-4376-4352-a81c-f6aad630623d/-/format/auto/-/preview/3000x3000/-/quality/lighter/image%20139.png",
            "heading": "動物にも優しいアニマルフリー",
            "text": "<p>カポックは高機能でありながら、木の実なので木を伐採することも、動物を痛めつけることも必要ありません。従来のダウンは水鳥の羽が使用されていました。</p>",
            "margin_bottom": 80
          }
        },
        "voice_of_customers_heading": {
          "type": "rich_text",
          "settings": {
            "heading": "お客様の声",
            "text": "<p>KAPOK KNOTをご愛用いただいている皆様からの声をご紹介します。</p>",
            "text_alignment": "center",
            "margin_bottom": 40
          }
        },
        "review_1": {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "image_url": "https://ucarecdn.com/fd5ed597-5751-4414-9666-6cb61ec50943/-/format/auto/-/preview/3000x3000/-/quality/lighter/comment_01.png",
            "heading": "木村祥一郎 様",
            "text": "軽くて薄いのに暖かい。言葉では伝わりにくいけど、体験すると感動するレベル。カラダは正直で、ついつい他よりKAPOK KNOTのアウターを選んでしまう。しかもサスティナブル志向。そりゃ応援したくなる。",
            "margin_bottom": 20
          }
        },
        "review_2": {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "image_url": "https://ucarecdn.com/d048ed14-caa7-4f4c-a6f2-5110e88d1ed1/-/format/auto/-/preview/3000x3000/-/quality/lighter/comment_02.png",
            "heading": "河野貴伸 様",
            "text": "機能とデザイン、そして環境配慮。それらのバランスをとりながら、全てを満たす魅力的なプロダクトを実現した「カポックノット」は、僕が心からリスペクトするD2Cブランドの一つです。",
            "margin_bottom": 20
          }
        },
        "review_3": {
          "type": "review_card",
          "settings": {
            "rating": 5,
            "image_url": "https://ucarecdn.com/24cac52c-dcf3-482b-b055-a449abbaa882/-/format/auto/-/preview/3000x3000/-/quality/lighter/comment_03.jpeg",
            "heading": "宮崎真理子 様",
            "text": "カポックノットを着ることで、サステナブルな地球環境を一緒に創らせてもらっているような気持ちです。ストーリーがあるだけなく、実際にあったかくてスタイリッシュなカポックノットが広がっている社会を想像し、ワクワクしています。",
            "margin_bottom": 40
          }
        },
        "founder_message": {
          "type": "image_text",
          "settings": {
            "layout": "left",
            "image_url": "https://ucarecdn.com/ee2273fb-34e1-4d2b-b443-bb4b32c0b2ff/-/format/auto/-/preview/3000x3000/-/quality/lighter/image%2069.png",
            "heading": "カポックノット代表　深井喜翔",
            "text": "<p>初めましてカポックノット創業者の深井喜翔です。老舗アパレル企業の4代目として繊維業界に身を置くことで、アパレル業界の大量生産・大量廃棄という負のシステム、そしてそのシステムが生み出す弊害を目の当たりにしてきました。<br>そんな中、カポックと出会い、「これこそが自分が人生を懸けて取り組むべき素材である」という感覚を持ちました。</p>",
            "margin_bottom": 80
          }
        },
