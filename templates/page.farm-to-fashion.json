        "farm_to_fashion_hero": {
          "type": "image_text",
          "settings": {
            "layout": "left",
            "image_url": "https://ucarecdn.com/e49f4318-c189-478f-a012-59ddab40db53/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202026-01-30%20140205.png",
            "heading": "",
            "text": "<p>わたしたちは「Farm to Fashion」を掲げ、農園や縫製工場の生産プロセスの透明性を大切にし、皆さんのもとへ届くまでに関わる生産者と地球環境にとってよりよい選択を模索し続けています。<br>カポックノットは、インドネシアの農園や工場に実際に足を運び、直接やりとりをし、短期的なコストだけでの選択をせず、長期的に関わる人たちにとってよりよい循環を生み出します。</p>",
            "margin_bottom": 40
          }
        },
        "farm_to_fashion_images": {
          "type": "features_grid",
          "settings": {
            "image_on": true,
            "image_url_1": "https://ucarecdn.com/660f0a29-15e9-4e4d-96d7-b3987a360c5d/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202026-01-30%20140130.png",
            "title_1": "農園から直接買い付け",
            "text_1": "丁寧に愛情深く紡がれるカポックの繊維。インドネシアのカポック農園の方々が、丁寧に生産・収穫しています。",
            "image_url_2": "https://ucarecdn.com/c1660664-c4a5-4791-a6a8-be24491f67b1/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202026-01-30%20140323.png",
            "title_2": "加工工場へ",
            "text_2": "国内大手繊維メーカーとの研究開発の末、カポックのシート化に成功。",
            "image_url_3": "https://ucarecdn.com/e49f4318-c189-478f-a012-59ddab40db53/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202026-01-30%20140205.png",
            "title_3": "特殊縫製工場へ",
            "text_3": "縫製工場では従業員の方達が、1着1着、丁寧に作り上げていきます。細部に思いやりの行き届いたモノづくりができます。",
            "image_url_4": "https://ucarecdn.com/2ed38a29-8529-49e6-b536-76e08098a0b7/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88%202026-01-30%20140237.png",
            "title_4": "皆様のもとへ",
            "text_4": "デザイン・機能・価格のバランスの取れたものづくりを心がけ、お客様に長く使っていただける服に仕上げています。",
            "margin_bottom": 80
