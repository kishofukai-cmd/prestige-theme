            "image_url_3": "https://ucarecdn.com/6fee2c21-4459-4e87-a64e-898f28f541f5/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%BF%E3%82%99%E3%82%A6%E3%83%B3%E3%81%AE%E6%9A%96%E3%81%8B%E3%81%95_%E6%A9%9F%E8%83%BD%E3%82%A2%E3%82%A4%E3%82%B3%E3%83%B3.png",
