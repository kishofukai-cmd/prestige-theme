uto/-/preview/3000x3000/-/quality/lighter/Line%201%20crop%20.png" alt="" class="gf_image" data-gemlang="en" data-width="70%" data-height="auto" title="" width="3000" height="535" natural-width="3000" natural-height="535"></a></div></div><!--gfsplit--><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1715838080800" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1715838080800" style=""><div class="elm text-edit gf-elm-center gf-elm-center-md gf-elm-center-sm gf-elm-center-lg gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">【カラーのご紹介】</h1></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1715838061307" class="gf_row" data-icon="gpicon-row" data-id="1715838061307" data-layout-lg="4+4+4" data-extraclass="" data-layout-md="4+4+4" data-layout-sm="12+12+12" data-layout-xs="12+12+12"><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1715838061356" data-id="1715838061356"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1721377020336" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1721377020336" data-resolution="3000x3000" style=""><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/products/new-kapok-sleep-ket?variant=46183658651900" target=""><img src="https://ucarecdn.com/65012c28-b137-45af-9773-30ae99bd3d90/-/format/auto/-/preview/3000x3000/-/quality/lighter/DSC_2991_3x_greige_1%20_1_.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1200" height="800" natural-width="1200" natural-height="800"></a></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1721377040644" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1721377040644" style=""><div class="elm text-edit gf-elm-center gf-elm-center-md gf-elm-center-sm gf-elm-left-xs gf-elm-left-lg" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">Off White（オフホワイト） <span style="color: rgb(237, 78, 78);">再入荷！</span></h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1721377062288" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1721377062288" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-xs" data-gemlang="en" data-exc=""><p><strong>人気No.1カラー「オフホワイト」が1年ぶりに再入荷！</strong><br data-mce-fragment="1" style="border-color: rgb(var(--border-color)); margin-block-start: 0px !important;"><br>くすみのあるホワイトでホワイトが基調のお部屋にはもちろん、どんなウッド調のお部屋・インテリアにも馴染みます。また、裏地も穏やかなカラーリングなので、気分や雰囲気に合わせてコーディネートを楽しめます。</p></div></div></div><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1715838064966" data-id="1715838064966"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1715838118049" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1715838118049" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/products/new-kapok-sleep-ket?variant=45639017955580" target=""><img src="https://ucarecdn.com/e60a7cd0-37e6-4b52-bd1c-6002dc4ae5cd/-/format/auto/-/preview/3000x3000/-/quality/lighter/DSC_2991_3x_2_1_a44d73d9-81da-42eb-9b4c-357929128e07.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1200" height="800" natural-width="1200" natural-height="800"></a></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1715838130171" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1715838130171" style=""><div class="elm text-edit gf-elm-center gf-elm-center-md gf-elm-center-sm gf-elm-left-xs gf-elm-left-lg" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">Mood Purple（ムードパープル）<span style="color: rgb(253, 83, 83);">再入荷！</span></h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1715838143278" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1715838143278" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-xs" data-gemlang="en" data-exc=""><p><span data-mce-fragment="1" style="border-color: rgb(var(--border-color)); margin-block-start: 0px !important;">どんなインテリアともマッチする意外な色をご存知でしょうか。<br data-mce-fragment="1" style="border-color: rgb(var(--border-color)); margin-block: 0px !important;"></span>それは、パープルとグリーンです。<br data-mce-fragment="1" style="border-color: rgb(var(--border-color));">この二つの色は中性色と呼ばれ、カラーチャート上の暖色と寒色の中間に位置するためどんな色とも組み合わせがよく、また季節を選ばないカラーとして知られています。<br data-mce-fragment="1" style="border-color: rgb(var(--border-color)); margin-block-start: 1.25rem;">パープルには鎮静作用があるとされており、ストレスや不安を軽減する効果を持ちます。<br data-mce-fragment="1" style="border-color: rgb(var(--border-color)); margin-block-start: 1.25rem; margin-block-end: 0px !important;">ストレスフルな毎日を過ごす方にオススメのカラーです。<br></p></div></div></div><div class="gf_column gf_col-lg-4 gf_col-md-4 gf_col-sm-12 gf_col-xs-12" id="c-1715838064980" data-id="1715838064980"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1715838123929" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1715838123929" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://kapok-knot.com/products/new-kapok-sleep-ket?variant=45734942441724" target=""><img src="https://ucarecdn.com/2abe2ee7-6b9d-4960-b3c2-bad988844153/-/format/auto/-/preview/3000x3000/-/quality/lighter/DSC_2988_3x_1_1_1_2fe3201d-85b8-4abb-b98c-f16d50382315.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" 