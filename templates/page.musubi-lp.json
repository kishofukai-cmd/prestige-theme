    "faq": {
      "type": "musubi-lp-faq",
      "settings": {},
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "リビングで利用できますか？",
            "answer": "<p>はい。Nap Size(M)はソファでの使用を想定して設計されています。日本のソファの平均奥行き70cmに基づくサイズです。</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "起きたらブランケットが落ちています。合っていないのでしょうか？",
            "answer": "<p>寝返りの際に落ちることはございますが、寝入りの際に心地よい重さを感じていれば、十分にお使いいただけています。</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "2人で使えますか？",
            "answer": "<p>Sleep Size(L)は150×100cmですので2人でも使用可能です。ただし、加重ブランケットの効果を最大限に感じるためには、1人での使用をおすすめしています。</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "洗濯は可能でしょうか？",
            "answer": "<p>ご家庭での手洗いが可能です。詳しくは付属の取扱説明書をご確認ください。</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "夏でも使えますか？",
            "answer": "<p>はい。あみあみ構造による通気性で、夏でも蒸れを気にせず365日お使いいただけます。</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "次の販売はいつごろですか？",
            "answer": "<p>次回販売の情報は公式LINEにて最速でお届けいたします。</p>"
          }
        }
      },
