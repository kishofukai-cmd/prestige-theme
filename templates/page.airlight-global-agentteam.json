    "faq": {
      "type": "airlight-global-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Is it as warm as a down jacket?",
            "answer": "<p>In our founder's 3-week field test in Norway in December, the AirLight never needed a backup jacket. Customers in Montreal and Vancouver report the same through -20°C winters. We don't publish a specific temperature rating, but real-world performance speaks for itself.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Machine washable — cold cycle, air dry. No dry-cleaning, no special instructions. This is one of the key reasons our customers switch from down.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "What size should I order?",
            "answer": "<p>AirLight fits true to North American sizing. See the size guide on this page. If you're between sizes, we recommend sizing up for layering flexibility.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Will I pay import duties?",
            "answer": "<p>AirLight ships DDU (Delivered Duty Unpaid). Any import duties or taxes are billed at delivery by DHL — not included in your purchase price. In the US, duties on a $398 jacket are typically $0–40. In Canada, typically $0–50 CAD. We recommend checking your country's import duty rates before ordering.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Please see our returns policy page for the latest terms.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "Where is the AirLight Jacket made?",
            "answer": "<p>Every AirLight Jacket is designed, developed, and engineered in Japan — using Japanese-developed fabric and insulation technology. Sewing and filling are handled by our trusted manufacturing partners. 'Designed in Japan' means Japanese textile expertise in every detail.</p>"
          }
        }
      },
