ta-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/e848dcda-3e9d-49dc-a4e4-60ca072e42c5/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_1323_KAPOKKNOT.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-6" id="c-1719459551860" data-id="1719459551860"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719459615948" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719459615948" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/b82dd7ff-7d88-4c9d-8243-9b2d1e0435d4/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_0456_KAPOKKNOT.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1719459609667" class="gf_row" data-icon="gpicon-row" data-id="1719459609667" style=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1719459447221" data-id="1719459447221"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1719459609676" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1719459609676" style=""><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">ムードピンク（Mood Pink）</h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1719459816450" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1719459816450" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>可愛さと上品さを兼ね揃えた、人の心を揺さぶる特別な雰囲気がありシンプルな部屋のポイントカラーになる。</p></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1719459609747" class="gf_row" data-icon="gpicon-row" data-id="1719459609747" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="6+6" style=""><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-6" id="c-1719459550731" data-id="1719459550731"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719459609673" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719459609673" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/8773dab9-419b-4311-b2ca-2fb3b0a6eba1/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_1320_KAPOKKNOT.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-6" id="c-1719459551860" data-id="1719459551860"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719459609708" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719459609708" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/47994496-9f4d-4e38-a455-5af51090d6e2/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_1228_KAPOKKNOT.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div></div></div></div