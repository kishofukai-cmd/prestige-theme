gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/cbf23df6-c1dc-4958-adeb-2ce9a62b2b66/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_8969.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div></div><div class="item"><div data-index="4" class="item-content"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719482276992" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719482276992" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/cfc6ae24-faef-4041-a6cd-0db6628b2390/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_9063.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1500" height="1500" natural-width="1500" natural-height="1500"></div></div></div></div><div class="item"><div data-index="5" class="item-content"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719482277012" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719482277012" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/89257960-dc18-4edf-96ac-15612aeeebfb/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_8990.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1500" height="1500" natural-width="1500" natural-height="1500"></div></div></div></div></div><div class="gf-carousel-loading"><div class="gf-caousel-ripple"><div></div><div></div></div></div></div><!--gfsplit--><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719457365633" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719457365633" data-resolution="3000x3000" style=""><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><b style="text-decoration-line: underline; color: rgb(195, 79, 75);"><img src="https://ucarecdn.com/e2ad9a1f-4dc7-4a6e-84fa-35ba63e25f71/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_9075.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1626" height="915" natural-width="1626" natural-height="915"></b></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1719462123629" class="gf_row" data-icon="gpicon-row" data-id="1719462123629"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1719462123651" data-id="1719462123651"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1719462134354" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1719462134354" style=""><div class="elm text-edit gf-elm-center gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2"><b style="color: rgb(0, 0, 0);">リカバリー加重ブランケット"MUSUBI"</b></h1><h1 class="gf_gs-text-heading-2"><b style="color: rgb(0, 0, 0);">に込めた想い</b></h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1719462128409" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1719462128409" style=""><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-md gf-elm-left-sm gf-elm-center-lg gf-elm-left-xs" data-gemlang="en" data-exc=""><p><b style=""><span style="color: rgb(0, 0, 0);">私達は今までインドネシアで契約している</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">カポック農家さんたちには</span></b><b style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;"><span style="color: rgb(0, 0, 0);">カポックの収穫時期である9〜11月しか仕事を与えることが</span></b><b style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;"><span style="color: rgb(0, 0, 0);">出来ていませんでした。</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);"><br></span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">しかし、このブランケットはインドネシアでひと編みひと編み、</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">手で編んでいるため、</span></b><b style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;"><span style="color: rgb(0, 0, 0);">カポックの収穫時期以外の時期に</span></b></p><p><b style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit; letter-spacing: 0px;"><span style="color: rgb(0, 0, 0);">ブランケットを編んでもらうことで安定した雇用が生まれ、</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">KAPOK KNOTとして大きなMISSIONであった、</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">生産者さんたちの生活を護ること。</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);"><br></span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);">それが実現出来ると信じています。</span></b></p><p><b style=""><span style="color: rgb(0, 0, 0);"><br></span></b></p><p><span style="color: rgb(0, 0, 0); font-weight: 700;">その意味も込めて”MUSUBI”と名づけました。</span></p></div></div><b style="text-decoration-line: underline; color: rgb(195, 79, 75);"></b></div></div><!--gfsplit--><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1719459447238" class="gf_row" data-icon="gpicon-row" data-id="1719459447238" style="" data-extraclass=""><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1719459447221" data-id="1719459447221"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1719459453981" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1719459453981" style=""><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">【Colorを4色紹介】</h1></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1719459568135" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1719459568135" style=""><div class="elm text-edit gf-elm-center" data-gemlang="en"><h1 class="gf_gs-text-heading-2">スモーキーグレー(Smoky Gray)</h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1719459710465" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1719459710465"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1" data-gemlang="en"><p>ブラックでもない、グレーでもない自分の感性でカラーを表現できる色味。ベーシックで落ち着いた上品な印象があり、どんな年齢にも好まれる。</p></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1719459550652" class="gf_row" data-icon="gpicon-row" data-id="1719459550652" data-layout-lg="6+6" data-extraclass="" data-layout-md="6+6" data-layout-sm="6+6" data-layout-xs="6+6" style=""><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-6" id="c-1719459550731" data-id="1719459550731"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719459503197" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1719459503197" style="" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/629148f0-5c64-48d7-b5d8-e12634fb506f/-/format/auto/-/preview/3000x3000/-/quality/lighter/IMG_1312_KAPOKKNOT.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="2000" height="2000" natural-width="2000" natural-height="2000"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-6" id="c-1719459551860" data-id="1719459551860"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1719459509363" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-i