gn hide_style = '' %}{% if current_variant.compare_at_price == null %}{% assign hide_style = 'display:none;' %}{% endif %}<span class="gf_product-compare-price money gf_gs-text-paragraph-1" style="margin-left: 5px!important;{{hide_style}}" itemprop="price" data-price-compare-at="">{{ current_variant.compare_at_price | money }}</span>{% endif %}{% if '0' == '1' %}{% assign hide_style = '' %}{% if comparePrice <= currentPrice or comparePrice <= 0 %}{% assign comparePrice = 1 %}{% assign hide_style = 'display:none' %}{% endif %}<span class="gf_pq-discount-selector" style="{{hide_style}}"><span class="gf_pq-discount gf_gs-text-paragraph-1">{% assign diff = comparePrice | minus: currentPrice %}{% assign comparePriceFloat = comparePrice | times: 1.0 %}{% assign diff = diff | divided_by: comparePriceFloat %}{% assign diff = diff | times: 100.0 %}{% assign diff = diff | round %}<span></span><span class="gf_pq-percent">{{ diff }}%</span><span>OFF</span></span></span>{% endif %}</div></div></div><div data-label="(P) Variants" data-key="p-variants" data-atomgroup="child-product" id="m-1679300398254" class="module-wrap" data-icon="gpicon-product-swatches" data-ver="1.0" data-id="1679300398254"><div class="module gf_module-left gf_module-left-lg gf_module--md gf_module--sm gf_module--xs " data-group="separately" data-style="inline" data-inlinespacing="100px" data-pid="{{product.id}}" data-blankoption="0" data-blankoptiontext="Please select an item in the list">{% unless product.options_with_values.size == 1 and product.variants[0].title == 'Default Title' %}{% assign cols_lg = 12 | divided_by: 1 %}{% assign cols_md = 12 | divided_by: 1 %}{% assign cols_sm = 12 | divided_by: 1 %}{% assign cols_xs = 12 | divided_by: 1 %}{% assign rechargeClass = 'single-option-selector single-option-selector-product' %}{% assign rechargeId = 'SingleOptionSelector-product-' %}{% unless rechargeCount %}{% assign rechargeCount = 0 %}{% endunless %}{% if 'separately' == 'together' %}<div class="gf_variants-wrapper"><select id="{{rechargeId}}{{rechargeCount}}" class="gf_variants {{rechargeClass}}" data-type="separately" style="margin-bottom: 10px;">{% assign current_variant = product.selected_or_first_available_variant %}{% for variant in product.variants %}{% if variant.available %}{% if variant.id == current_variant.id %}<option selected="true" data-sku="{{variant.sku}}" value="{{variant.id}}">{{ variant.title }} - {{ variant.price | money_with_currency }}</option>{% else %}<option data-sku="{{variant.sku}}" value="{{variant.id}}">{{ variant.title }} - {{ variant.price | money_with_currency }}</option>{% endif %}{% else %}<option disabled="disabled">{{ variant.title }} - (Sold Out)</option>{% endif %}{% endfor %}</select></div>{% else %}<div class="gf_variants-wrapper gf_row gf_row_no_tools gf_row-no-padding">{% for option in product.options_with_values %}<div class="gf_column gf_col_no_tools gf_col-lg-{{cols_lg}} gf_col-md-{{cols_md}} gf_col-sm-{{cols_sm}} gf_col-xs-{{cols_xs}} gf_variants-option{{forloop.index}}">{% if 'inline' == 'inline' %}<div class="gf_align-module gf_align-i-center">{% endif %}{% if '1' == '1' %}<label>{{option.name}}</label>{% endif %}<select id="{{rechargeId}}{{rechargeCount}}" class="gf_variants {{rechargeClass}}" data-type="separately" style="margin-bottom: 10px;">{% for value in option.values %}<option value="{{ value | escape }}">{{value}}</option>{% endfor %}</select>{% if 'inline' == 'inline' %}</div>{% endif %}</div>{% assign rechargeCount = rechargeCount | plus: 1 %}{% endfor %}</div>{% endif %}{% endunless %}</div></div><div data-label="(P) Cart Button" data-key="p-cart-button" data-atomgroup="child-product" id="m-1679289771348" class="module-wrap" data-icon="gpicon-product-cartbutton" data-ver="1.1" data-id="1679289771348"><div class="module gf_module-center gf_module-center-lg gf_module--md gf_module--sm gf_module-center-xs " data-pid="{{product.id}}" data-text="カートに入れる" data-soldouttext="Sold Out" data-ajaxcart="0" data-cbto="custom" data-editlink="" data-ajaxtext="Adding..." data-thankyoutext="Thank you!" data-successmessage="Added to cart! [cart label=View Cart] or [continue label=Continue Shopping]." data-continue="" data-effect="" data-ani="gf_ani-shakeLeftRight" data-interval="4000" data-stretch-lg="1" data-stretch-md="1" data-stretch-sm="1" data-stretch-xs="1">{% if '' != '' %}<input type="image" src="" class="gf_add-to-cart product-form-product-template  gf_gs-button-cart-button gf_gs-button---large">{% else %}{% if '' != '' %}<button type="submit" name="add" id="" class="gf_add-to-cart product-form-product-template button btn  gf_gs-button-cart-button gf_gs-button---large">{% else %}</button><button type="submit" name="add" class="gf_add-to-cart product-form-product-template button btn  gf_gs-button-cart-button gf_gs-button---large">{% endif %}<span class="AddToCartText">カートに入れる</span></button>{% endif %}</div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1705649040848" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1705649040848" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><a href="https://lin.ee/a8HZwzC" target=""><img src="https://ucarecdn.com/e4536605-e85d-4df3-9a7d-9bf788d5aeb8/-/format/auto/-/preview/3000x3000/-/quality/lighter/Line%201%20crop%20.png" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="3000" height="535" natural-width="3000" natural-height="535"></a></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1682936306410" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1682936306410"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">赤ちゃんにも安心のオーガニックコットン</h4></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679290119941" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679290119941"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>オーガニックコットンを使った肌に優しいブランケット。空気の層がふんわりと包んでくれるから、子どものお昼寝、膝掛けに最適な一枚。植物モチーフのキルティングステッチがかわいらしく、ギフトにもぴったり。</p></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1682936362603" class="gf_row gf_row-gap-0" data-icon="gpicon-row" data-id="1682936362603" data-extraclass="" data-row-gap="0px"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1682936362607" data-id="1682936362607"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679290233167" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679290233167"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">ギフト包装を承っております</h4></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1682936352488" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1682936352488" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><a href="https://kapok-knot.com/collections/all/products/giftwrapping" target=""><img src="https://ucarecdn.com/f21ff856-846b-434b-ac10-0dc265d944aa/-/format/auto/-/preview/3000x3000/-/quality/lighter/gifthousou.jpeg" alt="" class="gf_image" data-gemlang="en" data-width="80%" data-height="auto" title="" width="1200" height="1200" natural-width="1200" natural-height="1200"></a></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1682936434353" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1682936434353"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>ギフト包装をご希望の方は、<a href="https://kapok-knot.com/collections/all/products/giftwrapping" class="">こちらのページ</a>より「ギフトラッピング」をカートに追加いただき、商品と一緒にご購入ください。</p></div></div></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679290585773" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679290585773"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">素材</h4></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679290592104" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679290592104"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>- 表地: コットン100%</p><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">- 裏地: コットン100%</span></p><p>- 中綿: リサイクルポリエステル70％,&nbsp;<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">植物繊維（カポック）30％</span></p></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679290823977" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679290823977"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">サイズ</h4></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679290833059" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679290833059"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>68×100cm</p></div></div><div data-label="Accordion" data-key="accordion" data-atomgroup="module" id="m-1679975957380" class="module-wrap" data-icon="gpicon-accordion" data-ver="2" data-id="1679975957380"><div data-accordion-group="" class="module " data-opendefault="1" data-opentab="1" data-single="1" data-bordercolor="#cecece" data-bordersize="1px"><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="1" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679975957504" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679975957504"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">お手入れ方法</h4></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="1" data-key="content1" class="item-content"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679975957475" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679975957475"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>洗濯時はネットをご利用ください。<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">柔軟剤の使用はなるべくお避けください。</span><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">型崩れや縫目滑脱の原因になります。</span></p><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;"><br></span></p><p><span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">長時間洗液に浸しておいたり、水や汗に濡れたままの状態で放置しますと、色落ちや色移りの原因になりますのでお避けください。</span></p><p>素材の特性上、洗濯や着用により、中わたが吹き出したり、細やかな繊維が表に飛び出ることがあります。 吹き出した中わたは引っ張らずにハサミでカットしてください。</p><p><br></p><p>淡色の製品につきましてカポックの原綿に化学溶剤を使用していない為、稀に原料本来が持つ油分がお洗濯時、染み出す可能性が御座います。</p><p><br></p><p>十分なお水でお洗濯頂く必要がある為、洗濯機の手洗いモードが好ましく、脱水を洗濯機で十分に行って頂くことを推奨しております。<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">もし染み出した場合は再度、水洗いにて落ちますので、ご安心下さい。</span></p></div></div></article></div></div><div data-accordion="" style="padding-bottom: "><div data-control="" data-index="2" data-key="content" class="chevron iCon-right text- item-content"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679975957451" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679975957451"><div class="elm text-edit gf-elm-center gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><h4 class="gf_gs-text-heading-2">配送と返品</h4></div></div><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button><button type="button" class="wrapp-icon"><span class="acc-icon" style="background-color:#000000"></span></button></div><div data-content="" style="margin-top: ; background-color: #FFFFFF"><article data-index="2" data-key="content1" class="item-content"><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679975957457" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679975957457"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>お客様からオーダーを頂いてから、基本的には3日以内にお届けしております。<span style="color: inherit; font-family: inherit; font-size: inherit; text-align: inherit;">（ただし、物流状況に準じますことをご了承ください。）</span></p><p><br></p><p>また、お客様のお手元に商品が届いてから2週間以内でしたら、返品、交換が可能になります。商品に不良がない限り、商品タグを外して以降の返品、交換は基本的に対応致しかねますので、商品タグは切らずにご試着ください。</p></div></div></article></div></div></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1679922593454" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1679922593454" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-exc=""><a href="https://kapok-knot.com/blogs/news/try_kapok_on" target=""><img src="https://ucarecdn.com/47a7792c-3e71-4add-849b-35e01379125d/-/format/auto/-/preview/3000x3000/-/quality/lighter/trykapokon_home.png" alt="" class="gf_image" data-gemlang="en" data-width="100%" data-height="auto" title="" width="1724" height="375" natural-width="1724" natural-height="375"></a></div></div></div></div></div></div><div data-label="Row" data-key="row" id="r-1679922646806" class="gf_row" data-icon="gpicon-row" data-id="1679922646806"><div class="gf_col-lg-12 gf_column" id="c-1614054763048" data-id="1614054763048"><div data-label="Judge.me Reviews" data-key="judge-reviews" id="m-1679922646859" class="module-wrap" data-icon="gpicon-judge_reviews" data-ver="1" data-id="1679922646859" data-compile="false"><div class="module gf_module-left-lg gf_module-left-md gf_module-left-sm gf_module-left-xs " data-color="#339999" data-widget="reviews">{% if 'reviews' == 'reviews' %}{% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', concierge_install: false, product: product %}{% else %}{% render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: false, product: product %}{% endif %}</div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1679291402529" class="gf_row gf_row-fluid gf_row-no-padding" data-icon="gpicon-row" data-id="1679291402529" data-extraclass=""><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1679291402520" data-id="1679291402520"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1679291465298" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1679291465298" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/e2a27a1c-2bc3-4dfe-9a63-cf860d517456/-/format/auto/-/preview/3000x3000/-/quality/lighter/KKFLYING-20.png" alt="" class="gf_image" data-gemlang="en" width="1125" height="1126" data-width="100%" data-height="auto" title="" natural-width="1125" natural-height="1126"></div></div></div><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-12" id="c-1679291419729" data-id="1679291419729"><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1679291525020" class="gf_row" data-icon="gpicon-row" data-id="1679291525020"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1679291525010" data-id="1679291525010"><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1679291564098" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1679291564098" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-xs gf-elm-center-lg" data-exc=""><img src="https://ucarecdn.com/e7331333-e995-42d7-87c2-b5ed8f898c56/-/format/auto/-/preview/3000x3000/-/quality/lighter/%E3%82%A2%E3%83%BC%E3%83%88%E3%83%9B%E3%82%99%E3%83%BC%E3%83%88%E3%82%99%202%20%E3%81%AE%E3%82%B3%E3%83%92%E3%82%9A%E3%83%BC%202@3x.png" alt="" class="gf_image" data-gemlang="en" data-width="20%" data-height="auto" title="" width="124" height="168" natural-width="124" natural-height="168"></div></div><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679291620228" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="1679291620228"><div class="elm text-edit gf-elm-center gf-elm-center-lg gf-elm-center-md gf-elm-center-sm gf-elm-center-xs" data-gemlang="en" data-exc=""><h1 class="gf_gs-text-heading-2">赤ちゃんも安心のオーガニック素材</h1></div></div><div data-label="Text Block" data-key="text-block" data-atomgroup="element" id="e-1679291605250" class="element-wrap" data-icon="gpicon-textblock" data-ver="1" data-id="1679291605250"><div class="elm text-edit gf-elm-left gf_gs-text-paragraph-1 gf-elm-left-lg gf-elm-left-md gf-elm-left-sm gf-elm-left-xs" data-gemlang="en" data-exc=""><p>オーガニックコットンを使用しており、敏感肌にも優しい素材です。かつホルマリンフリーですので、赤ちゃんの肌にも優しく、安心してお使いいただけます。</p><p>新生児へのプレゼントにもぴったりな一枚。</p></div></div></div></div><div data-label="Image" data-key="image" data-atomgroup="element" id="e-1679293929646" class="element-wrap" data-icon="gpicon-image" data-ver="1.0" data-id="1679293929646" data-resolution="3000x3000"><div class="elm gf-elm-center gf_elm-left-xs gf-elm-center-md gf-elm-center-sm gf-elm-center-lg gf-elm-center-xs" data-exc=""><img src="https://ucarecdn.com/85775118-55e2-4c1e-845e-4de3a0d3a890/-/format/auto/-/preview/3000x3000/-/quality/lighter/KKSS-76%205.png" alt="" class="gf_image" data-gemlang="en" width="1116" height="1126" data-width="100%" data-height="auto" title="" natural-width="1116" natural-height="1126"></div></div></div></div><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1679291810404" class="gf_row gf_row-fluid gf_row-no-padding gf_row-gap-0" data-icon="gpicon-row" data-id="1679291810404" data-extraclass="" data-row-gap="0px"><div class="gf_column gf_col-lg-6 gf_col-md-6 gf_col-sm-6 gf_col-xs-" id="c-1679291402520" data-id="1679291402520"><div data-label="Row" data-key="row" data-atomgroup="row" id="r-1679291810282" class="gf_row" data-icon="gpicon-row" data-id="1679291810282"><div class="gf_column gf_col-lg-12 gf_col-md-12 gf_col-sm-12 gf_col-xs-12" id="c-1679291525010" data-id="1679291525010"><div data-label="Heading" data-key="heading" data-atomgroup="element" id="e-1679291810316" class="element-wrap" data-icon="gpicon-heading" data-ver="2" data-id="167