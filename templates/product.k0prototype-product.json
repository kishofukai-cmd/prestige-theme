    "custom_liquid_fkL7c8": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "settings": {
        "color_scheme": "",
        "separate_section_with_border": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{%- assign seo = product.metafields.custom.seo_body.value -%}\n{%- if seo != blank -%}\n{%- assign name = product.title | remove: '[New]' | remove: '[在庫限り]' | split: '-' | first | strip -%}\n<div class=\"kk-seo-section\" style=\"max-width:860px;margin:0 auto;padding:8px 16px 24px;text-align:left;\">\n  <details class=\"kk-seo-accordion\" style=\"border-top:1px solid #e5e5e5;border-bottom:1px solid #e5e5e5;\">\n    <summary style=\"cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;padding:16px 0;font-size:15px;font-weight:bold;letter-spacing:0.05em;\">\n      <span>{{ name }}について詳しく<span style=\"font-weight:normal;font-size:13px;color:#666;margin-left:8px;\">選び方・気温の目安・よくある質問</span></span>\n      <span class=\"kk-seo-icon\" aria-hidden=\"true\" style=\"font-size:20px;line-height:1;\">＋</span>\n    </summary>\n    <div class=\"kk-seo-body-wrap\" style=\"padding:0 0 16px;font-size:14px;line-height:1.9;text-align:left;\">\n      {{ seo }}\n    </div>\n  </details>\n</div>\n<style>\n  .kk-seo-section, .kk-seo-section * { text-align: left; }\n  .kk-seo-section table th, .kk-seo-section table td { text-align: left; }\n  .kk-seo-accordion summary::-webkit-details-marker { display: none; }\n  .kk-seo-accordion summary:focus { outline: none; }\n  .kk-seo-accordion summary:focus-visible { outline: 2px solid #33465C; outline-offset: 2px; }\n  .kk-seo-accordion[open] .kk-seo-icon { transform: rotate(45deg); }\n  .kk-seo-body-wrap h2 { font-size: 18px; margin: 24px 0 8px; }\n  .kk-seo-body-wrap h3 { font-size: 15px; margin: 18px 0 6px; }\n  .kk-seo-body-wrap table { font-size: 13px; }\n  @media (max-width: 480px) {\n    .kk-seo-body-wrap table { display: block; overflow-x: auto; }\n    .kk-seo-accordion summary > span:first-child > span { display: block; margin: 4px 0 0; }\n  }\n</style>\n{%- endif -%}\n{%- if product.metafields.custom.faq_jsonld != blank -%}\n<script type=\"application/ld+json\">{{ product.metafields.custom.faq_jsonld.value | json }}</script>\n{%- endif -%}",
        "text_alignment": "center"
      }
    },
