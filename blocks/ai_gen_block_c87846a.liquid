{% doc %}
  @prompt
     KVを入れたい。PCとSPで画像を変えられるようにして。
    KVには文字は入れない。
    そのKVの下にタイトルみたいなものを入れたいから、フォントサイズ、太字や余白など弄れるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-kv-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-kv-block-{{ ai_gen_id }}__visual {
    display: block;
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }

  .ai-kv-block-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-kv-block-{{ ai_gen_id }}__placeholder {
    display: flex;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    align-items: center;
    justify-content: center;
    background: #efefef;
  }

  .ai-kv-block-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-kv-block-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    margin: 0;
    padding: 8px 12px;
    color: #1c1c1c;
    background: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
  }

  .ai-kv-block-{{ ai_gen_id }}__title {
    margin: {{ block.settings.title_margin_top }}px 0 {{ block.settings.title_margin_bottom }}px;
    color: {{ block.settings.title_color }};
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-style: {{ block.settings.title_font.style }};
    font-weight: {% if block.settings.title_bold %}700{% else %}400{% endif %};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.35;
    text-align: {{ block.settings.title_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-kv-block-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-kv-block-{{ ai_gen_id }}__desktop-image {
      display: none;
    }

    .ai-kv-block-{{ ai_gen_id }}__mobile-image {
      display: block;
    }

    .ai-kv-block-{{ ai_gen_id }}__title {
      margin-top: {{ block.settings.mobile_title_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_title_margin_bottom }}px;
      font-size: {{ block.settings.mobile_title_size }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-kv-block-{{ ai_gen_id }}__mobile-image {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-kv-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-kv-block-{{ ai_gen_id }}__visual">
    {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
      {% if block.settings.desktop_image != blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__desktop-image"
          src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          loading="lazy"
        >
      {% endif %}
      {% if block.settings.mobile_image != blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__mobile-image"
          src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          loading="lazy"
        >
      {% endif %}
      {% if block.settings.desktop_image == blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__desktop-image"
          src="{{ block.settings.mobile_image | image_url: width: 2400 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          loading="lazy"
        >
      {% endif %}
      {% if block.settings.mobile_image == blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__mobile-image"
          src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          loading="lazy"
        >
      {% endif %}
    {% else %}
      <div class="ai-kv-block-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <p class="ai-kv-block-{{ ai_gen_id }}__empty-state">PC用・スマートフォン用の画像を設定してください</p>
      </div>
    {% endif %}
  </div>
  {% if block.settings.title != blank %}
    <h2 class="ai-kv-block-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>
  {% endif %}
</div>

{% schema %}
{
  "name": "KV画像とタイトル",
  "settings": [
    {
      "type": "header",
      "content": "KV画像"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "PC用画像"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "スマートフォン用画像"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "タイトル"
    },
    {
      "type": "text",
      "id": "title",
      "label": "タイトル"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "フォント",
      "default": "optima_nova_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "PCフォントサイズ",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "スマートフォンフォントサイズ",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "title_bold",
      "label": "太字にする",
      "default": false
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "文字揃え",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "文字色",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "title_margin_top",
      "label": "PC上の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "PC下の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_title_margin_top",
      "label": "スマートフォン上の余白",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_title_margin_bottom",
      "label": "スマートフォン下の余白",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "KV画像とタイトル"
    }
  ],
  "tag": null,
  "class": "kv-image-title-block"
}
{% endschema %}