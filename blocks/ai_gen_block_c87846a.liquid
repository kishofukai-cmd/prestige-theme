{% doc %}
  @prompt
    KVを入れたい。PCとSPで画像を変えられるようにする。
    KVには文字は入れない。
    KVの下にタイトルと本文を表示する。
    タイトルはフォントサイズ、太字、文字色、配置、余白を調整可能。
    本文はリッチテキストで、一部分だけ太字・リンクなどを設定可能。
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-kv-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-kv-block-{{ ai_gen_id }}__visual {
    display: block;
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }

  .ai-kv-block-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-kv-block-{{ ai_gen_id }}__placeholder {
    display: flex;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    align-items: center;
    justify-content: center;
    background: #efefef;
  }

  .ai-kv-block-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-kv-block-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    margin: 0;
    padding: 8px 12px;
    color: #1c1c1c;
    background: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    white-space: nowrap;
  }


  /* ================================
     タイトル
     ================================ */

  .ai-kv-block-{{ ai_gen_id }}__title {
    margin: {{ block.settings.title_margin_top }}px 0 {{ block.settings.title_margin_bottom }}px;
    padding: 0 {{ block.settings.content_side_padding }}px;

    color: {{ block.settings.title_color }};

    font-family:
      {{ block.settings.title_font.family }},
      {{ block.settings.title_font.fallback_families }};

    font-style: {{ block.settings.title_font.style }};

    font-weight:
      {% if block.settings.title_bold %}
        700
      {% else %}
        {{ block.settings.title_font.weight }}
      {% endif %};

    font-size: {{ block.settings.title_size }}px;
    line-height: {{ block.settings.title_line_height | divided_by: 100.0 }};
    letter-spacing: {{ block.settings.title_letter_spacing | divided_by: 100.0 }}em;
    text-align: {{ block.settings.title_alignment }};
  }


  /* ================================
     本文
     ================================ */

  .ai-kv-block-{{ ai_gen_id }}__text {
    margin: {{ block.settings.text_margin_top }}px 0 {{ block.settings.text_margin_bottom }}px;
    padding: 0 {{ block.settings.content_side_padding }}px;

    color: {{ block.settings.text_color }};

    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height | divided_by: 100.0 }};
    letter-spacing: {{ block.settings.text_letter_spacing | divided_by: 100.0 }}em;

    text-align: {{ block.settings.text_alignment }};
  }

  .ai-kv-block-{{ ai_gen_id }}__text p {
    margin-top: 0;
    margin-bottom: {{ block.settings.text_paragraph_spacing }}px;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  .ai-kv-block-{{ ai_gen_id }}__text p:last-child {
    margin-bottom: 0;
  }

  /* リッチテキストで選択した太字 */
  .ai-kv-block-{{ ai_gen_id }}__text strong,
  .ai-kv-block-{{ ai_gen_id }}__text b {
    font-weight: 700;
    color: inherit;
  }

  /* リンク */
  .ai-kv-block-{{ ai_gen_id }}__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-kv-block-{{ ai_gen_id }}__text a:hover {
    opacity: 0.65;
  }

  /* リスト */
  .ai-kv-block-{{ ai_gen_id }}__text ul,
  .ai-kv-block-{{ ai_gen_id }}__text ol {
    display: inline-block;
    text-align: left;
    margin-top: 0;
    margin-bottom: 1em;
  }


  /* ================================
     SP
     ================================ */

  @media screen and (max-width: 749px) {
    .ai-kv-block-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-kv-block-{{ ai_gen_id }}__desktop-image {
      display: none;
    }

    .ai-kv-block-{{ ai_gen_id }}__mobile-image {
      display: block;
    }

    .ai-kv-block-{{ ai_gen_id }}__title {
      margin-top: {{ block.settings.mobile_title_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_title_margin_bottom }}px;
      padding-left: {{ block.settings.mobile_content_side_padding }}px;
      padding-right: {{ block.settings.mobile_content_side_padding }}px;
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-kv-block-{{ ai_gen_id }}__text {
      margin-top: {{ block.settings.mobile_text_margin_top }}px;
      margin-bottom: {{ block.settings.mobile_text_margin_bottom }}px;
      padding-left: {{ block.settings.mobile_content_side_padding }}px;
      padding-right: {{ block.settings.mobile_content_side_padding }}px;
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }


  /* ================================
     PC
     ================================ */

  @media screen and (min-width: 750px) {
    .ai-kv-block-{{ ai_gen_id }}__mobile-image {
      display: none;
    }
  }
{% endstyle %}


<div
  class="ai-kv-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <!-- KV画像 -->
  <div class="ai-kv-block-{{ ai_gen_id }}__visual">

    {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank %}

      {% if block.settings.desktop_image != blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__desktop-image"
          src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          loading="lazy"
        >
      {% endif %}

      {% if block.settings.mobile_image != blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__mobile-image"
          src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          loading="lazy"
        >
      {% endif %}

      {% if block.settings.desktop_image == blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__desktop-image"
          src="{{ block.settings.mobile_image | image_url: width: 2400 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          loading="lazy"
        >
      {% endif %}

      {% if block.settings.mobile_image == blank %}
        <img
          class="ai-kv-block-{{ ai_gen_id }}__image ai-kv-block-{{ ai_gen_id }}__mobile-image"
          src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          loading="lazy"
        >
      {% endif %}

    {% else %}

      <div class="ai-kv-block-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <p class="ai-kv-block-{{ ai_gen_id }}__empty-state">
          PC用・スマートフォン用の画像を設定してください
        </p>
      </div>

    {% endif %}

  </div>


  <!-- タイトル -->
  {% if block.settings.title != blank %}
    <h2 class="ai-kv-block-{{ ai_gen_id }}__title">
      {{ block.settings.title | escape }}
    </h2>
  {% endif %}


  <!-- 本文 -->
  {% if block.settings.text != blank %}
    <div class="ai-kv-block-{{ ai_gen_id }}__text">
      {{ block.settings.text }}
    </div>
  {% endif %}

</div>


{% schema %}
{
  "name": "KV画像・タイトル・本文",

  "settings": [

    {
      "type": "header",
      "content": "KV画像"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "PC用画像"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "スマートフォン用画像"
    },

    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "PC画像・コンテンツ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },


    {
      "type": "header",
      "content": "タイトル"
    },

    {
      "type": "text",
      "id": "title",
      "label": "タイトル"
    },

    {
      "type": "font_picker",
      "id": "title_font",
      "label": "タイトルのフォント",
      "default": "optima_nova_n4"
    },

    {
      "type": "range",
      "id": "title_size",
      "label": "PC：フォントサイズ",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "SP：フォントサイズ",
      "min": 14,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "checkbox",
      "id": "title_bold",
      "label": "太字にする",
      "default": false
    },

    {
      "type": "select",
      "id": "title_alignment",
      "label": "文字揃え",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "文字色",
      "default": "#1c1c1c"
    },

    {
      "type": "range",
      "id": "title_line_height",
      "label": "行間",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 135
    },

    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "文字間隔",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 0
    },

    {
      "type": "range",
      "id": "title_margin_top",
      "label": "PC：上の余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "PC：下の余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "mobile_title_margin_top",
      "label": "SP：上の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "mobile_title_margin_bottom",
      "label": "SP：下の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },


    {
      "type": "header",
      "content": "本文"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>ここに本文を入力してください。強調したい部分だけ<strong>太字</strong>にできます。</p>"
    },

    {
      "type": "range",
      "id": "text_size",
      "label": "PC：本文フォントサイズ",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "SP：本文フォントサイズ",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "本文の文字揃え",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "本文の文字色",
      "default": "#555555"
    },

    {
      "type": "range",
      "id": "text_line_height",
      "label": "本文の行間",
      "min": 120,
      "max": 240,
      "step": 5,
      "unit": "%",
      "default": 180
    },

    {
      "type": "range",
      "id": "text_letter_spacing",
      "label": "本文の文字間隔",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 0
    },

    {
      "type": "range",
      "id": "text_paragraph_spacing",
      "label": "段落間の余白",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "text_margin_top",
      "label": "PC：本文上の余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "text_margin_bottom",
      "label": "PC：本文下の余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "mobile_text_margin_top",
      "label": "SP：本文上の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_text_margin_bottom",
      "label": "SP：本文下の余白",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },


    {
      "type": "header",
      "content": "左右の余白"
    },

    {
      "type": "range",
      "id": "content_side_padding",
      "label": "PC：左右の余白",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_content_side_padding",
      "label": "SP：左右の余白",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    }

  ],

  "presets": [
    {
      "name": "KV画像・タイトル・本文"
    }
  ],

  "tag": null,
  "class": "kv-image-title-block"
}
{% endschema %}