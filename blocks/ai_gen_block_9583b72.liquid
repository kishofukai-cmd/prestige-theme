{% doc %}
  @prompt
    題名「ギフトカードプレゼント」下に説明文入れる。, 題名「ギフトカードプレゼント」下に説明文、その下に左に画像右に説明文入れたい, スマホで見たときに左画像、説明文に配置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-card-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-gift-card-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-gift-card-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-gift-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px;
    font-weight: 600;
  }

  .ai-gift-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-gift-card-content-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
  }

  .ai-gift-card-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
  }

  .ai-gift-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-gift-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-gift-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-gift-card-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-gift-card-text-wrapper-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-gift-card-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_text_size }}px;
    color: {{ block.settings.content_text_color }};
    line-height: 1.8;
  }

  @media screen and (max-width: 749px) {
    .ai-gift-card-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-gift-card-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
    }

    .ai-gift-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-gift-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-gift-card-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.content_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-gift-card-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gift-card-container-{{ ai_gen_id }}">
    <div class="ai-gift-card-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-gift-card-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-gift-card-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-gift-card-content-{{ ai_gen_id }}">
      <div class="ai-gift-card-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-gift-card-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-gift-card-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-gift-card-empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-gift-card-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.content_text != blank %}
          <div class="ai-gift-card-text-{{ ai_gen_id }}">{{ block.settings.content_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ギフトカードプレゼント",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "タイトルと説明"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトル",
      "default": "ギフトカードプレゼント"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "説明文",
      "default": "<p>特別なギフトカードをプレゼントいたします。</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "テキスト配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "コンテンツ"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "コンテンツ説明文",
      "default": "<p>こちらのギフトカードは、お買い物の際にご利用いただけます。詳細については、カスタマーサポートまでお問い合わせください。</p>"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "画像の幅",
      "default": 40
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルの色",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "説明文の色",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "content_text_color",
      "label": "コンテンツ説明文の色",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "タイトルサイズ",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "説明文サイズ",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "コンテンツ説明文サイズ",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "画像の角丸",
      "default": 8
    },
    {
      "type": "header",
      "content": "間隔"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "セクションの余白",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "ヘッダーの下余白",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_margin",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "タイトルの下余白",
      "default": 15
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "画像とテキストの間隔",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "モバイルの間隔",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 100,
      "unit": "px",
      "label": "最大幅",
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "ギフトカードプレゼント"
    }
  ]
}
{% endschema %}
