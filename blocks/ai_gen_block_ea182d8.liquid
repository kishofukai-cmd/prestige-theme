{% doc %}
  @prompt
    PCで見ると3つの正方形画像があり、その遷移先がコレクションページにしたい
    SPはカルーセルにしたい, それぞれの画像にボタン設置（左寄せ）, 画像の上にタイトルつけたい, タイトルは画像それぞれにではなく、大項目見たく、まずタイトルがあって改行、その下に画像が入るようして, タイトルはセンターにして欲しい, PCは横3列、SPは縦3つ並びに変更して, 画像の左下にテキスト入れたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 30px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    display: block;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-collection-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.text_spacing }}px;
    left: {{ block.settings.text_spacing }}px;
    z-index: 2;
  }

  .ai-collection-grid__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_button_gap }}px;
    line-height: 1.3;
  }

  .ai-collection-grid__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-collection-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-collection-grid__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign image_key = 'image_' | append: i
        assign text_key = 'text_' | append: i
        assign button_text_key = 'button_text_' | append: i

        assign collection = block.settings[collection_key]
        assign image = block.settings[image_key]
        assign text = block.settings[text_key]
        assign button_text = block.settings[button_text_key]
      %}

      <div class="ai-collection-grid__item-{{ ai_gen_id }}">
        <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-collection-grid__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
            {% if text != blank %}
              <div class="ai-collection-grid__text-{{ ai_gen_id }}">{{ text }}</div>
            {% endif %}

            {% if collection != blank and button_text != blank %}
              <a href="{{ collection.url }}" class="ai-collection-grid__button-{{ ai_gen_id }}">
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

