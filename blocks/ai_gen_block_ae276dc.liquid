{% doc %}
  @prompt
    題名「Holiday Gift 2025」を入れて説明文を入れたい
    その後、題名、どんな商品をお探しですか？
    説明文、贈る相手やシーンに合わせて、おすすめのカテゴリーをご用意しました。とかいて、その下に2つのボタン設置したい。スマホで見たときに横並日になるようにして。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holiday-gift-section-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-holiday-gift-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-holiday-gift-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    text-align: center;
  }

  .ai-holiday-gift-main-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 40px;
    text-align: center;
    line-height: 1.6;
  }

  .ai-holiday-gift-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    text-align: center;
  }

  .ai-holiday-gift-subdescription-{{ ai_gen_id }} {
    font-size: {{ block.settings.subdescription_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    text-align: center;
    line-height: 1.6;
  }

  .ai-holiday-gift-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-holiday-gift-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
    min-width: 160px;
    text-align: center;
  }

  .ai-holiday-gift-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-holiday-gift-section-{{ ai_gen_id }} {
      padding: 30px 16px;
    }

    .ai-holiday-gift-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.8 }}px;
    }

    .ai-holiday-gift-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-holiday-gift-buttons-{{ ai_gen_id }} {
      flex-direction: row;
      gap: 12px;
    }

    .ai-holiday-gift-button-{{ ai_gen_id }} {
      flex: 1;
      min-width: 0;
      padding: 12px 20px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-holiday-gift-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-holiday-gift-container-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h1 class="ai-holiday-gift-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h1>
    {% endif %}

    {% if block.settings.main_description != blank %}
      <div class="ai-holiday-gift-main-description-{{ ai_gen_id }}">{{ block.settings.main_description }}</div>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <h2 class="ai-holiday-gift-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</h2>
    {% endif %}

    {% if block.settings.subdescription != blank %}
      <div class="ai-holiday-gift-subdescription-{{ ai_gen_id }}">{{ block.settings.subdescription }}</div>
    {% endif %}

    <div class="ai-holiday-gift-buttons-{{ ai_gen_id }}">
      {% if block.settings.button_1_text != blank %}
        <a href="{{ block.settings.button_1_link }}" class="ai-holiday-gift-button-{{ ai_gen_id }}">
          {{ block.settings.button_1_text }}
        </a>
      {% endif %}

      {% if block.settings.button_2_text != blank %}
        <a href="{{ block.settings.button_2_link }}" class="ai-holiday-gift-button-{{ ai_gen_id }}">
          {{ block.settings.button_2_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Holiday Gift 2025",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "メインタイトル"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "タイトル",
      "default": "Holiday Gift 2025"
    },
    {
      "type": "range",
      "id": "main_title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "タイトルサイズ",
      "default": 36
    },
    {
      "type": "textarea",
      "id": "main_description",
      "label": "説明文"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "説明文サイズ",
      "default": 16
    },
    {
      "type": "header",
      "content": "サブタイトル"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "サブタイトル",
      "default": "どんな商品をお探しですか？"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "サブタイトルサイズ",
      "default": 24
    },
    {
      "type": "textarea",
      "id": "subdescription",
      "label": "サブ説明文",
      "default": "贈る相手やシーンに合わせて、おすすめのカテゴリーをご用意しました。"
    },
    {
      "type": "range",
      "id": "subdescription_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "サブ説明文サイズ",
      "default": 14
    },
    {
      "type": "header",
      "content": "ボタン1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "ボタン1テキスト",
      "default": "カテゴリー1"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "ボタン1リンク"
    },
    {
      "type": "header",
      "content": "ボタン2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "ボタン2テキスト",
      "default": "カテゴリー2"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "ボタン2リンク"
    },
    {
      "type": "header",
      "content": "ボタンスタイル"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "フォントサイズ",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "角丸",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "背景色",
      "default": "#04358d"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "ホバー時背景色",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "テキスト色",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "セクションスタイル"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#1c1c1c"
    }
  ],
  "presets": [
    {
      "name": "Holiday Gift 2025"
    }
  ]
}
{% endschema %}
