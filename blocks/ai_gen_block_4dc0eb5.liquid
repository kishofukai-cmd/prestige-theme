{% doc %}
  @prompt
    おすすめrecommend
    PCは5枚横カルーセル
    SPは最初の1枚、その下は2列で横並び4つで表示する
    商品画像、商品名、金額だけ出るようにして欲しい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recommend-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-recommend-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin-bottom: 24px;
    text-align: {{ block.settings.title_alignment }};
    color: {{ block.settings.title_color }};
  }

  .ai-recommend-carousel__desktop-{{ ai_gen_id }} {
    display: none;
  }

  .ai-recommend-carousel__mobile-{{ ai_gen_id }} {
    display: block;
  }

  .ai-recommend-carousel__first-product-{{ ai_gen_id }} {
    margin-bottom: 16px;
  }

  .ai-recommend-carousel__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .ai-recommend-product-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-recommend-product__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    margin-bottom: 12px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-recommend-product__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-recommend-product__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-recommend-product__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-recommend-product__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin-bottom: 8px;
    color: {{ block.settings.text_color }};
  }

  .ai-recommend-product__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-recommend-carousel__desktop-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .ai-recommend-carousel__mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-recommend-carousel__track-{{ ai_gen_id }} {
      display: flex;
      gap: 20px;
      transition: transform 0.3s ease;
    }

    .ai-recommend-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(20% - 16px);
      min-width: 0;
    }

    .ai-recommend-carousel__nav-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 24px;
    }

    .ai-recommend-carousel__button-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid {{ block.settings.button_border_color }};
      background-color: {{ block.settings.button_background }};
      color: {{ block.settings.button_color }};
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }

    .ai-recommend-carousel__button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_hover_background }};
      color: {{ block.settings.button_hover_color }};
    }

    .ai-recommend-carousel__button-{{ ai_gen_id }}:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .ai-recommend-carousel__button-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<ai-recommend-carousel-{{ ai_gen_id }}
  class="ai-recommend-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h2 class="ai-recommend-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-recommend-carousel__desktop-{{ ai_gen_id }}">
    <div class="ai-recommend-carousel__track-{{ ai_gen_id }}">
      {% for product in block.settings.products %}
        <div class="ai-recommend-carousel__slide-{{ ai_gen_id }}">
          <a href="{{ product.url }}" class="ai-recommend-product-{{ ai_gen_id }}">
            <div class="ai-recommend-product__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-recommend-product__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-recommend-product__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-recommend-product__title-{{ ai_gen_id }}">{{ product.title }}</div>
            <div class="ai-recommend-product__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </a>
        </div>
      {% endfor %}
    </div>

    {% if block.settings.products.size > 5 %}
      <div class="ai-recommend-carousel__nav-{{ ai_gen_id }}">
        <button
          class="ai-recommend-carousel__button-{{ ai_gen_id }} ai-recommend-carousel__button--prev-{{ ai_gen_id }}"
          aria-label="前へ"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="ai-recommend-carousel__button-{{ ai_gen_id }} ai-recommend-carousel__button--next-{{ ai_gen_id }}"
          aria-label="次へ"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>

  <div class="ai-recommend-carousel__mobile-{{ ai_gen_id }}">
    {% if block.settings.products.size > 0 %}
      <div class="ai-recommend-carousel__first-product-{{ ai_gen_id }}">
        {% assign first_product = block.settings.products[0] %}
        <a href="{{ first_product.url }}" class="ai-recommend-product-{{ ai_gen_id }}">
          <div class="ai-recommend-product__image-wrapper-{{ ai_gen_id }}">
            {% if first_product.featured_image %}
              <img
                src="{{ first_product.featured_image | image_url: width: 600 }}"
                alt="{{ first_product.featured_image.alt | escape }}"
                class="ai-recommend-product__image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-recommend-product__placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-recommend-product__title-{{ ai_gen_id }}">{{ first_product.title }}</div>
          <div class="ai-recommend-product__price-{{ ai_gen_id }}">{{ first_product.price | money }}</div>
        </a>
      </div>
    {% endif %}

    {% if block.settings.products.size > 1 %}
      <div class="ai-recommend-carousel__grid-{{ ai_gen_id }}">
        {% for product in block.settings.products offset: 1 limit: 4 %}
          <a href="{{ product.url }}" class="ai-recommend-product-{{ ai_gen_id }}">
            <div class="ai-recommend-product__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-recommend-product__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                <div class="ai-recommend-product__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-recommend-product__title-{{ ai_gen_id }}">{{ product.title }}</div>
            <div class="ai-recommend-product__price-{{ ai_gen_id }}">{{ product.price | money }}</div>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</ai-recommend-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AiRecommendCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerPage = 5;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-recommend-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-recommend-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-recommend-carousel__button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-recommend-carousel__button--next-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.itemsPerPage);

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.prev());
          this.nextButton.addEventListener('click', () => this.next());
          this.updateButtons();
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = 20;
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateButtons();
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.maxIndex;
        }
      }
    }

    customElements.define('ai-recommend-carousel-{{ ai_gen_id }}', AiRecommendCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "おすすめ商品",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "タイトル",
      "default": "おすすめ商品"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "タイトル配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "商品",
      "limit": 10
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "商品スタイル"
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "商品名サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "product_price_size",
      "label": "価格サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルカラー",
      "default": "#1c1c1c"
    },
    {
      "type": "header",
      "content": "ナビゲーションボタン"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "アイコンカラー",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "ボーダーカラー",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "ホバー背景色",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "ホバーアイコンカラー",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "おすすめ商品"
    }
  ]
}
{% endschema %}
