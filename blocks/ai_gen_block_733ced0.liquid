{% doc %}
  @prompt
    ギフトカードを紹介したい
    まずタイトル
    左に画像、右に見出しの構成、そこに購入ボタン
    その下に
    枠をつけてFQA3問分
    Qだけ見れてて、Aは折りたたみ形式
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-card-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-gift-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    text-align: center;
    margin: 0 0 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-gift-card-hero-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 60px;
  }

  .ai-gift-card-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-gift-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gift-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gift-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-gift-card-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-gift-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-gift-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-gift-card-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
    align-self: flex-start;
  }

  .ai-gift-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-gift-card-faq-{{ ai_gen_id }} {
    border: {{ block.settings.faq_border_width }}px solid {{ block.settings.faq_border_color }};
    border-radius: {{ block.settings.faq_border_radius }}px;
    padding: 30px;
    background-color: {{ block.settings.faq_background_color }};
  }

  .ai-gift-card-faq-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.faq_title_size }}px;
    margin: 0 0 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-gift-card-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.faq_border_color }};
  }

  .ai-gift-card-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-gift-card-faq-question-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: {{ block.settings.faq_question_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-gift-card-faq-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-gift-card-faq-question-{{ ai_gen_id }}[aria-expanded="true"] .ai-gift-card-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-gift-card-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-gift-card-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 0 20px 0;
    font-size: {{ block.settings.faq_answer_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-gift-card-hero-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-gift-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 24px;
    }

    .ai-gift-card-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-gift-card-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<gift-card-block-{{ ai_gen_id }} class="ai-gift-card-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.main_title != blank %}
    <h2 class="ai-gift-card-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
  {% endif %}

  <div class="ai-gift-card-hero-{{ ai_gen_id }}">
    <div class="ai-gift-card-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-gift-card-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-gift-card-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-gift-card-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h3 class="ai-gift-card-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-gift-card-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_url != blank and block.settings.button_text != blank %}
        <a href="{{ block.settings.button_url }}" class="ai-gift-card-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ai-gift-card-faq-{{ ai_gen_id }}">
    {% if block.settings.faq_title != blank %}
      <h3 class="ai-gift-card-faq-title-{{ ai_gen_id }}">{{ block.settings.faq_title }}</h3>
    {% endif %}

    {% for i in (1..3) %}
      {% liquid
        assign question_key = 'faq_question_' | append: i
        assign answer_key = 'faq_answer_' | append: i
        assign question = block.settings[question_key]
        assign answer = block.settings[answer_key]
      %}

      {% if question != blank %}
        <div class="ai-gift-card-faq-item-{{ ai_gen_id }}">
          <button
            class="ai-gift-card-faq-question-{{ ai_gen_id }}"
            aria-expanded="false"
            data-faq-index="{{ i }}"
          >
            <span>{{ question }}</span>
            <svg class="ai-gift-card-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="ai-gift-card-faq-answer-{{ ai_gen_id }}" data-faq-answer="{{ i }}">
            {% if answer != blank %}
              <div class="ai-gift-card-faq-answer-content-{{ ai_gen_id }}">{{ answer }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</gift-card-block-{{ ai_gen_id }}>

<script>
  (function() {
    class GiftCardBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.faqButtons = this.querySelectorAll('.ai-gift-card-faq-question-{{ ai_gen_id }}');
        this.setupFAQ();
      }

      setupFAQ() {
        this.faqButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const index = button.getAttribute('data-faq-index');
            const answer = this.querySelector(`[data-faq-answer="${index}"]`);
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              button.setAttribute('aria-expanded', 'false');
              answer.style.maxHeight = '0';
            } else {
              button.setAttribute('aria-expanded', 'true');
              answer.style.maxHeight = answer.scrollHeight + 'px';
            }
          });
        });
      }
    }

    customElements.define('gift-card-block-{{ ai_gen_id }}', GiftCardBlock{{ ai_gen_id }});
  })();
</script>

