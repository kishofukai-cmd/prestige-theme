{% doc %}
  @prompt
    画像を一枚入れたい。SPとPCビューの二つ画像が入れれるようにしたい。
    また画像にはリンクを飛ばしたい。
    
    またwidthを調整できるようにしてほしい。, 中央揃えにしたい。, SPビューもwidthの調整できるようにしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-responsive-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.mobile_width_percent }}%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-responsive-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-responsive-image-img-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-responsive-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-responsive-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-responsive-image-desktop-{{ ai_gen_id }} {
    display: none;
  }

  .ai-responsive-image-mobile-{{ ai_gen_id }} {
    display: block;
  }

  @media screen and (min-width: 750px) {
    .ai-responsive-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }

    .ai-responsive-image-desktop-{{ ai_gen_id }} {
      display: block;
    }

    .ai-responsive-image-mobile-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div
  class="ai-responsive-image-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-responsive-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.link_url != blank %}
      <a
        href="{{ block.settings.link_url }}"
        class="ai-responsive-image-link-{{ ai_gen_id }}"
      >
        {% if block.settings.image_desktop %}
          <div class="ai-responsive-image-desktop-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
              alt="{{ block.settings.image_desktop.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_desktop.width }}"
              height="{{ block.settings.image_desktop.height }}"
              class="ai-responsive-image-img-{{ ai_gen_id }}"
            >
          </div>
        {% else %}
          <div class="ai-responsive-image-desktop-{{ ai_gen_id }}">
            <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
                PC用画像を追加してください
              </div>
            </div>
          </div>
        {% endif %}

        {% if block.settings.image_mobile %}
          <div class="ai-responsive-image-mobile-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
              alt="{{ block.settings.image_mobile.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_mobile.width }}"
              height="{{ block.settings.image_mobile.height }}"
              class="ai-responsive-image-img-{{ ai_gen_id }}"
            >
          </div>
        {% else %}
          <div class="ai-responsive-image-mobile-{{ ai_gen_id }}">
            <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
                SP用画像を追加してください
              </div>
            </div>
          </div>
        {% endif %}
      </a>
    {% else %}
      {% if block.settings.image_desktop %}
        <div class="ai-responsive-image-desktop-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
            alt="{{ block.settings.image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_desktop.width }}"
            height="{{ block.settings.image_desktop.height }}"
            class="ai-responsive-image-img-{{ ai_gen_id }}"
          >
        </div>
      {% else %}
        <div class="ai-responsive-image-desktop-{{ ai_gen_id }}">
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
              PC用画像を追加してください
            </div>
          </div>
        </div>
      {% endif %}

      {% if block.settings.image_mobile %}
        <div class="ai-responsive-image-mobile-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
            alt="{{ block.settings.image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_mobile.width }}"
            height="{{ block.settings.image_mobile.height }}"
            class="ai-responsive-image-img-{{ ai_gen_id }}"
          >
        </div>
      {% else %}
        <div class="ai-responsive-image-mobile-{{ ai_gen_id }}">
          <div class="ai-responsive-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-responsive-image-empty-state-{{ ai_gen_id }}">
              SP用画像を追加してください
            </div>
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Responsive image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "PC用画像"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "SP用画像"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "リンク先URL"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "PC表示幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_width_percent",
      "label": "SP表示幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Responsive image"
    }
  ]
}
{% endschema %}