{% doc %}
  @prompt
    セッションとセッションの間にスペースが欲しい
    SPで綺麗に見えるような横線が欲しい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-divider-line-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    border: none;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-divider-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing_top_mobile }}px 0 {{ block.settings.spacing_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-divider-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "区切り線",
  "settings": [
    {
      "type": "header",
      "content": "線のスタイル"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "線の太さ",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "線の色",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "スペース（デスクトップ）"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "上のスペース",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "下のスペース",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "スペース（モバイル）"
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "上のスペース",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "label": "下のスペース",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "区切り線"
    }
  ]
}
{% endschema %}
