{% doc %}
  @prompt
    画像とテキストを横並びにし、スマートフォンでは順序変更ができるブロック。画像サイズ、余白、本文行間を調整でき、本文下にリンクボタンを追加して背景色と文字色を変更可能にする。
    
    テキストも余白をつけて
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }
  .ai-image-text-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, {{ block.settings.image_width_percent }}fr) minmax(0, {{ 100 | minus: block.settings.image_width_percent }}fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }
  .ai-image-text-{{ ai_gen_id }}__media { width: 100%; overflow: hidden; }
  .ai-image-text-{{ ai_gen_id }}__media img {
    display: block;
    width: 100%;
    height: auto;
    max-height: {{ block.settings.image_max_height }}px;
    object-fit: {{ block.settings.image_fit }};
  }
  .ai-image-text-{{ ai_gen_id }}__placeholder {
    width: 100%; aspect-ratio: 4 / 3; background: #f1f0ee; position: relative;
    display: grid; place-items: center;
  }
  .ai-image-text-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; color: #77736e; }
  .ai-image-text-{{ ai_gen_id }}__empty {
    position: absolute; bottom: 12px; left: 12px; right: 12px; color: #45413d; text-align: center; font-size: 13px;
  }
  .ai-image-text-{{ ai_gen_id }}__content { min-width: 0; padding: {{ block.settings.text_padding }}px; }
  .ai-image-text-{{ ai_gen_id }}__heading {
    margin: 0 0 16px; font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    font-weight: {{ settings.heading_font.weight }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.25;
    color: {{ block.settings.text_color }};
  }
  .ai-image-text-{{ ai_gen_id }}__body {
    color: {{ block.settings.text_color }}; font-family: {{ settings.text_font.family }}, {{ settings.text_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px; line-height: {{ block.settings.body_line_height | divided_by: 10.0 }};
  }
  .ai-image-text-{{ ai_gen_id }}__body > :first-child { margin-top: 0; }
  .ai-image-text-{{ ai_gen_id }}__body > :last-child { margin-bottom: 0; }
  .ai-image-text-{{ ai_gen_id }}__button {
    display: inline-flex; justify-content: center; align-items: center; margin-top: 24px; padding: 13px 24px; min-height: 48px;
    background: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_background }}; text-decoration: none; font-size: 13px;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ai-image-text-{{ ai_gen_id }}__button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-image-text-{{ ai_gen_id }} { width: 100%; }
    .ai-image-text-{{ ai_gen_id }}__inner { grid-template-columns: minmax(0, 1fr); gap: {{ block.settings.mobile_gap }}px; }
    .ai-image-text-{{ ai_gen_id }}__media { order: {% if block.settings.mobile_order == 'text_first' %}2{% else %}1{% endif %}; }
    .ai-image-text-{{ ai_gen_id }}__content { order: {% if block.settings.mobile_order == 'text_first' %}1{% else %}2{% endif %}; }
    .ai-image-text-{{ ai_gen_id }}__media img { max-height: none; }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-{{ ai_gen_id }}__inner">
    <div class="ai-image-text-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-image-text-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-text-{{ ai_gen_id }}__empty">画像を設定してください</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-image-text-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}<h2 class="ai-image-text-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-image-text-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-image-text-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "画像とテキスト",
  "settings": [
    { "type": "header", "content": "コンテンツ" },
    { "type": "image_picker", "id": "image", "label": "画像" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "素材と向き合う、静かな心地よさ" },
    { "type": "richtext", "id": "body", "label": "本文", "default": "<p>日々に寄り添う上質な素材と、長く愛せるデザインをお届けします。</p>" },
    { "type": "text", "id": "button_label", "label": "ボタンのテキスト", "default": "詳しく見る" },
    { "type": "url", "id": "button_link", "label": "ボタンのリンク" },
    { "type": "header", "content": "レイアウト" },
    { "type": "range", "id": "desktop_width_percent", "label": "デスクトップ幅", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_width_percent", "label": "画像の幅比率", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "select", "id": "mobile_order", "label": "スマートフォンの順序", "options": [{ "value": "image_first", "label": "画像を先に" }, { "value": "text_first", "label": "テキストを先に" }], "default": "image_first" },
    { "type": "range", "id": "image_max_height", "label": "画像の最大高さ", "min": 200, "max": 900, "step": 50, "unit": "px", "default": 600 },
    { "type": "select", "id": "image_fit", "label": "画像の表示方法", "options": [{ "value": "cover", "label": "トリミング" }, { "value": "contain", "label": "全体を表示" }], "default": "cover" },
    { "type": "range", "id": "column_gap", "label": "デスクトップの間隔", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_gap", "label": "スマートフォンの間隔", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "text_padding", "label": "テキストの余白", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 25 },
    { "type": "header", "content": "テキストとボタン" },
    { "type": "range", "id": "heading_size", "label": "見出しサイズ", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "body_size", "label": "本文サイズ", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "body_line_height", "label": "本文の行間", "min": 12, "max": 24, "step": 1, "unit": "0.1", "default": 18 },
    { "type": "color", "id": "text_color", "label": "テキスト色", "default": "#1C1C1C" },
    { "type": "color", "id": "button_background", "label": "ボタンの背景色", "default": "#1C1C1C" },
    { "type": "color", "id": "button_text_color", "label": "ボタンの文字色", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "画像とテキスト" }],
  "tag": null,
  "class": "image-text-block"
}
{% endschema %}