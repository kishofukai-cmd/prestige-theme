{% doc %}
  @prompt
    ボタンを設置したい。
    カラーとエフェクトを選べるようにして, 横幅は文字サイズに合わせて可変するようにして, ボタン配置を真ん中にしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-block-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; }
  .ai-button-block-{{ ai_gen_id }}__link { position: relative; isolation: isolate; display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: max-content; max-width: 100%; padding: 15px 28px; overflow: hidden; border: 1px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.border_radius }}px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; font-family: {{ block.settings.text_font.family }}; font-size: 14px; font-weight: 500; letter-spacing: {{ block.settings.letter_spacing }}%; line-height: 1.2; text-align: center; text-decoration: none; text-transform: {{ block.settings.text_transform }}; transition: color 220ms ease, background-color 220ms ease, border-color 220ms ease, transform 220ms ease; }
  .ai-button-block-{{ ai_gen_id }}__label, .ai-button-block-{{ ai_gen_id }}__icon { position: relative; z-index: 2; }
  .ai-button-block-{{ ai_gen_id }}__icon { display: inline-flex; transition: transform 220ms ease; }
  .ai-button-block-{{ ai_gen_id }}__link--slide::before, .ai-button-block-{{ ai_gen_id }}__link--shine::before { position: absolute; z-index: 1; content: ''; pointer-events: none; }
  .ai-button-block-{{ ai_gen_id }}__link--slide::before { inset: 0; background: {{ block.settings.hover_color }}; transform: translateX(-102%); transition: transform 260ms ease; }
  .ai-button-block-{{ ai_gen_id }}__link--shine::before { top: 0; left: -80%; width: 45%; height: 100%; background: linear-gradient(105deg, transparent, rgba(255,255,255,.42), transparent); transform: skewX(-18deg); transition: left 500ms ease; }
  .ai-button-block-{{ ai_gen_id }}__link:hover, .ai-button-block-{{ ai_gen_id }}__link:focus-visible { background: {{ block.settings.hover_color }}; border-color: {{ block.settings.hover_color }}; color: {{ block.settings.hover_text_color }}; }
  .ai-button-block-{{ ai_gen_id }}__link--slide:hover::before, .ai-button-block-{{ ai_gen_id }}__link--slide:focus-visible::before { transform: translateX(0); }
  .ai-button-block-{{ ai_gen_id }}__link--shine:hover::before, .ai-button-block-{{ ai_gen_id }}__link--shine:focus-visible::before { left: 125%; }
  .ai-button-block-{{ ai_gen_id }}__link:hover .ai-button-block-{{ ai_gen_id }}__icon, .ai-button-block-{{ ai_gen_id }}__link:focus-visible .ai-button-block-{{ ai_gen_id }}__icon { transform: translateX(3px); }
  .ai-button-block-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  @media screen and (max-width: 749px) { .ai-button-block-{{ ai_gen_id }} { width: 100%; } .ai-button-block-{{ ai_gen_id }}__link { max-width: 100%; } }
{% endstyle %}

<div class="ai-button-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a class="ai-button-block-{{ ai_gen_id }}__link ai-button-block-{{ ai_gen_id }}__link--{{ block.settings.effect }}" href="{{ block.settings.button_link | default: '#' }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <span class="ai-button-block-{{ ai_gen_id }}__label">{{ block.settings.button_label }}</span>
    {% if block.settings.show_arrow %}<span class="ai-button-block-{{ ai_gen_id }}__icon" aria-hidden="true">→</span>{% endif %}
  </a>
</div>

{% schema %}
{
  "name": "Button",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Label", "default": "詳細を見る" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in new tab", "default": false },
    { "type": "checkbox", "id": "show_arrow", "label": "Show arrow", "default": true },
    { "type": "select", "id": "effect", "label": "Effect", "options": [{ "value": "none", "label": "None" }, { "value": "slide", "label": "Slide" }, { "value": "shine", "label": "Shine" }], "default": "slide" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1c1c1c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#1c1c1c" },
    { "type": "color", "id": "hover_color", "label": "Hover background", "default": "#04358d" },
    { "type": "color", "id": "hover_text_color", "label": "Hover text", "default": "#ffffff" },
    { "type": "range", "id": "border_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "select", "id": "text_transform", "label": "Text case", "options": [{ "value": "normal", "label": "Normal" }, { "value": "uppercase", "label": "Uppercase" }], "default": "normal" },
    { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 8 },
    { "type": "font_picker", "id": "text_font", "label": "Font", "default": "helvetica_n4" }
  ],
  "presets": [{ "name": "Button" }],
  "tag": null,
  "class": "button-block"
}
{% endschema %}