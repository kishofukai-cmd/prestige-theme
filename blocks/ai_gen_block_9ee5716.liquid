{% doc %}
  @prompt
    商品売上ランキング作りたいからそのブロックと3つ分の商品リンク用のボタンを設定して調整しやすいように作ってん, ボタンが設定されてるけど、それはいらない。普通に商品画像や商品名触ったら遷移するように設定してくれ
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ranking-container-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-ranking-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: {{ block.settings.title_alignment }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
  }

  .ai-ranking-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-ranking-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .ai-ranking-item-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
  }

  .ai-ranking-badge-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    border-radius: 50%;
    color: {{ block.settings.badge_text_color }};
  }

  .ai-ranking-badge-{{ ai_gen_id }}--1 {
    background-color: {{ block.settings.badge_color_1 }};
  }

  .ai-ranking-badge-{{ ai_gen_id }}--2 {
    background-color: {{ block.settings.badge_color_2 }};
  }

  .ai-ranking-badge-{{ ai_gen_id }}--3 {
    background-color: {{ block.settings.badge_color_3 }};
  }

  .ai-ranking-product-image-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-ranking-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ranking-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ranking-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-ranking-product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-ranking-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 {{ block.settings.title_price_gap }}px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-ranking-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-ranking-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-ranking-item-{{ ai_gen_id }} {
      gap: {{ block.settings.content_gap | times: 0.7 }}px;
      padding: {{ block.settings.item_padding | times: 0.7 }}px;
    }

    .ai-ranking-badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.8 }}px;
      height: {{ block.settings.badge_size | times: 0.8 }}px;
      font-size: {{ block.settings.badge_font_size | times: 0.8 }}px;
    }

    .ai-ranking-product-image-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-ranking-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }

    .ai-ranking-product-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_price_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-ranking-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-ranking-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-ranking-list-{{ ai_gen_id }}">
    {% liquid
      assign has_any_product = false
      for i in (1..3)
        assign product_key = 'product_' | append: i
        if block.settings[product_key] != blank
          assign has_any_product = true
          break
        endif
      endfor
    %}

    {% if has_any_product %}
      {% for i in (1..3) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        {% if product != blank %}
          <a href="{{ product.url }}" class="ai-ranking-item-{{ ai_gen_id }}">
            <div class="ai-ranking-badge-{{ ai_gen_id }} ai-ranking-badge-{{ ai_gen_id }}--{{ i }}">
              {{ i }}
            </div>

            <div class="ai-ranking-product-image-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 200 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="200"
                  height="200"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-ranking-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-ranking-product-info-{{ ai_gen_id }}">
              <h3 class="ai-ranking-product-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>
              <div class="ai-ranking-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-ranking-empty-state-{{ ai_gen_id }}">
        商品を選択してランキングを作成してください
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
