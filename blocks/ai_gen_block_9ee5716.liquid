      "id": "title_alignment",
      "label": "タイトル配置",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中央"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "タイトル下の余白",
      "default": 30
    },
    {
      "type": "header",
      "content": "1位の商品"
    },
    {
      "type": "product",
