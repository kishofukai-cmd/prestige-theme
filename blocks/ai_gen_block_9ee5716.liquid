    },
    {
      "type": "product",
      "id": "product_2",
      "label": "商品"
    },
    {
      "type": "header",
      "content": "3位の商品"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "商品"
    },
    {
      "type": "header",
      "content": "ランキングバッジ"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "バッジサイズ",
      "default": 50
    },
    {
      "type": "range",
