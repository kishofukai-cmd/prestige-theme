{% doc %}
  @prompt
    1枚大きい画像を見せて、その下に4つ画像を差し込んで横2つ、縦列2つでSPは見れるようにしたい, PCビューはサイズが大きすぎるから、サイドの余白設定ができるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding-left: {{ block.settings.desktop_padding_horizontal }}px;
    padding-right: {{ block.settings.desktop_padding_horizontal }}px;
  }

  .ai-image-gallery__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.desktop_max_width }}px;
    margin: 0 auto;
  }

  .ai-image-gallery__main-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-image-gallery__main-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery__main-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
  }

  .ai-image-gallery__main-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-gallery__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-image-gallery__grid-item-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-image-gallery__grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: 1 / 1;
  }

  .ai-image-gallery__grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-gallery__grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  @media screen and (max-width: 749px) {
    .ai-image-gallery-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_padding_horizontal }}px;
      padding-right: {{ block.settings.mobile_padding_horizontal }}px;
    }
  }
{% endstyle %}

<div class="ai-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-gallery__container-{{ ai_gen_id }}">
    <div class="ai-image-gallery__main-{{ ai_gen_id }}">
      {% if block.settings.main_image %}
        <img
          src="{{ block.settings.main_image | image_url: width: 2000 }}"
          alt="{{ block.settings.main_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.main_image.width }}"
          height="{{ block.settings.main_image.height }}"
          class="ai-image-gallery__main-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-gallery__main-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
            Add main image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-gallery__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'grid_image_' | append: i
          assign grid_image = block.settings[image_key]
        %}
        <div class="ai-image-gallery__grid-item-{{ ai_gen_id }}">
          {% if grid_image %}
            <img
              src="{{ grid_image | image_url: width: 800 }}"
              alt="{{ grid_image.alt | escape }}"
              loading="lazy"
              width="{{ grid_image.width }}"
              height="{{ grid_image.height }}"
              class="ai-image-gallery__grid-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-image-gallery__grid-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image gallery",
  "settings": [
    {
      "type": "header",
      "content": "Main image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image"
    },
    {
      "type": "header",
      "content": "Grid images"
    },
    {
      "type": "image_picker",
      "id": "grid_image_1",
      "label": "Grid image 1"
    },
    {
      "type": "image_picker",
      "id": "grid_image_2",
      "label": "Grid image 2"
    },
    {
      "type": "image_picker",
      "id": "grid_image_3",
      "label": "Grid image 3"
    },
    {
      "type": "image_picker",
      "id": "grid_image_4",
      "label": "Grid image 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_max_width",
      "label": "Desktop max width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "desktop_padding_horizontal",
      "label": "Desktop side padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "Mobile side padding",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image gallery"
    }
  ]
}
{% endschema %}
