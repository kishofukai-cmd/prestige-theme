{% doc %}
  @prompt
    タイトルとテキストを書いて行きたい。
    横に二つ並びで、SPは縦並び。
    
    テキストの長さが違うから、続きを読むとしたら全文開くようにして統一したい。
    
    タイトルとテキストで一つにして、どんどん追加できるようにして。
    
    あと文字サイズや文字色をつけれるようにして。
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-columns-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-text-columns__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-text-columns__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }
  }

  .ai-text-columns__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_background_color }};
    padding: {{ block.settings.item_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-text-columns__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: 600;
  }

  .ai-text-columns__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-text-columns__text-{{ ai_gen_id }}.is-truncated {
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.preview_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-text-columns__toggle-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.button_color }};
    cursor: pointer;
    padding: 0;
    margin-top: {{ block.settings.button_spacing }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: underline;
  }

  .ai-text-columns__toggle-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_color }};
  }
{% endstyle %}

<text-columns-{{ ai_gen_id }} class="ai-text-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-columns__container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign title_key = 'title_' | append: i
        assign text_key = 'text_' | append: i
        assign enabled_key = 'item_' | append: i | append: '_enabled'
        
        assign title = block.settings[title_key]
        assign text = block.settings[text_key]
        assign enabled = block.settings[enabled_key]
      %}

      {% if enabled %}
        <div class="ai-text-columns__item-{{ ai_gen_id }}" data-item-id="{{ i }}">
          {% if title != blank %}
            <h3 class="ai-text-columns__title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}

          {% if text != blank %}
            <div class="ai-text-columns__text-{{ ai_gen_id }} is-truncated" data-text-content>
              {{ text }}
            </div>
            <button class="ai-text-columns__toggle-{{ ai_gen_id }}" data-toggle-button aria-expanded="false">
              {{ block.settings.read_more_text }}
            </button>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</text-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class TextColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-item-id]');
        this.setupToggleButtons();
      }

      setupToggleButtons() {
        this.items.forEach((item) => {
          const textContent = item.querySelector('[data-text-content]');
          const toggleButton = item.querySelector('[data-toggle-button]');

          if (!textContent || !toggleButton) return;

          const readMoreText = toggleButton.textContent;
          const readLessText = '閉じる';

          toggleButton.addEventListener('click', () => {
            const isExpanded = toggleButton.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
              textContent.classList.add('is-truncated');
              toggleButton.setAttribute('aria-expanded', 'false');
              toggleButton.textContent = readMoreText;
            } else {
              textContent.classList.remove('is-truncated');
              toggleButton.setAttribute('aria-expanded', 'true');
              toggleButton.textContent = readLessText;
            }
          });
        });
      }
    }

    customElements.define('text-columns-{{ ai_gen_id }}', TextColumns{{ ai_gen_id }});
  })();
</script>

