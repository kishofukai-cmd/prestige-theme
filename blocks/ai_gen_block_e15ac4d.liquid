{% doc %}
  @prompt
    4つのコレクションを入れたい。, 画像もつけたい。PCでは4つ横並び、スマホは2列にしたい。, PCとスマホで画像を変えたい。
    あとスマホビューは縦に4つ並びに変更, PCビューは1040×1040
    スマホビューは1000×1750サイズの画像が綺麗に入るようにして, スマホビューの画像が綺麗に入ってない。, スマホビューは縦長ではなくて横長ね, コレクショングリットの上下にマージンを調整できるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-collection-grid__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    padding-top: 100%;
  }

  .ai-collection-grid__image-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-grid__image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-collection-grid__link-{{ ai_gen_id }}:hover .ai-collection-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid__empty-message-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    white-space: nowrap;
  }

  .ai-collection-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.title_color }};
    text-transform: {{ block.settings.title_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }} {
      margin-top: {{ block.settings.margin_top | times: 0.7 }}px;
      margin-bottom: {{ block.settings.margin_bottom | times: 0.7 }}px;
    }

    .ai-collection-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 0.7 }}px;
    }

    .ai-collection-grid__image-wrapper-{{ ai_gen_id }}::before {
      padding-top: 57%;
    }

    .ai-collection-grid__image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-grid__image-mobile-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .ai-collection-grid__link-{{ ai_gen_id }}:hover .ai-collection-grid__image-mobile-{{ ai_gen_id }} {
      transform: scale(1.05);
    }

    .ai-collection-grid__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px;
    }

    .ai-collection-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign image_desktop_key = 'image_desktop_' | append: i
        assign image_mobile_key = 'image_mobile_' | append: i
        assign title_key = 'title_' | append: i
        assign link_key = 'link_' | append: i
        assign image_desktop = block.settings[image_desktop_key]
        assign image_mobile = block.settings[image_mobile_key]
        assign title = block.settings[title_key]
        assign link = block.settings[link_key]
      %}

      <div class="ai-collection-grid__item-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-collection-grid__link-{{ ai_gen_id }}">
        {% else %}
          <div class="ai-collection-grid__link-{{ ai_gen_id }}">
        {% endif %}

          <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
            <div class="ai-collection-grid__image-container-{{ ai_gen_id }}">
              {% if image_desktop %}
                <img
                  src="{{ image_desktop | image_url: width: 1200 }}"
                  alt="{{ image_desktop.alt | escape }}"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ image_desktop.width }}"
                  height="{{ image_desktop.height }}"
                >
              {% else %}
                <div class="ai-collection-grid__placeholder-{{ ai_gen_id }} ai-collection-grid__image-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                  <div class="ai-collection-grid__empty-message-{{ ai_gen_id }}">
                    PC画像を追加 (1040×1040)
                  </div>
                </div>
              {% endif %}

              {% if image_mobile %}
                <img
                  src="{{ image_mobile | image_url: width: 1200 }}"
                  alt="{{ image_mobile.alt | escape }}"
                  class="ai-collection-grid__image-mobile-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ image_mobile.width }}"
                  height="{{ image_mobile.height }}"
                >
              {% elsif image_desktop %}
                <img
                  src="{{ image_desktop | image_url: width: 1200 }}"
                  alt="{{ image_desktop.alt | escape }}"
                  class="ai-collection-grid__image-mobile-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ image_desktop.width }}"
                  height="{{ image_desktop.height }}"
                >
              {% else %}
                <div class="ai-collection-grid__placeholder-{{ ai_gen_id }} ai-collection-grid__image-mobile-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                  <div class="ai-collection-grid__empty-message-{{ ai_gen_id }}">
                    スマホ画像を追加 (1000×570)
                  </div>
                </div>
              {% endif %}
            </div>
          </div>

          {% if block.settings.show_titles and title != blank %}
            <div class="ai-collection-grid__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                {{ title }}
              </h3>
            </div>
          {% endif %}

        {% if link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeGrid();
      }

      initializeGrid() {
        const items = this.querySelectorAll('.ai-collection-grid__item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

