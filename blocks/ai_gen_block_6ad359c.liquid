{% doc %}
  @prompt
    商品売上ランキング作りたいからそのブロックと3つ分の商品リンク用のボタンを設定して調整しやすいように作ってん, ボタンが設定されてるけど、それはいらない。普通に商品画像や商品名触ったら遷移するように設定してくれ
    商品画像は見やすく長方形で表示したい, さらにカルーセルにして6位までだしたい
    スマホで見やすくして, top5位に変更したい, 画像サイズ3 : 4（縦長）にしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-ranking-{{ ai_gen_id }} {
    padding: 40px 0;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-product-ranking__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-ranking__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-product-ranking__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-product-ranking__carousel-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 20px;
  }

  .ai-product-ranking__carousel-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-product-ranking__item-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    flex: 0 0 calc(33.333% - {{ block.settings.grid_gap | times: 0.666 }}px);
    transition: transform 0.3s ease;
  }

  .ai-product-ranking__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-product-ranking__rank-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: {{ block.settings.badge_size | times: 0.5 }}px;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-product-ranking__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 133%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-product-ranking__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-ranking__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-ranking__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-ranking__info-{{ ai_gen_id }} {
    padding: 16px 0;
  }

  .ai-product-ranking__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-product-ranking__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 500;
  }

  .ai-product-ranking__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-product-ranking__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .ai-product-ranking__nav-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-product-ranking__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-product-ranking__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-product-ranking__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-product-ranking__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-product-ranking__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-product-ranking__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-product-ranking__item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.grid_gap | times: 0.5 }}px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-ranking-{{ ai_gen_id }} {
      padding: 30px 0;
    }

    .ai-product-ranking__container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-product-ranking__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
      margin-bottom: 24px;
    }

    .ai-product-ranking__carousel-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }

    .ai-product-ranking__item-{{ ai_gen_id }} {
      flex: 0 0 calc(75% - {{ block.settings.grid_gap | times: 0.3 }}px);
    }

    .ai-product-ranking__rank-badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.8 }}px;
      height: {{ block.settings.badge_size | times: 0.8 }}px;
      font-size: {{ block.settings.badge_size | times: 0.4 }}px;
      top: 8px;
      left: 8px;
    }

    .ai-product-ranking__product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.product_title_size | times: 0.9 }}px;
    }

    .ai-product-ranking__product-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.9 }}px;
    }

    .ai-product-ranking__nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<product-ranking-carousel-{{ ai_gen_id }} class="ai-product-ranking-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-ranking__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-product-ranking__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-product-ranking__carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-product-ranking__carousel-{{ ai_gen_id }}" data-carousel>
        {% for i in (1..5) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
          %}

          {% if product != blank %}
            <a href="{{ product.url }}" class="ai-product-ranking__item-{{ ai_gen_id }}">
              <div class="ai-product-ranking__rank-badge-{{ ai_gen_id }}">{{ i }}</div>
              
              <div class="ai-product-ranking__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-product-ranking__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                  >
                {% else %}
                  <div class="ai-product-ranking__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-product-ranking__info-{{ ai_gen_id }}">
                <h3 class="ai-product-ranking__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <div class="ai-product-ranking__product-price-{{ ai_gen_id }}">
                  {{ product.price | money }}
                </div>
              </div>
            </a>
          {% else %}
            <div class="ai-product-ranking__item-{{ ai_gen_id }}">
              <div class="ai-product-ranking__rank-badge-{{ ai_gen_id }}">{{ i }}</div>
              
              <div class="ai-product-ranking__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-product-ranking__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                  <div class="ai-product-ranking__empty-state-{{ ai_gen_id }}">
                    商品を選択
                  </div>
                </div>
              </div>

              <div class="ai-product-ranking__info-{{ ai_gen_id }}">
                <h3 class="ai-product-ranking__product-title-{{ ai_gen_id }}">商品名</h3>
                <div class="ai-product-ranking__product-price-{{ ai_gen_id }}">¥0</div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-product-ranking__nav-{{ ai_gen_id }}">
        <button class="ai-product-ranking__nav-button-{{ ai_gen_id }}" data-prev aria-label="前へ">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-product-ranking__nav-button-{{ ai_gen_id }}" data-next aria-label="次へ">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <div class="ai-product-ranking__dots-{{ ai_gen_id }}" data-dots></div>
    </div>
  </div>
</product-ranking-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductRankingCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carousel = this.querySelector('[data-carousel]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.items = this.querySelectorAll('.ai-product-ranking__item-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.itemsPerView = this.getItemsPerView();
      }

      connectedCallback() {
        this.createDots();
        this.updateButtons();
        this.setupEventListeners();
        window.addEventListener('resize', () => {
          this.itemsPerView = this.getItemsPerView();
          this.createDots();
          this.updateButtons();
        });
      }

      getItemsPerView() {
        if (window.innerWidth <= 749) {
          return 1;
        } else if (window.innerWidth <= 989) {
          return 2;
        } else {
          return 3;
        }
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.ceil(this.items.length / this.itemsPerView);
        
        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('div');
          dot.className = 'ai-product-ranking__dot-{{ ai_gen_id }}';
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }

        this.carousel.addEventListener('scroll', () => {
          this.updateDotsOnScroll();
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.scrollToIndex(this.currentIndex);
        }
      }

      next() {
        const maxIndex = Math.ceil(this.items.length / this.itemsPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.scrollToIndex(this.currentIndex);
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.scrollToIndex(index);
      }

      scrollToIndex(index) {
        const itemWidth = this.items[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.carousel).gap) || 0;
        const scrollPosition = index * this.itemsPerView * (itemWidth + gap);
        this.carousel.scrollTo({
          left: scrollPosition,
          behavior: 'smooth'
        });
        this.updateButtons();
        this.updateDots();
      }

      updateDotsOnScroll() {
        const scrollLeft = this.carousel.scrollLeft;
        const itemWidth = this.items[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.carousel).gap) || 0;
        const newIndex = Math.round(scrollLeft / (this.itemsPerView * (itemWidth + gap)));
        
        if (newIndex !== this.currentIndex) {
          this.currentIndex = newIndex;
          this.updateDots();
          this.updateButtons();
        }
      }

      updateButtons() {
        if (!this.prevButton || !this.nextButton) return;
        
        const maxIndex = Math.ceil(this.items.length / this.itemsPerView) - 1;
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      updateDots() {
        const dots = this.dotsContainer.querySelectorAll('.ai-product-ranking__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('product-ranking-carousel-{{ ai_gen_id }}', ProductRankingCarousel{{ ai_gen_id }});
  })();
</script>

