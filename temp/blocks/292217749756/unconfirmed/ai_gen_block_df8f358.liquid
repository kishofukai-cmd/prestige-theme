{% doc %}
  @prompt
    3つのコレクションページがカルーセルで出るようにしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-collection-carousel__wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    min-width: 0;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background_color }};
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel__card-{{ ai_gen_id }}:hover .ai-collection-carousel__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-collection-carousel__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    color: {{ block.settings.title_color }};
  }

  .ai-collection-carousel__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-collection-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} {
    width: {{ block.settings.button_size }}px;
    height: {{ block.settings.button_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.button_icon_color }};
    transition: background-color 0.3s ease;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-collection-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-collection-carousel__button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.button_size }}px * 0.5);
    height: calc({{ block.settings.button_size }}px * 0.5);
  }

  .ai-collection-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-collection-carousel__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .ai-collection-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-collection-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.9);
    }

    .ai-collection-carousel__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign collection_1 = block.settings.collection_1
    assign collection_2 = block.settings.collection_2
    assign collection_3 = block.settings.collection_3
    assign has_collections = false

    if collection_1 != blank or collection_2 != blank or collection_3 != blank
      assign has_collections = true
    endif
  %}

  {% if has_collections %}
    <div class="ai-collection-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}

          {% if collection != blank %}
            <div class="ai-collection-carousel__slide-{{ ai_gen_id }}">
              <a
                href="{{ collection.url }}"
                class="ai-collection-carousel__card-{{ ai_gen_id }}"
              >
                <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
                  {% if collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 1200 }}"
                      alt="{{ collection.image.alt | escape }}"
                      loading="lazy"
                      width="{{ collection.image.width }}"
                      height="{{ collection.image.height }}"
                      class="ai-collection-carousel__image-{{ ai_gen_id }}"
                    >
                  {% elsif collection.products.first and collection.products.first.featured_image %}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 1200 }}"
                      alt="{{ collection.products.first.featured_image.alt | escape }}"
                      loading="lazy"
                      width="{{ collection.products.first.featured_image.width }}"
                      height="{{ collection.products.first.featured_image.height }}"
                      class="ai-collection-carousel__image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-collection-carousel__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                {% if block.settings.show_content %}
                  <div class="ai-collection-carousel__content-{{ ai_gen_id }}">
                    <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">
                      {{ collection.title }}
                    </h3>
                    {% if block.settings.show_description and collection.description != blank %}
                      <p class="ai-collection-carousel__description-{{ ai_gen_id }}">
                        {{ collection.description | strip_html | truncate: 100 }}
                      </p>
                    {% endif %}
                  </div>
                {% endif %}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-collection-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-collection-carousel__button-{{ ai_gen_id }} ai-collection-carousel__prev-{{ ai_gen_id }}"
        aria-label="前のコレクション"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-collection-carousel__dots-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}
          {% if collection != blank %}
            <button
              class="ai-collection-carousel__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="コレクション {{ forloop.index }}"
            ></button>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-collection-carousel__button-{{ ai_gen_id }} ai-collection-carousel__next-{{ ai_gen_id }}"
        aria-label="次のコレクション"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% else %}
    <div class="ai-collection-carousel__empty-state-{{ ai_gen_id }}">
      3つのコレクションを選択してください
    </div>
  {% endif %}
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-collection-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-collection-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-collection-carousel__next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-collection-carousel__dot-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.setupEventListeners();
        this.updateCarousel();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        {% if block.settings.autoplay %}
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        {% endif %}
      }

      prev() {
        this.currentIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.slides.length - 1;
        this.updateCarousel();
      }

      next() {
        this.currentIndex = this.currentIndex < this.slides.length - 1 ? this.currentIndex + 1 : 0;
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      updateCarousel() {
        const offset = -this.currentIndex * 100;
        this.track.style.transform = `translateX(${offset}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.prevButton.disabled = false;
        this.nextButton.disabled = false;
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, {{ block.settings.autoplay_speed | times: 1000 }});
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection carousel",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
