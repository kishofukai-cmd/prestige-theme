{% doc %}
  @prompt
    3つのコレクションページがカルーセルで出るようにしたい, 正方形画像を配置
    そこの遷移先がコレクション
    SPで見ても見栄えばいいように
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.card_background }};
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-grid__item-{{ ai_gen_id }}:hover .ai-collection-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: {{ block.settings.overlay_background }};
    color: {{ block.settings.overlay_text_color }};
    transition: opacity 0.3s ease;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-grid__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 14px;
    grid-column: 1 / -1;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-collection-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-collection-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% liquid
      assign has_any_collection = false
      for i in (1..block.settings.collection_count)
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
        if collection != blank
          assign has_any_collection = true
          break
        endif
      endfor
    %}

    {% if has_any_collection %}
      {% for i in (1..block.settings.collection_count) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-grid__item-{{ ai_gen_id }}"
          >
            <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="{{ collection.image.width }}"
                  height="{{ collection.image.height }}"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                >
              {% elsif collection.products.first and collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.products.first.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ collection.products.first.featured_image.width }}"
                  height="{{ collection.products.first.featured_image.height }}"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_title %}
                <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
                  <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                    {{ collection.title }}
                  </h3>
                </div>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      <div class="ai-collection-grid__empty-state-{{ ai_gen_id }}">
        コレクションを選択してください
      </div>
    {% endif %}
  </div>
</div>

