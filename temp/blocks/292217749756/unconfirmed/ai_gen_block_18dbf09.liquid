{% doc %}
  @prompt
    PCで見ると3つの正方形画像があり、その遷移先がコレクションページにしたい
    SPはカルーセルにしたい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-collection-grid__desktop-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid__mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-collection-grid__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    text-decoration: none;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-grid__link-{{ ai_gen_id }}:hover .ai-collection-grid__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.overlay_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.text_color }};
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-collection-grid__mobile-{{ ai_gen_id }} {
      display: block;
      position: relative;
      overflow: hidden;
    }

    .ai-collection-grid__carousel-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.grid_gap }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 10px;
    }

    .ai-collection-grid__carousel-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-collection-grid__carousel-item-{{ ai_gen_id }} {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }

    .ai-collection-grid__carousel-item-{{ ai_gen_id }} .ai-collection-grid__link-{{ ai_gen_id }} {
      padding-bottom: 100%;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__desktop-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        
        assign collection = block.settings[collection_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
      %}
      
      <div class="ai-collection-grid__item-{{ ai_gen_id }}">
        {% if collection %}
          <a href="{{ collection.url }}" class="ai-collection-grid__link-{{ ai_gen_id }}">
            <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                >
              {% elsif collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            {% if block.settings.show_overlay %}
              <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
                <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                  {% if title != blank %}
                    {{ title }}
                  {% else %}
                    {{ collection.title }}
                  {% endif %}
                </h3>
              </div>
            {% endif %}
          </a>
        {% else %}
          <div class="ai-collection-grid__link-{{ ai_gen_id }}">
            <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                  class="ai-collection-grid__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            {% if block.settings.show_overlay %}
              <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
                <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                  {% if title != blank %}
                    {{ title }}
                  {% else %}
                    コレクション {{ i }}
                  {% endif %}
                </h3>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-collection-grid__mobile-{{ ai_gen_id }}">
    <div class="ai-collection-grid__carousel-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign image_key = 'image_' | append: i
          assign title_key = 'title_' | append: i
          
          assign collection = block.settings[collection_key]
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
        %}
        
        <div class="ai-collection-grid__carousel-item-{{ ai_gen_id }}">
          <div class="ai-collection-grid__item-{{ ai_gen_id }}">
            {% if collection %}
              <a href="{{ collection.url }}" class="ai-collection-grid__link-{{ ai_gen_id }}">
                <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
                  {% if image %}
                    <img
                      src="{{ image | image_url: width: 800 }}"
                      alt="{{ image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="800"
                      class="ai-collection-grid__image-{{ ai_gen_id }}"
                    >
                  {% elsif collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 800 }}"
                      alt="{{ collection.image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="800"
                      class="ai-collection-grid__image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                
                {% if block.settings.show_overlay %}
                  <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
                    <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                      {% if title != blank %}
                        {{ title }}
                      {% else %}
                        {{ collection.title }}
                      {% endif %}
                    </h3>
                  </div>
                {% endif %}
              </a>
            {% else %}
              <div class="ai-collection-grid__link-{{ ai_gen_id }}">
                <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
                  {% if image %}
                    <img
                      src="{{ image | image_url: width: 800 }}"
                      alt="{{ image.alt | escape }}"
                      loading="lazy"
                      width="800"
                      height="800"
                      class="ai-collection-grid__image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                
                {% if block.settings.show_overlay %}
                  <div class="ai-collection-grid__overlay-{{ ai_gen_id }}">
                    <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">
                      {% if title != blank %}
                        {{ title }}
                      {% else %}
                        コレクション {{ i }}
                      {% endif %}
                    </h3>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</collection-grid-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Collection grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "画像間のスペース",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "コレクション 1"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "コレクション"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "タイトル"
    },
    {
      "type": "header",
      "content": "コレクション 2"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "コレクション"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "タイトル"
    },
    {
      "type": "header",
      "content": "コレクション 3"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "コレクション"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "タイトル"
    },
    {
      "type": "header",
      "content": "オーバーレイ"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "タイトルオーバーレイを表示",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "オーバーレイの透明度",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "type": "range",
      "id": "overlay_padding",
      "label": "オーバーレイの余白",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキストカラー",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
