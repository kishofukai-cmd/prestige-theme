      </div>
    {% endif %}

    {% if block.settings.item_3_enabled %}
      <div class="ai-editorial-item-{{ ai_gen_id }} ai-editorial-item-{{ ai_gen_id }}--{{ block.settings.item_3_size }}">
        <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.item_3_image %}
            <img
              src="{{ block.settings.item_3_image | image_url: width: 1200 }}"
              alt="{{ block.settings.item_3_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.item_3_image.width }}"
              height="{{ block.settings.item_3_image.height }}"
