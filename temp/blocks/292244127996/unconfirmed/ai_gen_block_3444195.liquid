              {% endif %}
              {% if block.settings.item_3_subtitle != blank %}
                <p class="ai-editorial-subtitle-{{ ai_gen_id }}">{{ block.settings.item_3_subtitle }}</p>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.item_3_link != blank %}
