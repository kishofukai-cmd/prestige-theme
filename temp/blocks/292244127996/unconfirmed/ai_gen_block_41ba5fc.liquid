{% doc %}
  @prompt
    KAPOK KNOTがギフトに選ばれる理由
    という表題で3つ挙げたい
    背景は薄いピンク
    01、左に正方形画像、右にタイトルと文言
    02、左に正方形画像、右にタイトルと文言
    03、左に正方形画像、右にタイトルと文言
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-reasons-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 40px;
  }

  .ai-gift-reasons__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-gift-reasons__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 50px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-gift-reasons__list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .ai-gift-reasons__item-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .ai-gift-reasons__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
  }

  .ai-gift-reasons__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gift-reasons__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gift-reasons__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-gift-reasons__content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-gift-reasons__number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    color: {{ block.settings.number_color }};
    margin: 0 0 10px;
    font-weight: 400;
  }

  .ai-gift-reasons__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-gift-reasons__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-gift-reasons-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-gift-reasons__heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-gift-reasons__item-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }

    .ai-gift-reasons__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-gift-reasons__number-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.8);
    }

    .ai-gift-reasons__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-gift-reasons__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-gift-reasons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gift-reasons__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-gift-reasons__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-gift-reasons__list-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'reason_' | append: i | append: '_image'
          assign title_key = 'reason_' | append: i | append: '_title'
          assign text_key = 'reason_' | append: i | append: '_text'

          assign reason_image = block.settings[image_key]
          assign reason_title = block.settings[title_key]
          assign reason_text = block.settings[text_key]
        %}

        <div class="ai-gift-reasons__item-{{ ai_gen_id }}">
          <div class="ai-gift-reasons__image-wrapper-{{ ai_gen_id }}">
            {% if reason_image %}
              <img
                src="{{ reason_image | image_url: width: 600 }}"
                alt="{{ reason_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-gift-reasons__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-gift-reasons__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-gift-reasons__content-{{ ai_gen_id }}">
            <div class="ai-gift-reasons__number-{{ ai_gen_id }}">0{{ i }}</div>
            {% if reason_title != blank %}
              <h3 class="ai-gift-reasons__title-{{ ai_gen_id }}">{{ reason_title }}</h3>
            {% endif %}
            {% if reason_text != blank %}
              <div class="ai-gift-reasons__text-{{ ai_gen_id }}">{{ reason_text }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KAPOK KNOTがギフトに選ばれる理由",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "KAPOK KNOTがギフトに選ばれる理由"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "理由 1"
    },
    {
      "type": "image_picker",
      "id": "reason_1_image",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "reason_1_title",
      "label": "タイトル",
      "default": "高品質な素材"
    },
    {
      "type": "textarea",
      "id": "reason_1_text",
      "label": "説明文",
      "default": "厳選された上質な素材を使用し、長く愛用いただける製品をお届けします。"
    },
    {
      "type": "header",
      "content": "理由 2"
    },
    {
      "type": "image_picker",
      "id": "reason_2_image",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "reason_2_title",
      "label": "タイトル",
      "default": "洗練されたデザイン"
    },
    {
      "type": "textarea",
      "id": "reason_2_text",
      "label": "説明文",
      "default": "シンプルで洗練されたデザインは、どんなシーンにもマッチします。"
    },
    {
      "type": "header",
      "content": "理由 3"
    },
    {
      "type": "image_picker",
      "id": "reason_3_image",
      "label": "画像"
    },
    {
      "type": "text",
      "id": "reason_3_title",
      "label": "タイトル",
      "default": "心を込めたギフト包装"
    },
    {
      "type": "textarea",
      "id": "reason_3_text",
      "label": "説明文",
      "default": "大切な方への贈り物として、丁寧なギフト包装でお届けします。"
    },
    {
      "type": "header",
      "content": "スタイル"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景色",
      "default": "#fce4ec"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "見出しの色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "見出しサイズ",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "番号の色",
      "default": "#e91e63"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "番号サイズ",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "タイトルの色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "タイトルサイズ",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "説明文の色",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "説明文サイズ",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "画像サイズ",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像の角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "KAPOK KNOTがギフトに選ばれる理由"
    }
  ]
