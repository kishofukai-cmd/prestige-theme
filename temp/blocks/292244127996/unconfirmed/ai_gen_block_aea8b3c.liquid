{% doc %}
  @prompt
    雑誌のような編集レイアウト
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-editorial-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-item-{{ ai_gen_id }}--large {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-editorial-item-{{ ai_gen_id }}--medium {
    grid-column: span 4;
    grid-row: span 1;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small {
    grid-column: span 4;
    grid-row: span 1;
  }

  .ai-editorial-item-{{ ai_gen_id }}--full {
    grid-column: span 12;
    grid-row: span 1;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    background-color: #f4f4f4;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    margin: 0 0 8px 0;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}%;
  }

  .ai-editorial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
  }

  .ai-editorial-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--large {
      grid-column: span 4;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--medium {
      grid-column: span 4;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--small {
      grid-column: span 2;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--full {
      grid-column: span 4;
    }

    .ai-editorial-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-editorial-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-editorial-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }} class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign item_size_key = 'item_' | append: i | append: '_size'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_title_key = 'item_' | append: i | append: '_title'
        assign item_subtitle_key = 'item_' | append: i | append: '_subtitle'
        assign item_link_key = 'item_' | append: i | append: '_link'

        assign item_enabled = block.settings[item_enabled_key]
        assign item_size = block.settings[item_size_key]
        assign item_image = block.settings[item_image_key]
        assign item_title = block.settings[item_title_key]
        assign item_subtitle = block.settings[item_subtitle_key]
        assign item_link = block.settings[item_link_key]
      %}

      {% if item_enabled %}
        <div class="ai-editorial-item-{{ ai_gen_id }} ai-editorial-item-{{ ai_gen_id }}--{{ item_size }}">
          <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 1200 }}"
                alt="{{ item_image.alt | escape }}"
                loading="lazy"
                width="{{ item_image.width }}"
                height="{{ item_image.height }}"
                class="ai-editorial-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-editorial-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if item_title != blank or item_subtitle != blank %}
              <div class="ai-editorial-content-{{ ai_gen_id }}">
                {% if item_title != blank %}
                  <h3 class="ai-editorial-title-{{ ai_gen_id }}">{{ item_title }}</h3>
                {% endif %}
                {% if item_subtitle != blank %}
                  <p class="ai-editorial-subtitle-{{ ai_gen_id }}">{{ item_subtitle }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if item_link != blank %}
              <a href="{{ item_link }}" class="ai-editorial-link-{{ ai_gen_id }}" aria-label="{{ item_title | escape }}"></a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

