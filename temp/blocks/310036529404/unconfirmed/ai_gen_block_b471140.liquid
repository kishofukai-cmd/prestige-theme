{% doc %}
  @prompt
    カルーセルで写真を5枚入れたい。
    自動でカルーセルがループして欲しい。
    一旦5枚写真を入れたいけど後から追加できるようにして。
    
    SPビューは表に3枚見れる状態で、PCビューは5枚見れるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    gap: {{ block.settings.gap }}px;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.gap | times: 4 }}px) / 5);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.gap | times: 2 }}px) / 3);
    }
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-carousel-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-carousel-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }
{% endstyle %}

<carousel-slider-{{ ai_gen_id }}
  class="ai-carousel-container-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign image = block.settings[image_key] %}

      {% if image != blank %}
        <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
            class="ai-carousel-image-{{ ai_gen_id }}"
          >
        </div>
      {% elsif forloop.index <= 5 %}
        <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
          <div class="ai-carousel-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-carousel-empty-state-{{ ai_gen_id }}">
              画像 {{ forloop.index }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% assign total_slides = 0 %}
  {% for i in (1..10) %}
    {% assign image_key = 'image_' | append: i %}
    {% if block.settings[image_key] != blank %}
      {% assign total_slides = forloop.index %}
    {% endif %}
  {% endfor %}
  {% if total_slides == 0 %}
    {% assign total_slides = 5 %}
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-carousel-controls-{{ ai_gen_id }}">
      {% for i in (1..total_slides) %}
        <button
          class="ai-carousel-dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          aria-label="スライド {{ forloop.index }} に移動"
        ></button>
      {% endfor %}
    </div>
  {% endif %}
</carousel-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CarouselSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-carousel-wrapper-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 3000;
        this.totalSlides = this.slides.length;

        this.setupEventListeners();
        
        if (this.autoplay && this.totalSlides > 0) {
          this.startAutoplay();
        }

        this.handleResize();
        window.addEventListener('resize', () => this.handleResize());
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.handleResize());
      }

      handleResize() {
        this.slidesToShow = window.innerWidth >= 750 ? 5 : 3;
        this.updateCarousel();
      }

      setupEventListeners() {
        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            this.stopAutoplay();
            this.currentIndex = parseInt(dot.dataset.slide);
            this.updateCarousel();
            if (this.autoplay) {
              this.startAutoplay();
            }
          });
        });
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
          this.updateCarousel();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      updateCarousel() {
        if (!this.wrapper || this.totalSlides === 0) return;

        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.wrapper).gap) || 0;
        const offset = -(this.currentIndex * (slideWidth + gap));
        
        this.wrapper.style.transform = `translateX(${offset}px)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('carousel-slider-{{ ai_gen_id }}', CarouselSlider{{ ai_gen_id }});
  })();
</script>

