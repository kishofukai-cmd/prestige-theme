{% doc %}
  @prompt
    画像を5つ入れられるようにしたい。
    PCとSPで見え方が変わるようにしてマージンも整えれるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-image-gallery__container-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.image_gap }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-image-gallery__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-image-gallery-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-image-gallery__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.image_gap_mobile }}px;
    }
  }

  .ai-image-gallery__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-gallery__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-gallery__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-gallery__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<image-gallery-{{ ai_gen_id }}
  class="ai-image-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-gallery__container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
      %}

      <div class="ai-image-gallery__item-{{ ai_gen_id }}">
        {% if image %}
          <img
            src="{{ image | image_url: width: 1000 }}"
            alt="{{ image.alt | escape }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
            class="ai-image-gallery__image-{{ ai_gen_id }}"
            style="aspect-ratio: {{ block.settings.image_aspect_ratio }};"
          >
        {% else %}
          <div class="ai-image-gallery__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
              画像を追加
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</image-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('image-gallery-{{ ai_gen_id }}', ImageGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "画像ギャラリー",
  "settings": [
    {
      "type": "header",
      "content": "画像"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "画像 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "画像 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "画像 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "画像 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "画像 5"
    },
    {
      "type": "header",
      "content": "レイアウト"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "デスクトップ列数",
      "options": [
        { "value": "2", "label": "2列" },
        { "value": "3", "label": "3列" },
        { "value": "4", "label": "4列" },
        { "value": "5", "label": "5列" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "モバイル列数",
      "options": [
        { "value": "1", "label": "1列" },
        { "value": "2", "label": "2列" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "画像アスペクト比",
      "options": [
        { "value": "1/1", "label": "正方形 (1:1)" },
        { "value": "4/3", "label": "横長 (4:3)" },
        { "value": "3/4", "label": "縦長 (3:4)" },
        { "value": "16/9", "label": "ワイド (16:9)" },
        { "value": "auto", "label": "オリジナル" }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "画像間隔（デスクトップ）",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_gap_mobile",
      "label": "画像間隔（モバイル）",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "画像角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "余白（デスクトップ）"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "上部余白",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "下部余白",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "label": "左右余白",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "余白（モバイル）"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "上部余白",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "下部余白",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "label": "左右余白",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "画像ギャラリー"
    }
  ]
}
{% endschema %}
