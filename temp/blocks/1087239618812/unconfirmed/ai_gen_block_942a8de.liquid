{% doc %}
  @prompt
    ページの下まで飛ばすボタンが欲しい
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scroll-bottom-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    text-align: {{ block.settings.alignment }};
  }

  .ai-scroll-bottom__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-size: 14px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-scroll-bottom__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_text_color }};
    color: {{ block.settings.button_color }};
  }

  .ai-scroll-bottom__button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .ai-scroll-bottom__icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-scroll-bottom__button-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<scroll-bottom-{{ ai_gen_id }} class="ai-scroll-bottom-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <button class="ai-scroll-bottom__button-{{ ai_gen_id }}" type="button" aria-label="{{ block.settings.button_label | escape }}">
    <span>{{ block.settings.button_label | escape }}</span>
    <svg class="ai-scroll-bottom__icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 2.5v10M3.75 8.5 8 12.75l4.25-4.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</scroll-bottom-{{ ai_gen_id }}>

<script>
  (() => {
    const elementName = 'scroll-bottom-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;

    class ScrollBottom{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.button = this.querySelector('button');
        this.handleClick = () => {
          window.scrollTo({ top: document.documentElement.scrollHeight, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
        };
        this.button.addEventListener('click', this.handleClick);
      }

      disconnectedCallback() {
        if (this.button && this.handleClick) this.button.removeEventListener('click', this.handleClick);
      }
    }

    customElements.define(elementName, ScrollBottom{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "ページ下部へ移動",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンの文言",
      "default": "ページの下まで見る"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "配置",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "ボタンの背景",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "ボタンの文字",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "角丸",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ページ下部へ移動"
    }
  ],
  "tag": null,
  "class": "scroll-bottom-block"
}
{% endschema %}