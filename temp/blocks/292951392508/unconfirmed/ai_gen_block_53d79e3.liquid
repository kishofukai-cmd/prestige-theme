{% doc %}
  @prompt
    アニメーションで光る効果のある見出し
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-glowing-heading__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_align }};
    margin: 0;
    position: relative;
    background: linear-gradient(
      90deg,
      {{ block.settings.text_color }} 0%,
      {{ block.settings.glow_color }} 50%,
      {{ block.settings.text_color }} 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: ai-glowing-heading-shine-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite;
  }

  @keyframes ai-glowing-heading-shine-{{ ai_gen_id }} {
    0% {
      background-position: 200% center;
    }
    100% {
      background-position: -200% center;
    }
  }

  .ai-glowing-heading__text-{{ ai_gen_id }}::before {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur({{ block.settings.glow_blur }}px);
    opacity: {{ block.settings.glow_opacity }};
    background: linear-gradient(
      90deg,
      transparent 0%,
      {{ block.settings.glow_color }} 50%,
      transparent 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: ai-glowing-heading-shine-{{ ai_gen_id }} {{ block.settings.animation_duration }}s ease-in-out infinite;
  }

  @media screen and (max-width: 749px) {
    .ai-glowing-heading__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.7);
    }
  }
{% endstyle %}

<div class="ai-glowing-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading_tag == 'h1' %}
    <h1 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h1>
  {% elsif block.settings.heading_tag == 'h2' %}
    <h2 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h2>
  {% elsif block.settings.heading_tag == 'h3' %}
    <h3 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h3>
  {% elsif block.settings.heading_tag == 'h4' %}
    <h4 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h4>
  {% elsif block.settings.heading_tag == 'h5' %}
    <h5 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h5>
  {% else %}
    <h6 class="ai-glowing-heading__text-{{ ai_gen_id }}" data-text="{{ block.settings.heading_text }}">
      {{ block.settings.heading_text }}
    </h6>
  {% endif %}
</div>

{% schema %}
{
  "name": "Glowing heading",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Special Offer"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#f9c8c8"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "range",
      "id": "glow_blur",
      "label": "Glow blur",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "glow_opacity",
      "label": "Glow opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ]
}
{% endschema %}