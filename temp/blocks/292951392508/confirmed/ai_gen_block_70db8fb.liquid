{% doc %}
  @prompt
    長方形画像
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rectangular-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-rectangular-image__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-rectangular-image__aspect-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
  }

  .ai-rectangular-image__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-rectangular-image__img-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-rectangular-image__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-rectangular-image__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-rectangular-image__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-rectangular-image-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-rectangular-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rectangular-image__wrapper-{{ ai_gen_id }}">
    <div class="ai-rectangular-image__aspect-{{ ai_gen_id }}">
      <div class="ai-rectangular-image__content-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 2000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-rectangular-image__img-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-rectangular-image__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-rectangular-image__empty-state-{{ ai_gen_id }}">
              画像を追加してください
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "長方形画像",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "デスクトップ幅",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "画像の比率"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "アスペクト比",
      "options": [
        {
          "value": "33.33",
          "label": "3:1 (横長)"
        },
        {
          "value": "50",
          "label": "2:1 (横長)"
        },
        {
          "value": "56.25",
          "label": "16:9 (横長)"
        },
        {
          "value": "66.67",
          "label": "3:2 (横長)"
        },
        {
          "value": "75",
          "label": "4:3 (横長)"
        },
        {
          "value": "100",
          "label": "1:1 (正方形)"
        },
        {
          "value": "133.33",
          "label": "3:4 (縦長)"
        },
        {
          "value": "150",
          "label": "2:3 (縦長)"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "角の丸み",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "長方形画像"
    }
  ]
}
{% endschema %}
