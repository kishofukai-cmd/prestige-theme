{% doc %}
  @prompt
    縦画像を一枚真ん中に置きたい。それを縦に画像追加できるようにしてURLも踏めるようにしてほしい。
    また画像の間にボタンも設置できるようにして
    表示する大きさを変更できるようにしてほしい, もっと画像を追加できるようにして
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vertical-image-stack-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-vertical-image-stack__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.spacing }}px;
  }

  .ai-vertical-image-stack__item-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ai-vertical-image-stack__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    text-decoration: none;
  }

  .ai-vertical-image-stack__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-vertical-image-stack__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-vertical-image-stack__placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: 2 / 3;
    position: relative;
  }

  .ai-vertical-image-stack__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-vertical-image-stack__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-vertical-image-stack__button-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ai-vertical-image-stack__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    display: inline-block;
  }

  .ai-vertical-image-stack__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-vertical-image-stack-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-vertical-image-stack__container-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.8 }}px;
    }
  }
{% endstyle %}

<vertical-image-stack-{{ ai_gen_id }}
  class="ai-vertical-image-stack-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-vertical-image-stack__container-{{ ai_gen_id }}">
    {% for i in (1..10) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign url_key = 'url_' | append: i
        assign show_button_key = 'show_button_' | append: i
        assign button_text_key = 'button_text_' | append: i
        assign button_url_key = 'button_url_' | append: i

        assign image = block.settings[image_key]
        assign url = block.settings[url_key]
        assign show_button = block.settings[show_button_key]
        assign button_text = block.settings[button_text_key]
        assign button_url = block.settings[button_url_key]
      %}

      {% if image != blank %}
        <div class="ai-vertical-image-stack__item-{{ ai_gen_id }}">
          {% if url != blank %}
            <a href="{{ url }}" class="ai-vertical-image-stack__link-{{ ai_gen_id }}">
              <div class="ai-vertical-image-stack__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-vertical-image-stack__image-{{ ai_gen_id }}"
                >
              </div>
            </a>
          {% else %}
            <div class="ai-vertical-image-stack__link-{{ ai_gen_id }}">
              <div class="ai-vertical-image-stack__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 1200 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-vertical-image-stack__image-{{ ai_gen_id }}"
                >
              </div>
            </div>
          {% endif %}
        </div>

        {% if show_button and button_text != blank %}
          <div class="ai-vertical-image-stack__button-wrapper-{{ ai_gen_id }}">
            {% if button_url != blank %}
              <a href="{{ button_url }}" class="ai-vertical-image-stack__button-{{ ai_gen_id }}">
                {{ button_text }}
              </a>
            {% else %}
              <span class="ai-vertical-image-stack__button-{{ ai_gen_id }}">
                {{ button_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      {% elsif i == 1 %}
        <div class="ai-vertical-image-stack__item-{{ ai_gen_id }}">
          <div class="ai-vertical-image-stack__link-{{ ai_gen_id }}">
            <div class="ai-vertical-image-stack__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-vertical-image-stack__empty-state-{{ ai_gen_id }}">
                画像を追加してください
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</vertical-image-stack-{{ ai_gen_id }}>

<script>
  (function() {
    class VerticalImageStack{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('vertical-image-stack-{{ ai_gen_id }}', VerticalImageStack{{ ai_gen_id }});
  })();
</script>

