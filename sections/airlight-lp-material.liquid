{% comment %} AirLight Jacket LP — Kapok Material Story Section {% endcomment %}

<section class="al-material" id="al-material">
  <div class="al-material__inner" data-al-reveal>
    <div class="al-material__img">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '900x' }}" alt="{{ section.settings.image_alt | default: 'Kapok fiber — the plant-based down alternative' }}" loading="lazy">
      {% else %}
        <div class="al-material__img--placeholder">🌿</div>
      {% endif %}
    </div>

    <div class="al-material__content">
      <p class="al-label al-label--light">{{ section.settings.label | default: 'ABOUT THE MATERIAL' }}</p>

      <h2 class="al-material__heading">
        {{ section.settings.heading | default: '"Wood-born down"<br><em>has arrived.</em>' }}
      </h2>

      <div class="al-material__body">
        {{ section.settings.body | default: '<p>Kapok is a seed fiber that grows inside the pods of the kapok tree across Southeast Asia. KAPOK KNOT's breakthrough was transforming this centuries-old natural material into a high-performance insulation sheet — a first in the fashion industry.</p><p>The result: a fiber that is <strong>1/8th the weight of cotton</strong>, breathes naturally, generates warmth as it absorbs moisture, and leaves no animal or environmental harm in its wake.</p>' }}
      </div>

      <ul class="al-material__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AirLight Material Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Kapok Material Image" },
    { "type": "text", "id": "image_alt", "label": "Image Alt", "default": "Kapok fiber — the plant-based down alternative" },
    { "type": "text", "id": "label", "label": "Section Label", "default": "ABOUT THE MATERIAL" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>\"Wood-born down\"<br><em>has arrived.</em></p>" },
    { "type": "richtext", "id": "body", "label": "Body Text" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Material Feature",
      "settings": [
        { "type": "text", "id": "text", "label": "Feature Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AirLight Material Story",
      "blocks": [
        { "type": "feature", "settings": { "text": "1/8th the weight of cotton fiber" } },
        { "type": "feature", "settings": { "text": "Moisture-activated warmth (hygroscopic heating)" } },
        { "type": "feature", "settings": { "text": "No tree cutting — harvested from seed pods only" } },
        { "type": "feature", "settings": { "text": "Supports reforestation and community jobs in SE Asia" } },
        { "type": "feature", "settings": { "text": "Patent-pending EthicalDown Kapok™ sheet process" } }
      ]
    }
  ]
}
{% endschema %}
