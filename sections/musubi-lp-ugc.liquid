<style>
  .ugc {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .ugc__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ugc__badge {
    display: inline-block;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 8px 15px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .ugc__title {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .ugc__title p {
    margin: 0;
  }

  .ugc__sub {
    max-width: 700px;
    margin: 0 auto 34px;
    font-size: {{ section.settings.subheading_size_pc }}px;
    color: {{ section.settings.subheading_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .ugc__highlight {
    max-width: 760px;
    margin: 0 auto 30px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .ugc__highlight-item {
    background: {{ section.settings.highlight_bg_color }};
    border: 1px solid {{ section.settings.highlight_border_color }};
    border-radius: {{ section.settings.highlight_radius }}px;
    padding: 18px 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
  }

  .ugc__highlight-number {
    display: block;
    font-size: {{ section.settings.highlight_number_size_pc }}px;
    color: {{ section.settings.highlight_number_color }};
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  .ugc__highlight-label {
    display: block;
    font-size: {{ section.settings.highlight_label_size_pc }}px;
    color: {{ section.settings.highlight_label_color }};
    font-weight: 600;
    line-height: 1.5;
  }

  .ugc__carousel {
    position: relative;
    margin: 0 calc(50% - 50vw);
    padding: 8px 0 18px;
  }

  .ugc__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 max(20px, calc((100vw - {{ section.settings.max_width }}px) / 2)) 10px;
    -webkit-overflow-scrolling: touch;
  }

  .ugc__track::-webkit-scrollbar {
    height: 6px;
  }

  .ugc__track::-webkit-scrollbar-thumb {
    background: {{ section.settings.scrollbar_color }};
    border-radius: 999px;
  }

  .ugc__item {
    flex: 0 0 {{ section.settings.card_width_pc }}px;
    scroll-snap-align: center;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
  }

  .ugc__iframe {
    width: 100%;
    height: {{ section.settings.iframe_height_pc }}px;
    display: block;
    border: 0;
    background: #fff;
  }

  .ugc__caption {
    padding: 12px 14px 14px;
    font-size: {{ section.settings.caption_size_pc }}px;
    color: {{ section.settings.caption_color }};
    line-height: 1.6;
    text-align: left;
    font-weight: 600;
  }

  .ugc__follow {
    margin-top: 28px;
  }

  .ugc__follow-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_color }};
    font-size: {{ section.settings.button_size_pc }}px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 15px 30px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .ugc__follow-link:hover {
    opacity: 0.86;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .ugc {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .ugc__badge {
      font-size: {{ section.settings.badge_size_sp }}px;
      margin-bottom: 12px;
    }

    .ugc__title {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .ugc__sub {
      font-size: {{ section.settings.subheading_size_sp }}px;
      margin-bottom: 24px;
    }

    .ugc__highlight {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-bottom: 22px;
    }

    .ugc__highlight-item {
      border-radius: {{ section.settings.highlight_radius_sp }}px;
      padding: 14px 12px;
    }

    .ugc__highlight-number {
      font-size: {{ section.settings.highlight_number_size_sp }}px;
    }

    .ugc__highlight-label {
      font-size: {{ section.settings.highlight_label_size_sp }}px;
    }

    .ugc__track {
      gap: 12px;
      padding: 0 16px 8px;
    }

    .ugc__item {
      flex-basis: {{ section.settings.card_width_sp }}px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .ugc__iframe {
      height: {{ section.settings.iframe_height_sp }}px;
    }

    .ugc__caption {
      font-size: {{ section.settings.caption_size_sp }}px;
    }

    .ugc__follow {
      margin-top: 22px;
    }

    .ugc__follow-link {
      width: 100%;
      font-size: {{ section.settings.button_size_sp }}px;
      padding: 14px 18px;
    }
  }
</style>

<section class="ugc" id="ugc">
  <div class="ugc__inner">

    {% if section.settings.badge != blank %}
      <div class="ugc__badge">
        {{ section.settings.badge }}
      </div>
    {% endif %}

    <h2 class="ugc__title">
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.subheading != blank %}
      <div class="ugc__sub">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.show_highlight %}
      <div class="ugc__highlight">
        <div class="ugc__highlight-item">
          <span class="ugc__highlight-number">{{ section.settings.highlight_number_1 }}</span>
          <span class="ugc__highlight-label">{{ section.settings.highlight_label_1 }}</span>
        </div>
        <div class="ugc__highlight-item">
          <span class="ugc__highlight-number">{{ section.settings.highlight_number_2 }}</span>
          <span class="ugc__highlight-label">{{ section.settings.highlight_label_2 }}</span>
        </div>
        <div class="ugc__highlight-item">
          <span class="ugc__highlight-number">{{ section.settings.highlight_number_3 }}</span>
          <span class="ugc__highlight-label">{{ section.settings.highlight_label_3 }}</span>
        </div>
      </div>
    {% endif %}

    <div class="ugc__carousel">
      <div class="ugc__track">
        {% for block in section.blocks %}
          <div class="ugc__item" {{ block.shopify_attributes }}>
            <iframe
              src="https://www.instagram.com/reel/{{ block.settings.reel_id }}/embed/"
              class="ugc__iframe"
              frameborder="0"
              scrolling="no"
              allowtransparency="true"
              loading="lazy"
              title="{{ block.settings.caption | default: 'Instagram Reel' }}">
            </iframe>

            {% if block.settings.caption != blank %}
              <div class="ugc__caption">
                {{ block.settings.caption }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.instagram_url != blank %}
      <div class="ugc__follow">
        <a href="{{ section.settings.instagram_url }}" class="ugc__follow-link" target="_blank" rel="noopener">
          {{ section.settings.follow_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

