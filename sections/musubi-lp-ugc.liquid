<style>
  .ugc {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .ugc__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .ugc__badge {
    display: inline-block;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 8px 15px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .ugc__title {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .ugc__title p,
  .ugc__sub p {
    margin: 0;
  }

  .ugc__sub {
    max-width: 700px;
    margin: 0 auto 34px;
    font-size: {{ section.settings.subheading_size_pc }}px;
    color: {{ section.settings.subheading_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .ugc__carousel {
    margin: 0 calc(50% - 50vw);
    padding: 8px 0 18px;
  }

  .ugc__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 max(20px, calc((100vw - {{ section.settings.max_width }}px) / 2)) 10px;
    -webkit-overflow-scrolling: touch;
  }

  .ugc__item {
    flex: 0 0 {{ section.settings.card_width_pc }}px;
    scroll-snap-align: center;
    background: #fff;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
  }

  .ugc__iframe {
    width: 100%;
    height: {{ section.settings.iframe_height_pc }}px;
    display: block;
    border: 0;
    background: #fff;
  }

  .ugc__caption {
    padding: 12px 14px 14px;
    font-size: {{ section.settings.caption_size_pc }}px;
    color: {{ section.settings.caption_color }};
    line-height: 1.6;
    text-align: left;
    font-weight: 600;
  }

  .ugc__follow {
    margin-top: 28px;
  }

  .ugc__follow-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_color }};
    font-size: {{ section.settings.button_size_pc }}px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 15px 30px;
  }

  @media (max-width: 768px) {
    .ugc {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .ugc__badge {
      font-size: {{ section.settings.badge_size_sp }}px;
    }

    .ugc__title {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .ugc__sub {
      font-size: {{ section.settings.subheading_size_sp }}px;
      margin-bottom: 24px;
    }

    .ugc__track {
      gap: 12px;
      padding: 0 16px 8px;
    }

    .ugc__item {
      flex-basis: {{ section.settings.card_width_sp }}px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .ugc__iframe {
      height: {{ section.settings.iframe_height_sp }}px;
    }

    .ugc__caption {
      font-size: {{ section.settings.caption_size_sp }}px;
    }

    .ugc__follow-link {
      width: 100%;
      font-size: {{ section.settings.button_size_sp }}px;
      padding: 14px 18px;
    }
  }
</style>

<section class="ugc" id="ugc">
  <div class="ugc__inner">

    {% if section.settings.badge != blank %}
      <div class="ugc__badge">{{ section.settings.badge }}</div>
    {% endif %}

    <h2 class="ugc__title">
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.subheading != blank %}
      <div class="ugc__sub">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div class="ugc__carousel">
      <div class="ugc__track">
        {% for block in section.blocks %}
          <div class="ugc__item" {{ block.shopify_attributes }}>
            <iframe
              src="https://www.instagram.com/{{ block.settings.post_type }}/{{ block.settings.post_id }}/embed/"
              class="ugc__iframe"
              frameborder="0"
              scrolling="no"
              allowtransparency="true"
              loading="lazy"
              title="{{ block.settings.caption | default: 'Instagram Post' }}">
            </iframe>

            {% if block.settings.caption != blank %}
              <div class="ugc__caption">
                {{ block.settings.caption }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.instagram_url != blank %}
      <div class="ugc__follow">
        <a href="{{ section.settings.instagram_url }}" class="ugc__follow-link" target="_blank" rel="noopener">
          {{ section.settings.follow_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

