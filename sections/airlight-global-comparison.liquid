{% comment %} AirLight Global LP — Comparison Table (Mobile-optimized) {% endcomment %}

<style>
  .ag-comparison {
    background: var(--ag-bg-dark, #1a2640);
    padding: clamp(64px, 10vw, 120px) 0;
  }

  .ag-comparison__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 clamp(40px, 6vw, 64px);
    text-align: center;
  }

  /* ═══ Desktop table ═══ */
  .ag-comparison__table-wrap {
    border-radius: 16px;
    box-shadow: 0 4px 40px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }

  .ag-comparison__table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.04);
  }

  .ag-comparison__table thead tr {
    background: rgba(194, 157, 102, 0.12);
    border-bottom: 2px solid rgba(194, 157, 102, 0.3);
  }

  .ag-comparison__table th {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    padding: clamp(14px, 2vw, 20px) clamp(16px, 2.5vw, 28px);
    text-align: left;
    white-space: nowrap;
  }

  .ag-comparison__th--hero {
    color: var(--ag-gold, #c29d66) !important;
  }

  .ag-comparison__table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.2s ease;
  }

  .ag-comparison__table tbody tr:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .ag-comparison__table tbody tr:last-child {
    border-bottom: none;
  }

  .ag-comparison__table td {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.85rem, 1.4vw, 0.95rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    padding: clamp(14px, 2vw, 20px) clamp(16px, 2.5vw, 28px);
    vertical-align: middle;
  }

  .ag-comparison__table td:first-child {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ag-comparison__td--hero {
    color: #fff !important;
    font-weight: 600 !important;
  }

  /* ═══ Mobile cards (hide table, show cards) ═══ */
  .ag-comparison__cards {
    display: none;
  }

  @media (max-width: 768px) {
    .ag-comparison {
      padding: 48px 16px;
    }
    .ag-comparison__heading {
      font-size: 1.7rem;
      margin-bottom: 32px;
    }
    .ag-comparison__table-wrap {
      display: none;
    }
    .ag-comparison__cards {
      display: flex;
      flex-direction: column;
      gap: 0;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 30px rgba(0,0,0,0.2);
    }

    /* ── Individual row card ── */
    .ag-comp-row {
      display: grid;
      grid-template-columns: 1fr;
      background: #fff;
      border-bottom: 1px solid #e8e3da;
    }
    .ag-comp-row:last-child {
      border-bottom: none;
    }

    .ag-comp-row__feature {
      font-family: 'Outfit', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #1a2640;
      padding: 14px 16px 0;
    }

    .ag-comp-row__values {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0;
      padding: 8px 0 14px;
    }

    .ag-comp-cell {
      text-align: center;
      padding: 6px 8px;
      font-family: 'Outfit', sans-serif;
      font-size: 13px;
      line-height: 1.35;
      color: #5a5550;
    }

    .ag-comp-cell__label {
      display: block;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a7f6e;
      margin-bottom: 3px;
    }

    .ag-comp-cell--hero {
      background: linear-gradient(135deg, #1a2640, #2a3a5c);
      color: #fff;
      border-radius: 8px;
      margin: 0 4px;
      padding: 8px;
    }
    .ag-comp-cell--hero .ag-comp-cell__label {
      color: var(--ag-gold, #c29d66);
    }

    /* ── Header row ── */
    .ag-comp-header {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0;
      background: #f0ece4;
      padding: 12px 0;
    }
    .ag-comp-header__cell {
      text-align: center;
      font-family: 'Outfit', sans-serif;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #8a7f6e;
      padding: 4px 8px;
    }
    .ag-comp-header__cell--hero {
      color: #1a2640;
    }
    .ag-comp-header__cell--hero::before {
      content: '★ ';
      color: var(--ag-gold, #c29d66);
    }
  }
</style>

<section class="ag-comparison" id="ag-comparison">
  <div class="ag-container" data-ag-reveal>
    <h2 class="ag-comparison__heading">{{ section.settings.heading | default: 'How AirLight Compares.' }}</h2>

    <!-- ══ Desktop table ══ -->
    <div class="ag-comparison__table-wrap">
      <table class="ag-comparison__table">
        <thead>
          <tr>
            <th></th>
            <th class="ag-comparison__th--hero">★ OUR PICK</th>
            <th>Down</th>
            <th>Synthetic</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.feature }}</td>
                <td class="ag-comparison__td--hero">{{ block.settings.airlight }}</td>
                <td>{{ block.settings.down }}</td>
                <td>{{ block.settings.synthetic }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    <!-- ══ Mobile cards ══ -->
    <div class="ag-comparison__cards">
      <!-- Column headers -->
      <div class="ag-comp-header">
        <div class="ag-comp-header__cell ag-comp-header__cell--hero">AirLight</div>
        <div class="ag-comp-header__cell">Down</div>
        <div class="ag-comp-header__cell">Synthetic</div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'row' %}
          <div class="ag-comp-row" {{ block.shopify_attributes }}>
            <div class="ag-comp-row__feature">{{ block.settings.feature }}</div>
            <div class="ag-comp-row__values">
              <div class="ag-comp-cell ag-comp-cell--hero">
                {{ block.settings.airlight }}
              </div>
              <div class="ag-comp-cell">
                {{ block.settings.down }}
              </div>
              <div class="ag-comp-cell">
                {{ block.settings.synthetic }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "AG Comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How AirLight Compares." },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "カスタムCSS"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Warmth" },
        { "type": "text", "id": "airlight", "label": "AirLight", "default": "✅ Proven in -20°C winters" },
        { "type": "text", "id": "down", "label": "Down", "default": "✅ Effective" },
        { "type": "text", "id": "synthetic", "label": "Synthetic", "default": "⚠️ Adequate" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Warmth", "airlight": "✅ Proven in -20°C winters", "down": "✅ Effective", "synthetic": "⚠️ Adequate" } },
        { "type": "row", "settings": { "feature": "Water Resistance", "airlight": "✅ Maintained when wet", "down": "❌ Collapses", "synthetic": "✅ Maintained" } },
        { "type": "row", "settings": { "feature": "Machine Washable", "airlight": "✅ Yes — cold cycle", "down": "❌ Dry-clean only", "synthetic": "⚠️ Often yes" } },
        { "type": "row", "settings": { "feature": "Allergen-Free", "airlight": "✅ 100% plant-based", "down": "❌ No", "synthetic": "✅ Yes" } },
        { "type": "row", "settings": { "feature": "Animal-Free", "airlight": "✅ Yes", "down": "❌ No", "synthetic": "✅ Yes" } },
        { "type": "row", "settings": { "feature": "Price", "airlight": "✅ $398", "down": "❌ $350–600", "synthetic": "⚠️ $200–400" } }
      ]
    }
  ]
}
{% endschema %}
