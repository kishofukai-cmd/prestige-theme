{% comment %} AirLight Global LP — Reviews (Carousel) {% endcomment %}

<style>
  .ag-reviews {
    background: var(--ag-bg-warm, #faf9f6);
    padding: clamp(64px, 10vw, 120px) 0;
    overflow: hidden;
  }

  .ag-reviews__header {
    max-width: var(--ag-max, 960px);
    margin: 0 auto;
    padding: 0 var(--ag-pad, 20px);
    text-align: center;
  }

  .ag-reviews__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ag-heading, #1a2640);
    margin: 0 0 clamp(12px, 2vw, 20px);
  }

  .ag-reviews__stars-avg {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--ag-gold, #c29d66);
    margin: 0 0 clamp(40px, 6vw, 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ag-reviews__stars-avg span {
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    color: var(--ag-text, #5a5550);
  }

  /* --- Carousel Track --- */
  .ag-reviews__carousel-wrap {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--ag-pad, 20px);
  }

  .ag-reviews__track {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 24px;
    overflow-x: auto !important;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .ag-reviews__track::-webkit-scrollbar { display: none; }

  .ag-review-card {
    width: 400px;
    max-width: 85vw;
    flex-shrink: 0;
    scroll-snap-align: start;
    background: #fff;
    border-radius: 16px;
    padding: clamp(28px, 3.5vw, 40px);
    box-shadow: 0 2px 20px rgba(26, 38, 64, 0.06);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ag-review-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 40px rgba(26, 38, 64, 0.1);
  }

  .ag-review-card__stars {
    font-size: 1.1rem;
    color: var(--ag-gold, #c29d66);
    letter-spacing: 0.05em;
  }

  .ag-review-card__headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ag-heading, #1a2640);
    margin: 0;
  }

  .ag-review-card__text {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.88rem, 1.4vw, 0.95rem);
    line-height: 1.75;
    color: var(--ag-text, #5a5550);
    margin: 0;
    flex: 1;
  }

  .ag-review-card__meta {
    font-family: 'Outfit', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ag-text, #5a5550);
    opacity: 0.65;
    padding-top: 12px;
    border-top: 1px solid rgba(26, 38, 64, 0.08);
    margin-top: auto;
  }

  .ag-review-card__badge {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ag-gold, #c29d66);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 6px;
  }

  /* --- Navigation Arrows --- */
  .ag-reviews__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .ag-reviews__nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--ag-border, #dfe4eb);
    background: #fff;
    color: var(--ag-text, #1a2640);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .ag-reviews__nav-btn:hover {
    background: var(--ag-bg-dark, #1a2640);
    border-color: var(--ag-bg-dark, #1a2640);
    color: #fff;
  }
  .ag-reviews__nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .ag-reviews__nav-btn:disabled:hover {
    background: #fff;
    border-color: var(--ag-border, #dfe4eb);
    color: var(--ag-text, #1a2640);
  }

  /* --- Dots --- */
  .ag-reviews__dots {
    display: flex;
    gap: 8px;
  }
  .ag-reviews__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ag-border, #dfe4eb);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .ag-reviews__dot.is-active {
    background: var(--ag-gold, #c29d66);
    transform: scale(1.25);
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .ag-reviews {
      padding-left: 0;
      padding-right: 0;
    }
    .ag-reviews__track {
      gap: 14px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .ag-review-card {
      width: 85vw;
      flex-shrink: 0;
      padding: 20px;
    }
    .ag-review-card__text {
      font-size: 14px;
    }
  }
</style>

<section class="ag-reviews" id="ag-reviews">
  <div class="ag-reviews__header" data-ag-reveal>
    <h2 class="ag-reviews__heading">{{ section.settings.heading }}</h2>
    <div class="ag-reviews__stars-avg">
      {{ section.settings.avg_stars | default: '★★★★★' }}
      <span>{{ section.settings.avg_label | default: '4.8 / 5 — 142 Verified Buyers' }}</span>
    </div>
  </div>

  <div class="ag-reviews__carousel-wrap">
    <div class="ag-reviews__track" id="ag-reviews-track-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'review_card' %}
          <div class="ag-review-card" {{ block.shopify_attributes }} data-ag-reveal>
            <div class="ag-review-card__stars">{{ block.settings.stars }}</div>
            <h3 class="ag-review-card__headline">{{ block.settings.headline }}</h3>
            <p class="ag-review-card__text">{{ block.settings.text }}</p>
            <div class="ag-review-card__meta">{{ block.settings.meta }}</div>
            <div class="ag-review-card__badge">{{ section.settings.verified_badge | default: '✓ Verified Buyer' }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ag-reviews__nav">
      <button class="ag-reviews__nav-btn" id="ag-reviews-prev-{{ section.id }}" aria-label="Previous review">&#8592;</button>
      <div class="ag-reviews__dots" id="ag-reviews-dots-{{ section.id }}"></div>
      <button class="ag-reviews__nav-btn" id="ag-reviews-next-{{ section.id }}" aria-label="Next review">&#8594;</button>
    </div>
  </div>
</section>

<script>
(function () {
  var sid = '{{ section.id }}';
  var track = document.getElementById('ag-reviews-track-' + sid);
  var prevBtn = document.getElementById('ag-reviews-prev-' + sid);
  var nextBtn = document.getElementById('ag-reviews-next-' + sid);
  var dotsWrap = document.getElementById('ag-reviews-dots-' + sid);
  if (!track) return;

  var cards = track.querySelectorAll('.ag-review-card');
  var total = cards.length;
  if (total === 0) return;

  /* Build dots */
  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.className = 'ag-reviews__dot' + (i === 0 ? ' is-active' : '');
    dot.setAttribute('aria-label', 'Go to review ' + (i + 1));
    dot.dataset.index = i;
    dot.addEventListener('click', function () {
      scrollToCard(parseInt(this.dataset.index));
    });
    dotsWrap.appendChild(dot);
  }

  var currentIndex = 0;

  function scrollToCard(idx) {
    if (idx < 0) idx = 0;
    if (idx >= total) idx = total - 1;
    currentIndex = idx;
    cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    updateUI();
  }

  function updateUI() {
    prevBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex >= total - 1;
    var dots = dotsWrap.querySelectorAll('.ag-reviews__dot');
    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === currentIndex);
    });
  }

  prevBtn.addEventListener('click', function () { scrollToCard(currentIndex - 1); });
  nextBtn.addEventListener('click', function () { scrollToCard(currentIndex + 1); });

  /* Sync dots on manual scroll */
  var scrollTimer;
  track.addEventListener('scroll', function () {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function () {
      var trackLeft = track.scrollLeft;
      var closest = 0;
      var minDist = Infinity;
      cards.forEach(function (card, i) {
        var dist = Math.abs(card.offsetLeft - track.offsetLeft - trackLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      currentIndex = closest;
      updateUI();
    }, 80);
  });

  updateUI();
})();
</script>

{% schema %}
{
  "name": "AG Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Customers. Real Winters." },
    { "type": "text", "id": "avg_stars", "label": "Stars Display", "default": "★★★★★" },
    { "type": "text", "id": "avg_label", "label": "Average Label", "default": "4.6 / 5 — 42 Verified Buyers" },
    { "type": "text", "id": "verified_badge", "label": "Verified Buyer Badge", "default": "✓ Verified Buyer" }
  ],
  "blocks": [
    {
      "type": "review_card",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "textarea", "id": "text", "label": "Review Text" },
        { "type": "text", "id": "meta", "label": "Reviewer Info" }
      ]
    }
  ],
  "presets": [
    {
