{% comment %} AirLight Global LP — Reviews (Carousel) {% endcomment %}\r
\r
<style>\r
  .ag-reviews {\r
    background: var(--ag-bg-warm, #faf9f6);\r
    padding: clamp(64px, 10vw, 120px) 0;\r
    overflow: hidden;\r
  }\r
\r
  .ag-reviews__header {\r
    max-width: var(--ag-max, 960px);\r
    margin: 0 auto;\r
    padding: 0 var(--ag-pad, 20px);\r
    text-align: center;\r
  }\r
\r
  .ag-reviews__heading {\r
    font-family: 'Cormorant Garamond', serif;\r
    font-size: clamp(2rem, 4.5vw, 3rem);\r
    font-weight: 600;\r
    line-height: 1.15;\r
    color: var(--ag-heading, #1a2640);\r
    margin: 0 0 clamp(12px, 2vw, 20px);\r
  }\r
\r
  .ag-reviews__stars-avg {\r
    font-size: clamp(1.1rem, 2vw, 1.3rem);\r
    color: var(--ag-gold, #c29d66);\r
    margin: 0 0 clamp(40px, 6vw, 64px);\r
    display: flex;\r
    align-items: center;\r
    justify-content: center;\r
    gap: 8px;\r
  }\r
\r
  .ag-reviews__stars-avg span {\r
    font-family: 'Outfit', sans-serif;\r
    font-size: 0.82rem;\r
    color: var(--ag-text, #5a5550);\r
  }\r
\r
  /* --- Carousel Track --- */\r
  .ag-reviews__carousel-wrap {\r
    position: relative;\r
    max-width: 1200px;\r
    margin: 0 auto;\r
    padding: 0 var(--ag-pad, 20px);\r
  }\r
\r
  .ag-reviews__track {\r
    display: flex;\r
    gap: 24px;\r
    overflow-x: auto;\r
    scroll-snap-type: x mandatory;\r
    -webkit-overflow-scrolling: touch;\r
    scrollbar-width: none;\r
    padding-bottom: 4px;\r
  }\r
  .ag-reviews__track::-webkit-scrollbar { display: none; }\r
\r
  .ag-review-card {\r
    flex: 0 0 min(400px, 85vw);\r
    scroll-snap-align: start;\r
    background: #fff;\r
    border-radius: 16px;\r
    padding: clamp(28px, 3.5vw, 40px);\r
    box-shadow: 0 2px 20px rgba(26, 38, 64, 0.06);\r
    display: flex;\r
    flex-direction: column;\r
    gap: 14px;\r
    transition: transform 0.3s ease, box-shadow 0.3s ease;\r
  }\r
\r
  .ag-review-card:hover {\r
    transform: translateY(-3px);\r
    box-shadow: 0 8px 40px rgba(26, 38, 64, 0.1);\r
  }\r
\r
  .ag-review-card__stars {\r
    font-size: 1.1rem;\r
    color: var(--ag-gold, #c29d66);\r
    letter-spacing: 0.05em;\r
  }\r
\r
  .ag-review-card__headline {\r
    font-family: 'Cormorant Garamond', serif;\r
    font-size: clamp(1.15rem, 2vw, 1.4rem);\r
    font-weight: 600;\r
    line-height: 1.25;\r
    color: var(--ag-heading, #1a2640);\r
    margin: 0;\r
  }\r
\r
  .ag-review-card__text {\r
    font-family: 'Outfit', sans-serif;\r
    font-size: clamp(0.88rem, 1.4vw, 0.95rem);\r
    line-height: 1.75;\r
    color: var(--ag-text, #5a5550);\r
    margin: 0;\r
    flex: 1;\r
  }\r
\r
  .ag-review-card__meta {\r
    font-family: 'Outfit', sans-serif;\r
    font-size: 0.78rem;\r
    font-weight: 600;\r
    color: var(--ag-text, #5a5550);\r
    opacity: 0.65;\r
    padding-top: 12px;\r
    border-top: 1px solid rgba(26, 38, 64, 0.08);\r
    margin-top: auto;\r
  }\r
\r
  .ag-review-card__badge {\r
    font-family: 'Outfit', sans-serif;\r
    font-size: 0.7rem;\r
    font-weight: 700;\r
    color: var(--ag-gold, #c29d66);\r
    letter-spacing: 0.08em;\r
    text-transform: uppercase;\r
    margin-top: 6px;\r
  }\r
\r
  /* --- Navigation Arrows --- */\r
  .ag-reviews__nav {\r
    display: flex;\r
    justify-content: center;\r
    align-items: center;\r
    gap: 16px;\r
    margin-top: clamp(24px, 4vw, 40px);\r
  }\r
\r
  .ag-reviews__nav-btn {\r
    width: 44px;\r
    height: 44px;\r
    border-radius: 50%;\r
    border: 1px solid var(--ag-border, #dfe4eb);\r
    background: #fff;\r
    color: var(--ag-text, #1a2640);\r
    font-size: 18px;\r
    cursor: pointer;\r
    display: flex;\r
    align-items: center;\r
    justify-content: center;\r
    transition: background 0.2s, border-color 0.2s, color 0.2s;\r
  }\r
  .ag-reviews__nav-btn:hover {\r
    background: var(--ag-bg-dark, #1a2640);\r
    border-color: var(--ag-bg-dark, #1a2640);\r
    color: #fff;\r
  }\r
  .ag-reviews__nav-btn:disabled {\r
    opacity: 0.3;\r
    cursor: default;\r
  }\r
  .ag-reviews__nav-btn:disabled:hover {\r
    background: #fff;\r
    border-color: var(--ag-border, #dfe4eb);\r
    color: var(--ag-text, #1a2640);\r
  }\r
\r
  /* --- Dots --- */\r
  .ag-reviews__dots {\r
    display: flex;\r
    gap: 8px;\r
  }\r
  .ag-reviews__dot {\r
    width: 8px;\r
    height: 8px;\r
    border-radius: 50%;\r
    background: var(--ag-border, #dfe4eb);\r
    border: none;\r
    padding: 0;\r
    cursor: pointer;\r
    transition: background 0.2s, transform 0.2s;\r
  }\r
  .ag-reviews__dot.is-active {\r
    background: var(--ag-gold, #c29d66);\r
    transform: scale(1.25);\r
  }\r
\r
  /* --- Mobile --- */\r
  @media (max-width: 768px) {\r
    .ag-reviews {\r
      padding-left: 0;\r
      padding-right: 0;\r
    }\r
    .ag-reviews__track {\r
      gap: 14px;\r
      padding-left: 16px;\r
      padding-right: 16px;\r
    }\r
    .ag-review-card {\r
      flex: 0 0 85vw;\r
      padding: 20px;\r
    }\r
    .ag-review-card__text {\r
      font-size: 14px;\r
    }\r
  }\r
</style>\r
\r
<section class="ag-reviews" id="ag-reviews">\r
  <div class="ag-reviews__header" data-ag-reveal>\r
    <h2 class="ag-reviews__heading">{{ section.settings.heading }}</h2>\r
    <div class="ag-reviews__stars-avg">\r
      {{ section.settings.avg_stars | default: '★★★★★' }}\r
      <span>{{ section.settings.avg_label | default: '4.8 / 5 — 142 Verified Buyers' }}</span>\r
    </div>\r
  </div>\r
\r
  <div class="ag-reviews__carousel-wrap">\r
    <div class="ag-reviews__track" id="ag-reviews-track-{{ section.id }}">\r
      {% for block in section.blocks %}\r
        {% if block.type == 'review_card' %}\r
          <div class="ag-review-card" {{ block.shopify_attributes }} data-ag-reveal>\r
            <div class="ag-review-card__stars">{{ block.settings.stars }}</div>\r
            <h3 class="ag-review-card__headline">{{ block.settings.headline }}</h3>\r
            <p class="ag-review-card__text">{{ block.settings.text }}</p>\r
            <div class="ag-review-card__meta">{{ block.settings.meta }}</div>\r
            <div class="ag-review-card__badge">&#10003; Verified Buyer</div>\r
          </div>\r
        {% endif %}\r
      {% endfor %}\r
    </div>\r
\r
    <div class="ag-reviews__nav">\r
      <button class="ag-reviews__nav-btn" id="ag-reviews-prev-{{ section.id }}" aria-label="Previous review">&#8592;</button>\r
      <div class="ag-reviews__dots" id="ag-reviews-dots-{{ section.id }}"></div>\r
      <button class="ag-reviews__nav-btn" id="ag-reviews-next-{{ section.id }}" aria-label="Next review">&#8594;</button>\r
    </div>\r
  </div>\r
</section>\r
\r
<script>\r
(function () {\r
  var sid = '{{ section.id }}';\r
  var track = document.getElementById('ag-reviews-track-' + sid);\r
  var prevBtn = document.getElementById('ag-reviews-prev-' + sid);\r
  var nextBtn = document.getElementById('ag-reviews-next-' + sid);\r
  var dotsWrap = document.getElementById('ag-reviews-dots-' + sid);\r
  if (!track) return;\r
\r
  var cards = track.querySelectorAll('.ag-review-card');\r
  var total = cards.length;\r
  if (total === 0) return;\r
\r
  /* Build dots */\r
  for (var i = 0; i < total; i++) {\r
    var dot = document.createElement('button');\r
    dot.className = 'ag-reviews__dot' + (i === 0 ? ' is-active' : '');\r
    dot.setAttribute('aria-label', 'Go to review ' + (i + 1));\r
    dot.dataset.index = i;\r
    dot.addEventListener('click', function () {\r
      scrollToCard(parseInt(this.dataset.index));\r
    });\r
    dotsWrap.appendChild(dot);\r
  }\r
\r
  var currentIndex = 0;\r
\r
  function scrollToCard(idx) {\r
    if (idx < 0) idx = 0;\r
    if (idx >= total) idx = total - 1;\r
    currentIndex = idx;\r
    cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });\r
    updateUI();\r
  }\r
\r
  function updateUI() {\r
    prevBtn.disabled = currentIndex === 0;\r
    nextBtn.disabled = currentIndex >= total - 1;\r
    var dots = dotsWrap.querySelectorAll('.ag-reviews__dot');\r
    dots.forEach(function (d, i) {\r
      d.classList.toggle('is-active', i === currentIndex);\r
    });\r
  }\r
\r
  prevBtn.addEventListener('click', function () { scrollToCard(currentIndex - 1); });\r
  nextBtn.addEventListener('click', function () { scrollToCard(currentIndex + 1); });\r
\r
  /* Sync dots on manual scroll */\r
  var scrollTimer;\r
  track.addEventListener('scroll', function () {\r
    clearTimeout(scrollTimer);\r
    scrollTimer = setTimeout(function () {\r
      var trackLeft = track.scrollLeft;\r
      var closest = 0;\r
      var minDist = Infinity;\r
      cards.forEach(function (card, i) {\r
        var dist = Math.abs(card.offsetLeft - track.offsetLeft - trackLeft);\r
        if (dist < minDist) { minDist = dist; closest = i; }\r
      });\r
      currentIndex = closest;\r
      updateUI();\r
    }, 80);\r
  });\r
\r
  updateUI();\r
})();\r
</script>\r
\r
{% schema %}\r
{\r
  "name": "AG Reviews",\r
  "settings": [\r
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Customers. Real Winters." },\r
    { "type": "text", "id": "avg_stars", "label": "Stars Display", "default": "★★★★★" },\r
    { "type": "text", "id": "avg_label", "label": "Average Label", "default": "4.6 / 5 — 42 Verified Buyers" }\r
  ],\r
  "blocks": [\r
    {\r
      "type": "review_card",\r
      "name": "Review",\r
      "settings": [\r
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },\r
        { "type": "text", "id": "headline", "label": "Headline" },\r
        { "type": "textarea", "id": "text", "label": "Review Text" },\r
        { "type": "text", "id": "meta", "label": "Reviewer Info" }\r
      ]\r
    }\r
  ],\r
