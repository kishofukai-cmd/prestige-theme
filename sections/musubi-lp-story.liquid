<style>
  .story {
    padding: 120px 20px;
    background: linear-gradient(180deg, #ffffff 0%, #faf7f2 100%);
    text-align: center;
  }

  .story__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .story__label {
    display: inline-block;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: #b8a78a;
    margin-bottom: 18px;
    font-weight: 600;
  }

  .story__heading {
    font-size: 2rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.7;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }

  .story__heading em {
    font-style: normal;
    color: #b8a78a;
    border-bottom: 2px solid #b8a78a;
    padding-bottom: 3px;
  }

  .story__divider {
    width: 40px;
    height: 2px;
    background: #d4c8b8;
    margin: 28px auto;
    border: none;
  }

  .story__body {
    font-size: 1.05rem;
    line-height: 2.2;
    color: #555;
    letter-spacing: 0.05em;
  }

  .story__body p {
    margin: 0;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .story {
      padding: 80px 16px;
    }

    .story__label {
      font-size: 0.72rem;
      margin-bottom: 14px;
    }

    .story__heading {
      font-size: 1.5rem;
      line-height: 1.6;
    }

    .story__body {
      font-size: 0.95rem;
      line-height: 2;
    }
  }
</style>

<section class="story" id="story">
  <div class="story__inner">
    <div class="story__label" data-reveal>
      {{ section.settings.label }}
    </div>

    <h2 class="story__heading" data-reveal>
      {{ section.settings.heading }}
    </h2>

    <hr class="story__divider" data-reveal>

    <div class="story__body" data-reveal>
      {{ section.settings.body }}
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const elements = document.querySelectorAll("[data-reveal]");
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    }, { threshold: 0.2 });

    elements.forEach(el => observer.observe(el));
  });
</script>

{% schema %}
{
  "name": "MUSUBI ストーリー",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "その悩みに、MUSUBIが考えたこと"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "見出し",
      "default": "<p>眠りには<em>「導入スイッチ」</em>が<br>必要だった</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文",
      "default": "<p>瞑想でもない。<br>フレグランスでもない。<br>包まれる「重さ」という、<br>物理的なスイッチ。</p>"
    }
  ],
  "presets": [
    {
      "name": "MUSUBI ストーリー"
    }
  ]
}
{% endschema %}