<style>
  .story {
    padding: 80px 20px;
    background: #fff;
    text-align: center;
  }
  .story__inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .story__heading {
    font-size: 1.8rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .story__heading em {
    font-style: normal;
    color: #b8a78a;
    border-bottom: 2px solid #b8a78a;
    padding-bottom: 2px;
  }
  .story__divider {
    width: 40px;
    height: 2px;
    background: #d4c8b8;
    margin: 24px auto;
    border: none;
  }
  .story__body {
    font-size: 1rem;
    line-height: 2;
    color: #666;
    letter-spacing: 0.03em;
  }
  .story__body p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .story {
      padding: 60px 16px;
    }
    .story__heading {
      font-size: 1.4rem;
    }
    .story__body {
      font-size: 0.9rem;
      line-height: 1.9;
    }
  }
</style>

<section class="story" id="story">
  <div class="story__inner">
    <h2 class="story__heading" data-reveal>
      {{ section.settings.heading | default: '眠りには<em>「導入スイッチ」</em>が<br>必要だった' }}
    </h2>
    <hr class="story__divider" data-reveal>
    <div class="story__body" data-reveal>
      {{ section.settings.body | default: '<p>瞑想でもない。<br>フレグランスでもない。<br>包まれる「重さ」という、<br>物理的なスイッチ。</p>' }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI ストーリー",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "見出し",
      "default": "<p>眠りには<em>「導入スイッチ」</em>が<br>必要だった</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文",
      "default": "<p>瞑想でもない。<br>フレグランスでもない。<br>包まれる「重さ」という、<br>物理的なスイッチ。</p>"
    }
  ],
  "presets": [
    {
      "name": "MUSUBI ストーリー"
    }
  ]
}
{% endschema %}
