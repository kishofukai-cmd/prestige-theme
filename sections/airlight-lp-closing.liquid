{% comment %} AirLight Jacket LP — Closing Section {% endcomment %}

<section class="al-closing" id="al-closing">
  <div class="al-closing__bg">
    {% if section.settings.bg_image != blank %}
      <img src="{{ section.settings.bg_image | img_url: '1600x' }}" alt="" loading="lazy">
    {% endif %}
  </div>

  <div class="al-closing__content" data-al-reveal>
    <p class="al-closing__eyebrow">{{ section.settings.eyebrow | default: 'KAPOK KNOT' }}</p>

    <h2 class="al-closing__title">
      {{ section.settings.title | default: 'The jacket that changes<br><em>what warmth means.</em>' }}
    </h2>

    <div class="al-closing__proofs">
      {% for block in section.blocks %}
        {% if block.type == 'proof_line' %}
          <span class="al-closing__proof-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>

    <a href="{{ section.settings.cta_url | default: '#' }}" class="al-cta__btn">
      {{ section.settings.cta_text | default: 'Shop Now — Free Shipping →' }}
    </a>

    <div class="al-cta__micros" style="margin-top:20px;">
      <span>{{ section.settings.micro_1 | default: '✓ Free worldwide shipping' }}</span>
      <span>{{ section.settings.micro_2 | default: '✓ First 100 orders only' }}</span>
      <span>{{ section.settings.micro_3 | default: '✓ 30-day returns' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AirLight Closing",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KAPOK KNOT" },
    { "type": "richtext", "id": "title", "label": "Closing Title", "default": "<p>The jacket that changes<br><em>what warmth means.</em></p>" },
    { "type": "url", "id": "cta_url", "label": "CTA Link" },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop Now — Free Shipping →" },
    { "type": "text", "id": "micro_1", "label": "Micro 1", "default": "✓ Free worldwide shipping" },
    { "type": "text", "id": "micro_2", "label": "Micro 2", "default": "✓ First 100 orders only" },
    { "type": "text", "id": "micro_3", "label": "Micro 3", "default": "✓ 30-day returns" }
  ],
  "blocks": [
    {
      "type": "proof_line",
      "name": "Proof Tag",
      "settings": [
        { "type": "text", "id": "text", "label": "Proof Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AirLight Closing",
      "blocks": [
        { "type": "proof_line", "settings": { "text": "¥50M+ Crowdfunded in Japan" } },
        { "type": "proof_line", "settings": { "text": "10+ Design Awards" } },
        { "type": "proof_line", "settings": { "text": "Milano Unica Exhibitor" } },
        { "type": "proof_line", "settings": { "text": "★ Fumi Nikaido Collab" } }
      ]
    }
  ]
}
{% endschema %}
