{% comment %}
  AirLight 2026 — Hero / KV
  airlight2025-hero をもとに作成（2025版は変更しない）。
  - KV は一枚画像。PC用とスマホ用（768px以下）を別々に設定できる。スマホ用が空ならPC用を出す
  - KV の下に アイブロー／見出し／サブテキスト／CTA ボタン＋注記
{% endcomment %}

{%- liquid
  assign sid = section.settings.section_id | default: 'a26-hero'
  assign pc_src = ''
  if section.settings.kv_image != blank
    assign pc_src = section.settings.kv_image | image_url: width: 2000
  elsif section.settings.kv_image_url != blank
    assign pc_src = section.settings.kv_image_url
  endif
  assign sp_src = ''
  if section.settings.kv_image_sp != blank
    assign sp_src = section.settings.kv_image_sp | image_url: width: 1200
  elsif section.settings.kv_image_sp_url != blank
    assign sp_src = section.settings.kv_image_sp_url
  endif
-%}

<style>
  .a26-hero {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: 0 0 clamp(24px, 5vw, 56px);
    overflow: hidden;
  }
  .a26-hero__kv-wrap {
    width: 100%;
    margin: 0 auto clamp(24px, 4vw, 48px);
  }
  .a26-hero__kv-wrap picture { display: block; }
  .a26-hero__kv {
    width: 100%;
    height: auto;
    display: block;
  }
  .a26-hero__inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 24px);
    text-align: center;
  }
  .a26-hero__eyebrow {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(11px, 1.5vw, 13px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#c29d66' }};
    margin: 0 0 clamp(12px, 2vw, 20px);
  }
  .a26-hero__heading {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1.4rem, 3.8vw, 2.1rem);
    font-weight: 500;
    line-height: 1.55;
    color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    margin: 0 0 clamp(16px, 2.5vw, 24px);
    letter-spacing: 0.02em;
  }
  .a26-hero__heading p { margin: 0 0 0.4em; }
  .a26-hero__heading p:last-child { margin-bottom: 0; }
  .a26-hero__heading em {
    font-style: normal;
    font-weight: 700;
    display: inline-block;
    margin-top: 0.2em;
    font-size: 1.15em;
  }
  .a26-hero__sub {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: clamp(13px, 1.8vw, 15px);
    line-height: 1.8;
    color: {{ section.settings.sub_color | default: '#5a5550' }};
    margin: 0 auto clamp(20px, 3vw, 32px);
    max-width: 640px;
  }
  .a26-hero__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: clamp(20px, 3vw, 32px);
  }
  .a26-hero__cta {
    display: inline-block;
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: {{ section.settings.cta_text_color | default: '#ffffff' }};
    background: {{ section.settings.cta_bg_color | default: '#1a1a1a' }};
    border-radius: 100px;
    padding: 14px 40px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
    min-width: 260px;
    text-align: center;
    box-sizing: border-box;
  }
  .a26-hero__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }
  .a26-hero__cta-note {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #8a7f6e;
    margin: 0;
  }
  .a26-hero__footnote {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: 10.5px;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: #8a7f6e;
    max-width: 560px;
    margin: clamp(14px, 2vw, 20px) auto 0;
  }
  @media (max-width: 768px) {
    .a26-hero__inner { padding: 0 16px; }
    .a26-hero__heading {
      font-size: clamp(1.2rem, 4.8vw, 1.6rem);
      line-height: 1.6;
    }
    .a26-hero__sub { font-size: 13px; }
    .a26-hero__cta {
      width: 100%;
      min-width: 0;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<section class="a26-hero" id="{{ sid }}">
  {%- if pc_src != '' or sp_src != '' -%}
    <div class="a26-hero__kv-wrap">
      <picture>
        {%- if sp_src != '' and pc_src != '' -%}
          <source media="(max-width: 768px)" srcset="{{ sp_src }}">
        {%- endif -%}
        <img class="a26-hero__kv"
             src="{% if pc_src != '' %}{{ pc_src }}{% else %}{{ sp_src }}{% endif %}"
             alt="{{ section.settings.kv_image_alt | escape }}"
             width="2400" height="1326"
             loading="eager" fetchpriority="high">
      </picture>
    </div>
  {%- endif -%}

  <div class="a26-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="a26-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <div class="a26-hero__heading">{{ section.settings.heading }}</div>
    {%- endif -%}
    {%- if section.settings.sub_text != blank -%}
      <p class="a26-hero__sub">{{ section.settings.sub_text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="a26-hero__cta-wrap">
        <a class="a26-hero__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{ section.settings.cta_text }}
        </a>
        {%- if section.settings.cta_note != blank -%}
          <p class="a26-hero__cta-note">{{ section.settings.cta_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <p class="a26-hero__footnote">{{ section.settings.footnote | newline_to_br }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "A2026 Hero",
  "tag": "section",
  "class": "shopify-section--a26-hero",
  "settings": [
    { "type": "header", "content": "セクション ID / 背景" },
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "a26-hero" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#ffffff" },

    { "type": "header", "content": "KV 画像（PC）" },
    { "type": "image_picker", "id": "kv_image", "label": "KV 画像（PC・横長）" },
    { "type": "text", "id": "kv_image_url", "label": "KV 画像 URL（PC・画像未設定時に使う）" },

    { "type": "header", "content": "KV 画像（スマホ・768px以下）" },
    { "type": "image_picker", "id": "kv_image_sp", "label": "KV 画像（スマホ・4:3 程度）" },
    { "type": "text", "id": "kv_image_sp_url", "label": "KV 画像 URL（スマホ・空ならPC用を表示）" },
    { "type": "text", "id": "kv_image_alt", "label": "KV 画像の代替テキスト" },

    { "type": "header", "content": "KV下の見出しテキスト" },
    { "type": "text", "id": "eyebrow", "label": "アイブロー（上の小さな文字）", "default": "KAPOK KNOT — AirLight Jacket 2026" },
    { "type": "color", "id": "eyebrow_color", "label": "アイブロー色", "default": "#c29d66" },
    { "type": "richtext", "id": "heading", "label": "メイン見出し", "default": "<p>空も飛べそうな、軽さへ。</p>" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "textarea", "id": "sub_text", "label": "サブテキスト" },
    { "type": "color", "id": "sub_color", "label": "サブテキスト色", "default": "#5a5550" },

    { "type": "header", "content": "CTA ボタン" },
    { "type": "text", "id": "cta_text", "label": "ボタンテキスト", "default": "商品を見る →" },
    { "type": "url", "id": "cta_url", "label": "ボタンリンク" },
    { "type": "color", "id": "cta_bg_color", "label": "ボタン背景色", "default": "#1a1a1a" },
    { "type": "color", "id": "cta_text_color", "label": "ボタン文字色", "default": "#ffffff" },
    { "type": "text", "id": "cta_note", "label": "ボタン下の注記" },
    { "type": "textarea", "id": "footnote", "label": "最下部の小さな注記（エンブレムの説明など・空なら非表示）" }
  ],
  "presets": [
    { "name": "A2026 Hero" }
  ]
}
{% endschema %}
