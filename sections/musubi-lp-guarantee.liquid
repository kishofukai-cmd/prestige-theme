{% comment %} MUSUBI LP - 安心保証バナー (Guarantee) {% endcomment %}
<section class="guarantee" id="guarantee">
  <div class="container--narrow">
    <div class="guarantee__list" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'badge' %}
          <div class="guarantee__item" {{ block.shopify_attributes }}>
            <div class="guarantee__icon">
              <!-- アイコンSVGはテーマエディタで設定可能に -->
              {% if block.settings.icon_svg != blank %}
                {{ block.settings.icon_svg }}
              {% else %}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {% endif %}
            </div>
            <p class="guarantee__text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

