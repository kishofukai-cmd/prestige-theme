{% comment %} AirLight Global LP — Closing (Full-screen CTA) {% endcomment %}

<style>
  .ag-closing {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ag-bg-dark, #1a2640);
    color: var(--ag-text-light, #faf8f5);
    overflow: hidden;
  }
  .ag-closing__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .ag-closing__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }
  .ag-closing__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to top, rgba(26,38,64,0.95), rgba(26,38,64,0.48));
  }
  .ag-closing__content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 80px var(--ag-pad, 24px);
    max-width: 680px;
    width: 100%;
  }
  .ag-closing__eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ag-gold, #c29d66);
    margin-bottom: 24px;
  }
  .ag-closing__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 28px;
  }
  .ag-closing__title em { font-style: italic; color: var(--ag-gold, #c29d66); }
  .ag-closing__title p { font-size: inherit; font-family: inherit; font-weight: inherit; line-height: inherit; margin: 0; }
  .ag-closing__proofs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 20px;
    margin-bottom: 20px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    color: rgba(250,248,245,0.6);
  }
  .ag-closing__spots {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--ag-gold, #c29d66);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }
  .ag-closing__btn {
    display: inline-block;
    padding: 16px 56px;
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ag-bg-dark, #1a2640);
    background: linear-gradient(135deg, var(--ag-gold, #c29d66), #d4b78a);
    border-radius: 100px;
    box-shadow: 0 4px 20px rgba(194,157,102,0.5);
    transition: all 0.3s ease;
    text-decoration: none;
  }
  .ag-closing__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(194,157,102,0.6);
  }
  .ag-closing__micros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin-top: 16px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    color: rgba(250,248,245,0.5);
  }

  @media (max-width: 768px) {
    .ag-closing__content { padding: 60px 16px 80px; }
    .ag-closing__title { font-size: clamp(1.7rem, 6vw, 2.2rem); margin-bottom: 20px; }
    .ag-closing__btn {
      width: 100%;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      padding: 16px 24px;
    }
    .ag-closing__proofs { flex-direction: column; gap: 8px; align-items: center; }
    .ag-closing__micros { flex-direction: column; gap: 6px; align-items: center; }
    .ag-closing__spots { font-size: 11px; }
  }
</style>

<section class="ag-closing" id="ag-closing">
  <div class="ag-closing__bg">
    {% if section.settings.bg_image %}
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: alt: 'AirLight Jacket', loading: 'lazy' }}
    {% elsif section.settings.fallback_url != blank %}
      <img src="{{ section.settings.fallback_url }}" alt="AirLight Jacket" loading="lazy">
    {% endif %}
  </div>
  <div class="ag-closing__overlay"></div>

  <div class="ag-closing__content" data-ag-reveal>
    <p class="ag-closing__eyebrow">{{ section.settings.eyebrow | default: 'KAPOK KNOT' }}</p>

    <h2 class="ag-closing__title">
      {{ section.settings.title }}
    </h2>

    <div class="ag-closing__proofs">
      {% for block in section.blocks %}
        {% if block.type == 'proof_line' %}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.spots_text != blank %}
      <p class="ag-closing__spots">{{ section.settings.spots_text }}</p>
    {% endif %}

    <a href="{{ section.settings.cta_url | default: '#ag-products' }}" class="ag-closing__btn">
      {{ section.settings.cta_text | default: 'Shop Now →' }}
    </a>

    <div class="ag-closing__micros">
      {% if section.settings.micro_1 != blank %}<span>{{ section.settings.micro_1 }}</span>{% endif %}
      {% if section.settings.micro_2 != blank %}<span>{{ section.settings.micro_2 }}</span>{% endif %}
      {% if section.settings.micro_3 != blank %}<span>{{ section.settings.micro_3 }}</span>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AG Closing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "KAPOK KNOT" },
    { "type": "richtext", "id": "title", "label": "Title", "default": "<p>The jacket that changes<br><em>what warmth means.</em></p>" },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Shop Now →" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "fallback_url", "label": "Background Image URL (fallback)" },
    { "type": "text", "id": "spots_text", "label": "Spots Remaining Text", "default": "Only 100 Global Launch Spots Available." },
    { "type": "text", "id": "micro_1", "label": "Micro 1" },
    { "type": "text", "id": "micro_2", "label": "Micro 2" },
    { "type": "text", "id": "micro_3", "label": "Micro 3", "default": "✓ Secure checkout" }
  ],
  "blocks": [
    {
      "type": "proof_line",
      "name": "Proof Line",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Closing",
      "blocks": [
        { "type": "proof_line", "settings": { "text": "¥50M+ Crowdfunded in Japan" } },
        { "type": "proof_line", "settings": { "text": "10+ Design Awards" } },
        { "type": "proof_line", "settings": { "text": "Milano Unica Exhibitor" } },
        { "type": "proof_line", "settings": { "text": "★ 4.8 Review Score" } }
      ]
    }
  ]
}
{% endschema %}
