<style>
  .reviews {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .reviews__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .reviews__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .reviews__label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 8px 15px;
    border-radius: 999px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .reviews__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .reviews__heading p {
    margin: 0;
  }

  .reviews__graph {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 32px;
    align-items: center;
    margin-bottom: 36px;
    padding: 34px;
    border-radius: {{ section.settings.graph_radius }}px;
    background: {{ section.settings.graph_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
  }

  .reviews__graph-summary {
    text-align: center;
  }

  .reviews__graph-score {
    display: block;
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.score_size_pc }}px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 10px;
  }

  .reviews__graph-stars {
    color: {{ section.settings.star_color }};
    font-size: {{ section.settings.star_size_pc }}px;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .reviews__graph-count {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.count_size_pc }}px;
    font-weight: 600;
  }

  .reviews__graph-bars {
    display: grid;
    gap: 10px;
  }

  .reviews__graph-row {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    gap: 10px;
    align-items: center;
  }

  .reviews__graph-label,
  .reviews__graph-pct {
    color: {{ section.settings.text_color }};
    font-size: 13px;
    font-weight: 700;
  }

  .reviews__graph-pct {
    text-align: right;
  }

  .reviews__graph-bar {
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: {{ section.settings.bar_bg_color }};
  }

  .reviews__graph-fill {
    height: 100%;
    width: var(--bar-width);
    border-radius: 999px;
    background: {{ section.settings.accent_color }};
  }

  .reviews__cards {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_pc }}, minmax(0, 1fr));
    gap: 18px;
  }

  .reviews__card {
    padding: 24px;
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    box-shadow: 0 12px 34px rgba(0,0,0,0.05);
    text-align: left;
  }

  .reviews__card-stars {
    color: {{ section.settings.star_color }};
    font-size: 14px;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .reviews__card-title {
    margin: 0 0 12px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
  }

  .reviews__card-text {
    margin: 0 0 16px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.body_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .reviews__card-meta {
    margin-bottom: 12px;
    color: {{ section.settings.meta_color }};
    font-size: 12px;
  }

  .reviews__card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .reviews__tag {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 999px;
    background: {{ section.settings.tag_bg_color }};
    color: {{ section.settings.tag_color }};
    font-size: 11px;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .reviews {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .reviews__header {
      margin-bottom: 28px;
    }

    .reviews__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .reviews__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .reviews__graph {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 26px 18px;
      border-radius: {{ section.settings.graph_radius_sp }}px;
    }

    .reviews__graph-score {
      font-size: {{ section.settings.score_size_sp }}px;
    }

    .reviews__graph-stars {
      font-size: {{ section.settings.star_size_sp }}px;
    }

    .reviews__graph-count {
      font-size: {{ section.settings.count_size_sp }}px;
    }

    .reviews__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .reviews__card {
      padding: 22px 18px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .reviews__card-title {
      font-size: {{ section.settings.title_size_sp }}px;
    }

    .reviews__card-text {
      font-size: {{ section.settings.body_size_sp }}px;
    }
  }
</style>

<section class="reviews" id="reviews-{{ section.id }}">
  <div class="reviews__inner">

    <div class="reviews__header">
      {% if section.settings.label != blank %}
        <div class="reviews__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="reviews__heading">
        {{ section.settings.heading }}
      </h2>
    </div>

    {% if section.settings.show_graph %}
      <div class="reviews__graph">
        <div class="reviews__graph-summary">
          <span class="reviews__graph-score">{{ section.settings.avg_score }}</span>
          <div class="reviews__graph-stars">{{ section.settings.avg_stars }}</div>
          <span class="reviews__graph-count">{{ section.settings.review_count }}</span>
        </div>

        <div class="reviews__graph-bars">
          <div class="reviews__graph-row">
            <span class="reviews__graph-label">★5</span>
            <div class="reviews__graph-bar">
              <div class="reviews__graph-fill" style="--bar-width: {{ section.settings.star5_pct }}%;"></div>
            </div>
            <span class="reviews__graph-pct">{{ section.settings.star5_pct }}%</span>
          </div>

          <div class="reviews__graph-row">
            <span class="reviews__graph-label">★4</span>
            <div class="reviews__graph-bar">
              <div class="reviews__graph-fill" style="--bar-width: {{ section.settings.star4_pct }}%;"></div>
            </div>
            <span class="reviews__graph-pct">{{ section.settings.star4_pct }}%</span>
          </div>

          <div class="reviews__graph-row">
            <span class="reviews__graph-label">★3</span>
            <div class="reviews__graph-bar">
              <div class="reviews__graph-fill" style="--bar-width: {{ section.settings.star3_pct }}%;"></div>
            </div>
            <span class="reviews__graph-pct">{{ section.settings.star3_pct }}%</span>
          </div>

          <div class="reviews__graph-row">
            <span class="reviews__graph-label">★2</span>
            <div class="reviews__graph-bar">
              <div class="reviews__graph-fill" style="--bar-width: {{ section.settings.star2_pct }}%;"></div>
            </div>
            <span class="reviews__graph-pct">{{ section.settings.star2_pct }}%</span>
          </div>

          <div class="reviews__graph-row">
            <span class="reviews__graph-label">★1</span>
            <div class="reviews__graph-bar">
              <div class="reviews__graph-fill" style="--bar-width: {{ section.settings.star1_pct }}%;"></div>
            </div>
            <span class="reviews__graph-pct">{{ section.settings.star1_pct }}%</span>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="reviews__cards">
      {% for block in section.blocks %}
        <div class="reviews__card" {{ block.shopify_attributes }}>
          <div class="reviews__card-stars">
            {{ block.settings.stars }}
          </div>

          {% if block.settings.title != blank %}
            <h4 class="reviews__card-title">
              {{ block.settings.title }}
            </h4>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="reviews__card-text">
              {{ block.settings.text }}
            </p>
          {% endif %}

          {% if block.settings.meta != blank %}
            <div class="reviews__card-meta">
              {{ block.settings.meta }}
            </div>
          {% endif %}

          {% if block.settings.tags != blank %}
            <div class="reviews__card-tags">
              {% assign tags = block.settings.tags | split: ',' %}
              {% for tag in tags %}
                {% if tag != blank %}
                  <span class="reviews__tag">{{ tag | strip }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

