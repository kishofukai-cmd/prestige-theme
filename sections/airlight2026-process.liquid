{% comment %}
  AirLight 2026 — 工程（PROCESS）
  ブロック「工程」= 番号／英字ラベル／見出し／本文／イラスト（線画SVG 4種）か任意の画像
  - PC: 横並び（ホバーで少し浮く）
  - スマホ: 横スクロールのカルーセル（scroll-snap・1枚 82%・ドット）。中央のカードが正面、
    両脇は rotateY(±16deg)・scale(0.94) で奥に下がる（JS でスクロール位置から計算）
  - 見えた時にカードが順番にふわっと出る。prefers-reduced-motion: reduce では静止
{% endcomment %}

{%- assign sid = section.settings.section_id | default: section.id -%}
{%- assign accent = section.settings.accent_color | default: '#c29d66' -%}
{%- assign cols = section.blocks.size | at_least: 1 | at_most: 4 -%}

<style>
  #{{ sid }}.a26-pr {
    background: {{ section.settings.bg_color | default: '#faf9f6' }};
    color: {{ section.settings.text_color | default: '#1a1a1a' }};
    padding: clamp(40px, 7vw, 88px) 0;
    overflow: hidden;
  }
  #{{ sid }} .a26-pr__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
  }
  #{{ sid }} .a26-pr__head { text-align: center; max-width: 720px; margin: 0 auto clamp(24px, 4vw, 44px); }
  #{{ sid }} .a26-pr__kicker {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 12px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
    color: {{ accent }}; margin: 0 0 12px;
  }
  #{{ sid }} .a26-pr__heading {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 3.4vw, 2.2rem); font-weight: 500; line-height: 1.5; letter-spacing: 0.04em;
    margin: 0; word-break: keep-all; overflow-wrap: anywhere;
  }
  #{{ sid }} .a26-pr__lead {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: clamp(14px, 1.6vw, 15px); line-height: 1.9;
    color: {{ section.settings.body_color | default: '#4a4540' }}; margin: 14px 0 0;
  }

  #{{ sid }} .a26-pr__track {
    list-style: none; margin: 0; padding: 8px 0 12px;
    display: grid;
    grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
    perspective: 1000px;
  }
  #{{ sid }} .a26-pr__card {
    transform-style: preserve-3d;
    will-change: transform;
  }
  #{{ sid }} .a26-pr__card-in {
    height: 100%;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid rgba(26, 26, 26, 0.07);
    border-radius: 14px;
    padding: clamp(20px, 2.4vw, 28px) clamp(18px, 2vw, 24px) clamp(22px, 2.6vw, 30px);
    box-shadow: 0 10px 30px rgba(26, 26, 26, 0.05);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, opacity 0.7s ease;
  }
  #{{ sid }} .a26-pr__art {
    width: 76px; height: 76px; margin: 0 0 16px;
    color: {{ section.settings.art_color | default: accent }};
  }
  #{{ sid }} .a26-pr__art svg { width: 100%; height: 100%; display: block; }
  #{{ sid }} .a26-pr__art img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #{{ sid }} .a26-pr__label {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 11px; font-weight: 600; letter-spacing: 0.2em;
    color: {{ accent }}; margin: 0 0 8px;
  }
  #{{ sid }} .a26-pr__label b { font-weight: 700; color: {{ section.settings.text_color | default: '#1a1a1a' }}; margin-right: 0.5em; }
  #{{ sid }} .a26-pr__title {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1.02rem, 1.5vw, 1.12rem); font-weight: 600; line-height: 1.55;
    margin: 0 0 10px; word-break: keep-all; overflow-wrap: anywhere;
  }
  #{{ sid }} .a26-pr__text {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: 13.5px; line-height: 1.85;
    color: {{ section.settings.body_color | default: '#4a4540' }}; margin: 0;
  }
  #{{ sid }} .a26-pr__dots { display: none; }

  @media (hover: hover) and (min-width: 769px) {
    #{{ sid }} .a26-pr__card:hover .a26-pr__card-in {
      transform: translateY(-6px);
      box-shadow: 0 18px 40px rgba(26, 26, 26, 0.10);
    }
  }

  /* 見えた時に順番に出る（JS が .is-pre を付けた時だけ隠す＝JSが動かなくても内容は見える） */
  #{{ sid }} .a26-pr__card.is-pre .a26-pr__card-in { opacity: 0; transform: translateY(16px); }
  #{{ sid }} .a26-pr__card.is-in .a26-pr__card-in { opacity: 1; }

  @media (max-width: 768px) {
    #{{ sid }} .a26-pr__inner { padding: 0; }
    #{{ sid }} .a26-pr__head { padding: 0 16px; }
    #{{ sid }} .a26-pr__track {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 10px 9vw 18px;
      scroll-padding: 0 9vw;
    }
    #{{ sid }} .a26-pr__track::-webkit-scrollbar { display: none; }
    #{{ sid }} .a26-pr__card {
      flex: 0 0 82vw;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      transition: transform 0.12s linear;
    }
    #{{ sid }} .a26-pr__dots {
      display: flex; justify-content: center; gap: 8px; margin: 4px 0 0; padding: 0; list-style: none;
    }
    #{{ sid }} .a26-pr__dot {
      width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%;
      background: rgba(26, 26, 26, 0.18); cursor: pointer;
      transition: width 0.3s ease, background 0.3s ease, border-radius 0.3s ease;
    }
    #{{ sid }} .a26-pr__card.is-center .a26-pr__card-in { box-shadow: 0 18px 44px rgba(26, 26, 26, 0.12); }
    #{{ sid }} .a26-pr__dot.is-active { width: 20px; border-radius: 4px; background: {{ accent }}; }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} .a26-pr__card,
    #{{ sid }} .a26-pr__card-in { transition: none !important; transform: none !important; opacity: 1 !important; }
  }
</style>

<section class="a26-pr" id="{{ sid }}" data-a26-process>
  <div class="a26-pr__inner">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.lead != blank -%}
      <div class="a26-pr__head">
        {%- if section.settings.kicker != blank -%}<p class="a26-pr__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="a26-pr__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.lead != blank -%}<p class="a26-pr__lead">{{ section.settings.lead | newline_to_br }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="a26-pr__track" data-a26-track>
        {%- for block in section.blocks -%}
          <li class="a26-pr__card" data-a26-card {{ block.shopify_attributes }}>
            <div class="a26-pr__card-in">
              {%- if block.settings.image != blank -%}
                <div class="a26-pr__art">
                  <img src="{{ block.settings.image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy">
                </div>
              {%- elsif block.settings.illust != 'none' -%}
                <div class="a26-pr__art" aria-hidden="true">
                  {%- case block.settings.illust -%}
                    {%- when 'farm' -%}
                      <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M40 72 V14"/>
                        <path d="M10 72 H70"/>
                        <path d="M40 46 C32 43 22 42 12 42"/>
                        <path d="M40 46 C48 43 58 42 68 42"/>
                        <path d="M40 30 C34 27 27 26 20 26"/>
                        <path d="M40 30 C46 27 53 26 60 26"/>
                        <path d="M40 18 C37 16 33 15 30 15"/>
                        <path d="M40 18 C43 16 47 15 50 15"/>
                        <path d="M18 42 V45"/><path d="M18 45 C15 47 15 56 18 59 C21 56 21 47 18 45 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M62 42 V45"/><path d="M62 45 C59 47 59 56 62 59 C65 56 65 47 62 45 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M28 27 V30"/><path d="M28 30 C25.6 31.6 25.6 39 28 41.5 C30.4 39 30.4 31.6 28 30 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M53 26.5 V29"/><path d="M53 29 C50.8 30.5 50.8 37 53 39 C55.2 37 55.2 30.5 53 29 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M10 42 c-2 -3 -1 -6 2 -7 c1 3 0 6 -2 7 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M70 42 c2 -3 1 -6 -2 -7 c-1 3 0 6 2 7 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M30 15 c-2 -2 -2 -5 0 -6 c2 1 2 4 0 6 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M50 15 c2 -2 2 -5 0 -6 c-2 1 -2 4 0 6 Z" fill="currentColor" fill-opacity="0.16"/>
                      </svg>
                    {%- when 'factory' -%}
                      <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 44 a6 6 0 0 1 4 -10 a7.5 7.5 0 0 1 13 -4 a6.5 6.5 0 0 1 11 4 a5.5 5.5 0 0 1 -1 11 H12 a3.5 3.5 0 0 1 -3 -1 Z" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M17 38 c2 -2 4 -2 6 0"/><path d="M26 34 c2 -1.5 4 -1.5 6 0"/>
                        <circle cx="54" cy="35" r="9" fill="currentColor" fill-opacity="0.10"/>
                        <circle cx="54" cy="57" r="9" fill="currentColor" fill-opacity="0.10"/>
                        <circle cx="54" cy="35" r="1.6"/>
                        <circle cx="54" cy="57" r="1.6"/>
                        <path d="M38 46 C41 44.5 43 47.5 45 46"/>
                        <path d="M63 45 H74"/><path d="M63 47 H74"/>
                        <path d="M68 41 l3 3 l-3 3" stroke-width="1.5"/>
                        <path d="M12 72 H70"/>
                        <path d="M47 66 V72"/><path d="M61 66 V72"/>
                      </svg>
                    {%- when 'sewing' -%}
                      <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="8" y="58" width="64" height="8" rx="2" fill="currentColor" fill-opacity="0.12"/>
                        <path d="M62 58 V27 C62 22.5 59 20 54.5 20 H23 C18.5 20 16 22.5 16 27 V40 C16 42 17 43 19 43 H28 C30 43 31 42 31 40 V32 H50 V58"/>
                        <path d="M23.5 43 V51"/>
                        <path d="M23.5 51 V54" stroke-width="1.2"/>
                        <path d="M18.5 54 H28.5"/>
                        <path d="M38 20 V15"/>
                        <rect x="34.5" y="10" width="7" height="5" rx="1" fill="currentColor" fill-opacity="0.16"/>
                        <path d="M34.5 12.5 C28 13 24 15.5 22.5 20" stroke-width="1.2"/>
                        <path d="M10 55.5 C18 53.5 28 57 38 55 C42 54.2 45 54.4 47 55"/>
                        <path d="M56 38 a4 4 0 1 1 0.01 0" />
                      </svg>
                    {%- when 'textile' -%}
                      <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 14 H58" stroke-width="2.2"/>
                        <path d="M10 66 H58" stroke-width="2.2"/>
                        <path d="M18 14 V66"/><path d="M26 14 V66"/><path d="M34 14 V66"/><path d="M42 14 V66"/><path d="M50 14 V66"/>
                        <rect x="14" y="37" width="40" height="27" fill="currentColor" fill-opacity="0.10" stroke="none"/>
                        <path d="M14 40 C16 37.5 20 42.5 22 40 C24 37.5 28 42.5 30 40 C32 37.5 36 42.5 38 40 C40 37.5 44 42.5 46 40 C48 37.5 52 42.5 54 40"/>
                        <path d="M14 47 C16 49.5 20 44.5 22 47 C24 49.5 28 44.5 30 47 C32 49.5 36 44.5 38 47 C40 49.5 44 44.5 46 47 C48 49.5 52 44.5 54 47"/>
                        <path d="M14 54 C16 51.5 20 56.5 22 54 C24 51.5 28 56.5 30 54 C32 51.5 36 56.5 38 54 C40 51.5 44 56.5 46 54 C48 51.5 52 56.5 54 54"/>
                        <path d="M14 61 C16 63.5 20 58.5 22 61 C24 63.5 28 58.5 30 61 C32 63.5 36 58.5 38 61 C40 63.5 44 58.5 46 61 C48 63.5 52 58.5 54 61"/>
                        <path d="M54 40 C58 38 60 36 61 33"/>
                        <path d="M60 33 C62 28 70 26 74 28 C72 32 64 36 60 33 Z" fill="currentColor" fill-opacity="0.16"/>
                      </svg>
                  {%- endcase -%}
                </div>
              {%- endif -%}
              {%- if block.settings.number != blank or block.settings.label != blank -%}
                <p class="a26-pr__label">{%- if block.settings.number != blank -%}<b>{{ block.settings.number }}</b>{%- endif -%}{{ block.settings.label }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}<h3 class="a26-pr__title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="a26-pr__text">{{ block.settings.text | newline_to_br }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.blocks.size > 1 -%}
        <div class="a26-pr__dots" data-a26-dots>
          {%- for block in section.blocks -%}
            <button type="button" class="a26-pr__dot{% if forloop.first %} is-active{% endif %}" data-a26-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}枚目を表示"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% javascript %}
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var mqSp = window.matchMedia ? window.matchMedia('(max-width: 768px)') : { matches: false };

  function initProcess(root) {
    if (!root || root.dataset.a26Init) return;
    root.dataset.a26Init = '1';
    var track = root.querySelector('[data-a26-track]');
    if (!track) return;
    var cards = Array.prototype.slice.call(track.querySelectorAll('[data-a26-card]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-a26-dot]'));
    var ticking = false;

    function update() {
      ticking = false;
      if (!mqSp.matches) {
        cards.forEach(function (c) { c.style.transform = ''; });
        return;
      }
      var tr = track.getBoundingClientRect();
      var center = tr.left + tr.width / 2;
      var best = 0, bestD = Infinity;
      cards.forEach(function (c, i) {
        var r = c.getBoundingClientRect();
        var d = (r.left + r.width / 2 - center) / (r.width || 1);
        var t = Math.max(-1, Math.min(1, d));
        if (Math.abs(d) < bestD) { bestD = Math.abs(d); best = i; }
        if (!reduce) {
          c.style.transform = 'rotateY(' + (t * 16).toFixed(2) + 'deg) scale(' + (1 - Math.abs(t) * 0.06).toFixed(3) + ')';
        }
      });
      cards.forEach(function (c, i) { c.classList.toggle('is-center', i === best); });
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === best); });
    }
    function onScroll() {
      if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
    }
    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    dots.forEach(function (d, i) {
      d.addEventListener('click', function () {
        var c = cards[i]; if (!c) return;
        track.scrollTo({ left: c.offsetLeft - (track.clientWidth - c.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
      });
    });
    update();

    // 見えた時に順番にふわっと出る
    if (!reduce && 'IntersectionObserver' in window) {
      cards.forEach(function (c, i) {
        c.classList.add('is-pre');
        c.querySelector('.a26-pr__card-in').style.transitionDelay = (i * 0.12) + 's';
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          cards.forEach(function (c) { c.classList.add('is-in'); c.classList.remove('is-pre'); });
          setTimeout(function () {
            cards.forEach(function (c) { c.querySelector('.a26-pr__card-in').style.transitionDelay = ''; });
          }, 1400);
          io.disconnect();
        });
      }, { threshold: 0.2 });
      io.observe(track);
    }
  }

  function initAll(scope) {
    Array.prototype.forEach.call((scope || document).querySelectorAll('[data-a26-process]'), initProcess);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }
  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "A2026 工程（PROCESS）",
  "tag": "div",
  "class": "shopify-section--a26-process",
  "settings": [
    { "type": "text", "id": "section_id", "label": "Section ID（ページ内リンク用・英数字）" },
    { "type": "text", "id": "kicker", "label": "キッカー（上の小さな文字）", "default": "PROCESS" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "農園から、一着になるまで。" },
    { "type": "textarea", "id": "lead", "label": "リード文（空なら非表示）" },
    { "type": "header", "content": "色" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#faf9f6" },
    { "type": "color", "id": "text_color", "label": "見出しの色", "default": "#1a1a1a" },
    { "type": "color", "id": "body_color", "label": "本文の色", "default": "#4a4540" },
    { "type": "color", "id": "accent_color", "label": "強調の色（キッカー・ラベル・ドット）", "default": "#c29d66" },
    { "type": "color", "id": "art_color", "label": "イラストの色", "default": "#c29d66" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "工程",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "number", "label": "番号", "default": "01" },
        { "type": "text", "id": "label", "label": "英字ラベル", "default": "FARM" },
        { "type": "text", "id": "title", "label": "見出し" },
        { "type": "textarea", "id": "text", "label": "本文" },
        {
          "type": "select", "id": "illust", "label": "イラスト",
          "options": [
            { "value": "farm", "label": "農園（カポックの木と実）" },
            { "value": "factory", "label": "加工（綿とローラー）" },
            { "value": "sewing", "label": "縫製（ミシン）" },
            { "value": "textile", "label": "織物（織機）" },
            { "value": "none", "label": "なし" }
          ],
          "default": "farm"
        },
        { "type": "image_picker", "id": "image", "label": "画像（入れるとイラストより優先）" }
      ]
    }
  ],
  "presets": [
    { "name": "A2026 工程（PROCESS）" }
  ]
}
{% endschema %}
