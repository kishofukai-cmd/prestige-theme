<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap">
{{ 'k0-prototype.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign k0_cautions = section.blocks | where: 'type', 'caution'
  assign k0_supports = section.blocks | where: 'type', 'support'
-%}

<section class="k0 k0-apply" id="k0-apply">
  <div class="k0-wrap">

    <div class="k0-apply__head">
      {%- if section.settings.kicker != blank -%}
        <p class="k0-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="k0-apply__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="k0-apply__intro k0-rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} 注意カード {%- endcomment -%}
    {%- if k0_cautions.size > 0 -%}
      <div class="k0-caution-cards">
        {%- for block in k0_cautions -%}
          <div class="k0-caution-card" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <div class="k0-caution-card__n">{{ block.settings.number | escape }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="k0-caution-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="k0-caution-card__body k0-rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.summary != blank -%}
      <p class="k0-caution-summary">{{ section.settings.summary | escape }}</p>
    {%- endif -%}

    {%- comment -%} 購入後のサポート {%- endcomment -%}
    {%- if k0_supports.size > 0 -%}
      <div class="k0-support">
        {%- if section.settings.support_heading != blank -%}
          <h3 class="k0-support__heading">{{ section.settings.support_heading | escape }}</h3>
        {%- endif -%}
        {%- for block in k0_supports -%}
          {%- capture k0_idx -%}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{%- endcapture -%}
          <details class="k0-acc k0-acc--support"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            {%- render 'k0-acc-summary', title: block.settings.title, note: block.settings.summary_note, index: k0_idx -%}
            {%- if block.settings.body != blank -%}
              <div class="k0-acc__body k0-support__body k0-rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>



{% schema %}
{
  "name": "K-0 注意事項・サポート",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 50,
  "settings": [
    {
      "type": "header",
      "content": "見出し"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "小見出し（英字）",
      "default": "BEFORE YOU APPLY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "応募の前に、必ずご確認ください"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "導入文",
      "default": "<p>K-0 PROTOTYPEには、一般的なダウン製品とは異なる特性があります。<br>ご応募前に、必ず以下の点をご確認ください。</p>"
    },
    {
      "type": "paragraph",
      "content": "注意カードは「注意カード」ブロックで編集します。"
    },
    {
      "type": "text",
      "id": "summary",
      "label": "注意カードの後のまとめ",
      "default": "これらの特性をご理解いただいたうえで、抽選販売へのご応募をお願いいたします。"
    },
    {
      "type": "header",
      "content": "購入後のサポート"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "見出し",
      "default": "購入後のサポート — K-0 PROTOTYPEは、販売して終わりの製品ではありません"
    },
    {
      "type": "paragraph",
      "content": "各項目は「サポート」ブロックで編集します（番号 01・02… は自動）。見出し行だけ見え、開くと本文が出ます。"
    }
  ],
  "blocks": [
    {
      "type": "caution",
      "name": "注意カード",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "番号",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "見出し"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "本文"
        }
      ]
    },
    {
      "type": "support",
      "name": "サポート",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "見出し"
        },
        {
          "type": "text",
          "id": "summary_note",
          "label": "閉じた状態の補足",
          "info": "見出しの下に薄い文字で出ます（空欄なら出しません）"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "本文（開くと表示）"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "最初から開く",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "K-0 注意事項・サポート",
      "blocks": [
        {
          "type": "caution",
          "settings": {
            "number": "01",
            "title": "中綿の偏り・着用感について",
            "body": "<p>着用や保管によって、中綿に部分的な偏りや塊が生じる場合があります。その結果、ごわつきや暖かさのムラを感じる可能性があります。</p>"
          }
        },
        {
          "type": "caution",
          "settings": {
            "number": "02",
            "title": "長期使用について",
            "body": "<p>長期間使用した際の中綿の変化については、まだ十分な検証が完了していません。実際の着用を通じて感じたことを共有いただき、今後の素材開発につなげていきたいと考えています。</p>"
          }
        },
        {
          "type": "caution",
          "settings": {
            "number": "03",
            "title": "洗濯・お手入れについて",
            "body": "<p>現時点では、家庭での洗濯を推奨していません。また、クリーニングを含めた最適なお手入れ方法についても現在検証中です。お手入れが必要な場合は、まずKAPOK KNOTへご相談ください。</p>"
          }
        },
        {
          "type": "support",
          "settings": {
            "open": false,
            "title": "継続サポート",
            "summary_note": "気になる変化は、いつでもご相談ください",
            "body": "<p>着用中に気になる変化があった場合は、いつでもご相談ください。製品の状態を確認し、その時点で可能な対応を一緒に検討します。</p>"
          }
        },
        {
          "type": "support",
          "settings": {
            "open": false,
            "title": "定期チェック",
            "summary_note": "一定期間のご使用後に、製品の状態を確認します",
            "body": "<p>一定期間ご使用いただいた後、製品の状態を確認します。中綿の状態や着用による変化を確認し、今後のケアや開発につなげます。</p>"
          }
        },
        {
          "type": "support",
          "settings": {
            "open": false,
            "title": "Future Update Program",
            "summary_note": "アップデートモデルを優先的にご案内します",
            "body": "<p>今後、アップデートモデルが完成・発売された場合は、ご購入者の方へ優先的にご案内します。買い替えやアップデートなど、購入者向けのプログラムも検討していきます。</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
