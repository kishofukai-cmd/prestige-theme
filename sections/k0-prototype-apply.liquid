{%- comment -%}
  ------------------------------------------------------------------------------
  K-0 PROTOTYPE 商品ページ ③応募エリア（薄緑の地）
  ------------------------------------------------------------------------------
  テンプレート: templates/product.k0-prototype.json（全体の説明は sections/k0-prototype.liquid 冒頭）
  見た目: assets/k0-prototype.css

  - 購入ボックスのボタンの既定リンク「#k0-apply」はこのセクションを指す。
  - 畳むのは「購入後のサポート」の各項目だけ（<details>。見出し行だけ見え、開くと本文）。
    既定の開閉はブロックごとの「最初から開く」（既定: 閉じる）。
    注意カード・合言葉・スケジュール・チェックリスト・応募ボタンは応募の必須情報なので畳まない。
  - 応募ボタン（Googleフォーム）は「チェックリストの全項目にチェック」＋「合言葉が一致」のときだけ押せる。
    応募フォームの URL が空欄のあいだは常に押せない（「準備中」の案内を出す）。
  - 合言葉の照合はブラウザの JS で行う（全角/半角・大文字/小文字・空白の違いは無視）。
    合言葉はページのソースから読めるため、厳密な認証ではない（「最後まで読んだか」の確認用）。
    合言葉の設定を空欄にすると、合言葉の案内と入力欄を出さず、チェックだけで押せるようになる。
  - 未確定の既定値: 合言葉「［例：K0-START］」（仮）、応募フォームの URL（空欄）。
  - JS はこのファイル下部の javascript タグの中（assets/*.js は .shopifyignore の *.js で
    GitHub 経由の push から除外されるため使わない）。
  ------------------------------------------------------------------------------
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap">
{{ 'k0-prototype.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign k0_cautions = section.blocks | where: 'type', 'caution'
  assign k0_supports = section.blocks | where: 'type', 'support'
  assign k0_timeline = section.blocks | where: 'type', 'timeline_row'
  assign k0_checks = section.blocks | where: 'type', 'check_item'
  assign k0_password = section.settings.password | strip
  assign k0_form_url = section.settings.cta_url | strip

  if k0_form_url == blank
    assign k0_initial_hint = section.settings.cta_unavailable_text
  else
    assign k0_initial_hint = section.settings.cta_locked_text
  endif
-%}

<section class="k0 k0-apply" id="k0-apply">
  <k0-apply-gate class="k0-wrap" data-password="{{ k0_password | escape }}" data-form-url="{{ k0_form_url | escape }}">

    <div class="k0-apply__head">
      {%- if section.settings.kicker != blank -%}
        <p class="k0-kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="k0-apply__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="k0-apply__intro k0-rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} 注意カード {%- endcomment -%}
    {%- if k0_cautions.size > 0 -%}
      <div class="k0-caution-cards">
        {%- for block in k0_cautions -%}
          <div class="k0-caution-card" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}
              <div class="k0-caution-card__n">{{ block.settings.number | escape }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="k0-caution-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="k0-caution-card__body k0-rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.summary != blank -%}
      <p class="k0-caution-summary">{{ section.settings.summary | escape }}</p>
    {%- endif -%}

    {%- comment -%} 合言葉 {%- endcomment -%}
    {%- if k0_password != blank -%}
      <div class="k0-password-box">
        {{- section.settings.password_label | escape -}}<b>{{ k0_password | escape }}</b>
        {%- if section.settings.password_note != blank -%}
          <br><span>{{ section.settings.password_note | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 購入後のサポート {%- endcomment -%}
    {%- if k0_supports.size > 0 -%}
      <div class="k0-support">
        {%- if section.settings.support_heading != blank -%}
          <h3 class="k0-support__heading">{{ section.settings.support_heading | escape }}</h3>
        {%- endif -%}
        {%- for block in k0_supports -%}
          {%- capture k0_idx -%}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{%- endcapture -%}
          <details class="k0-acc k0-acc--support"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
            {%- render 'k0-acc-summary', title: block.settings.title, note: block.settings.summary_note, index: k0_idx -%}
            {%- if block.settings.body != blank -%}
              <div class="k0-acc__body k0-support__body k0-rte">{{ block.settings.body }}</div>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} 抽選スケジュール {%- endcomment -%}
    {%- if k0_timeline.size > 0 or section.settings.timeline_note != blank -%}
      <div class="k0-timeline">
        {%- if section.settings.timeline_heading != blank -%}
          <h3 class="k0-timeline__heading">{{ section.settings.timeline_heading | escape }}</h3>
        {%- endif -%}
        {%- if k0_timeline.size > 0 -%}
          <table class="k0-timeline-table">
            <tbody>
              {%- for block in k0_timeline -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.title | escape }}</th>
                  <td>{{ block.settings.value | escape }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}
        {%- if section.settings.timeline_note != blank -%}
          <div class="k0-timeline__note k0-rte">{{ section.settings.timeline_note }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} チェックリスト＋合言葉の入力欄 {%- endcomment -%}
    {%- if k0_checks.size > 0 or k0_password != blank -%}
      <div class="k0-checklist">
        {%- if section.settings.checklist_heading != blank -%}
          <h3 class="k0-checklist__heading">{{ section.settings.checklist_heading | escape }}</h3>
        {%- endif -%}
        {%- for block in k0_checks -%}
          <label class="k0-check-item" {{ block.shopify_attributes }}>
            <input type="checkbox" data-k0-check>
            <span>{{ block.settings.text | escape }}</span>
          </label>
        {%- endfor -%}
        {%- if k0_password != blank -%}
          <div class="k0-pw-field">
            <label for="k0-pw-{{ section.id }}">{{ section.settings.password_field_label | escape }}</label>
            <input type="text" id="k0-pw-{{ section.id }}" data-k0-password placeholder="{{ section.settings.password_placeholder | escape }}" autocomplete="off" autocapitalize="off" spellcheck="false">
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 応募ボタン（JS が条件を満たしたときだけ href を付ける） {%- endcomment -%}
    <div class="k0-cta-wrap">
      <a class="k0-cta" data-k0-cta role="link" aria-disabled="true">{{ section.settings.cta_label | escape }}</a>
      <p class="k0-cta-hint" data-k0-hint aria-live="polite"
        data-locked="{{ section.settings.cta_locked_text | escape }}"
        data-mismatch="{{ section.settings.cta_mismatch_text | escape }}"
        data-unavailable="{{ section.settings.cta_unavailable_text | escape }}">{{ k0_initial_hint | escape }}</p>
      {%- if section.settings.cta_sub != blank -%}
        <p class="k0-cta-sub">{{ section.settings.cta_sub | escape }}</p>
      {%- endif -%}
    </div>
  </k0-apply-gate>
</section>

{% javascript %}
  /* K-0 PROTOTYPE：チェックリスト全チェック＋合言葉一致のときだけ応募ボタンを有効にする */
  (function () {
    // 全角・半角、大文字・小文字、空白の違いは同じとみなす
    function normalize(value) {
      var s = String(value || '');
      if (s.normalize) s = s.normalize('NFKC');
      return s.replace(/\s+/g, '').toUpperCase();
    }

    if (!window.customElements.get('k0-apply-gate')) {
      class K0ApplyGate extends HTMLElement {
        constructor() {
          super();
          var self = this;
          var handler = function () { self.update(); };
          this.addEventListener('change', handler);
          this.addEventListener('input', handler);
          this.addEventListener('click', function (event) {
            var cta = event.target.closest('[data-k0-cta]');
            if (cta && cta.getAttribute('aria-disabled') === 'true') event.preventDefault();
          });
        }

        connectedCallback() {
          this.update();
        }

        update() {
          var cta = this.querySelector('[data-k0-cta]');
          if (!cta) return;
          var hint = this.querySelector('[data-k0-hint]');
          var url = (this.getAttribute('data-form-url') || '').trim();
          var expected = normalize(this.getAttribute('data-password'));
          var boxes = Array.prototype.slice.call(this.querySelectorAll('input[type="checkbox"][data-k0-check]'));
          var pwInput = this.querySelector('[data-k0-password]');
          var entered = pwInput ? normalize(pwInput.value) : '';
          var allChecked = boxes.every(function (box) { return box.checked; });
          var passwordOk = expected === '' || entered === expected;
          var ready = url !== '' && allChecked && passwordOk;

          if (ready) {
            cta.setAttribute('href', url);
            cta.setAttribute('target', '_blank');
            cta.setAttribute('rel', 'noopener');
            cta.removeAttribute('aria-disabled');
          } else {
            cta.removeAttribute('href');
            cta.removeAttribute('target');
            cta.removeAttribute('rel');
            cta.setAttribute('aria-disabled', 'true');
          }

          if (hint) {
            var message = '';
            if (url === '') {
              message = hint.getAttribute('data-unavailable') || '';
            } else if (!ready) {
              message = (allChecked && entered !== '' && !passwordOk)
                ? (hint.getAttribute('data-mismatch') || '')
                : (hint.getAttribute('data-locked') || '');
            }
            hint.textContent = message;
          }
        }
      }
      window.customElements.define('k0-apply-gate', K0ApplyGate);
    }

    // 「戻る」で戻ったときや、ブラウザが入力内容を復元したときにも判定し直す
    function refreshGates() {
      document.querySelectorAll('k0-apply-gate').forEach(function (gate) {
        if (typeof gate.update === 'function') gate.update();
      });
    }
    window.addEventListener('pageshow', refreshGates);
    window.addEventListener('load', refreshGates);
  })();
{% endjavascript %}

