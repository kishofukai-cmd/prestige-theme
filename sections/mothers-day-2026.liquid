    },
    {
      "type": "range",
      "id": "kv_pc_padding",
      "label": "KV余白 PC",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "kv_sp_padding",
      "label": "KV余白 SP",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "ファーストビュー文言"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "アイブロウ",
      "default": "FATHER'S DAY 2026"
    },
    {
      "type": "textarea",
