{% comment %}
  父の日2026 LP — 全文言編集対応版
{% endcomment %}

<style>
  .fd-lp {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
    line-height: 1.9;
  }

  .fd-lp * {
    box-sizing: border-box;
  }

  .fd-section {
    padding: {{ section.settings.sp_section_padding }}px 20px;
  }

  @media screen and (min-width: 768px) {
    .fd-section {
      padding: {{ section.settings.pc_section_padding }}px 40px;
    }
  }

  .fd-container {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }

  .fd-center {
    text-align: center;
  }

  .fd-eyebrow {
    color: {{ section.settings.accent_color }};
    font-size: 13px;
    letter-spacing: .18em;
    margin-bottom: 12px;
  }

  .fd-heading {
    color: {{ section.settings.heading_color }};
    font-family: "Noto Serif JP", "Yu Mincho", serif;
    font-size: {{ section.settings.sp_h2_size }}px;
    line-height: 1.6;
    font-weight: {{ section.settings.heading_weight }};
    margin: 0 0 20px;
  }

  @media screen and (min-width: 768px) {
    .fd-heading {
      font-size: {{ section.settings.pc_h2_size }}px;
    }
  }

  .fd-lead {
    font-size: {{ section.settings.sp_body_size }}px;
    margin: 0;
  }

  @media screen and (min-width: 768px) {
    .fd-lead {
      font-size: {{ section.settings.pc_body_size }}px;
    }
  }

  .fd-kv {
    background: {{ section.settings.kv_bg_color }};
    padding: {{ section.settings.kv_sp_padding }}px 20px;
    text-align: center;
  }

  @media screen and (min-width: 768px) {
    .fd-kv {
      padding: {{ section.settings.kv_pc_padding }}px 40px;
    }
  }

  .fd-kv img {
    width: 100%;
    max-width: {{ section.settings.kv_max_width }}px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .fd-countdown {
    background: {{ section.settings.countdown_bg_color }};
    color: {{ section.settings.countdown_text_color }};
    text-align: center;
    padding: 12px 16px;
    font-size: 14px;
    letter-spacing: .05em;
  }

  .fd-countdown strong {
    font-size: 20px;
    margin: 0 4px;
  }

  .fd-card {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    padding: 24px;
  }

  .fd-grid {
    display: grid;
    gap: 20px;
  }

  .fd-grid-2 {
    grid-template-columns: 1fr;
  }

  .fd-grid-3 {
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 768px) {
    .fd-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }

    .fd-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fd-img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 18px;
  }

  .fd-btn-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
  }

  @media screen and (min-width: 768px) {
    .fd-btn-wrap {
      flex-direction: row;
      justify-content: center;
    }
  }

  .fd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 28px;
    text-decoration: none;
    border-radius: {{ section.settings.button_radius }}px;
    font-weight: 600;
    line-height: 1.4;
  }

  .fd-btn-primary {
    background: {{ section.settings.primary_button_bg }};
    color: {{ section.settings.primary_button_text }};
    border: 1px solid {{ section.settings.primary_button_border }};
  }

  .fd-btn-secondary {
    background: {{ section.settings.secondary_button_bg }};
    color: {{ section.settings.secondary_button_text }};
    border: 1px solid {{ section.settings.secondary_button_border }};
  }

  .fd-table {
    width: 100%;
    border-collapse: collapse;
    background: {{ section.settings.card_bg_color }};
  }

  .fd-table th,
  .fd-table td {
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding: 14px 12px;
    text-align: left;
    vertical-align: top;
  }

  .fd-table th {
    background: {{ section.settings.table_header_bg }};
    color: {{ section.settings.heading_color }};
  }

  .fd-faq {
    border-bottom: 1px solid {{ section.settings.border_color }};
    background: {{ section.settings.card_bg_color }};
  }

  .fd-faq summary {
    cursor: pointer;
    padding: 18px;
    font-weight: 600;
    list-style: none;
  }

  .fd-faq summary::-webkit-details-marker {
    display: none;
  }

  .fd-faq-body {
    padding: 0 18px 22px;
  }

  .fd-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: {% if section.settings.show_sticky_cta %}flex{% else %}none{% endif %};
    gap: 8px;
    padding: 10px;
    background: rgba(255,255,255,.96);
    border-top: 1px solid {{ section.settings.border_color }};
  }

  .fd-sticky a {
    flex: 1;
    font-size: 13px;
    min-height: 46px;
  }

  @media screen and (min-width: 768px) {
    .fd-sticky {
      display: none;
    }
  }
</style>

<div class="fd-lp">

  {% if section.settings.show_countdown %}
    <div class="fd-countdown" id="fd-countdown" data-target="{{ section.settings.countdown_date }}" data-zero="{{ section.settings.countdown_zero_text | escape }}">
      {{ section.settings.countdown_before }}
      <strong id="fd-days">—</strong>
      {{ section.settings.countdown_after }}
    </div>
  {% endif %}

  {% if section.settings.kv_image != blank %}
    <section class="fd-kv">
      <img
        src="{{ section.settings.kv_image | image_url: width: 1800 }}"
        alt="{{ section.settings.kv_alt }}"
        width="1800"
        height="900"
        loading="eager"
      >
    </section>
  {% endif %}

  <section class="fd-section fd-center">
    <div class="fd-container">
      {% if section.settings.hero_eyebrow != blank %}
        <p class="fd-eyebrow">{{ section.settings.hero_eyebrow }}</p>
      {% endif %}

      <h1 class="fd-heading" style="font-size: {{ section.settings.sp_h1_size }}px;">
        {{ section.settings.hero_heading }}
      </h1>

      <style>
        @media screen and (min-width: 768px) {
          .fd-lp h1.fd-heading {
            font-size: {{ section.settings.pc_h1_size }}px !important;
          }
        }
      </style>

      {% if section.settings.hero_sub != blank %}
        <div class="fd-lead">{{ section.settings.hero_sub }}</div>
      {% endif %}

      <div class="fd-btn-wrap">
        {% if section.settings.hero_btn_1_text != blank %}
          <a href="{{ section.settings.hero_btn_1_url }}" class="fd-btn fd-btn-primary">
            {{ section.settings.hero_btn_1_text }}
          </a>
        {% endif %}

        {% if section.settings.hero_btn_2_text != blank %}
          <a href="{{ section.settings.hero_btn_2_url }}" class="fd-btn fd-btn-secondary">
            {{ section.settings.hero_btn_2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>

  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'text_section' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container {% if block.settings.center %}fd-center{% endif %}">
            {% if block.settings.eyebrow != blank %}
              <p class="fd-eyebrow">{{ block.settings.eyebrow }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="fd-heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="fd-lead">{{ block.settings.body }}</div>
            {% endif %}
            <div class="fd-btn-wrap">
              {% if block.settings.btn_text != blank %}
                <a href="{{ block.settings.btn_url }}" class="fd-btn fd-btn-primary">{{ block.settings.btn_text }}</a>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'image_text' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container">
            <div class="fd-grid fd-grid-2" style="align-items:center;">
              <div>
                {% if block.settings.image != blank %}
                  <img class="fd-img" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image_alt }}" loading="lazy">
                {% endif %}
              </div>
              <div>
                {% if block.settings.eyebrow != blank %}
                  <p class="fd-eyebrow">{{ block.settings.eyebrow }}</p>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <h2 class="fd-heading">{{ block.settings.heading }}</h2>
                {% endif %}
                {% if block.settings.body != blank %}
                  <div class="fd-lead">{{ block.settings.body }}</div>
                {% endif %}
                {% if block.settings.btn_text != blank %}
                  <div class="fd-btn-wrap" style="justify-content:flex-start;">
                    <a href="{{ block.settings.btn_url }}" class="fd-btn fd-btn-primary">{{ block.settings.btn_text }}</a>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </section>

      {% when 'product_grid_start' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container fd-center">
            {% if block.settings.eyebrow != blank %}
              <p class="fd-eyebrow">{{ block.settings.eyebrow }}</p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 class="fd-heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="fd-lead">{{ block.settings.body }}</div>
            {% endif %}
          </div>
        </section>

      {% when 'product_card' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="padding-top: 24px; padding-bottom: 24px;">
          <div class="fd-container">
            <div class="fd-card">
              {% if block.settings.badge != blank %}
                <p class="fd-eyebrow">{{ block.settings.badge }}</p>
              {% endif %}
              {% if block.settings.image != blank %}
                <img class="fd-img" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title }}" loading="lazy">
              {% endif %}
              <h3 class="fd-heading" style="font-size:24px;">{{ block.settings.title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p style="color: {{ section.settings.muted_color }}; margin:0 0 14px;">{{ block.settings.subtitle }}</p>
              {% endif %}
              {% if block.settings.description != blank %}
                <div>{{ block.settings.description }}</div>
              {% endif %}
              {% if block.settings.price != blank %}
                <p style="font-weight:700; margin-top:14px;">{{ block.settings.price }}</p>
              {% endif %}
              {% if block.settings.note != blank %}
                <p style="font-size:13px; color: {{ section.settings.muted_color }};">{{ block.settings.note }}</p>
              {% endif %}
              {% if block.settings.cta_text != blank %}
                <div class="fd-btn-wrap" style="justify-content:flex-start;">
                  <a href="{{ block.settings.cta_url }}" class="fd-btn {% if block.settings.button_type == 'primary' %}fd-btn-primary{% else %}fd-btn-secondary{% endif %}">
                    {{ block.settings.cta_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        </section>

      {% when 'three_cards' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container">
            <div class="fd-center">
              {% if block.settings.eyebrow != blank %}
                <p class="fd-eyebrow">{{ block.settings.eyebrow }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="fd-heading">{{ block.settings.heading }}</h2>
              {% endif %}
            </div>

            <div class="fd-grid fd-grid-3">
              <div class="fd-card">
                {% if block.settings.card1_title != blank %}<h3>{{ block.settings.card1_title }}</h3>{% endif %}
                {% if block.settings.card1_body != blank %}<div>{{ block.settings.card1_body }}</div>{% endif %}
              </div>
              <div class="fd-card">
                {% if block.settings.card2_title != blank %}<h3>{{ block.settings.card2_title }}</h3>{% endif %}
                {% if block.settings.card2_body != blank %}<div>{{ block.settings.card2_body }}</div>{% endif %}
              </div>
              <div class="fd-card">
                {% if block.settings.card3_title != blank %}<h3>{{ block.settings.card3_title }}</h3>{% endif %}
                {% if block.settings.card3_body != blank %}<div>{{ block.settings.card3_body }}</div>{% endif %}
              </div>
            </div>
          </div>
        </section>

      {% when 'table_section' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container">
            <div class="fd-center">
              {% if block.settings.heading != blank %}
                <h2 class="fd-heading">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.body != blank %}
                <div class="fd-lead">{{ block.settings.body }}</div>
              {% endif %}
            </div>
            <div style="overflow-x:auto; margin-top:28px;">
              <table class="fd-table">
                <thead>
                  <tr>
                    <th>{{ block.settings.col1 }}</th>
                    <th>{{ block.settings.col2 }}</th>
                    <th>{{ block.settings.col3 }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ block.settings.row1_col1 }}</td>
                    <td>{{ block.settings.row1_col2 }}</td>
                    <td>{{ block.settings.row1_col3 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.row2_col1 }}</td>
                    <td>{{ block.settings.row2_col2 }}</td>
                    <td>{{ block.settings.row2_col3 }}</td>
                  </tr>
                  <tr>
                    <td>{{ block.settings.row3_col1 }}</td>
                    <td>{{ block.settings.row3_col2 }}</td>
                    <td>{{ block.settings.row3_col3 }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </section>

      {% when 'faq_item' %}
        <section class="fd-section" {{ block.shopify_attributes }} style="padding-top:0; padding-bottom:0;">
          <div class="fd-container">
            <details class="fd-faq">
              <summary>{{ block.settings.question }}</summary>
              <div class="fd-faq-body">{{ block.settings.answer }}</div>
            </details>
          </div>
        </section>

      {% when 'final_cta' %}
        <section class="fd-section fd-center" {{ block.shopify_attributes }} style="background: {{ block.settings.bg_color }};">
          <div class="fd-container">
            {% if block.settings.heading != blank %}
              <h2 class="fd-heading">{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="fd-lead">{{ block.settings.body }}</div>
            {% endif %}
            <div class="fd-btn-wrap">
              {% if block.settings.btn1_text != blank %}
                <a href="{{ block.settings.btn1_url }}" class="fd-btn fd-btn-primary">{{ block.settings.btn1_text }}</a>
              {% endif %}
              {% if block.settings.btn2_text != blank %}
                <a href="{{ block.settings.btn2_url }}" class="fd-btn fd-btn-secondary">{{ block.settings.btn2_text }}</a>
              {% endif %}
            </div>
          </div>
        </section>

    {% endcase %}
  {% endfor %}

  <div class="fd-sticky">
    <a href="{{ section.settings.sticky_btn_1_url }}" class="fd-btn fd-btn-primary">{{ section.settings.sticky_btn_1_text }}</a>
    <a href="{{ section.settings.sticky_btn_2_url }}" class="fd-btn fd-btn-secondary">{{ section.settings.sticky_btn_2_text }}</a>
  </div>
</div>

<script>
  (function() {
    var el = document.getElementById('fd-countdown');
    if (!el) return;

    var targetText = el.getAttribute('data-target');
    var zeroText = el.getAttribute('data-zero');
    var daysEl = document.getElementById('fd-days');

    if (!targetText || !daysEl) return;

    var target = new Date(targetText + 'T00:00:00+09:00').getTime();
    var now = Date.now();
    var diff = Math.ceil((target - now) / (1000 * 60 * 60 * 24));

    if (diff <= 0) {
      el.innerHTML = zeroText || '';
    } else {
      daysEl.textContent = diff;
    }
  })();
</script>

{% schema %}
{
  "name": "父の日LP｜全編集対応",
  "settings": [
    {
      "type": "header",
      "content": "全体設定"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "ページ背景色",
      "default": "#F7F3EC"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "カード背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "本文カラー",
      "default": "#2B2B2B"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "見出しカラー",
      "default": "#1F2A44"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "アクセントカラー",
      "default": "#B97A5C"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "補足テキストカラー",
      "default": "#6B6B6B"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "線カラー",
      "default": "#E8DFD1"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "コンテンツ最大幅",
      "min": 720,
      "max": 1280,
      "step": 20,
      "default": 960
    },
    {
      "type": "range",
      "id": "pc_section_padding",
      "label": "セクション余白 PC",
      "min": 40,
      "max": 160,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "sp_section_padding",
      "label": "セクション余白 SP",
      "min": 24,
      "max": 100,
      "step": 4,
      "default": 64
    },
    {
      "type": "header",
      "content": "文字サイズ"
    },
    {
      "type": "range",
      "id": "pc_h1_size",
      "label": "H1 PC",
      "min": 24,
      "max": 72,
      "step": 1,
      "default": 42
    },
    {
      "type": "range",
      "id": "sp_h1_size",
      "label": "H1 SP",
      "min": 20,
      "max": 48,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "pc_h2_size",
      "label": "H2 PC",
      "min": 20,
      "max": 56,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "sp_h2_size",
      "label": "H2 SP",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "pc_body_size",
      "label": "本文 PC",
      "min": 13,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
