      "label": "KV画像"
    },
    {
      "type": "text",
      "id": "kv_alt",
      "label": "KV画像alt",
      "default": "父の日ギフト特集"
    },
    {
      "type": "color",
      "id": "kv_bg_color",
      "label": "KV背景色",
      "default": "#F7E6E4"
    },
    {
      "type": "range",
      "id": "kv_max_width",
