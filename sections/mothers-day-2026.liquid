<script>
  (function(){
    try {
      var banner = document.getElementById('md-countdown');
      if (!banner) return;
      var targetDate = banner.getAttribute('data-target-date') || '2026-05-10';
      var zeroMsg = banner.getAttribute('data-zero-message') || '本日は父の日。ありがとうの一日を。';
      var target = new Date(targetDate + 'T00:00:00+09:00').getTime();
      var now = Date.now();
      var diff = Math.max(0, Math.ceil((target - now) / (1000*60*60*24)));
      var el = document.getElementById('md-days');
      if (el) el.textContent = diff;
      if (diff === 0) { banner.innerHTML = zeroMsg; }
      if (diff < 0) { banner.style.display = 'none'; }
    } catch(e){}

    var els = document.querySelectorAll('.md-fade');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function(el){ io.observe(el); });
    } else {
      els.forEach(function(el){ el.classList.add('is-visible'); });
    }

    var nums = document.querySelectorAll('.count-up');
    if ('IntersectionObserver' in window) {
      var io2 = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (!e.isIntersecting) return;
          var el = e.target; var target = parseFloat(el.dataset.target); if (isNaN(target)) return;
          var start = 0; var dur = 1200; var t0 = performance.now();
          function step(t){
            var p = Math.min((t-t0)/dur, 1);
            var v = (start + (target-start) * (1 - Math.pow(1-p, 3))).toFixed(1);
            el.textContent = v + '%';
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
          io2.unobserve(el);
        });
      }, { threshold: 0.5 });
      nums.forEach(function(el){ io2.observe(el); });
    }
  })();
</script>

