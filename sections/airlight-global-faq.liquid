{% comment %} AirLight Global LP — FAQ (Accordion) {% endcomment %}

<style>
  .ag-faq {
    background: #faf9f6;
    padding: clamp(60px, 8vw, 100px) 0;
  }
  .ag-faq__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #1a2640;
    text-align: center;
    margin: 0 0 clamp(40px, 6vw, 64px);
    line-height: 1.2;
  }
  .ag-faq__list {
    max-width: 720px;
    margin: 0 auto;
  }
  .ag-faq__item {
    border-top: 1px solid #ddd9d2;
  }
  .ag-faq__item:last-child {
    border-bottom: 1px solid #ddd9d2;
  }
  .ag-faq__question {
    width: 100%;
    background: none;
    border: none;
    padding: 22px 0;
    text-align: left;
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #1a2640;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    line-height: 1.4;
  }
  .ag-faq__question:hover {
    color: #c29d66;
  }
  .ag-faq__question-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
    transition: transform 0.3s ease;
  }
  .ag-faq__question-icon::before,
  .ag-faq__question-icon::after {
    content: '';
    position: absolute;
    background: #c29d66;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .ag-faq__question-icon::before {
    width: 100%;
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }
  .ag-faq__question-icon::after {
    width: 1.5px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  .ag-faq__item.is-active .ag-faq__question-icon::after {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
  .ag-faq__answer p {
    margin: 0 0 12px;
  }
  .ag-faq__answer p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 768px) {
    .ag-faq {
      padding-left: 16px;
      padding-right: 16px;
      overflow-x: hidden;
    }
    .ag-faq__heading {
      font-size: 1.7rem;
      margin-bottom: 24px;
    }
    .ag-faq__question {
      font-size: 0.95rem;
      padding: 14px 16px;
      text-align: left;
      min-height: 48px;
    }
    .ag-faq__answer {
      font-size: 14px;
      padding: 0 16px 14px;
      line-height: 1.65;
    }
    .ag-faq img {
      max-width: 100%;
      height: auto;
    }
  }
</style>

<section class="ag-faq" id="ag-faq">
  <div class="ag-container--narrow" data-ag-reveal>
    <h2 class="ag-faq__heading">{{ section.settings.heading | default: 'Everything You Need to Know Before You Order' }}</h2>

    <div class="ag-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="ag-faq__item" {{ block.shopify_attributes }}>
            <button class="ag-faq__question" type="button" aria-expanded="false">
              {{ block.settings.question }}
            </button>
            <div class="ag-faq__answer">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function() {
    var items = document.querySelectorAll('.ag-faq__item');
    items.forEach(function(item) {
      var btn = item.querySelector('.ag-faq__question');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var isOpen = item.classList.contains('ag-faq__item--open');
        // Close all
        items.forEach(function(el) {
          el.classList.remove('ag-faq__item--open');
          var b = el.querySelector('.ag-faq__question');
          if (b) b.setAttribute('aria-expanded', 'false');
        });
        // Toggle clicked
        if (!isOpen) {
          item.classList.add('ag-faq__item--open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "AG FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything You Need to Know Before You Order" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it as warm as a down jacket?",
            "answer": "<p>In our founder's 3-week field test in Norway in December, the AirLight never needed a backup jacket. Customers in Montreal and Vancouver report the same through -20°C winters. We don't publish a specific temperature rating — but real-world performance speaks for itself.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Will I have to pay import duties?",
            "answer": "<p>Import duties may apply depending on your country. These are collected by customs upon delivery — not by us. USA: typically 0% for apparel under $800. Canada: typically 0–18%. We recommend checking your local customs authority for the most accurate estimate before ordering.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What's your return policy?",
            "answer": "<p>We offer a 30-day return window. If you're not satisfied, contact us within 30 days of delivery. Items must be unworn and in original packaging. Return shipping costs are the customer's responsibility. Contact: support@kapokknot.com</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Machine washable — cold cycle, air dry. No dry-cleaning, no special instructions. This is one of the key reasons our customers switch from down.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What size should I order?",
            "answer": "<p>AirLight fits true to North American sizing. See the size guide on this page. If you're between sizes, we recommend sizing up for layering flexibility.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What exactly is KapokFill™?",
            "answer": "<p>KapokFill™ is our patent-pending insulation technology made entirely from kapok fiber — a plant-based fiber harvested from the seed pods of tropical trees. Unlike down, it contains zero allergens, maintains its loft when wet, and is 100% animal-free. The fiber processing and jacket manufacturing are done entirely in Japan.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
