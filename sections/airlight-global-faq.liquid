{% comment %} AirLight Global LP — FAQ (Accordion) {% endcomment %}

<section class="ag-faq" id="ag-faq">
  <div class="ag-container--narrow" data-ag-reveal>
    <h2 class="ag-faq__heading">{{ section.settings.heading | default: 'Your questions, answered.' }}</h2>

    <div class="ag-faq__list">
      {% for block in section.blocks %}
        {% if block.type == 'faq_item' %}
          <div class="ag-faq__item" {{ block.shopify_attributes }}>
            <button class="ag-faq__question" type="button">
              {{ block.settings.question }}
            </button>
            <div class="ag-faq__answer">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AG FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your questions, answered." }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How warm is the AirLight Jacket?", "answer": "<p>Thermographic testing at 3°C confirms down-equivalent warmth.</p>" } }
      ]
    }
  ]
}
{% endschema %}
