<style>
  .middle-cta {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    text-align: center;
  }

  .middle-cta__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .middle-cta__label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 8px 15px;
    border-radius: 999px;
    background: {{ section.settings.label_bg }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .middle-cta__heading {
    margin: 0 0 14px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .middle-cta__heading p,
  .middle-cta__text p,
  .middle-cta__care p {
    margin: 0;
  }

  .middle-cta__text {
    margin: 0 auto 22px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }

  .middle-cta__price {
    margin: 0 0 20px;
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_size_pc }}px;
    font-weight: 800;
    line-height: 1.3;
  }

  .middle-cta__buttons {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: {{ section.settings.soldout_margin_top }}px;
  }

  .middle-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    padding: 15px 28px;
    border-radius: 999px;
    font-size: {{ section.settings.button_size_pc }}px;
    font-weight: 700;
    text-decoration: none;
    transition: 0.25s ease;
  }

  .middle-cta__button:hover {
    opacity: 0.86;
    transform: translateY(-2px);
  }

  .middle-cta__button--product {
    background: {{ section.settings.product_button_bg }};
    color: {{ section.settings.product_button_color }};
    border: 1px solid {{ section.settings.product_button_border }};
  }

  .middle-cta__button--line {
    background: {{ section.settings.line_button_bg }};
    color: {{ section.settings.line_button_color }};
    border: 1px solid {{ section.settings.line_button_border }};
  }

  .middle-cta__soldout {
    margin: 0 0 {{ section.settings.soldout_margin_bottom }}px;
    color: {{ section.settings.soldout_color }};
    font-size: {{ section.settings.soldout_size_pc }}px;
    font-weight: 700;
    line-height: 1.7;
    white-space: pre-line;
  }

  .middle-cta__care {
    background: {{ section.settings.care_bg }};
    border: 1px solid {{ section.settings.care_border }};
    border-radius: {{ section.settings.care_radius }}px;
    padding: 22px 24px;
    color: {{ section.settings.care_color }};
    font-size: {{ section.settings.care_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .middle-cta {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .middle-cta__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .middle-cta__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .middle-cta__text {
      font-size: {{ section.settings.text_size_sp }}px;
    }

    .middle-cta__price {
      font-size: {{ section.settings.price_size_sp }}px;
    }

    .middle-cta__buttons {
      flex-direction: column;
      gap: 10px;
    }

    .middle-cta__button {
      width: 100%;
      min-width: 0;
      font-size: {{ section.settings.button_size_sp }}px;
    }

    .middle-cta__soldout {
      font-size: {{ section.settings.soldout_size_sp }}px;
    }

    .middle-cta__care {
      padding: 18px 16px;
      border-radius: {{ section.settings.care_radius_sp }}px;
      font-size: {{ section.settings.care_size_sp }}px;
    }
  }
</style>

<section class="middle-cta" id="middle-cta-{{ section.id }}">
  <div class="middle-cta__inner">

    {% if section.settings.label != blank %}
      <div class="middle-cta__label">
        {{ section.settings.label }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="middle-cta__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="middle-cta__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.price != blank %}
      <p class="middle-cta__price">
        {{ section.settings.price }}
      </p>
    {% endif %}

    <div class="middle-cta__buttons">
      {% if section.settings.product_url != blank %}
        <a href="{{ section.settings.product_url }}" class="middle-cta__button middle-cta__button--product">
          {{ section.settings.product_button_text }}
        </a>
      {% endif %}

      {% if section.settings.line_url != blank %}
        <a href="{{ section.settings.line_url }}" class="middle-cta__button middle-cta__button--line" target="_blank" rel="noopener">
          {{ section.settings.line_button_text }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.soldout_text != blank %}
      <p class="middle-cta__soldout">
        {{ section.settings.soldout_text }}
      </p>
    {% endif %}

    {% if section.settings.care_text != blank %}
      <div class="middle-cta__care">
        {{ section.settings.care_text }}
      </div>
    {% endif %}

  </div>
</section>

