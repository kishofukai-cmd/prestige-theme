<section
  class="middle-hero-cta"
  id="middle-hero-cta-{{ section.id }}"
  style="
    --middle-bg-color: {{ section.settings.bg_color }};
  "
>
  <div class="middle-hero-cta__content">
    <div
      class="middle-hero-cta__subtitle"
      style="
        font-size: {{ section.settings.subtitle_font_size }}px;
        font-weight: {{ section.settings.subtitle_font_weight }};
        color: {{ section.settings.subtitle_color }};
      "
    >
      {{ section.settings.subtitle }}
    </div>

    <div class="middle-hero-cta__cta-area">
      {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
        <a
          href="{{ section.settings.cta_url }}"
          class="middle-hero-cta__btn"
          style="
            background: {{ section.settings.cta1_bg_color }};
            color: {{ section.settings.cta1_text_color }};
            margin-top: {{ section.settings.cta1_margin_top }}px;
            margin-bottom: {{ section.settings.cta1_margin_bottom }}px;
          "
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.cta_text }}
        </a>
      {% endif %}

      {% if section.settings.cta_url_2 != blank and section.settings.cta_text_2 != blank %}
        <a
          href="{{ section.settings.cta_url_2 }}"
          class="middle-hero-cta__btn"
          style="
            background: {{ section.settings.cta2_bg_color }};
            color: {{ section.settings.cta2_text_color }};
            margin-top: {{ section.settings.cta2_margin_top }}px;
            margin-bottom: {{ section.settings.cta2_margin_bottom }}px;
          "
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.cta_text_2 }}
        </a>
      {% endif %}

      {% if section.settings.show_soldout and section.settings.soldout_text != blank %}
        <p
          class="middle-hero-cta__soldout"
          style="
            margin-top: {{ section.settings.soldout_margin_top }}px;
            margin-bottom: {{ section.settings.soldout_margin_bottom }}px;
            font-size: {{ section.settings.soldout_font_size }}px;
            color: {{ section.settings.soldout_text_color }};
          "
        >
          {{ section.settings.soldout_text | newline_to_br }}
        </p>
      {% endif %}

      {% if section.settings.price_text != blank %}
        <p
          class="middle-hero-cta__price"
          style="
            margin-top: {{ section.settings.price_margin_top }}px;
            margin-bottom: {{ section.settings.price_margin_bottom }}px;
            color: {{ section.settings.price_color }};
          "
        >
          {{ section.settings.price_text }}
          <span class="middle-hero-cta__price-tax">{{ section.settings.price_tax }}</span>
        </p>
      {% endif %}

      <div
        class="middle-hero-cta__features"
        style="color: {{ section.settings.features_color }};"
      >
        {% if section.settings.feature_1 != blank %}<span>✓ {{ section.settings.feature_1 }}</span>{% endif %}
        {% if section.settings.feature_2 != blank %}<span>✓ {{ section.settings.feature_2 }}</span>{% endif %}
        {% if section.settings.feature_3 != blank %}<span>✓ {{ section.settings.feature_3 }}</span>{% endif %}
        {% if section.settings.feature_4 != blank %}<span>✓ {{ section.settings.feature_4 }}</span>{% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.middle-hero-cta {
  display: flex;
  flex-direction: column;
}

.middle-hero-cta__content {
  background: var(--middle-bg-color) !important;
  padding: {{ section.settings.padding_top_pc }}px 16px {{ section.settings.padding_bottom_pc }}px;
  text-align: center;
  color: #fff;
}

.middle-hero-cta__subtitle p {
  margin: 0 0 20px;
  line-height: 1.7;
}

.middle-hero-cta__btn {
  display: block;
  width: min(100%, 360px);
  padding: 14px 24px;
  border-radius: 999px;
  text-align: center;
  text-decoration: none;
  font-weight: 700;
  line-height: 1.4;
  margin-left: auto;
  margin-right: auto;
}

.middle-hero-cta__soldout {
  font-weight: 700;
  text-align: center;
  letter-spacing: 0.05em;
  font-family: inherit;
  line-height: 1.6;
}

.middle-hero-cta__price {
  font-size: {{ section.settings.price_font_size }}px;
  font-weight: 700;
  line-height: 1.5;
}

.middle-hero-cta__price-tax {
  font-size: 0.8em;
  font-weight: 400;
}

.middle-hero-cta__features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4px 12px;
  font-size: {{ section.settings.features_font_size }}px;
  margin-top: 8px;
  letter-spacing: 0.03em;
}

@media screen and (max-width: 767px) {
  .middle-hero-cta__content {
    padding: {{ section.settings.padding_top_sp }}px 16px {{ section.settings.padding_bottom_sp }}px;
  }
}
</style>

