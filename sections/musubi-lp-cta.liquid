<section class="mid-cta" id="{{ section.settings.section_id | default: 'mid-cta' }}">
  <div class="container--narrow">
    <div class="mid-cta__box" data-reveal>
      {% if section.settings.heading != blank %}
        <p class="mid-cta__heading">{{ section.settings.heading }}</p>
      {% endif %}
      <a href="{{ section.settings.cta_url | default: 'https://kapok-knot.com/products/musubi-en' }}" class="mid-cta__btn" target="_blank" rel="noopener">
        {{ section.settings.cta_text | default: '今すぐMUSUBIを手に入れる' }}
      </a>
      <div class="mid-cta__micro">
        {% if section.settings.micro_1 != blank %}
          <span class="mid-cta__micro-item">{{ section.settings.micro_1 }}</span>
        {% endif %}
        {% if section.settings.micro_2 != blank %}
          <span class="mid-cta__micro-item">{{ section.settings.micro_2 }}</span>
        {% endif %}
        {% if section.settings.micro_3 != blank %}
          <span class="mid-cta__micro-item">{{ section.settings.micro_3 }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 中間CTA",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "セクションID",
      "default": "mid-cta"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し（省略可）",
      "default": "体験した人だけが知る、この安心感。"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTAリンク先"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTAボタンテキスト",
      "default": "今すぐMUSUBIを手に入れる"
    },
    {
      "type": "text",
      "id": "micro_1",
      "label": "マイクロコピー1",
      "default": "✓ オールシーズン対応"
    },
    {
      "type": "text",
      "id": "micro_2",
      "label": "マイクロコピー2",
      "default": "✓ オールシーズン対応"
    },
    {
      "type": "text",
      "id": "micro_3",
      "label": "マイクロコピー3",
      "default": "✓ ギフトラッピング対応"
    }
  ],
  "presets": [{ "name": "MUSUBI 中間CTA" }]
}
{% endschema %}
