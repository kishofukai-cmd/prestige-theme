{% comment %} AirLight Global LP — Hero Section (和モダン) {% endcomment %}
{% render 'airlight-global-styles' %}
{% render 'airlight-global-scripts' %}

<section class="ag-hero" id="ag-hero">
  <div class="ag-hero__img-wrapper">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: '1600x' }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% elsif section.settings.fallback_url != blank %}
      <img src="{{ section.settings.fallback_url | asset_url }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% else %}
      <img src="{{ 'airlight-hero-bg.jpg' | asset_url }}"
           alt="AirLight Jacket — KAPOK KNOT" class="ag-hero__img" fetchpriority="high">
    {% endif %}
  </div>

  <div class="ag-hero__content">
    <p class="ag-hero__eyebrow">{{ section.settings.eyebrow | default: "Japan Global Launch — First 100 Customers Only" }}</p>

    <div class="ag-hero__launch-badge">
      <span class="ag-hero__launch-spot">⬡ {{ section.settings.launch_spot | default: "Only 100 spots available globally" }}</span>
    </div>

    <h1 class="ag-hero__title">
      {{ section.settings.hero_title }}
    </h1>

    <p class="ag-hero__sub">
      {{ section.settings.hero_sub | default: '500g. Plant-based warmth. Tested in Norwegian winters. Made in Japan. Now shipping worldwide.' }}
    </p>

    <!-- Proof Bar -->
    <div class="ag-hero__proof">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          {% unless forloop.first %}<div class="ag-hero__proof-div"></div>{% endunless %}
          <div class="ag-hero__proof-item" {{ block.shopify_attributes }}>
            <span class="ag-hero__proof-num">{{ block.settings.number }}</span>
            <span class="ag-hero__proof-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CTA -->
    <div class="ag-hero__cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#ag-products' }}"
         class="ag-hero__cta-btn">
        {{ section.settings.cta_text | default: 'Claim Your Spot — $398' }}
      </a>
      <p class="ag-hero__cta-note">
        <strong>{{ section.settings.offer_main | default: 'Free worldwide shipping on all orders' }}</strong>
        {{ section.settings.offer_note | default: '· 30-day guarantee · Only 100 spots' }}
      </p>
    </div>
  </div>
</section>

<style>
.ag-hero__launch-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(194,157,102,0.12);
  border: 1px solid rgba(194,157,102,0.35);
  border-radius: 100px;
  padding: 6px 16px;
  margin-bottom: 20px;
}
.ag-hero__launch-spot {
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: #c29d66;
  letter-spacing: 0.06em;
}

/* --- Mobile --- */
@media (max-width: 768px) {
  .ag-hero {
    overflow-x: hidden;
  }
  .ag-hero__content {
    padding: 80px 16px 120px;
  }
  .ag-hero__title {
    font-size: 2rem;
    margin-bottom: 16px;
  }
  .ag-hero__title p,
  .ag-hero__title h1 {
    font-size: inherit;
  }
  .ag-hero__sub {
    font-size: 14px;
    margin-bottom: 24px;
  }
  .ag-hero__cta-btn {
    width: 100%;
    min-height: 48px;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    text-align: center;
  }
  .ag-hero__cta-note {
    font-size: 12px;
  }
  .ag-hero__proof {
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .ag-hero__launch-badge {
    margin-bottom: 12px;
  }
  .ag-hero__img {
    max-width: 100%;
    height: auto;
  }
}
</style>

{% schema %}
{
  "name": "AG Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_image_alt", "label": "Image Alt", "default": "AirLight Jacket — KAPOK KNOT" },
    { "type": "text", "id": "fallback_url", "label": "Fallback Image URL", "default": "airlight-hero-bg.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Japan Global Launch — First 100 Customers Only" },
    { "type": "text", "id": "launch_spot", "label": "Launch Spot Text", "default": "Only 100 spots available globally" },
    { "type": "richtext", "id": "hero_title", "label": "Headline", "default": "<p>The Jacket That Sold Out 3 Times in Japan <em>Is Coming to You.</em></p>" },
    { "type": "richtext", "id": "hero_sub", "label": "Subheadline", "default": "<p>500g. Plant-based warmth. Tested in Norwegian winters. Made in Japan. Now shipping worldwide.</p>" },
    { "type": "url", "id": "cta_url", "label": "CTA Link" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Claim Your Spot — $398" },
    { "type": "text", "id": "offer_main", "label": "Offer Line (Bold)", "default": "Free worldwide shipping on all orders" },
    { "type": "text", "id": "offer_note", "label": "Offer Note", "default": "· 30-day guarantee · Only 100 spots" }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "Sold Out 3×" },
        { "type": "text", "id": "label", "label": "Label", "default": "Japan" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Hero",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "Sold Out 3×", "label": "Japan" } },
        { "type": "proof_item", "settings": { "number": "$400K+", "label": "Raised in Japan" } },
        { "type": "proof_item", "settings": { "number": "★ 4.8", "label": "Verified Reviews" } }
      ]
    }
  ]
}
{% endschema %}
