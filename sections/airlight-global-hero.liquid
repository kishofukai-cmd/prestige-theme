{% comment %} AirLight Global LP — Hero Section (和モダン) {% endcomment %}
{% render 'airlight-global-styles' %}
{% render 'airlight-global-scripts' %}

<section class="ag-hero" id="ag-hero">
  <div class="ag-hero__img-wrapper">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: '1600x' }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% elsif section.settings.fallback_url != blank %}
      <img src="{{ section.settings.fallback_url }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% else %}
      <img src="https://ucarecdn.com/64b0716b-231b-4805-b0ca-4a3c0f422c63/-/format/auto/-/preview/3000x3000/-/quality/lighter/ig_24aw%20_15_.png"
           alt="AirLight Jacket — KAPOK KNOT" class="ag-hero__img" fetchpriority="high">
    {% endif %}
  </div>

  <div class="ag-hero__content">
    <p class="ag-hero__eyebrow">{{ section.settings.eyebrow | default: 'KAPOK KNOT — Japan Material Innovation' }}</p>

    <h1 class="ag-hero__title">
      {{ section.settings.hero_title | default: '<p>Down Warmth.<br><em>Reinvented in Japan.</em></p>' }}
    </h1>

    <p class="ag-hero__sub">
      {{ section.settings.hero_sub | default: '<p>500g plant-based jacket. Engineered with Japanese precision.<br>Ethical insulation. Zero compromise.</p>' }}
    </p>

    <!-- Proof Bar -->
    <div class="ag-hero__proof">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          {% unless forloop.first %}<div class="ag-hero__proof-div"></div>{% endunless %}
          <div class="ag-hero__proof-item" {{ block.shopify_attributes }}>
            <span class="ag-hero__proof-num">{{ block.settings.number }}</span>
            <span class="ag-hero__proof-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CTA -->
    <div class="ag-hero__cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#ag-products' }}"
         class="ag-hero__cta-btn">
        {{ section.settings.cta_text | default: 'Shop Now' }}
      </a>
      <p class="ag-hero__cta-note">
        <strong>{{ section.settings.offer_main | default: 'Free worldwide shipping' }}</strong>
        {{ section.settings.offer_note | default: '· First 100 orders only' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AG Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_image_alt", "label": "Image Alt", "default": "AirLight Jacket — KAPOK KNOT" },
    { "type": "text", "id": "fallback_url", "label": "Fallback Image URL" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "KAPOK KNOT — Japan Material Innovation" },
    { "type": "richtext", "id": "hero_title", "label": "Headline", "default": "<p>Down Warmth.<br><em>Reinvented in Japan.</em></p>" },
    { "type": "richtext", "id": "hero_sub", "label": "Subheadline", "default": "<p>500g plant-based jacket. Engineered with Japanese precision.<br>Ethical insulation. Zero compromise.</p>" },
    { "type": "url", "id": "cta_url", "label": "CTA Link" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Shop Now" },
    { "type": "text", "id": "offer_main", "label": "Offer Line (Bold)", "default": "Free worldwide shipping" },
    { "type": "text", "id": "offer_note", "label": "Offer Note", "default": "· First 100 orders only" }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "¥50M+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Crowdfunded in Japan" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Hero",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "¥50M+", "label": "Crowdfunded" } },
        { "type": "proof_item", "settings": { "number": "10+", "label": "Awards Won" } },
        { "type": "proof_item", "settings": { "number": "★ 4.8", "label": "Review Score" } }
      ]
    }
  ]
}
{% endschema %}
