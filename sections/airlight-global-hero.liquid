{% comment %} AirLight Global LP  EHero Section {% endcomment %}
{% render 'airlight-global-styles' %}
{% render 'airlight-global-scripts' %}

<section class="ag-hero" id="ag-hero">
  <div class="ag-hero__img-wrapper">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: '1600x' }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket  EKAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% elsif section.settings.fallback_url != blank %}
      <img src="{{ section.settings.fallback_url }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket  EKAPOK KNOT' }}"
           class="ag-hero__img" fetchpriority="high">
    {% else %}
      <img src="{{ 'airlight-hero-bg.jpg' | asset_url }}"
           alt="AirLight Jacket  EKAPOK KNOT" class="ag-hero__img" fetchpriority="high">
    {% endif %}
    <!-- ④ Dark gradient overlay -->
    <div class="ag-hero__img-overlay"></div>
  </div>

  <div class="ag-hero__content">
    <p class="ag-hero__eyebrow">{{ section.settings.eyebrow | default: "Japan Global Launch  EFirst 100 Customers Only" }}</p>

    <div class="ag-hero__launch-badge">
      <span class="ag-hero__launch-spot">⬡ {{ section.settings.launch_spot | default: "Only 100 spots available globally" }}</span>
    </div>

    <!-- ④ サブ文言�E��EチE��ライン上！E-->
    <p class="ag-hero__pre-headline">{{ section.settings.pre_headline | default: 'Still freezing in a jacket that weighs you down?' }}</p>

    <h1 class="ag-hero__title">
      {{ section.settings.hero_title }}
    </h1>

    <!-- ① Proof Bar  Eヘッドライン直丁E-->
    <div class="ag-hero__proof">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          {% unless forloop.first %}<div class="ag-hero__proof-div"></div>{% endunless %}
          <div class="ag-hero__proof-item" {{ block.shopify_attributes }}>
            <span class="ag-hero__proof-num">{{ block.settings.number }}</span>
            <span class="ag-hero__proof-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <p class="ag-hero__sub">
      {{ section.settings.hero_sub | default: '500g. Plant-based warmth. Made in Japan. Now shipping worldwide.' }}
    </p>

    <!-- Highlights (Makuake-style key points) -->
    {% assign highlights = section.blocks | where: 'type', 'highlight_item' %}
    {% if highlights.size > 0 %}
      <div class="ag-hero__highlights">
        {% for block in highlights %}
          <div class="ag-hero__highlight-item" {{ block.shopify_attributes }}>
            <span class="ag-hero__highlight-check">✁E/span>
            <span class="ag-hero__highlight-text">{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- ② CTA -->
    <div class="ag-hero__cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#ag-products' }}"
         class="ag-hero__cta-btn">
        {{ section.settings.cta_label | default: 'Get My AirLight Jacket ↁE }}
      </a>
      <p class="ag-hero__cta-price">{{ section.settings.cta_price | default: '$398 · Free Worldwide Shipping' }}</p>
      <p class="ag-hero__cta-note">
        {{ section.settings.offer_note | default: '· 30-day guarantee · Only 100 spots' }}
      </p>
    </div>
  </div>

  <!-- ⑤ スクロール誘封E-->
  <div class="ag-hero__scroll-hint">
    <span>{{ section.settings.scroll_hint | default: 'ↁESee how it works' }}</span>
  </div>
</section>

<style>
/* --- Gradient Overlay --- */
.ag-hero__img-wrapper {
  position: relative;
}
.ag-hero__img-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
  pointer-events: none;
}

/* --- Pre-headline (上サブ文言) --- */
.ag-hero__pre-headline {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(0.95rem, 2vw, 1.1rem);
  font-style: italic;
  color: rgba(255,255,255,0.6);
  margin: 0 0 12px;
  line-height: 1.5;
}

/* --- Proof Bar (ヘッドライン直丁E --- */
.ag-hero__proof {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 24px;
}

/* --- CTA price line --- */
.ag-hero__cta-price {
  font-family: 'Outfit', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  color: rgba(255,255,255,0.95);
  margin: 10px 0 4px;
  text-align: center;
}

/* --- Scroll Hint --- */
.ag-hero__scroll-hint {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  animation: ag-scroll-fade 2s ease-in-out infinite;
}
.ag-hero__scroll-hint span {
  font-family: 'Outfit', sans-serif;
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.65);
}
@keyframes ag-scroll-fade {
  0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
  50% { opacity: 1; transform: translateX(-50%) translateY(4px); }
}

/* --- Hero Highlights --- */
.ag-hero__highlights {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 28px;
  padding: 20px 24px;
  background: rgba(255,255,255,0.06);
  border-left: 3px solid var(--ag-gold, #c29d66);
  border-radius: 0 8px 8px 0;
  text-align: left;
}
.ag-hero__highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  line-height: 1.5;
}
.ag-hero__highlight-check {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--ag-gold, #c29d66);
  color: #0a0a0a;
  font-size: 13px;
  font-weight: 700;
  margin-top: 1px;
}
.ag-hero__highlight-text {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(0.85rem, 2vw, 0.95rem);
  color: rgba(255,255,255,0.92);
  font-weight: 400;
}

.ag-hero__launch-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(194,157,102,0.12);
  border: 1px solid rgba(194,157,102,0.35);
  border-radius: 100px;
  padding: 6px 16px;
  margin-bottom: 20px;
}
.ag-hero__launch-spot {
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: #c29d66;
  letter-spacing: 0.06em;
}

/* --- Mobile --- */
@media (max-width: 768px) {
  .ag-hero {
    overflow-x: hidden;
  }
  .ag-hero__content {
    padding: 80px 16px 120px;
  }
  .ag-hero__title {
    font-size: 2rem;
    margin-bottom: 16px;
  }
  .ag-hero__title p,
  .ag-hero__title h1 {
    font-size: inherit;
  }
  .ag-hero__sub {
    font-size: 14px;
    margin-bottom: 24px;
  }
  .ag-hero__cta-btn {
    width: 100%;
    min-height: 48px;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    text-align: center;
  }
  .ag-hero__cta-price {
    font-size: 0.9rem;
  }
  .ag-hero__cta-note {
    font-size: 12px;
  }
  .ag-hero__proof {
    flex-wrap: nowrap;
    gap: 0;
    justify-content: center;
    padding: 10px 0;
    max-width: 100%;
    margin-bottom: 20px;
  }
  .ag-hero__launch-badge {
    margin-bottom: 12px;
  }
  .ag-hero__img {
    max-width: 100%;
    height: auto;
  }
  .ag-hero__highlights {
    padding: 16px 18px;
    gap: 8px;
    margin-bottom: 20px;
  }
  .ag-hero__highlight-text {
    font-size: 13px;
  }
  .ag-hero__scroll-hint {
    bottom: 16px;
  }
}
</style>

{% schema %}
{
  "name": "AG Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "hero_image_alt", "label": "Image Alt", "default": "AirLight Jacket  EKAPOK KNOT" },
    { "type": "text", "id": "fallback_url", "label": "Fallback Image URL (external)", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Japan Global Launch  EFirst 100 Customers Only" },
    { "type": "text", "id": "launch_spot", "label": "Launch Badge Text", "default": "Only 100 spots available globally" },
    { "type": "text", "id": "pre_headline", "label": "Pre-headline (italic, above title)", "default": "Still freezing in a jacket that weighs you down?" },
    { "type": "richtext", "id": "hero_title", "label": "Headline", "default": "<p>Down Warmth.<br><em>Reinvented in Japan.</em></p>" },
    { "type": "richtext", "id": "hero_sub", "label": "Subheadline", "default": "<p>500g plant-based jacket. Engineered with Japanese precision.<br>Ethical insulation. Zero compromise.</p>" },
    { "type": "url", "id": "cta_url", "label": "CTA Link" },
    { "type": "text", "id": "cta_label", "label": "CTA Button Text", "default": "Get My AirLight Jacket ↁE },
    { "type": "text", "id": "cta_price", "label": "Price Line (below button)", "default": "$398 · Free Worldwide Shipping" },
    { "type": "text", "id": "offer_note", "label": "Offer Note", "default": "· 30-day guarantee · Only 100 spots" },
    { "type": "text", "id": "scroll_hint", "label": "Scroll Hint Text", "default": "ↁESee how it works" }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "Sold Out 3ÁE },
        { "type": "text", "id": "label", "label": "Label", "default": "Japan" }
      ]
    },
    {
      "type": "highlight_item",
      "name": "Key Highlight",
      "settings": [
        { "type": "text", "id": "text", "label": "Highlight Text", "default": "Just 500g  Edown-level warmth in a plant-based jacket you'll forget you're wearing." }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Hero",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "Sold Out 3ÁE, "label": "Japan" } },
        { "type": "proof_item", "settings": { "number": "10+", "label": "Design Awards" } },
        { "type": "proof_item", "settings": { "number": "☁E4.8", "label": "Verified Reviews" } },
        { "type": "highlight_item", "settings": { "text": "Just 500g  Edown-level warmth in a plant-based jacket you'll forget you're wearing." } },
        { "type": "highlight_item", "settings": { "text": "Kapok: a hollow-core plant fiber that absorbs moisture and generates heat  Enature's lightest insulator." } },
        { "type": "highlight_item", "settings": { "text": "No animal feathers. No tree cutting. A sustainable brand from Japan changing fashion with plant innovation." } }
      ]
    }
  ]
}
{% endschema %}
