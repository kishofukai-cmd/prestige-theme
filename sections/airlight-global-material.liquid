{% comment %} AirLight Global LP — Material Story (4-block) {% endcomment %}

<style>
  .ag-material-section {
    overflow: hidden;
  }

  /* ---- Block 1: Origin Story ---- */
  .ag-material-origin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding: clamp(60px, 8vw, 100px) 0;
    max-width: 1100px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    .ag-material-origin { grid-template-columns: 1fr; }
  }
  .ag-material-origin__img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 4px;
  }
  .ag-material-origin__img-placeholder {
    background: #e8e4da;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }
  .ag-material-origin__label {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c29d66;
    margin-bottom: 12px;
    display: block;
  }
  .ag-material-origin__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #1a2640;
    margin: 0 0 20px;
    line-height: 1.15;
  }
  .ag-material-origin__body {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    line-height: 1.75;
    color: #5a5550;
    margin: 0;
  }

  /* ---- Block 2: Fiber ---- */
  .ag-material-fiber {
    position: relative;
    width: 100%;
    min-height: 480px;
    overflow: hidden;
    background: #1a2640;
  }
  .ag-material-fiber__img {
    width: 100%;
    height: 100%;
    min-height: 480px;
    object-fit: cover;
    display: block;
    opacity: 0.6;
  }
  .ag-material-fiber__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,15,30,0.92) 0%, rgba(10,15,30,0.3) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(32px, 5vw, 60px);
  }
  .ag-material-fiber__text-wrap {
    max-width: 640px;
    margin-bottom: 32px;
  }
  .ag-material-fiber__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #fff;
    margin: 0 0 16px;
  }
  .ag-material-fiber__body {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255,255,255,0.8);
    margin: 0;
  }
  .ag-material-fiber__stats {
    display: flex;
    gap: clamp(24px, 4vw, 48px);
    flex-wrap: wrap;
  }
  .ag-material-fiber__stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 300;
    color: #c29d66;
    line-height: 1;
    display: block;
  }
  .ag-material-fiber__stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    margin-top: 4px;
  }
  .ag-material-fiber__placeholder {
    width: 100%;
    min-height: 480px;
    background: #1a2640;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: rgba(255,255,255,0.15);
  }

  /* ---- Block 3: Japanese Engineering ---- */
  .ag-material-engineering {
    padding: clamp(60px, 8vw, 100px) 0;
    max-width: 1100px;
    margin: 0 auto;
  }
  .ag-material-engineering__text {
    max-width: 640px;
    margin: 0 auto clamp(32px, 5vw, 56px);
    text-align: center;
  }
  .ag-material-engineering__label {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c29d66;
    margin-bottom: 12px;
    display: block;
  }
  .ag-material-engineering__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #1a2640;
    margin: 0 0 20px;
    line-height: 1.15;
  }
  .ag-material-engineering__body {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    line-height: 1.75;
    color: #5a5550;
    margin: 0;
  }
  .ag-material-engineering__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .ag-material-engineering__images { grid-template-columns: 1fr; }
  }
  .ag-material-engineering__img {
    width: 100%;
    aspect-ratio: 3/2;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .ag-material-engineering__img-placeholder {
    background: #e8e4da;
    width: 100%;
    aspect-ratio: 3/2;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }
  .ag-material-engineering__caption {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    color: #8a8580;
    margin-top: 8px;
    font-style: italic;
    text-align: center;
  }

  /* ---- Block 4: Heat Test ---- */
  .ag-material-heat {
    background: #0a0a0a;
    color: #fff;
    padding: clamp(60px, 8vw, 100px) 20px;
    text-align: center;
  }
  .ag-material-heat__label {
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c29d66;
    margin-bottom: 16px;
    display: block;
  }
  .ag-material-heat__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 400;
    color: #fff;
    margin: 0 0 8px;
  }
  .ag-material-heat__sub {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    color: rgba(255,255,255,0.55);
    margin: 0 0 40px;
  }
  .ag-material-heat__gif-wrap {
    max-width: 720px;
    margin: 0 auto;
  }
  .ag-material-heat__gif {
    width: 100%;
    border-radius: 4px;
    display: block;
  }
  .ag-material-heat__placeholder {
    background: #1a1a1a;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: rgba(255,255,255,0.15);
  }
  .ag-material-heat__caption {
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.45);
    margin-top: 16px;
    font-style: italic;
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .ag-material-section {
      overflow-x: hidden;
    }

    /* Block 1: Origin Story */
    .ag-material-origin {
      grid-template-columns: 1fr;
      padding: 48px 16px;
      gap: 24px;
    }
    /* 画像を上、テキストを下に */
    .ag-material-origin .ag-material-origin__img-wrap {
      order: -1;
    }
    .ag-material-origin__img {
      aspect-ratio: 16/9;
      max-width: 100%;
      height: auto;
    }
    .ag-material-origin__heading {
      font-size: 1.8rem;
    }
    .ag-material-origin__body {
      font-size: 14px;
    }

    /* Block 2: Fiber */
    .ag-material-fiber {
      min-height: 320px;
    }
    .ag-material-fiber__img {
      min-height: 320px;
      max-width: 100%;
      height: auto;
    }
    .ag-material-fiber__placeholder {
      min-height: 320px;
    }
    .ag-material-fiber__overlay {
      padding: 24px 16px;
    }
    .ag-material-fiber__heading {
      font-size: 1.8rem;
    }
    .ag-material-fiber__body {
      font-size: 14px;
    }
    .ag-material-fiber__stats {
      gap: 20px;
    }
    .ag-material-fiber__stat-num {
      font-size: 2.2rem;
    }

    /* Block 3: Japanese Engineering */
    .ag-material-engineering {
      padding: 48px 16px;
    }
    .ag-material-engineering__heading {
      font-size: 1.8rem;
    }
    .ag-material-engineering__body {
      font-size: 14px;
    }
    .ag-material-engineering__images {
      grid-template-columns: 1fr;
    }
    .ag-material-engineering__img {
      max-width: 100%;
      height: auto;
    }

    /* Block 4: Heat Test */
    .ag-material-heat {
      padding: 48px 16px;
    }
    .ag-material-heat__heading {
      font-size: 2rem;
    }
    .ag-material-heat__gif-wrap {
      max-width: 100%;
    }
    .ag-material-heat__gif {
      max-width: 100%;
      width: 100%;
      height: auto;
    }
  }
</style>

<div class="ag-material-section" id="ag-material">
  {% for block in section.blocks %}

    {% if block.type == 'origin_story' %}
      <div class="ag-container" {{ block.shopify_attributes }}>
        <div class="ag-material-origin" data-ag-reveal>
          <div class="ag-material-origin__img-wrap">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'ag-material-origin__img', alt: block.settings.heading }}
            {% elsif block.settings.fallback_image != blank %}
              <img src="{{ block.settings.fallback_image | asset_url }}" class="ag-material-origin__img" alt="{{ block.settings.heading }}">
            {% else %}
              <img src="{{ 'airlight-material-origin.png' | asset_url }}" class="ag-material-origin__img" alt="{{ block.settings.heading }}">
            {% endif %}
          </div>
          <div class="ag-material-origin__text">
            <span class="ag-material-origin__label">{{ block.settings.label }}</span>
            <h3 class="ag-material-origin__heading">{{ block.settings.heading }}</h3>
            <p class="ag-material-origin__body">{{ block.settings.body }}</p>
          </div>
        </div>
      </div>

    {% elsif block.type == 'fiber' %}
      <div class="ag-material-fiber" {{ block.shopify_attributes }} data-ag-reveal>
        {% if block.settings.image %}
          {{ block.settings.image | image_url: width: 1800 | image_tag: class: 'ag-material-fiber__img', alt: block.settings.heading }}
        {% elsif block.settings.fallback_image != blank %}
          <img src="{{ block.settings.fallback_image | asset_url }}" class="ag-material-fiber__img" alt="{{ block.settings.heading }}">
        {% else %}
          <img src="{{ 'airlight-material-fiber.gif' | asset_url }}" class="ag-material-fiber__img" alt="{{ block.settings.heading }}">
        {% endif %}
        <div class="ag-material-fiber__overlay">
          <div class="ag-material-fiber__text-wrap">
            <h3 class="ag-material-fiber__heading">{{ block.settings.heading }}</h3>
            <p class="ag-material-fiber__body">{{ block.settings.body }}</p>
          </div>
          <div class="ag-material-fiber__stats">
            <div class="ag-material-fiber__stat">
              <span class="ag-material-fiber__stat-num">{{ block.settings.stat1_num }}</span>
              <span class="ag-material-fiber__stat-label">{{ block.settings.stat1_label }}</span>
            </div>
            <div class="ag-material-fiber__stat">
              <span class="ag-material-fiber__stat-num">{{ block.settings.stat2_num }}</span>
              <span class="ag-material-fiber__stat-label">{{ block.settings.stat2_label }}</span>
            </div>
            <div class="ag-material-fiber__stat">
              <span class="ag-material-fiber__stat-num">{{ block.settings.stat3_num }}</span>
              <span class="ag-material-fiber__stat-label">{{ block.settings.stat3_label }}</span>
            </div>
          </div>
        </div>
      </div>

    {% elsif block.type == 'japanese_engineering' %}
      <div class="ag-container" {{ block.shopify_attributes }}>
        <div class="ag-material-engineering" data-ag-reveal>
          <div class="ag-material-engineering__text">
            <span class="ag-material-engineering__label">{{ block.settings.label }}</span>
            <h3 class="ag-material-engineering__heading">{{ block.settings.heading }}</h3>
            <p class="ag-material-engineering__body">{{ block.settings.body }}</p>
          </div>
          <div class="ag-material-engineering__images">
            <div>
              {% if block.settings.image1 %}
                {{ block.settings.image1 | image_url: width: 1200 | image_tag: class: 'ag-material-engineering__img', alt: block.settings.image1_caption }}
              {% elsif block.settings.fallback_image1 != blank %}
                <img src="{{ block.settings.fallback_image1 | asset_url }}" class="ag-material-engineering__img" alt="{{ block.settings.image1_caption }}">
              {% else %}
                <img src="{{ 'airlight-material-sheet.png' | asset_url }}" class="ag-material-engineering__img" alt="{{ block.settings.image1_caption }}">
              {% endif %}
              {% if block.settings.image1_caption != blank %}
                <p class="ag-material-engineering__caption">{{ block.settings.image1_caption }}</p>
              {% endif %}
            </div>
            <div>
              {% if block.settings.image2 %}
                {{ block.settings.image2 | image_url: width: 1200 | image_tag: class: 'ag-material-engineering__img', alt: block.settings.image2_caption }}
              {% elsif block.settings.fallback_image2 != blank %}
                <img src="{{ block.settings.fallback_image2 | asset_url }}" class="ag-material-engineering__img" alt="{{ block.settings.image2_caption }}">
              {% else %}
                <img src="{{ 'airlight-material-craftsman.png' | asset_url }}" class="ag-material-engineering__img" alt="{{ block.settings.image2_caption }}">
              {% endif %}
              {% if block.settings.image2_caption != blank %}
                <p class="ag-material-engineering__caption">{{ block.settings.image2_caption }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    {% elsif block.type == 'heat_test' %}
      <div class="ag-material-heat" {{ block.shopify_attributes }} data-ag-reveal>
        <span class="ag-material-heat__label">{{ block.settings.label }}</span>
        <h3 class="ag-material-heat__heading">{{ block.settings.heading }}</h3>
        <p class="ag-material-heat__sub">{{ block.settings.sub }}</p>
        <div class="ag-material-heat__gif-wrap">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 1440 | image_tag: class: 'ag-material-heat__gif', alt: block.settings.heading }}
          {% elsif block.settings.gif_url != blank %}
            <img src="{{ block.settings.gif_url | asset_url }}" class="ag-material-heat__gif" alt="{{ block.settings.heading }}">
          {% else %}
            <img src="{{ 'airlight-material-thermo.gif' | asset_url }}" class="ag-material-heat__gif" alt="{{ block.settings.heading }}">
          {% endif %}
          {% if block.settings.caption != blank %}
            <p class="ag-material-heat__caption">{{ block.settings.caption }}</p>
          {% endif %}
        </div>
      </div>

    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "AG Material",
  "settings": [],
  "blocks": [
    {
      "type": "origin_story",
      "name": "① Origin Story",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The Origin" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "It Starts With a Tree" },
        { "type": "textarea", "id": "body", "label": "Body Text", "default": "Kapok grows wild across Southeast Asia. The fiber is harvested from the seed pods of the kapok tree — no cutting, no clearing. The more you harvest, the more the tree grows. Every jacket supports rural farming communities in Indonesia." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback Image Filename", "default": "airlight-material-origin.png" }
      ]
    },
    {
      "type": "fiber",
      "name": "② The Fiber",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Nature's Lightest Insulation" },
        { "type": "textarea", "id": "body", "label": "Body Text", "default": "Kapok fiber has a hollow tube structure — 80% air by volume. That's what traps heat so efficiently. At 1/8 the weight of cotton, it's the lightest natural insulation on earth. And unlike down, it contains zero allergens." },
        { "type": "image_picker", "id": "image", "label": "Background Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback Image Filename", "default": "airlight-material-fiber.gif" },
        { "type": "text", "id": "stat1_num", "label": "Stat 1 Number", "default": "1/8" },
        { "type": "text", "id": "stat1_label", "label": "Stat 1 Label", "default": "Weight of Cotton" },
        { "type": "text", "id": "stat2_num", "label": "Stat 2 Number", "default": "80%" },
        { "type": "text", "id": "stat2_label", "label": "Stat 2 Label", "default": "Air by Volume" },
        { "type": "text", "id": "stat3_num", "label": "Stat 3 Number", "default": "0" },
        { "type": "text", "id": "stat3_label", "label": "Stat 3 Label", "default": "Allergens" }
      ]
    },
    {
      "type": "japanese_engineering",
      "name": "③ Japanese Engineering",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Japanese Engineering" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "5 Years. One Breakthrough." },
        { "type": "textarea", "id": "body", "label": "Body Text", "default": "Kapok fiber is too short to spin into thread — or so we were told. We spent five years working with Japan's leading textile engineers to solve this. The result: KapokFill™, a patent-pending insulation sheet that holds fiber without spinning it. Sewn by artisans in Hokkaido. Built to last decades." },
        { "type": "image_picker", "id": "image1", "label": "Image 1 (Sheet/Fiber)" },
        { "type": "text", "id": "fallback_image1", "label": "Fallback Image 1 Filename", "default": "airlight-material-sheet.png" },
        { "type": "text", "id": "image1_caption", "label": "Image 1 Caption", "default": "KapokFill™ insulation sheet" },
        { "type": "image_picker", "id": "image2", "label": "Image 2 (Factory/Craft)" },
        { "type": "text", "id": "fallback_image2", "label": "Fallback Image 2 Filename", "default": "airlight-material-craftsman.png" },
        { "type": "text", "id": "image2_caption", "label": "Image 2 Caption", "default": "Master craftsman Yamakawa — 60 years, Hokkaido" }
      ]
    },
    {
      "type": "heat_test",
      "name": "④ Heat Test",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Heat Test" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "See the Warmth" },
        { "type": "text", "id": "sub", "label": "Sub Text", "default": "Thermal camera test — 1 minute after wearing, at 3°C" },
        { "type": "image_picker", "id": "image", "label": "GIF / Image" },
        { "type": "text", "id": "gif_url", "label": "Fallback GIF Filename", "default": "airlight-material-thermo.gif" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "AirLight Jacket vs. Traditional Down — Same warmth. Zero animals." }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Material",
      "blocks": [
        { "type": "origin_story" },
        { "type": "fiber" },
        { "type": "japanese_engineering" },
        { "type": "heat_test" }
      ]
    }
  ]
}
{% endschema %}
