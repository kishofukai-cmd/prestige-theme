<style>
  .colors {
    padding: 80px 20px;
    background: #faf5ef;
    text-align: center;
  }
  .colors .container {
    max-width: 600px;
    margin: 0 auto;
  }
  .colors .section-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 32px;
  }
  .colors__showcase {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .colors__showcase img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .colors__name {
    font-size: 1rem;
    color: #666;
    letter-spacing: 0.05em;
    margin: 0 0 20px;
  }
  .colors__swatches {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .colors__swatch {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.3s, transform 0.2s;
  }
  .colors__swatch:hover {
    transform: scale(1.1);
  }
  .colors__swatch--active {
    border-color: #b8a78a;
    box-shadow: 0 0 0 2px #b8a78a;
  }
  .colors__carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .colors__carousel-arrow {
    background: none;
    border: none;
    font-size: 1.8rem;
    color: #999;
    cursor: pointer;
    padding: 4px 8px;
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .colors__carousel-arrow:hover {
    color: #333;
  }
  .colors__carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
  }
  .colors__carousel-track::-webkit-scrollbar {
    display: none;
  }
  .colors__carousel-item {
    flex: 0 0 auto;
    width: 90px;
    cursor: pointer;
    scroll-snap-align: start;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.3s;
  }
  .colors__carousel-item--active {
    border-color: #b8a78a;
  }
  .colors__carousel-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  .colors__carousel-item span {
    display: block;
    font-size: 0.7rem;
    color: #666;
    padding: 6px 4px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 768px) {
    .colors {
      padding: 60px 16px;
    }
    .colors .section-title {
      font-size: 1.3rem;
      margin-bottom: 24px;
    }
    .colors__swatch {
      width: 36px;
      height: 36px;
    }
    .colors__carousel-item {
      width: 80px;
    }
  }
</style>

<section class="colors" id="colors">
  <div class="container">
    <h2 class="section-title" data-reveal>{{ section.settings.heading | default: 'カラーバリエーション' }}</h2>
    <div class="colors__showcase" data-reveal>
      {% assign first_block = section.blocks | first %}
      <img id="colors-main-img"
        src="{% if first_block.settings.image != blank %}{{ first_block.settings.image | img_url: '1200x' }}{% elsif first_block.settings.image_url != blank %}{{ first_block.settings.image_url }}{% else %}https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1200{% endif %}"
        alt="{{ first_block.settings.name | default: 'Powder Beige' }}" loading="lazy">
    </div>
    <p class="colors__name" id="colors-name" data-reveal>{{ first_block.settings.name | default: 'Powder Beige' }}</p>
    <div class="colors__swatches" data-reveal>
      {% for block in section.blocks %}
        <div class="colors__swatch{% if forloop.first %} colors__swatch--active{% endif %}"
          style="background: {{ block.settings.color_code }};"
          data-color="{{ block.settings.name }}"
          data-img="{% if block.settings.image != blank %}{{ block.settings.image | img_url: '1200x' }}{% elsif block.settings.image_url != blank %}{{ block.settings.image_url }}{% endif %}"
          {{ block.shopify_attributes }}>
        </div>
      {% endfor %}
    </div>
    <div class="colors__carousel" data-reveal>
      <button class="colors__carousel-arrow colors__carousel-arrow--left" aria-label="前へ">‹</button>
      <div class="colors__carousel-track">
        {% for block in section.blocks %}
          <div class="colors__carousel-item{% if forloop.first %} colors__carousel-item--active{% endif %}" data-color="{{ block.settings.name }}">
            <img src="{% if block.settings.thumbnail != blank %}{{ block.settings.thumbnail | img_url: '400x' }}{% elsif block.settings.image != blank %}{{ block.settings.image | img_url: '400x' }}{% elsif block.settings.image_url != blank %}{{ block.settings.image_url }}{% endif %}"
              alt="{{ block.settings.name }}" loading="lazy">
            <span>{{ block.settings.name }}</span>
          </div>
        {% endfor %}
      </div>
      <button class="colors__carousel-arrow colors__carousel-arrow--right" aria-label="次へ">›</button>
    </div>
  </div>
</section>

<script>
  (function() {
    const section = document.querySelector('.colors');
    if (!section) return;
    const mainImg = section.querySelector('#colors-main-img');
    const nameEl = section.querySelector('#colors-name');
    const swatches = section.querySelectorAll('.colors__swatch');
    const items = section.querySelectorAll('.colors__carousel-item');

    function setActive(colorName) {
      swatches.forEach(s => {
        s.classList.toggle('colors__swatch--active', s.dataset.color === colorName);
        if (s.dataset.color === colorName && s.dataset.img) {
          mainImg.src = s.dataset.img;
          mainImg.alt = colorName;
        }
      });
      items.forEach(i => i.classList.toggle('colors__carousel-item--active', i.dataset.color === colorName));
      if (nameEl) nameEl.textContent = colorName;
    }

    swatches.forEach(s => s.addEventListener('click', () => setActive(s.dataset.color)));
    items.forEach(i => i.addEventListener('click', () => setActive(i.dataset.color)));

    const track = section.querySelector('.colors__carousel-track');
    section.querySelector('.colors__carousel-arrow--left').addEventListener('click', () => {
      track.scrollBy({ left: -100, behavior: 'smooth' });
    });
    section.querySelector('.colors__carousel-arrow--right').addEventListener('click', () => {
      track.scrollBy({ left: 100, behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "MUSUBI カラバリ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "カラーバリエーション"
    }
  ],
  "blocks": [
    {
      "type": "color_variant",
      "name": "カラー",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "カラー名",
          "default": "Powder Beige"
        },
        {
          "type": "text",
          "id": "color_code",
          "label": "カラーコード",
          "default": "#d9cfc4"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "メイン画像"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "画像URL（image_pickerが空の場合に使用）"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "サムネイル画像（省略時はメイン画像を使用）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI カラバリ",
      "blocks": [
        { "type": "color_variant", "settings": { "name": "Powder Beige", "color_code": "#d9cfc4" } },
        { "type": "color_variant", "settings": { "name": "Dusty Navy", "color_code": "#3d4259" } },
        { "type": "color_variant", "settings": { "name": "Calm Brown", "color_code": "#8b6b50" } },
        { "type": "color_variant", "settings": { "name": "Cloud White", "color_code": "#e8e4de" } },
        { "type": "color_variant", "settings": { "name": "Blossom Peach", "color_code": "#d4a5a0" } },
        { "type": "color_variant", "settings": { "name": "Earth Green", "color_code": "#5e7a5a" } },
        { "type": "color_variant", "settings": { "name": "Moon Purple", "color_code": "#7b6b8a" } }
      ]
    }
  ]
}
{% endschema %}
