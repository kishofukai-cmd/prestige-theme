<style>
  .why {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .why__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .why__header {
    text-align: center;
    margin-bottom: 42px;
  }

  .why__label,
  .why__comparison-label {
    display: inline-block;
    font-weight: 700;
    letter-spacing: 0.12em;
    border-radius: 999px;
    padding: 8px 15px;
  }

  .why__label {
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    margin-bottom: 16px;
  }

  .why__heading {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .why__heading p,
  .why__lead p,
  .why__comparison-heading p,
  .why__comparison-conclusion p {
    margin: 0;
  }

  .why__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: {{ section.settings.lead_size_pc }}px;
    color: {{ section.settings.lead_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .why__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-bottom: 64px;
  }

  .why__card {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: stretch;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.07);
  }

  .why__card:nth-child(even) {
    grid-template-columns: 0.88fr 1.12fr;
  }

  .why__card:nth-child(even) .why__card-img {
    order: 2;
  }

  .why__card:nth-child(even) .why__card-content {
    order: 1;
  }

  .why__card-img {
    position: relative;
    min-height: {{ section.settings.image_height_pc }}px;
    background: {{ section.settings.image_bg_color }};
    overflow: hidden;
  }

  .why__card-img img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .why__card-content {
    padding: 42px 38px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .why__card-num {
    display: inline-flex;
    width: fit-content;
    color: {{ section.settings.number_color }};
    background: {{ section.settings.number_bg_color }};
    font-size: {{ section.settings.number_size_pc }}px;
    font-weight: 800;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 7px 14px;
    margin-bottom: 18px;
  }

  .why__card-title {
    font-size: {{ section.settings.title_size_pc }}px;
    color: {{ section.settings.title_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .why__card-desc {
    font-size: {{ section.settings.description_size_pc }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.9;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .why__comparison {
    background: {{ section.settings.comparison_bg_color }};
    border: 1px solid {{ section.settings.comparison_border_color }};
    border-radius: {{ section.settings.comparison_radius }}px;
    padding: 48px 38px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
  }

  .why__comparison-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .why__comparison-label {
    color: {{ section.settings.comparison_label_color }};
    background: {{ section.settings.comparison_label_bg_color }};
    font-size: {{ section.settings.comparison_label_size_pc }}px;
    margin-bottom: 14px;
  }

  .why__comparison-heading {
    font-size: {{ section.settings.comparison_heading_size_pc }}px;
    color: {{ section.settings.comparison_heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* グラフ */
  .why__comparison-chart {
    background: #fff;
    border-radius: 22px;
    padding: 24px;
    margin: 0 0 28px;
  }

  .why__comparison-chart-title {
    font-size: {{ section.settings.chart_title_size_pc }}px;
    color: {{ section.settings.chart_title_color }};
    font-weight: 700;
    text-align: center;
    margin: 0 0 18px;
  }

  .why__humidity-graph {
    position: relative;
    background: #ffffff;
    border: 1px solid #eee7dd;
    border-radius: 20px;
    padding: 28px 20px 22px 54px;
  }

  .why__graph-area {
    position: relative;
    height: 280px;
    border-left: 1px solid #d8cfc3;
    border-bottom: 1px solid #d8cfc3;
    background: linear-gradient(to bottom, rgba(216,207,195,0.35) 1px, transparent 1px);
    background-size: 100% 25%;
  }

  .why__graph-grid {
    position: absolute;
    left: 20px;
    top: 78px;
    height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 12px;
    color: #8a8178;
  }

  .why__ideal-zone {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28%;
    height: 22%;
    background: rgba(139,115,85,0.10);
    color: #8B7355;
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .why__graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .why__graph-path {
    fill: none;
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .why__graph-path--musubi {
    stroke: #8B7355;
  }

  .why__graph-path--other {
    stroke: #b9b1a8;
    stroke-dasharray: 5 5;
  }

  .why__graph-point {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    transform: translate(-50%, 50%);
    z-index: 3;
  }

  .why__graph-line--musubi .why__graph-point {
    background: #8B7355;
  }

  .why__graph-line--other .why__graph-point {
    background: #b9b1a8;
  }

  .why__graph-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 12px;
    color: #8a8178;
  }

  .why__graph-legend {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 18px;
    font-size: 13px;
    color: #333;
    font-weight: 700;
    flex-wrap: wrap;
  }

  .why__legend-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    margin-right: 6px;
  }

  .why__legend-dot--musubi {
    background: #8B7355;
  }

  .why__legend-dot--other {
    background: #b9b1a8;
  }

  .why__comparison-note {
    font-size: {{ section.settings.chart_note_size_pc }}px;
    color: {{ section.settings.chart_note_color }};
    line-height: 1.7;
    text-align: center;
    margin: 14px 0 0;
  }

  .why__comparison-conclusion {
    background: {{ section.settings.conclusion_bg_color }};
    border: 1px solid {{ section.settings.conclusion_border_color }};
    border-radius: 22px;
    padding: 26px;
    text-align: center;
    margin-bottom: 28px;
  }

  .why__comparison-conclusion-label {
    font-size: {{ section.settings.conclusion_label_size_pc }}px;
    color: {{ section.settings.conclusion_label_color }};
    font-weight: 700;
    margin: 0 0 12px;
  }

  .why__comparison-conclusion-text {
    font-size: {{ section.settings.conclusion_text_size_pc }}px;
    color: {{ section.settings.conclusion_text_color }};
    line-height: 1.9;
    letter-spacing: 0.04em;
  }

  .why__comparison-conclusion-text strong {
    color: {{ section.settings.strong_color }};
  }

  .why__comparison-cards {
    display: grid;
    grid-template-columns: 1fr 64px 1fr;
    gap: 18px;
    align-items: stretch;
  }

  .why__comparison-card {
    background: {{ section.settings.comparison_card_bg_color }};
    border: 1px solid {{ section.settings.comparison_card_border_color }};
    border-radius: 22px;
    padding: 28px 20px;
    text-align: center;
  }

  .why__comparison-card--musubi {
    border-color: {{ section.settings.musubi_accent_color }};
  }

  .why__comparison-badge {
    display: inline-block;
    font-size: {{ section.settings.comparison_badge_size_pc }}px;
    color: {{ section.settings.comparison_badge_color }};
    font-weight: 700;
    margin: 0 0 14px;
  }

  .why__comparison-value {
    font-size: {{ section.settings.comparison_value_size_pc }}px;
    color: {{ section.settings.comparison_value_color }};
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .why__comparison-desc {
    font-size: {{ section.settings.comparison_desc_size_pc }}px;
    color: {{ section.settings.comparison_desc_color }};
    line-height: 1.6;
    margin: 0 0 14px;
  }

  .why__comparison-verdict {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.comparison_verdict_size_pc }}px;
    font-weight: 700;
    border-radius: 999px;
    padding: 7px 13px;
    margin: 0;
  }

  .why__comparison-verdict--good {
    color: {{ section.settings.good_text_color }};
    background: {{ section.settings.good_bg_color }};
  }

  .why__comparison-verdict--bad {
    color: {{ section.settings.bad_text_color }};
    background: {{ section.settings.bad_bg_color }};
  }

  .why__comparison-vs {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #eee7dd;
    color: {{ section.settings.vs_color }};
    font-size: {{ section.settings.vs_size_pc }}px;
    font-weight: 800;
    letter-spacing: 0.08em;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    justify-self: center;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .why {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .why__header {
      margin-bottom: 30px;
    }

    .why__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .why__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .why__lead {
      font-size: {{ section.settings.lead_size_sp }}px;
    }

    .why__cards {
      gap: 22px;
      margin-bottom: 44px;
    }

    .why__card,
    .why__card:nth-child(even) {
      grid-template-columns: 1fr;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .why__card:nth-child(even) .why__card-img,
    .why__card:nth-child(even) .why__card-content {
      order: initial;
    }

    .why__card-img {
      min-height: {{ section.settings.image_height_sp }}px;
    }

    .why__card-content {
      padding: 26px 20px 28px;
    }

    .why__card-num {
      font-size: {{ section.settings.number_size_sp }}px;
    }

    .why__card-title {
      font-size: {{ section.settings.title_size_sp }}px;
    }

    .why__card-desc {
      font-size: {{ section.settings.description_size_sp }}px;
    }

    .why__comparison {
      padding: 32px 16px;
      border-radius: {{ section.settings.comparison_radius_sp }}px;
    }

    .why__comparison-label {
      font-size: {{ section.settings.comparison_label_size_sp }}px;
    }

    .why__comparison-heading {
      font-size: {{ section.settings.comparison_heading_size_sp }}px;
    }

    .why__comparison-chart {
      padding: 16px;
    }

    .why__comparison-chart-title {
      font-size: {{ section.settings.chart_title_size_sp }}px;
    }

    .why__humidity-graph {
      padding: 24px 14px 18px 44px;
    }

    .why__graph-area {
      height: 220px;
    }

    .why__graph-grid {
      left: 12px;
      top: 72px;
      height: 220px;
      font-size: 11px;
    }

    .why__ideal-zone {
      font-size: 10px;
    }

    .why__comparison-note {
      font-size: {{ section.settings.chart_note_size_sp }}px;
    }

    .why__comparison-conclusion-label {
      font-size: {{ section.settings.conclusion_label_size_sp }}px;
    }

    .why__comparison-conclusion-text {
      font-size: {{ section.settings.conclusion_text_size_sp }}px;
    }

    .why__comparison-cards {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .why__comparison-vs {
      width: 52px;
      height: 52px;
      font-size: {{ section.settings.vs_size_sp }}px;
      margin: 0 auto;
    }

    .why__comparison-value {
      font-size: {{ section.settings.comparison_value_size_sp }}px;
    }

    .why__comparison-badge {
      font-size: {{ section.settings.comparison_badge_size_sp }}px;
    }

    .why__comparison-desc {
      font-size: {{ section.settings.comparison_desc_size_sp }}px;
    }

    .why__comparison-verdict {
      font-size: {{ section.settings.comparison_verdict_size_sp }}px;
    }
  }
</style>

<section class="why" id="why">
  <div class="why__inner">

    <div class="why__header">
      {% if section.settings.label != blank %}
        <div class="why__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="why__heading">{{ section.settings.heading }}</h2>

      {% if section.settings.lead != blank %}
        <div class="why__lead">{{ section.settings.lead }}</div>
      {% endif %}
    </div>

    <div class="why__cards">
      {% for block in section.blocks %}
        <div class="why__card" {{ block.shopify_attributes }}>
          <div class="why__card-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '1200x' }}" alt="{{ block.settings.title }}" loading="lazy">
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" loading="lazy">
            {% endif %}
          </div>

          <div class="why__card-content">
            <span class="why__card-num">{{ block.settings.number }}</span>
            <h3 class="why__card-title">{{ block.settings.title }}</h3>
            <p class="why__card-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_comparison %}
      <div class="why__comparison">
        <div class="why__comparison-header">
          <div class="why__comparison-label">{{ section.settings.comparison_label }}</div>
          <h3 class="why__comparison-heading">{{ section.settings.comparison_heading }}</h3>
        </div>

        <div class="why__comparison-chart">
          <p class="why__comparison-chart-title">{{ section.settings.chart_title }}</p>

          <div class="why__humidity-graph">
            <div class="why__graph-grid">
              <span>70%</span>
              <span>60%</span>
              <span>50%</span>
              <span>40%</span>
            </div>

            <div class="why__graph-area">
              <div class="why__ideal-zone">理想的な湿度帯 50% ±5%</div>

              <svg class="why__graph-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                <polyline points="8,64 38,63 68,62 92,62" class="why__graph-path why__graph-path--musubi" />
                <polyline points="8,50 38,38 68,24 92,8" class="why__graph-path why__graph-path--other" />
              </svg>

              <div class="why__graph-line why__graph-line--musubi">
                <span class="why__graph-point" style="left: 8%; bottom: 36%;"></span>
                <span class="why__graph-point" style="left: 38%; bottom: 37%;"></span>
                <span class="why__graph-point" style="left: 68%; bottom: 38%;"></span>
                <span class="why__graph-point" style="left: 92%; bottom: 38%;"></span>
              </div>

              <div class="why__graph-line why__graph-line--other">
                <span class="why__graph-point" style="left: 8%; bottom: 50%;"></span>
                <span class="why__graph-point" style="left: 38%; bottom: 62%;"></span>
                <span class="why__graph-point" style="left: 68%; bottom: 76%;"></span>
                <span class="why__graph-point" style="left: 92%; bottom: 92%;"></span>
              </div>
            </div>

            <div class="why__graph-axis">
              <span>開始</span>
              <span>20分</span>
              <span>40分</span>
              <span>60分</span>
            </div>

            <div class="why__graph-legend">
              <span><i class="why__legend-dot why__legend-dot--musubi"></i>MUSUBI -en-</span>
              <span><i class="why__legend-dot why__legend-dot--other"></i>他社加重ブランケット</span>
            </div>
          </div>

          <p class="why__comparison-note">{{ section.settings.chart_note }}</p>
        </div>

        <div class="why__comparison-conclusion">
          <p class="why__comparison-conclusion-label">{{ section.settings.conclusion_label }}</p>
          <div class="why__comparison-conclusion-text">{{ section.settings.conclusion }}</div>
        </div>

        <div class="why__comparison-cards">
          <div class="why__comparison-card why__comparison-card--musubi">
            <p class="why__comparison-badge">MUSUBI -en-</p>
            <p class="why__comparison-value">{{ section.settings.musubi_value }}</p>
            <p class="why__comparison-desc">{{ section.settings.musubi_desc }}</p>
            <p class="why__comparison-verdict why__comparison-verdict--good">{{ section.settings.musubi_verdict }}</p>
          </div>

          <div class="why__comparison-vs">VS</div>

          <div class="why__comparison-card">
            <p class="why__comparison-badge">他社加重ブランケット</p>
            <p class="why__comparison-value">{{ section.settings.other_value }}</p>
            <p class="why__comparison-desc">{{ section.settings.other_desc }}</p>
            <p class="why__comparison-verdict why__comparison-verdict--bad">{{ section.settings.other_verdict }}</p>
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 選ばれる理由",
  "settings": [
    { "type": "header", "content": "選ばれる理由：テキスト" },
    { "type": "text", "id": "label", "label": "ラベル", "default": "WHY MUSUBI" },
    { "type": "richtext", "id": "heading", "label": "セクション見出し", "default": "<p>なぜMUSUBIは<br>選ばれているのか？</p>" },
    { "type": "richtext", "id": "lead", "label": "リード文", "default": "<p>重さだけではない。日々の暮らしに自然になじむよう、素材・構造・サイズ感まで設計しています。</p>" },

    { "type": "header", "content": "検証データ比較" },
    { "type": "checkbox", "id": "show_comparison", "label": "検証データ比較を表示する", "default": true },
    { "type": "text", "id": "comparison_label", "label": "検証ラベル", "default": "LABORATORY TEST" },
    { "type": "richtext", "id": "comparison_heading", "label": "検証見出し", "default": "<p>検証データが示す<br>MUSUBIの快適性</p>" },
    { "type": "text", "id": "chart_title", "label": "グラフタイトル", "default": "寝床内湿度（空間）比較データ" },
    { "type": "text", "id": "chart_note", "label": "グラフ注記", "default": "※発汗量 15ml/㎡/hr → 30ml/㎡/hrの条件下で計測" },
    { "type": "text", "id": "conclusion_label", "label": "結論ラベル", "default": "理想的な寝床内湿度：50% ± 5%" },
    { "type": "richtext", "id": "conclusion", "label": "結論テキスト", "default": "<p>MUSUBIの「あみあみ構造」は、重みによるムレを軽減。<br><strong>365日・オールシーズン快適に使える加重ブランケット</strong>を目指しました。</p>" },
    { "type": "text", "id": "musubi_value", "label": "MUSUBI 数値", "default": "約47〜48%" },
    { "type": "text", "id": "musubi_desc", "label": "MUSUBI 説明", "default": "60分間ほぼ一定で推移" },
    { "type": "text", "id": "musubi_verdict", "label": "MUSUBI 判定", "default": "✓ 理想的な範囲内" },
    { "type": "text", "id": "other_value", "label": "他社 数値", "default": "55% → 70%" },
    { "type": "text", "id": "other_desc", "label": "他社 説明", "default": "時間経過とともに上昇" },
    { "type": "text", "id": "other_verdict", "label": "他社 判定", "default": "✗ ムレやすい" },

    { "type": "header", "content": "文字サイズ・カラー" },
    { "type": "range", "id": "label_size_pc", "label": "ラベルサイズ（PC）", "min": 10, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "label_size_sp", "label": "ラベルサイズ（SP）", "min": 10, "max": 20, "step": 1, "default": 11 },
    { "type": "color", "id": "label_color", "label": "ラベル文字カラー", "default": "#8B7355" },
    { "type": "color", "id": "label_bg_color", "label": "ラベル背景カラー", "default": "#f4eee6" },
    { "type": "range", "id": "heading_size_pc", "label": "見出しサイズ（PC）", "min": 20, "max": 52, "step": 1, "default": 32 },
    { "type": "range", "id": "heading_size_sp", "label": "見出しサイズ（SP）", "min": 18, "max": 36, "step": 1, "default": 25 },
    { "type": "color", "id": "heading_color", "label": "見出しカラー", "default": "#1a1a1a" },
    { "type": "range", "id": "lead_size_pc", "label": "リード文サイズ（PC）", "min": 12, "max": 22, "step": 1, "default": 15 },
    { "type": "range", "id": "lead_size_sp", "label": "リード文サイズ（SP）", "min": 12, "max": 20, "step": 1, "default": 14 },
