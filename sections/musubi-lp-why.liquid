<style>
  .why {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .why__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .why__header {
    text-align: center;
    margin-bottom: 42px;
  }

  .why__label {
    display: inline-block;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 8px 15px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .why__heading {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .why__heading p,
  .why__lead p {
    margin: 0;
  }

  .why__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: {{ section.settings.lead_size_pc }}px;
    color: {{ section.settings.lead_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .why__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .why__card {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: stretch;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.07);
  }

  .why__card:nth-child(even) {
    grid-template-columns: 0.88fr 1.12fr;
  }

  .why__card:nth-child(even) .why__card-img {
    order: 2;
  }

  .why__card:nth-child(even) .why__card-content {
    order: 1;
  }

  .why__card-img {
    position: relative;
    min-height: {{ section.settings.image_height_pc }}px;
    background: {{ section.settings.image_bg_color }};
    overflow: hidden;
  }

  .why__card-img img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .why__card-img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.16) 100%);
    pointer-events: none;
  }

  .why__card-content {
    padding: 42px 38px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .why__card-num {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.number_color }};
    background: {{ section.settings.number_bg_color }};
    font-size: {{ section.settings.number_size_pc }}px;
    font-weight: 800;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 7px 14px;
    margin-bottom: 18px;
  }

  .why__card-title {
    font-size: {{ section.settings.title_size_pc }}px;
    color: {{ section.settings.title_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }

  .why__card-desc {
    font-size: {{ section.settings.description_size_pc }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.9;
    letter-spacing: 0.04em;
    margin: 0;
  }

  @media (max-width: 768px) {
    .why {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .why__header {
      margin-bottom: 30px;
    }

    .why__label {
      font-size: {{ section.settings.label_size_sp }}px;
      margin-bottom: 12px;
    }

    .why__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .why__lead {
      font-size: {{ section.settings.lead_size_sp }}px;
    }

    .why__cards {
      gap: 22px;
    }

    .why__card,
    .why__card:nth-child(even) {
      grid-template-columns: 1fr;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .why__card:nth-child(even) .why__card-img,
    .why__card:nth-child(even) .why__card-content {
      order: initial;
    }

    .why__card-img {
      min-height: {{ section.settings.image_height_sp }}px;
    }

    .why__card-content {
      padding: 26px 20px 28px;
    }

    .why__card-num {
      font-size: {{ section.settings.number_size_sp }}px;
      margin-bottom: 14px;
    }

    .why__card-title {
      font-size: {{ section.settings.title_size_sp }}px;
    }

    .why__card-desc {
      font-size: {{ section.settings.description_size_sp }}px;
      line-height: 1.8;
    }
  }
</style>

<section class="why" id="why">
  <div class="why__inner">

    <div class="why__header">
      {% if section.settings.label != blank %}
        <div class="why__label">
          {{ section.settings.label }}
        </div>
      {% endif %}

      <h2 class="why__heading">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.lead != blank %}
        <div class="why__lead">
          {{ section.settings.lead }}
        </div>
      {% endif %}
    </div>

    <div class="why__cards">
      {% for block in section.blocks %}
        <div class="why__card" {{ block.shopify_attributes }}>

          <div class="why__card-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '1200x' }}" alt="{{ block.settings.title }}" loading="lazy">
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.title }}" loading="lazy">
            {% endif %}
          </div>

          <div class="why__card-content">
            <span class="why__card-num">
              {{ block.settings.number }}
            </span>

            <h3 class="why__card-title">
              {{ block.settings.title }}
            </h3>

            <p class="why__card-desc">
              {{ block.settings.description }}
            </p>
          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

