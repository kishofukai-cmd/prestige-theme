<style>
  .soldout-history {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .soldout-history__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .soldout-history__box {
    background: {{ section.settings.box_bg_color }};
    border-radius: {{ section.settings.box_radius_pc }}px;
    padding: 48px 40px;
    box-shadow: 0 18px 48px rgba(0,0,0,0.06);
    text-align: center;
  }

  .soldout-history__heading {
    margin: 0 0 24px;
    font-size: {{ section.settings.heading_size_pc }}px;
    line-height: 1.55;
    letter-spacing: 0.04em;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
  }

  .soldout-history__heading p {
    margin: 0;
  }

  .soldout-history__lead {
    margin: 0 auto 28px;
    max-width: 680px;
    font-size: {{ section.settings.lead_size_pc }}px;
    line-height: 1.9;
    color: {{ section.settings.lead_color }};
    letter-spacing: 0.04em;
  }

  .soldout-history__lead p {
    margin: 0;
  }

  .soldout-history__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .soldout-history__item {
    background: {{ section.settings.item_bg_color }};
    border: 1px solid {{ section.settings.item_border_color }};
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .soldout-history__date {
    font-size: {{ section.settings.item_text_size_pc }}px;
    line-height: 1.5;
    color: {{ section.settings.item_text_color }};
    font-weight: 600;
    text-align: left;
  }

  .soldout-history__tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.tag_bg_color }};
    color: {{ section.settings.tag_color }};
    border-radius: 999px;
    padding: 5px 10px;
    font-size: {{ section.settings.tag_size_pc }}px;
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .soldout-history {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .soldout-history__box {
      padding: 32px 16px;
      border-radius: {{ section.settings.box_radius_sp }}px;
    }

    .soldout-history__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
      margin-bottom: 16px;
    }

    .soldout-history__lead {
      font-size: {{ section.settings.lead_size_sp }}px;
      margin-bottom: 22px;
    }

    .soldout-history__list {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .soldout-history__item {
      padding: 10px 12px;
    }

    .soldout-history__date {
      font-size: {{ section.settings.item_text_size_sp }}px;
    }

    .soldout-history__tag {
      font-size: {{ section.settings.tag_size_sp }}px;
      padding: 4px 8px;
    }
  }
</style>

<section class="soldout-history" id="soldout-history-{{ section.id }}">
  <div class="soldout-history__inner">
    <div class="soldout-history__box">

      <h2 class="soldout-history__heading">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.lead != blank %}
        <div class="soldout-history__lead">
          {{ section.settings.lead }}
        </div>
      {% endif %}

      <div class="soldout-history__list">
        {% for block in section.blocks %}
          <div class="soldout-history__item" {{ block.shopify_attributes }}>
            <span class="soldout-history__date">
              {{ block.settings.date }}
            </span>

            <span class="soldout-history__tag">
              {{ block.settings.status }}
            </span>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

