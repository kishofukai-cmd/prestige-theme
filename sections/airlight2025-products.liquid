{% comment %} AirLight 2025 (JP Domestic) — Product Cards (Men / Women / Peplum) {% endcomment %}

<style>
  .a25-products {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: clamp(40px, 7vw, 80px) 0;
  }

  .a25-products__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
  }

  .a25-products__heading {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1.4rem, 3.2vw, 2rem);
    font-weight: 500;
    line-height: 1.55;
    color: #1a1a1a;
    text-align: center;
    letter-spacing: 0.02em;
    margin: 0 0 clamp(28px, 4.5vw, 56px);
  }

  .a25-products__heading p { margin: 0 0 0.4em; }
  .a25-products__heading p:last-child { margin-bottom: 0; }
  .a25-products__heading em {
    font-style: normal;
    font-weight: 700;
    color: #c29d66;
  }

  .a25-products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 36px);
  }

  .a25-product-card {
    background: #ffffff;
    border: 1px solid #ece7df;
    border-radius: 10px;
    padding: clamp(16px, 2.2vw, 24px);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .a25-product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(26, 26, 26, 0.08);
  }

  /* Main gallery image */
  .a25-product-card__main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: #faf9f6;
    margin: 0 0 12px;
  }

  .a25-product-card__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }

  .a25-product-card__main img.is-fading { opacity: 0; }

  .a25-product-card__color-badge {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #1a1a1a;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 100px;
    padding: 4px 12px;
    pointer-events: none;
  }

  /* Color thumbnails (switcher) */
  .a25-product-card__thumbs {
    display: flex;
    gap: 8px;
    margin: 0 0 clamp(12px, 1.8vw, 18px);
  }

  .a25-product-card__thumb {
    display: block;
    width: 48px;
    min-width: 44px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: #faf9f6;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .a25-product-card__thumb.is-active {
    border-color: #c29d66;
  }

  .a25-product-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .a25-product-card__name {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 600;
    line-height: 1.5;
    color: #1a1a1a;
    margin: 0 0 6px;
    letter-spacing: 0.02em;
  }

  .a25-product-card__subtitle {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: #8a7f6e;
    margin: 0 0 10px;
    letter-spacing: 0.02em;
  }

  .a25-product-card__price {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-weight: 600;
    color: #c29d66;
    margin: 0 0 12px;
    letter-spacing: 0.02em;
  }

  .a25-product-card__description {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: 13px;
    line-height: 1.85;
    color: #5a5550;
    margin: 0 0 clamp(16px, 2.2vw, 22px);
    flex: 1;
  }

  .a25-product-card__cta {
    display: inline-block;
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    background: #1a1a1a;
    border-radius: 100px;
    padding: 12px 28px;
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
    margin-top: auto;
  }

  .a25-product-card__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .a25-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .a25-products {
      padding: 40px 0;
    }
    .a25-products__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .a25-product-card {
      padding: 16px;
    }
    .a25-product-card__thumbs {
      gap: 5px;
    }
    .a25-product-card__name {
      font-size: 1rem;
    }
    .a25-product-card__description {
      font-size: 13px;
      line-height: 1.8;
    }
    .a25-product-card__cta {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<section class="a25-products" id="{{ section.settings.section_id | default: 'a25-products' }}">
  <div class="a25-products__inner">
    {% if section.settings.heading != blank %}
      <div class="a25-products__heading">{{ section.settings.heading }}</div>
    {% endif %}

    <div class="a25-products__grid">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          <article class="a25-product-card" data-a25-gallery {{ block.shopify_attributes }}>
            {% assign main_src = '' %}
            {% assign main_color = '' %}
            {% for i in (1..5) %}
              {% assign img_key = 'image_' | append: i %}
              {% assign url_key = 'image_' | append: i | append: '_url' %}
              {% assign color_key = 'color_' | append: i %}
              {% assign img = block.settings[img_key] %}
              {% assign img_url = block.settings[url_key] %}
              {% if main_src == '' %}
                {% if img != blank %}
                  {% assign main_src = img | image_url: width: 900 %}
                  {% assign main_color = block.settings[color_key] %}
                {% elsif img_url != blank %}
                  {% assign main_src = img_url %}
                  {% assign main_color = block.settings[color_key] %}
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if main_src != '' %}
              <div class="a25-product-card__main">
                <img src="{{ main_src }}"
                     alt="{{ block.settings.product_name }} {{ main_color }}"
                     loading="lazy" data-a25-main>
                {% if main_color != blank %}
                  <span class="a25-product-card__color-badge" data-a25-badge>{{ main_color }}</span>
                {% endif %}
              </div>
            {% endif %}

            <div class="a25-product-card__thumbs" role="group" aria-label="{{ block.settings.product_name }} colors">
              {% for i in (1..5) %}
                {% assign img_key = 'image_' | append: i %}
                {% assign url_key = 'image_' | append: i | append: '_url' %}
                {% assign color_key = 'color_' | append: i %}
                {% assign img = block.settings[img_key] %}
                {% assign img_url = block.settings[url_key] %}
                {% assign color_label = block.settings[color_key] %}
                {% if img != blank or img_url != blank %}
                  {% assign thumb_src = img_url %}
                  {% if img != blank %}{% assign thumb_src = img | image_url: width: 900 %}{% endif %}
                  <button type="button"
                          class="a25-product-card__thumb{% if forloop.first %} is-active{% endif %}"
                          data-a25-thumb
                          data-src="{{ thumb_src }}"
                          data-color="{{ color_label | escape }}"
                          aria-label="Show {{ color_label | default: 'color' | escape }}">
                    <img src="{{ thumb_src }}"
                         alt=""
                         width="96" height="96" loading="lazy">
                  </button>
                {% endif %}
              {% endfor %}
            </div>

            {% if block.settings.product_name != blank %}
              <h3 class="a25-product-card__name">{{ block.settings.product_name }}</h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="a25-product-card__subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
            {% if block.settings.price != blank %}
              <p class="a25-product-card__price">{{ block.settings.price }}</p>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="a25-product-card__description">{{ block.settings.description | newline_to_br }}</p>
            {% endif %}
            {% if block.settings.cta_text != blank %}
              <a class="a25-product-card__cta" href="{{ block.settings.cta_url | default: '#' }}">
                {{ block.settings.cta_text }}
              </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    function initGalleries(root) {
      (root || document).querySelectorAll('[data-a25-gallery]').forEach(function (card) {
        if (card.dataset.a25Init) return;
        card.dataset.a25Init = '1';
        var main = card.querySelector('[data-a25-main]');
        var badge = card.querySelector('[data-a25-badge]');
        if (!main) return;
        card.querySelectorAll('[data-a25-thumb]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var src = btn.dataset.src;
            if (!src || src === main.getAttribute('src')) return;
            main.classList.add('is-fading');
            var swap = function () {
              main.setAttribute('src', src);
              if (badge && btn.dataset.color) badge.textContent = btn.dataset.color;
              main.classList.remove('is-fading');
            };
            setTimeout(swap, 120);
            card.querySelectorAll('[data-a25-thumb]').forEach(function (b) {
              b.classList.toggle('is-active', b === btn);
            });
          });
        });
      });
    }
    initGalleries();
    document.addEventListener('shopify:section:load', function (e) {
      initGalleries(e.target);
    });
  })();
</script>

