<section class="hotels" id="hotels">
  <div class="container">
    <h2 class="section-title" data-reveal>{{ section.settings.heading | default: 'MUSUBIを体験できる宿' }}</h2>
    <p class="hotels__desc" data-reveal>{{ section.settings.description | default: '全国のこだわりの宿で、購入前にMUSUBIの寝心地をお試しいただけます。' }}</p>
    <div class="hotels__grid">
      {% for block in section.blocks %}
        <div class="hotels__card" data-reveal {{ block.shopify_attributes }}>
          <div class="hotels__card-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.name }}" loading="lazy">
            {% endif %}
          </div>
          <h4 class="hotels__card-name">{{ block.settings.name }}</h4>
          <p class="hotels__card-type">{{ block.settings.type }}</p>
          <p class="hotels__card-detail">{{ block.settings.detail }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 体験宿",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "MUSUBIを体験できる宿"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "説明文",
      "default": "全国のこだわりの宿で、購入前にMUSUBIの寝心地をお試しいただけます。"
    }
  ],
  "blocks": [
    {
      "type": "hotel_card",
      "name": "宿カード",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "name",
          "label": "宿名",
          "default": "古民家宿 るうふ"
        },
        {
          "type": "text",
          "id": "type",
          "label": "タイプ",
          "default": "一棟貸し古民家宿"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "詳細",
          "default": "時が刻まれた壮麗な空間で、地域に伝わる食と自然の恵みを味わう"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI 体験宿",
      "blocks": [
        { "type": "hotel_card", "settings": { "name": "古民家宿 るうふ", "type": "一棟貸し古民家宿", "detail": "時が刻まれた壮麗な空間で、地域に伝わる食と自然の恵みを味わう" } },
        { "type": "hotel_card", "settings": { "name": "オーベルジュ エルバステラ", "type": "全3室の小さな宿", "detail": "野菜ソムリエプロ夫婦が営む滞在型リトリート" } },
        { "type": "hotel_card", "settings": { "name": "TACTILE HOUSE", "type": "工芸建材の体験宿", "detail": "産地の工芸・建材を空間で体験できる宿泊施設" } }
      ]
    }
  ]
}
{% endschema %}
