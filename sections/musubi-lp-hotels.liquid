<style>
  .hotels {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .hotels__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .hotels__header {
    text-align: center;
    margin-bottom: 42px;
  }

  .hotels__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border-radius: 999px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
  }

  .hotels__heading {
    margin: 0 0 18px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .hotels__heading p {
    margin: 0;
  }

  .hotels__desc {
    max-width: 720px;
    margin: 0 auto;
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desc_size_pc }}px;
    line-height: 2;
    letter-spacing: 0.04em;
  }

  .hotels__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_pc }}, minmax(0, 1fr));
    gap: 22px;
  }

  .hotels__card {
    overflow: hidden;
    border-radius: {{ section.settings.card_radius_pc }}px;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    box-shadow: 0 14px 38px rgba(0,0,0,0.06);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .hotels__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.10);
  }

  .hotels__card-img {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #f3f3f3;
  }

  .hotels__card-img::before {
    content: "";
    display: block;
    padding-top: {{ section.settings.image_ratio_pc }}%;
  }

  .hotels__card-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
    transition: transform 0.6s ease;
  }

  .hotels__card:hover .hotels__card-img img {
    transform: scale(1.04);
  }

  .hotels__card-content {
    padding: 24px 22px 26px;
  }

  .hotels__card-type {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 999px;
    background: {{ section.settings.type_bg_color }};
    color: {{ section.settings.type_color }};
    font-size: {{ section.settings.type_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 14px;
  }

  .hotels__card-name {
    margin: 0 0 10px;
    color: {{ section.settings.name_color }};
    font-size: {{ section.settings.name_size_pc }}px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.03em;
  }

  .hotels__card-detail {
    margin: 0;
    color: {{ section.settings.detail_color }};
    font-size: {{ section.settings.detail_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {

    .hotels {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .hotels__header {
      margin-bottom: 30px;
    }

    .hotels__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .hotels__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
      margin-bottom: 14px;
    }

    .hotels__desc {
      font-size: {{ section.settings.desc_size_sp }}px;
      line-height: 1.9;
    }

    .hotels__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .hotels__card {
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .hotels__card-img {
      width: 100%;
    }

    .hotels__card-img::before {
      padding-top: {{ section.settings.image_ratio_sp }}%;
    }

    .hotels__card-img img {
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.image_fit_sp }};
    }

    .hotels__card-content {
      padding: 20px 18px 22px;
    }

    .hotels__card-type {
      font-size: {{ section.settings.type_size_sp }}px;
    }

    .hotels__card-name {
      font-size: {{ section.settings.name_size_sp }}px;
    }

    .hotels__card-detail {
      font-size: {{ section.settings.detail_size_sp }}px;
    }
  }
</style>

<section class="hotels" id="hotels-{{ section.id }}">
  <div class="hotels__inner">

    <div class="hotels__header">

      {% if section.settings.label != blank %}
        <div class="hotels__label">
          {{ section.settings.label }}
        </div>
      {% endif %}

      <h2 class="hotels__heading">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <div class="hotels__desc">
          {{ section.settings.description }}
        </div>
      {% endif %}

    </div>

    <div class="hotels__grid">
      {% for block in section.blocks %}
        <div class="hotels__card" {{ block.shopify_attributes }}>

          <div class="hotels__card-img">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | img_url: '1200x' }}"
                alt="{{ block.settings.name }}"
                loading="lazy"
              >
            {% elsif block.settings.image_url != blank %}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.name }}"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="hotels__card-content">

            {% if block.settings.type != blank %}
              <div class="hotels__card-type">
                {{ block.settings.type }}
              </div>
            {% endif %}

            {% if block.settings.name != blank %}
              <h3 class="hotels__card-name">
                {{ block.settings.name }}
              </h3>
            {% endif %}

            {% if block.settings.detail != blank %}
              <p class="hotels__card-detail">
                {{ block.settings.detail }}
              </p>
            {% endif %}

          </div>

        </div>
      {% endfor %}
    </div>

  </div>
</section>

