<section class="ff-lp" id="ff-lp-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="ff-lp__inner" style="max-width: {{ section.settings.container_width }}px;">
    
    {%- for block in section.blocks -%}
      <div class="ff-lp__block ff-lp__block--{{ block.type }}" {{ block.shopify_attributes }} style="margin-top: {{ block.settings.margin_top }}px; margin-bottom: {{ block.settings.margin_bottom }}px; --margin-top: {{ block.settings.margin_top }}px; --margin-bottom: {{ block.settings.margin_bottom }}px;">
        
        {%- case block.type -%}
          {%- when 'hero' -%}
            <div class="ff-lp__hero">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | default: 'Hero image' | escape }}" class="ff-lp__hero-img {% if block.settings.image_sp != blank or block.settings.image_sp_url != blank %}ff-lp__hide-sp{% endif %}" loading="lazy">
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" alt="Hero image" class="ff-lp__hero-img {% if block.settings.image_sp != blank or block.settings.image_sp_url != blank %}ff-lp__hide-sp{% endif %}" loading="lazy">
              {%- endif -%}

              {%- if block.settings.image_sp != blank -%}
                <img src="{{ block.settings.image_sp | img_url: 'master' }}" alt="{{ block.settings.image_sp.alt | default: 'Hero image' | escape }}" class="ff-lp__hero-img ff-lp__hide-pc" loading="lazy">
              {%- elsif block.settings.image_sp_url != blank -%}
                <img src="{{ block.settings.image_sp_url }}" alt="Hero image sp" class="ff-lp__hero-img ff-lp__hide-pc" loading="lazy">
              {%- else -%}
                {%- if block.settings.image == blank and block.settings.image_url == blank -%}
                  {{ 'image' | placeholder_svg_tag: 'ff-lp__placeholder' }}
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'rich_text' -%}
            <div class="ff-lp__rich-text" style="text-align: {{ block.settings.text_alignment }}; color: {{ block.settings.text_color }}; background-color: {{ block.settings.bg_color }}; padding: {{ block.settings.padding }}px;">
              {%- if block.settings.heading != blank -%}
                <h2 class="ff-lp__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ff-lp__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'image_text' -%}
            <div class="ff-lp__image-text {% if block.settings.layout == 'right' %}ff-lp__image-text--reverse{% endif %}">
              <div class="ff-lp__image-text-col">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | img_url: '1000x' }}" alt="{{ block.settings.image.alt | escape }}" class="ff-lp__img" loading="lazy">
                {%- elsif block.settings.image_url != blank -%}
                  <img src="{{ block.settings.image_url }}" alt="Image" class="ff-lp__img" loading="lazy">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'ff-lp__placeholder' }}
                {%- endif -%}
              </div>
              <div class="ff-lp__image-text-col ff-lp__image-text-content" style="text-align: {{ block.settings.text_alignment }};">
                {%- if block.settings.heading != blank -%}
                  <h3 class="ff-lp__subheading" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="ff-lp__text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div style="margin-top: 24px;">
                    <a href="{{ block.settings.button_link | default: '#' }}" class="ff-lp__btn ff-lp__btn--sub">{{ block.settings.button_label }}</a>
                  </div>
                {%- endif -%}
              </div>
            </div>

          {%- when 'image_full' -%}
            <div class="ff-lp__image-full" style="text-align: center;">
              {%- if block.settings.button_link != blank -%}<a href="{{ block.settings.button_link }}">{%- endif -%}
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.image.alt | escape }}" class="ff-lp__img" style="max-width: {{ block.settings.max_width }}%; margin: 0 auto;" loading="lazy">
              {%- elsif block.settings.image_url != blank -%}
                 <img src="{{ block.settings.image_url }}" alt="Image" class="ff-lp__img" style="max-width: {{ block.settings.max_width }}%; margin: 0 auto;" loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'ff-lp__placeholder' }}
              {%- endif -%}
              {%- if block.settings.button_link != blank -%}</a>{%- endif -%}
            </div>

          {%- when 'product_grid' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="ff-lp__heading ff-lp__heading--center">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="ff-lp__product-grid" style="--grid-col-desktop: {{ block.settings.columns_desktop }};">
              {%- if block.settings.collection != blank -%}
                {%- assign target_col = block.settings.collection -%}
                {%- if target_col.products == blank -%}
                  {%- assign target_col = collections[target_col] -%}
                {%- endif -%}
                {%- for obj in target_col.products limit: block.settings.collection_limit -%}
                  <a href="{{ obj.url }}" class="ff-lp__product-card">
                    <div class="ff-lp__product-image">
                       <img src="{{ obj.featured_image | img_url: '600x' }}" alt="{{ obj.title | escape }}" loading="lazy">
                    </div>
                    <div class="ff-lp__product-info">
                      <h4 class="ff-lp__product-title">{{ obj.title }}</h4>
                      <div class="ff-lp__product-price">{{ obj.price | money }}</div>
                    </div>
                  </a>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..4) -%}
                  {%- capture product_key -%}product_{{ i }}{%- endcapture -%}
                  {%- assign product_handle = block.settings[product_key] -%}
                  {%- if product_handle != blank -%}
                    {%- assign obj = all_products[product_handle] -%}
                    <a href="{{ obj.url }}" class="ff-lp__product-card">
                      <div class="ff-lp__product-image">
                         <img src="{{ obj.featured_image | img_url: '600x' }}" alt="{{ obj.title | escape }}" loading="lazy">
                      </div>
                      <div class="ff-lp__product-info">
                        <h4 class="ff-lp__product-title">{{ obj.title }}</h4>
                        <div class="ff-lp__product-price">{{ obj.price | money }}</div>
                      </div>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
            
          {%- when 'features_grid' -%}
            <div class="ff-lp__features-grid {% if block.settings.icon_size == 'large' %}ff-lp__features-grid--large{% endif %}" style="--columns: {{ block.settings.columns_desktop }}; --columns-mobile: {{ block.settings.columns_mobile | default: 2 }};">
              {%- for i in (1..4) -%}
                {%- capture img_key -%}image_{{ i }}{%- endcapture -%}
                {%- capture img_url_key -%}image_url_{{ i }}{%- endcapture -%}
                {%- capture title_key -%}title_{{ i }}{%- endcapture -%}
                {%- capture text_key -%}text_{{ i }}{%- endcapture -%}
                
                {%- if block.settings[img_key] != blank or block.settings[img_url_key] != blank or block.settings[title_key] != blank -%}
                  <div class="ff-lp__feature-item">
                    <div class="ff-lp__feature-icon {% if block.settings.icon_size == 'large' %}ff-lp__feature-icon--large{% endif %}">
                      {%- if block.settings[img_key] != blank -%}
                        <img src="{{ block.settings[img_key] | img_url: '400x' }}" alt="{{ block.settings[title_key] | escape }}" loading="lazy">
                      {%- elsif block.settings[img_url_key] != blank -%}
                        <img src="{{ block.settings[img_url_key] }}" alt="{{ block.settings[title_key] | escape }}" loading="lazy">
                      {%- endif -%}
                    </div>
                    {%- if block.settings[title_key] != blank -%}
                      <div class="ff-lp__feature-heading">{{ block.settings[title_key] }}</div>
                    {%- endif -%}
                    {%- if block.settings[text_key] != blank -%}
                      <div class="ff-lp__feature-text">{{ block.settings[text_key] }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            
          {%- when 'review_card' -%}
            <div class="ff-lp__review-card">
              <div class="ff-lp__review-stars">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.rating -%}
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.heading != blank -%}
                <div class="ff-lp__review-heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ff-lp__review-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

          {%- when 'separator' -%}
            <hr class="ff-lp__separator" style="border-top: {{ block.settings.thickness }}px solid {{ block.settings.color }};">

          {%- when 'button' -%}
            <div class="ff-lp__btn-wrapper" style="text-align: {{ block.settings.alignment }};">
              <a href="{{ block.settings.button_link | default: '#' }}" class="ff-lp__btn">{{ block.settings.button_label }}</a>
            </div>

          {%- when 'spacer' -%}
            <div class="ff-lp__spacer ff-lp__hide-sp" style="height: {{ block.settings.height_pc }}px;"></div>
            <div class="ff-lp__spacer ff-lp__hide-pc" style="height: {{ block.settings.height_sp }}px;"></div>

          {%- when 'accordion' -%}
            <div class="ff-lp__accordion" style="margin-bottom: {{ block.settings.margin_bottom }}px;">
              {%- render 'accordion', title: block.settings.title, content: block.settings.content, open: block.settings.open, prose_content: true, show_arrow: true -%}
            </div>
        {%- endcase -%}

      </div>
    {%- endfor -%}

  </div>
</section>

<style>
  /* BEM Standard CSS */
  .ff-lp {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }
  .ff-lp__inner {
    margin: 0 auto;
    padding: 0 16px;
    width: 100%;
  }

  /* Utilities */
  .ff-lp__hide-pc { display: none; }
  .ff-lp__hide-sp { display: block; }
  @media (max-width: 768px) {
    .ff-lp__hide-pc { display: block; }
    .ff-lp__hide-sp { display: none; }
  }

  .ff-lp__placeholder {
    width: 100%;
    height: auto;
    background: #f4f4f4;
    display: block;
  }
  .ff-lp__img {
    max-width: 100%;
    width: auto;
    margin: 0 auto;
    height: auto;
    display: block;
  }

  /* Blocks */
  .ff-lp__block {
    position: relative;
  }

  /* Hero */
  .ff-lp__hero {
    width: 100%;
  }
  .ff-lp__hero-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Rich Text */
  .ff-lp__rich-text {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 0;
  }
  .ff-lp__heading {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: bold;
    margin-bottom: 24px;
    line-height: 1.4;
  }
  .ff-lp__heading--center {
    text-align: center;
  }
  .ff-lp__subheading {
    font-size: clamp(20px, 3vw, 28px);
    font-weight: bold;
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .ff-lp__text {
    font-size: 16px;
    line-height: 1.6;
  }
  .ff-lp__text p {
    margin-bottom: 1em;
  }
  .ff-lp__text h3 {
    font-size: 24px;
    font-weight: 600;
    margin-top: 32px;
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .ff-lp__text p:last-child {
    margin-bottom: 0;
  }

  /* Image with Text */
  .ff-lp__image-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px;
  }
  .ff-lp__image-text--reverse {
    flex-direction: row-reverse;
  }
  .ff-lp__image-text-col {
    flex: 1 1 300px;
    min-width: 300px;
  }
  @media (max-width: 768px) {
    .ff-lp__block {
      margin-top: calc(var(--margin-top, 40px) * 0.6) !important;
      margin-bottom: calc(var(--margin-bottom, 40px) * 0.6) !important;
    }
    .ff-lp__image-text {
      flex-direction: column;
      gap: 16px;
    }
    .ff-lp__image-text-col {
      flex-basis: auto !important;
      min-width: 100%;
    }
    .ff-lp__image-text--reverse {
      flex-direction: column;
    }
  }

  /* Product Grid */
  .ff-lp__product-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-col-desktop, 4), 1fr);
    gap: 24px;
    margin-top: 32px;
  }
  @media (max-width: 768px) {
    .ff-lp__product-grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 24px;
      margin-bottom: -12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .ff-lp__product-grid::-webkit-scrollbar {
      display: none;
    }
  }
  .ff-lp__product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }
  @media (max-width: 768px) {
    .ff-lp__product-card {
      width: 75%;
      flex: 0 0 75%;
      scroll-snap-align: start;
    }
  }
  .ff-lp__product-card:hover {
    opacity: 0.8;
  }
  .ff-lp__product-image {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f4f4f4;
    margin-bottom: 16px;
  }
  .ff-lp__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ff-lp__product-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    text-align: center;
  }
  .ff-lp__product-price {
    font-size: 15px;
    text-align: center;
    color: #666;
  }
  
  /* Features Grid */
  .ff-lp__features-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 4), 1fr);
    gap: 20px;
  }
  @media (max-width: 768px) {
    .ff-lp__features-grid {
      grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
    }
    .ff-lp__features-grid--large {
      grid-template-columns: 1fr !important; /* Stack large items on mobile */
      gap: 32px !important;
    }
  }
  .ff-lp__feature-item {
    text-align: center;
  }
  .ff-lp__feature-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ff-lp__feature-icon--large {
    width: 100% !important;
    height: auto !important;
    margin: 0 auto 20px !important;
    display: block !important;
  }
  .ff-lp__feature-icon--large img {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    object-fit: cover !important;
  }
  .ff-lp__feature-icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .ff-lp__feature-heading {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .ff-lp__feature-text {
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }
  
  /* Review Card */
  .ff-lp__review-card {
    background: #fdfdfd;
    padding: 32px;
    border-radius: 8px;
    text-align: left;
    border: 1px solid #eaeaea;
    max-width: 600px;
    margin: 0 auto;
  }
  .ff-lp__review-stars {
    color: #dba936;
    margin-bottom: 16px;
    display: flex;
    gap: 4px;
  }
  .ff-lp__review-heading {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 12px;
  }
  .ff-lp__review-text {
    font-size: 15px;
    line-height: 1.6;
    color: #444;
  }
  
  /* Separator */
  .ff-lp__separator {
    width: 100%;
    margin: 0;
  }

  /* Buttons */
  .ff-lp__btn {
    display: inline-block;
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 16px 40px;
    font-size: 16px;
    font-weight: bold;
    text-decoration: none;
    text-align: center;
    border-radius: 4px;
    transition: background-color 0.3s ease;
    cursor: pointer;
  }
  .ff-lp__btn:hover {
    background-color: #333333;
    color: #ffffff;
  }
  .ff-lp__btn--sub {
    padding: 12px 32px;
    font-size: 14px;
  }

</style>

{% schema %}
{
  "name": "Farm to Fashion LP",
  "max_blocks": 150,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "hero",
      "name": "Hero Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Desktop Image URL Fallback",
          "info": "Used if standard image is empty. e.g. https://ucarecdn.com/..."
        },
        {
          "type": "image_picker",
          "id": "image_sp",
          "label": "Mobile Image (optional)"
        },
        {
          "type": "text",
          "id": "image_sp_url",
          "label": "Mobile Image URL Fallback",
          "info": "Used if standard image is empty."
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Top",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Bottom",
          "default": 40
        }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your heading here"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers.</p>"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "transparent"
        },
        {
          "type": "range",
          "id": "padding",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Padding Inside",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Top",
          "default": 40
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Bottom",
          "default": 40
        }
      ]
    },
    {
      "type": "image_text",
      "name": "Image with Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL Fallback"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Desktop Layout",
          "options": [
            { "value": "left", "label": "Image on left" },
            { "value": "right", "label": "Image on right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Image with text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair large text with an image.</p>"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#1a1a1a"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Top",
          "default": 40
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Margin Bottom",
          "default": 40
        }
      ]
