{% comment %} AirLight Global LP — CTA Section {% endcomment %}

<section class="ag-cta" id="{{ section.settings.section_id | default: 'ag-cta' }}">
  <div class="ag-container--narrow" data-ag-reveal>
    {% if section.settings.eyebrow != blank %}
      <p class="ag-cta__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h2 class="ag-cta__heading">
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.subheading != blank %}
      <p class="ag-cta__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.show_launch_price %}
    <div style="
      display: inline-block;
      background: var(--ag-bg-dark);
      color: var(--ag-text-light);
      border-radius: 12px;
      padding: 14px 28px;
      margin-bottom: 24px;
      font-family: var(--ag-font-head);
    ">
      <span style="font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--ag-gold); display:block; margin-bottom:4px;">LAUNCH PRICE</span>
      <span style="font-size:1.8rem; font-weight:700; color:#fff; letter-spacing:0.02em;">{{ section.settings.launch_price | default: '$398' }}</span>
      <span style="font-size:0.78rem; color:rgba(255,255,255,0.5); margin-left:8px;">— {{ section.settings.launch_ends | default: 'First 100 customers only' }}</span>
    </div>
    {% endif %}

    {% if section.settings.offer_main != blank %}
      <div class="ag-cta__offer">
        {{ section.settings.offer_main }}
        {% if section.settings.offer_note != blank %}
          <div class="ag-cta__offer-note">{{ section.settings.offer_note }}</div>
        {% endif %}
      </div>
    {% endif %}

    <a href="{{ section.settings.cta_url | default: '#ag-products' }}" class="ag-cta__btn">
      {{ section.settings.cta_text | default: 'Claim Your Spot — $398' }}
    </a>

    <div class="ag-cta__micros">
      {% if section.settings.micro_1 != blank %}<span>{{ section.settings.micro_1 }}</span>{% endif %}
      {% if section.settings.micro_2 != blank %}<span>{{ section.settings.micro_2 }}</span>{% endif %}
      {% if section.settings.micro_3 != blank %}<span>{{ section.settings.micro_3 }}</span>{% endif %}
    </div>
  </div>
</section>

<style>
.ag-cta__subheading {
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  color: rgba(255,255,255,0.7);
  margin: 0 0 32px;
  line-height: 1.65;
  max-width: 540px;
}

/* --- Mobile --- */
@media (max-width: 768px) {
  .ag-cta {
    padding-left: 16px;
    padding-right: 16px;
  }
  .ag-cta__heading {
    font-size: clamp(1.8rem, 6vw, 2.4rem);
  }
  .ag-cta__subheading {
    font-size: 0.95rem;
  }
  .ag-cta__btn {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    font-size: 1rem;
  }
  .ag-cta__micros {
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }
  .ag-cta__offer {
    font-size: 13px;
  }
}
</style>

{% schema %}
{
  "name": "AG CTA",
  "settings": [
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "ag-cta" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Global Launch — First 100 Customers" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Join the First 100 <em>Global Members.</em></p>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "This is not a flash sale. This is the first time AirLight Jacket has ever been available outside Japan." },
    { "type": "text", "id": "launch_price", "label": "Launch Price", "default": "$398" },
    { "type": "text", "id": "launch_ends", "label": "Launch Ends Date", "default": "First 100 customers only" },
    { "type": "checkbox", "id": "show_launch_price", "label": "Show Launch Price Banner", "default": true },
    { "type": "text", "id": "offer_main", "label": "Offer Main", "default": "✓ Free Worldwide Shipping on All Orders" },
    { "type": "text", "id": "offer_note", "label": "Offer Note", "default": "No code needed. Applied automatically at checkout." },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Claim Your Spot — $398" },
    { "type": "text", "id": "micro_1", "label": "Micro 1", "default": "✓ 30-day return guarantee" },
    { "type": "text", "id": "micro_2", "label": "Micro 2", "default": "✓ All Made in Japan" },
    { "type": "text", "id": "micro_3", "label": "Micro 3", "default": "✓ Import duties billed at delivery (DDU)" }
  ],
  "presets": [{ "name": "AG CTA" }]
}
{% endschema %}
