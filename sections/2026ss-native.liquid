  .ag-carousel[data-collg="4"] > .ag-carousel-item { flex: 0 0 calc(25% - 12px); }
}

/* Icon List */
ul.ag-icon-list { list-style: none; padding: 0; margin: 0; }
ul.ag-icon-list > li { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 24px; }
