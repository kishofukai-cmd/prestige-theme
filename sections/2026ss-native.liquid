  .ag-elm-right-xs { text-align: right !important; }
}

/* Typography Overrides */
.ag-text-heading-2 { font-size: 1.5rem; font-weight: bold; margin-bottom: 0.5em; line-height: 1.4; }
.ag-text-paragraph-1 { font-size: 1rem; }

/* Buttons */
.ag-button { display: inline-block; padding: 14px 32px; border-radius: 4px; text-decoration: none; text-align: center; font-weight: bold; transition: opacity 0.2s; }
