.ag-carousel::-webkit-scrollbar { display: none; }
.ag-carousel-item { scroll-snap-align: center; flex: 0 0 80%; }
.ag-carousel[data-colxs="1"] > .ag-carousel-item { flex: 0 0 calc(100% - 16px); }
.ag-carousel[data-colxs="2"] > .ag-carousel-item { flex: 0 0 calc(50% - 8px); }
