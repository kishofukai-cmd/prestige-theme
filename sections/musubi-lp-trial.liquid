<section class="trial" id="trial">
  <div class="container--narrow">
    <div class="trial__box" data-reveal>
      <h2 class="trial__title">{{ section.settings.title | default: '「私に合うかな…？」<br>まずはご自宅でお試しください' }}</h2>
      <div class="trial__price">
        <span class="trial__label">{{ section.settings.plan_label | default: '1週間 お試しプラン' }}</span>
        <span class="trial__amount">{{ section.settings.plan_price | default: '¥5,000' }}<span>{{ section.settings.plan_price_suffix | default: '〜' }}</span></span>
      </div>
      <p class="trial__desc">{{ section.settings.description | default: '「重さが負担にならないか」「自分に合うか不安」という方へ。まずは1週間、いつもの寝室やソファでじっくりお試しいただける特別なプランをご用意しました。合わなければ返却も可能です。' }}</p>
      <a href="{{ section.settings.cta_url | default: '#link-to-rental' }}" class="trial__btn">{{ section.settings.cta_text | default: 'お試しプランを詳しく見る' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI トライアル",
  "settings": [
    {
      "type": "richtext",
      "id": "title",
      "label": "タイトル",
      "default": "<p>「私に合うかな…？」<br>まずはご自宅でお試しください</p>"
    },
    {
      "type": "text",
      "id": "plan_label",
      "label": "プランラベル",
      "default": "1週間 お試しプラン"
    },
    {
      "type": "text",
      "id": "plan_price",
      "label": "プラン価格",
      "default": "¥5,000"
    },
    {
      "type": "text",
      "id": "plan_price_suffix",
      "label": "価格接尾辞",
      "default": "〜"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "説明文",
      "default": "「重さが負担にならないか」「自分に合うか不安」という方へ。まずは1週間、いつもの寝室やソファでじっくりお試しいただける特別なプランをご用意しました。合わなければ返却も可能です。"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTAリンク先"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTAボタンテキスト",
      "default": "お試しプランを詳しく見る"
    }
  ],
  "presets": [{ "name": "MUSUBI トライアル" }]
}
{% endschema %}
