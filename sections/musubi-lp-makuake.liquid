<style>
  .makuake {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .makuake__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .makuake__box {
    background: {{ section.settings.box_bg_color }};
    border: 1px solid {{ section.settings.box_border_color }};
    border-radius: {{ section.settings.box_radius }}px;
    padding: 56px 44px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
    text-align: center;
  }

  .makuake__badge {
    display: inline-block;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 9px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .makuake__title {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 28px;
  }

  .makuake__title p {
    margin: 0;
  }

  .makuake__hero-image {
    margin: 0 auto 34px;
    max-width: {{ section.settings.hero_image_width }}px;
    border-radius: {{ section.settings.hero_image_radius }}px;
    overflow: hidden;
    box-shadow: 0 16px 42px rgba(0,0,0,0.10);
  }

  .makuake__hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .makuake__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 34px;
  }

  .makuake__stat {
    background: {{ section.settings.stat_bg_color }};
    border-radius: {{ section.settings.stat_radius }}px;
    padding: 28px 16px;
    border: 1px solid {{ section.settings.stat_border_color }};
  }

  .makuake__stat-number {
    display: block;
    font-size: {{ section.settings.stat_number_size_pc }}px;
    color: {{ section.settings.stat_number_color }};
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.02em;
    margin-bottom: 8px;
  }

  .makuake__stat-label {
    display: block;
    font-size: {{ section.settings.stat_label_size_pc }}px;
    color: {{ section.settings.stat_label_color }};
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .makuake__soldout {
    background: {{ section.settings.soldout_bg_color }};
    border-radius: {{ section.settings.soldout_radius }}px;
    padding: 28px;
    margin-bottom: 28px;
    text-align: left;
  }

  .makuake__soldout-title {
    margin: 0 0 18px;
    text-align: center;
    font-size: {{ section.settings.soldout_heading_size_pc }}px;
    color: {{ section.settings.soldout_heading_color }};
    font-weight: 700;
    line-height: 1.5;
  }

  .makuake__soldout-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .makuake__soldout-item {
    background: {{ section.settings.soldout_item_bg_color }};
    border: 1px solid {{ section.settings.soldout_item_border_color }};
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .makuake__soldout-date {
    font-size: {{ section.settings.soldout_text_size_pc }}px;
    color: {{ section.settings.soldout_text_color }};
    line-height: 1.5;
    font-weight: 600;
  }

  .makuake__soldout-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: {{ section.settings.soldout_tag_bg_color }};
    color: {{ section.settings.soldout_tag_color }};
    font-size: {{ section.settings.soldout_tag_size_pc }}px;
    font-weight: 700;
    border-radius: 999px;
    padding: 5px 10px;
    line-height: 1;
  }

  .makuake__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.link_bg_color }};
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size_pc }}px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 15px 28px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .makuake__link:hover {
    opacity: 0.86;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .makuake {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .makuake__box {
      padding: 36px 18px;
      border-radius: {{ section.settings.box_radius_sp }}px;
    }

    .makuake__badge {
      font-size: {{ section.settings.badge_size_sp }}px;
      margin-bottom: 14px;
    }

    .makuake__title {
      font-size: {{ section.settings.heading_size_sp }}px;
      margin-bottom: 20px;
    }

    .makuake__hero-image {
      margin-bottom: 24px;
      border-radius: {{ section.settings.hero_image_radius_sp }}px;
    }

    .makuake__stats {
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 24px;
    }

    .makuake__stat {
      padding: 22px 14px;
      border-radius: {{ section.settings.stat_radius_sp }}px;
    }

    .makuake__stat-number {
      font-size: {{ section.settings.stat_number_size_sp }}px;
    }

    .makuake__stat-label {
      font-size: {{ section.settings.stat_label_size_sp }}px;
    }

    .makuake__soldout {
      padding: 20px 14px;
      border-radius: {{ section.settings.soldout_radius_sp }}px;
      margin-bottom: 24px;
    }

    .makuake__soldout-title {
      font-size: {{ section.settings.soldout_heading_size_sp }}px;
    }

    .makuake__soldout-list {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .makuake__soldout-date {
      font-size: {{ section.settings.soldout_text_size_sp }}px;
    }

    .makuake__soldout-tag {
      font-size: {{ section.settings.soldout_tag_size_sp }}px;
    }

    .makuake__link {
      width: 100%;
      font-size: {{ section.settings.link_size_sp }}px;
      padding: 14px 18px;
    }
  }
</style>

<section class="makuake" id="makuake">
  <div class="makuake__inner">
    <div class="makuake__box">

      <div class="makuake__header">

        {% if section.settings.badge != blank %}
          <span class="makuake__badge">
            {{ section.settings.badge }}
          </span>
        {% endif %}

        <h2 class="makuake__title">
          {{ section.settings.heading }}
        </h2>

        {% if section.settings.hero_image != blank %}
          <div class="makuake__hero-image">
            <img
              src="{{ section.settings.hero_image | img_url: '1200x' }}"
              alt="{{ section.settings.hero_image_alt }}"
              loading="lazy"
            >
          </div>
        {% endif %}

      </div>

      <div class="makuake__stats">

        <div class="makuake__stat">
          <span class="makuake__stat-number">
            {{ section.settings.amount }}
          </span>
          <span class="makuake__stat-label">
            {{ section.settings.amount_label }}
          </span>
        </div>

        <div class="makuake__stat">
          <span class="makuake__stat-number">
            {{ section.settings.supporters }}
          </span>
          <span class="makuake__stat-label">
            {{ section.settings.supporters_label }}
          </span>
        </div>

        <div class="makuake__stat">
          <span class="makuake__stat-number">
            {{ section.settings.percent }}
          </span>
          <span class="makuake__stat-label">
            {{ section.settings.percent_label }}
          </span>
        </div>

      </div>

      <div class="makuake__soldout">

        <p class="makuake__soldout-title">
          {{ section.settings.soldout_heading }}
        </p>

        <div class="makuake__soldout-list">

          {% for block in section.blocks %}
            <div class="makuake__soldout-item" {{ block.shopify_attributes }}>
              <span class="makuake__soldout-date">
                {{ block.settings.date }}
              </span>

              <span class="makuake__soldout-tag">
                {{ block.settings.status }}
              </span>
            </div>
          {% endfor %}

        </div>
      </div>

      {% if section.settings.makuake_url != blank %}
        <a
          href="{{ section.settings.makuake_url }}"
          class="makuake__link"
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.link_text }}
        </a>
      {% endif %}

    </div>
  </div>
</section>

