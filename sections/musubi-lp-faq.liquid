<style>
  .faq {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .faq__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .faq__header {
    text-align: center;
    margin-bottom: 36px;
  }

  .faq__label {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }

  .faq__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .faq__heading p {
    margin: 0;
  }

  .faq__list {
    display: grid;
    gap: 14px;
  }

  .faq__item {
    overflow: hidden;
    border-radius: {{ section.settings.card_radius_pc }}px;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    box-shadow: 0 10px 28px rgba(0,0,0,0.04);
  }

  .faq__question {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 24px;
    cursor: pointer;
    color: {{ section.settings.question_color }};
    font-size: {{ section.settings.question_size_pc }}px;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question span:first-child {
    flex: 1;
  }

  .faq__icon {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: {{ section.settings.icon_bg_color }};
    color: {{ section.settings.icon_color }};
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 24px 24px;
    color: {{ section.settings.answer_color }};
    font-size: {{ section.settings.answer_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .faq__answer p {
    margin: 0;
  }

  .faq__answer a {
    color: {{ section.settings.link_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .faq {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .faq__header {
      margin-bottom: 28px;
    }

    .faq__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .faq__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .faq__list {
      gap: 12px;
    }

    .faq__item {
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .faq__question {
      padding: 18px 18px;
      font-size: {{ section.settings.question_size_sp }}px;
    }

    .faq__icon {
      width: 28px;
      height: 28px;
      font-size: 20px;
    }

    .faq__answer {
      padding: 0 18px 20px;
      font-size: {{ section.settings.answer_size_sp }}px;
    }
  }
</style>

<section class="faq" id="faq-{{ section.id }}">
  <div class="faq__inner">

    <div class="faq__header">
      {% if section.settings.label != blank %}
        <div class="faq__label">
          {{ section.settings.label }}
        </div>
      {% endif %}

      <h2 class="faq__heading">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="faq__list">
      {% for block in section.blocks %}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="faq__icon">+</span>
          </summary>

          <div class="faq__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>

  </div>
</section>

