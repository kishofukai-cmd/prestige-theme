{% comment %} AirLight Global LP — Features (5大特徴) {% endcomment %}

<style>
  .ag-features {
    background: var(--ag-bg-warm, #faf9f6);
    padding: clamp(64px, 10vw, 120px) 0;
    overflow: hidden;
  }
  .ag-features__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ag-text, #1a2640);
    text-align: center;
    margin: 0 auto clamp(48px, 7vw, 80px);
    max-width: 640px;
    padding: 0 var(--ag-pad, 24px);
  }
  .ag-features__heading em {
    font-style: italic;
    color: var(--ag-gold, #c29d66);
  }
  .ag-features__heading p { font-size: inherit; font-family: inherit; font-weight: inherit; line-height: inherit; margin: 0; }

  .ag-features__cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 36px);
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--ag-pad, 24px);
  }

  .ag-feature-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 20px rgba(26,38,64,0.06);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ag-feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 40px rgba(26,38,64,0.12);
  }

  .ag-feature-card__img {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--ag-bg-warm, #faf9f6);
    display: block;
    flex-shrink: 0;
  }
  .ag-feature-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .ag-feature-card:hover .ag-feature-card__img img { transform: scale(1.04); }

  .ag-feature-card__body {
    padding: clamp(20px, 2.5vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .ag-feature-card__tag {
    font-family: 'Outfit', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ag-gold, #c29d66);
  }
  .ag-feature-card__num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.88rem;
    color: rgba(26,38,64,0.22);
    font-weight: 400;
    letter-spacing: 0.05em;
  }
  .ag-feature-card__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ag-text, #1a2640);
    margin: 0;
  }
  .ag-feature-card__desc {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.85rem, 1.3vw, 0.92rem);
    line-height: 1.75;
    color: var(--ag-text-sub, #5a6678);
    margin: 0;
    flex: 1;
  }
  .ag-feature-card__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid rgba(26,38,64,0.08);
  }
  .ag-feature-card__stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--ag-text, #1a2640);
    line-height: 1;
  }
  .ag-feature-card__stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    color: var(--ag-text-sub, #5a6678);
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .ag-features { padding-left: 0; padding-right: 0; }
    .ag-features__heading { font-size: 1.8rem; margin-bottom: 32px; padding: 0 16px; }
    .ag-features__cards { grid-template-columns: 1fr; gap: 20px; padding: 0 16px; }
    .ag-feature-card__img { aspect-ratio: 16/9; }
    .ag-feature-card__title { font-size: 1.2rem; }
    .ag-feature-card__desc { font-size: 14px; }
  }
</style>

<section class="ag-features" id="ag-features">
  <div class="ag-container--narrow">
    <h2 class="ag-features__heading" data-ag-reveal>
      {{ section.settings.heading }}
    </h2>
  </div>

  <div class="ag-features__cards">
    {% assign counter = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'feature_card' %}
        {% assign counter = counter | plus: 1 %}
        <div class="ag-feature-card" {{ block.shopify_attributes }} data-ag-reveal>
          <div class="ag-feature-card__img">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {% elsif block.settings.fallback_url != blank %}
              <img src="{{ block.settings.fallback_url }}" alt="{{ block.settings.title }}" loading="lazy">
            {% else %}
              <div style="width:100%;height:100%;background:var(--ag-bg-warm);display:flex;align-items:center;justify-content:center;font-size:3rem;">{{ block.settings.placeholder_emoji | default: '🪶' }}</div>
            {% endif %}
          </div>
          <div class="ag-feature-card__body">
            <span class="ag-feature-card__tag">{{ block.settings.tag }}</span>
            <span class="ag-feature-card__num">0{{ counter }}</span>
            <h3 class="ag-feature-card__title">{{ block.settings.title }}</h3>
            <p class="ag-feature-card__desc">{{ block.settings.description }}</p>
            {% if block.settings.stat_num != blank %}
              <div class="ag-feature-card__stat">
                <span class="ag-feature-card__stat-num">{{ block.settings.stat_num }}</span>
                <span class="ag-feature-card__stat-label">{{ block.settings.stat_label }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "AG Features",
  "settings": [
    { "type": "richtext", "id": "heading", "label": "Section Heading", "default": "<p>Everything down promises. <em>Finally delivered.</em></p>" }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "settings": [
        { "type": "text", "id": "placeholder_emoji", "label": "Placeholder Emoji", "default": "🪶" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "ULTRALIGHT" },
        { "type": "text", "id": "title", "label": "Title", "default": "Lighter Than a Sweater" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "stat_num", "label": "Stat Number", "default": "500g" },
        { "type": "text", "id": "stat_label", "label": "Stat Label", "default": "Total weight — 40% lighter than down" },
        { "type": "image_picker", "id": "image", "label": "Card Image" },
        { "type": "text", "id": "fallback_url", "label": "Image URL (fallback)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Features",
      "blocks": [
        { "type": "feature_card", "settings": { "tag": "ULTRALIGHT", "title": "Lighter Than a Sweater", "stat_num": "500g", "stat_label": "vs 800–1000g for down" } },
        { "type": "feature_card", "settings": { "tag": "ALL-WEATHER", "title": "Rain? No Problem.", "stat_num": "20×", "stat_label": "Water resistance vs umbrella" } },
        { "type": "feature_card", "settings": { "tag": "100% VEGAN", "title": "No Animals. No Feathers.", "stat_num": "0", "stat_label": "Animals involved" } },
        { "type": "feature_card", "settings": { "tag": "DOWN-LEVEL WARMTH", "title": "As Warm as Down. Proven.", "stat_num": "3°C", "stat_label": "Test environment — matches down" } }
      ]
    }
  ]
}
{% endschema %}
