  .ag-carousel[data-collg="3"] > .ag-carousel-item { flex: 0 0 calc(33.333333% - 11px); }
  .ag-carousel[data-collg="4"] > .ag-carousel-item { flex: 0 0 calc(25% - 12px); }
}

/* Icon List */
ul.ag-icon-list { list-style: none; padding: 0; margin: 0; }
.ag-icon-list { padding: 0; margin: 0; }
.ag-icon-list > li,
.ag-icon-list .ag-il-item { display: flex !important; align-items: flex-start !important; gap: 16px !important; margin-bottom: 24px !important; }
.ag-il-icon { flex: 0 0 80px !important; max-width: 80px !important; display: block !important; }
.ag-il-icon img { width: 100% !important; height: auto !important; display: block !important; }
.ag-il-text { flex: 1 !important; }
.ag-il-text h3, .ag-il-text h4 { margin-top: 0; margin-bottom: 8px; font-size: 1.1rem; }
