.ag-elm-left, .ag-elm-left-lg, .ag-elm-left-md, .ag-elm-left-sm { text-align: left; }
.ag-elm-right, .ag-elm-right-lg, .ag-elm-right-md, .ag-elm-right-sm { text-align: right; }
