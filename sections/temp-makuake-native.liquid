.ag-button:hover { opacity: 0.8; }

/* Responsive Hide Rules */
@media (min-width: 1200px) { .ag-hide-pc, .hidden-lg { display: none !important; } }
@media (max-width: 1199px) and (min-width: 992px) { .ag-hide-laptop { display: none !important; } }
