/* Carousel (CSS Scroll Snap) */
.ag-carousel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; padding-bottom: 16px; scrollbar-width: none; }
.ag-carousel::-webkit-scrollbar { display: none; }
.ag-carousel-item { scroll-snap-align: center; flex: 0 0 80%; }
