{% comment %}
  MUSUBI-en レビューAIサマリーセクション
  設置場所: Shopify テーマ > Sections > 新規追加
  最終更新: 2026-10-19（AI要約は44件のレビューから作成。平均と件数は商品のレビュー情報 reviews.rating / reviews.rating_count から自動。
  星ごとの棒グラフは手で合わせるとずれるため外し、正確な分布は下の Judge.me の欄に任せる）
  2026-10-19 追加: レビューが0件の商品（コラボ商品など）は、設定「参考に出す商品」のレビューを注記つきで出す。構造化データには載せない
{% endcomment %}

<style>
  .mrs-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 48px;
    font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif;
    color: #333;
  }

  /* ── 見出し ── */
  .mrs-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .mrs-heading-icon {
    width: 22px;
    height: 22px;
    color: #555;
  }

  .mrs-heading h2 {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.03em;
  }

  /* ── 評価エリア ── */
  .mrs-rating-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
  }

  .mrs-score {
    text-align: center;
    grid-column: 2;
  }

  .mrs-stars-large {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-bottom: 8px;
  }

  .mrs-star-lg {
    width: 30px;
    height: 30px;
    fill: #e8a020;
  }

  .mrs-star-lg--half {
    fill: url(#mrs-half-grad);
  }

  .mrs-star-lg--empty {
    fill: #e0e0e0;
  }

  .mrs-ref-note {
    margin: 8px 0 0;
    font-size: 12px;
    color: #888;
  }

  .mrs-all-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    color: #555;
    text-decoration: underline;
  }

  .mrs-score-num {
    font-size: 44px;
    font-weight: 300;
    letter-spacing: -1px;
    color: #222;
    line-height: 1;
    margin-bottom: 6px;
  }

  .mrs-review-count {
    font-size: 13px;
    color: #888;
  }

  /* バー */
  .mrs-bars {
    grid-column: 3;
  }

  .mrs-bar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
  }

  .mrs-bar-star {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: #666;
    width: 24px;
    justify-content: flex-end;
  }

  .mrs-bar-star svg {
    width: 10px;
    height: 10px;
    fill: #ccc;
    flex-shrink: 0;
  }

  .mrs-bar-track {
    flex: 1;
    height: 8px;
    background: #e8e8e8;
    border-radius: 4px;
    overflow: hidden;
    min-width: 140px;
  }

  .mrs-bar-fill {
    height: 100%;
    background: #333;
    border-radius: 4px;
  }

  .mrs-bar-count {
    font-size: 12px;
    color: #999;
    width: 32px;
    text-align: right;
  }

  /* ── AI要約 ── */
  .mrs-ai-section {
    border: 1px solid #ddd;
  }

  .mrs-ai-title {
    font-size: 14px;
    font-weight: 500;
    padding: 14px 20px 0;
    color: #333;
  }

  .mrs-tabs {
    display: flex;
    margin: 10px 0 0;
    border-bottom: 1px solid #ddd;
  }

  .mrs-tab-btn {
    padding: 11px 28px;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    border: none;
    border-right: 1px solid #ddd;
    background: #f0f0f0;
    color: #999;
    letter-spacing: 0.02em;
    transition: background 0.15s, color 0.15s;
  }

  .mrs-tab-btn.is-active {
    background: #fff;
    color: #222;
    font-weight: 500;
  }

  .mrs-panel {
    display: none;
    padding: 22px 24px 18px;
  }

  .mrs-panel.is-active {
    display: block;
  }

  /* お客様の声リスト */
  .mrs-voice-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mrs-voice-list li {
    position: relative;
    padding: 10px 0 10px 20px;
    font-size: 14px;
    line-height: 1.8;
    color: #333;
    border-bottom: 1px solid #f0f0f0;
  }

  .mrs-voice-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mrs-voice-list li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 19px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #bbb;
  }

  /* 色々な使い方 */
  .mrs-usage-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mrs-usage-item {
    display: flex;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid #f0f0f0;
    align-items: flex-start;
  }

  .mrs-usage-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mrs-usage-tag {
    flex-shrink: 0;
    font-size: 11px;
    color: #888;
    border: 1px solid #ddd;
    padding: 2px 8px;
    letter-spacing: 0.06em;
    margin-top: 3px;
    white-space: nowrap;
  }

  .mrs-usage-text {
    font-size: 14px;
    line-height: 1.8;
    color: #333;
  }

  /* 免責 */
  .mrs-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 11px 20px;
    background: #fafafa;
    border-top: 1px solid #e8e8e8;
  }

  .mrs-disclaimer svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 2px;
    color: #bbb;
  }

  .mrs-disclaimer p {
    margin: 0;
    font-size: 11px;
    color: #aaa;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .mrs-rating-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .mrs-score { grid-column: 1; }
    .mrs-bars  { grid-column: 1; }
    .mrs-tab-btn { padding: 10px 16px; font-size: 13px; }
  }
</style>

<svg width="0" height="0" style="position:absolute;pointer-events:none">
  <defs>
    <linearGradient id="mrs-half-grad" x1="0" x2="1" y1="0" y2="0">
      <stop offset="50%" stop-color="#e8a020"/>
      <stop offset="50%" stop-color="#e0e0e0"/>
    </linearGradient>
  </defs>
</svg>

<div class="mrs-wrap">

  <div class="mrs-heading">
    <svg class="mrs-heading-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <h2>レビュー</h2>
  </div>

  {%- comment -%} 平均と件数は Judge.me が商品に記録しているレビュー情報から。無いとき（件数0）は評価の行ごと出さない {%- endcomment -%}
  {%- assign mrs_src = product -%}
  {%- assign mrs_ref = false -%}
  {%- assign mrs_count = product.metafields.reviews.rating_count.value | default: 0 -%}
  {%- if mrs_count == 0 and section.settings.reference_product != blank -%}
    {%- assign mrs_src = section.settings.reference_product -%}
    {%- assign mrs_count = mrs_src.metafields.reviews.rating_count.value | default: 0 -%}
    {%- assign mrs_ref = true -%}
  {%- endif -%}
  {%- assign mrs_rating = mrs_src.metafields.reviews.rating.value.rating | default: 0 -%}
  {%- if mrs_count > 0 -%}
  <div class="mrs-rating-row">
    <div></div>

    <div class="mrs-score">
      <div class="mrs-stars-large">
        {%- for i in (1..5) -%}
          {%- assign mrs_diff = mrs_rating | minus: forloop.index0 -%}
          {%- if mrs_diff >= 0.75 -%}{%- assign mrs_cls = '' -%}{%- elsif mrs_diff >= 0.25 -%}{%- assign mrs_cls = ' mrs-star-lg--half' -%}{%- else -%}{%- assign mrs_cls = ' mrs-star-lg--empty' -%}{%- endif -%}
          <svg class="mrs-star-lg{{ mrs_cls }}" viewBox="0 0 24 24"><polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/></svg>
        {%- endfor -%}
      </div>
      <div class="mrs-score-num">{{ mrs_rating | round: 1 }}</div>
      <div class="mrs-review-count">レビュー件数：{{ mrs_count }}件</div>
      {%- if mrs_ref -%}
      <p class="mrs-ref-note">{{ section.settings.reference_note }}</p>
      <a class="mrs-all-link" href="{{ mrs_src.url }}#judgeme_product_reviews">{{ section.settings.reference_link_text }}</a>
      {%- else -%}
      <a class="mrs-all-link" href="#judgeme_product_reviews">すべてのレビューを見る</a>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <div class="mrs-ai-section">
    <div class="mrs-ai-title">レビューのAI要約</div>

    <div class="mrs-tabs">
      <button class="mrs-tab-btn is-active" data-tab="voices">お客様の声</button>
      <button class="mrs-tab-btn" data-tab="usage">色々な使い方</button>
    </div>

    <div class="mrs-panel is-active" id="mrs-panel-voices">
      <ul class="mrs-voice-list">
        <li>重みに包まれる安心感で「寝つきが早くなった」「夜中に目が覚めにくくなった」と感じたという声が多く寄せられています。使い始めた日から朝までぐっすり眠れたというレビューも。</li>
        <li>あみあみの編み目から熱が抜けるので、暑い夜でも蹴らずに朝までかけていられたという声が目立ちます。冬は「寝ている間に掛け布団がずれず、暑すぎず寒すぎずで快適」という声も。</li>
        <li>もちもち・ふかふかとした肌触りと、部屋になじむ見た目が好評。ベッドやソファに置いておくだけで絵になるという声も。</li>
        <li>サイズについて：Sleep Size（L）は縦に長く、身長175〜185cmでもつま先まで届いたという声がある一方、横幅は狭めと感じる方もいます（編み物のため、表記より幅が狭く感じたという声も）。体をすっぽり包みたい方・体格の大きい方には Full Size（XL）が向いています。</li>
        <li>重さの感じ方は人それぞれです。「思ったより重い」という声と、「ビーズ入りの加重ブランケットより圧はやわらかめ」という声の両方があります。重みを強めたいときは、薄手の掛け布団を1枚あいだに挟むと面で圧を感じやすい、というお客様のアドバイスも。</li>
      </ul>
    </div>

    <div class="mrs-panel" id="mrs-panel-usage">
      <ul class="mrs-usage-list">
        <li class="mrs-usage-item">
          <span class="mrs-usage-tag">就寝</span>
          <span class="mrs-usage-text">夏は1枚で、冬は掛け布団と合わせて。重みで寝る姿勢が落ち着き、掛け布団がずれにくくなったという声があります。</span>
        </li>
        <li class="mrs-usage-item">
          <span class="mrs-usage-tag">昼寝</span>
          <span class="mrs-usage-text">ソファでの昼寝や仮眠に。短い時間でもすっきり起きられた、すぐ寝落ちしてしまうという声も。</span>
        </li>
        <li class="mrs-usage-item">
          <span class="mrs-usage-tag">くつろぎ</span>
          <span class="mrs-usage-text">ソファでくるまってリラックスしたり、瞑想の時間に使ったり。丸めて枕代わりにする使い方も。</span>
        </li>
        <li class="mrs-usage-item">
          <span class="mrs-usage-tag">インテリア</span>
          <span class="mrs-usage-text">ラグのように敷いて寝転んだり、ベッドやソファに置いて飾ったり。使わない時間も部屋になじみます。</span>
        </li>
        <li class="mrs-usage-item">
          <span class="mrs-usage-tag">贈り物</span>
          <span class="mrs-usage-text">ご家族へのプレゼントに選ばれています。</span>
        </li>
      </ul>
    </div>

    <div class="mrs-disclaimer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <p>要約は、お客様の投稿に基づきAIで生成されています。カスタマーレビューは、お客様自身による感想や意見であり、当方の見解を示すものではありません。</p>
    </div>
  </div>

</div>

<script>
  (function () {
    document.querySelectorAll('.mrs-tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = this.dataset.tab;
        document.querySelectorAll('.mrs-tab-btn').forEach(function (b) { b.classList.remove('is-active'); });
        document.querySelectorAll('.mrs-panel').forEach(function (p) { p.classList.remove('is-active'); });
        this.classList.add('is-active');
        document.getElementById('mrs-panel-' + tab).classList.add('is-active');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "MUSUBI レビュー要約",
  "settings": [
    { "type": "product", "id": "reference_product", "label": "レビューが0件のときに参考に出す商品", "info": "コラボ商品など、まだレビューの無い商品で使う。選ばなければ何も出さない" },
    { "type": "text", "id": "reference_note", "label": "参考表示の注記", "default": "元のMUSUBI（MUSUBI -en-）のレビューを参考に表示しています" },
    { "type": "text", "id": "reference_link_text", "label": "参考表示のリンクの文言", "default": "元のMUSUBIのレビューを見る" }
  ],
  "presets": [{ "name": "MUSUBI レビュー要約" }]
}
{% endschema %}
