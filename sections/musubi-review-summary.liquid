{% comment %}
  MUSUBI-en レビューAIサマリーセクション
  設置場所: Shopify テーマ > Sections > 新規追加
  最終更新: 2026-04-03 (29件レビューより生成)
{% endcomment %}

<style>
  .mrs-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 20px 48px;
    font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', sans-serif;
    color: #333;
  }

  /* ── 見出し ── */
  .mrs-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .mrs-heading-icon {
    width: 22px;
    height: 22px;
    color: #555;
  }

  .mrs-heading h2 {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.03em;
  }

  /* ── 評価エリア ── */
  .mrs-rating-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 32px;
  }

  .mrs-score {
    text-align: center;
    grid-column: 2;
  }

  .mrs-stars-large {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-bottom: 8px;
  }

  .mrs-star-lg {
    width: 30px;
    height: 30px;
    fill: #e8a020;
  }

  .mrs-star-lg--half {
    fill: url(#mrs-half-grad);
  }

  .mrs-score-num {
    font-size: 44px;
    font-weight: 300;
    letter-spacing: -1px;
    color: #222;
    line-height: 1;
    margin-bottom: 6px;
  }

  .mrs-review-count {
    font-size: 13px;
    color: #888;
  }

  /* バー */
  .mrs-bars {
    grid-column: 3;
  }

  .mrs-bar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
  }

  .mrs-bar-star {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: #666;
    width: 24px;
    justify-content: flex-end;
  }

  .mrs-bar-star svg {
    width: 10px;
    height: 10px;
    fill: #ccc;
    flex-shrink: 0;
  }

  .mrs-bar-track {
    flex: 1;
    height: 8px;
    background: #e8e8e8;
    border-radius: 4px;
    overflow: hidden;
    min-width: 140px;
  }

  .mrs-bar-fill {
    height: 100%;
    background: #333;
    border-radius: 4px;
  }

  .mrs-bar-count {
    font-size: 12px;
    color: #999;
    width: 32px;
    text-align: right;
  }

  /* ── AI要約 ── */
  .mrs-ai-section {
    border: 1px solid #ddd;
  }

  .mrs-ai-title {
    font-size: 14px;
    font-weight: 500;
    padding: 14px 20px 0;
    color: #333;
  }

  .mrs-tabs {
    display: flex;
    margin: 10px 0 0;
    border-bottom: 1px solid #ddd;
  }

  .mrs-tab-btn {
    padding: 11px 28px;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    border: none;
    border-right: 1px solid #ddd;
    background: #f0f0f0;
    color: #999;
    letter-spacing: 0.02em;
    transition: background 0.15s, color 0.15s;
  }

  .mrs-tab-btn.is-active {
    background: #fff;
    color: #222;
    font-weight: 500;
  }

  .mrs-panel {
    display: none;
    padding: 22px 24px 18px;
  }

  .mrs-panel.is-active {
    display: block;
  }

  /* お客様の声リスト */
  .mrs-voice-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mrs-voice-list li {
    position: relative;
    padding: 10px 0 10px 20px;
    font-size: 14px;
    line-height: 1.8;
    color: #333;
    border-bottom: 1px solid #f0f0f0;
  }

  .mrs-voice-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mrs-voice-list li::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 19px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #bbb;
  }

  /* 色々な使い方 */
  .mrs-usage-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mrs-usage-item {
    display: flex;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid #f0f0f0;
    align-items: flex-start;
  }

  .mrs-usage-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mrs-usage-tag {
    flex-shrink: 0;
    font-size: 11px;
    color: #888;
    border: 1px solid #ddd;
    padding: 2px 8px;
    letter-spacing: 0.06em;
    margin-top: 3px;
    white-space: nowrap;
  }

  .mrs-usage-text {
    font-size: 14px;
    line-height: 1.8;
    color: #333;
  }

  /* 免責 */
  .mrs-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 11px 20px;
    background: #fafafa;
    border-top: 1px solid #e8e8e8;
  }

  .mrs-disclaimer svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-top: 2px;
    color: #bbb;
  }

  .mrs-disclaimer p {
    margin: 0;
    font-size: 11px;
    color: #aaa;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .mrs-rating-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .mrs-score { grid-column: 1; }
    .mrs-bars  { grid-column: 1; }
    .mrs-tab-btn { padding: 10px 16px; font-size: 13px; }
  }
</style>

<svg width="0" height="0" style="position:absolute;pointer-events:none">
