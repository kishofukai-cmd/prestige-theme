    <linearGradient id="mrs-half-grad" x1="0" x2="1" y1="0" y2="0">
      <stop offset="50%" stop-color="#e8a020"/>
      <stop offset="50%" stop-color="#e0e0e0"/>
    </linearGradient>
  </defs>
</svg>

