        { "type": "award_item", "settings": { "meta": "Forbes Japan — 2022", "title": "🏆 Forbes Japan Innovators Under 30" } },
        { "type": "award_item", "settings": { "meta": "Sustainability Award — 2022", "title": "🏆 Circular Economy Innovation Award — Japan" } },
