        { "type": "award_item", "settings": { "meta": "Good Design Award — 2022", "title": "🏆 Good Design Award — Sustainable Innovation Category" } },
        { "type": "award_item", "settings": { "meta": "Japan Startup Selection — 2021", "title": "🏆 J-Startup 2021 — Selected Startup" } },
