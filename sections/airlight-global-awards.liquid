{% comment %} AirLight Global LP — Awards {% endcomment %}

<style>
  .ag-awards {
    background: var(--ag-bg-warm, #faf9f6);
    padding: clamp(64px, 10vw, 120px) 0;
  }

  .ag-label--gold {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ag-gold, #c29d66);
    display: block;
    margin-bottom: clamp(12px, 2vw, 18px);
  }

  .ag-awards__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--ag-heading, #1a2640);
    margin: 0 0 clamp(12px, 2vw, 20px);
  }

  .ag-awards__subtext {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.7;
    color: var(--ag-text, #5a5550);
    max-width: 560px;
    margin: 0 0 clamp(40px, 6vw, 64px);
  }

  .ag-awards__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .ag-awards__item {
    background: #fff;
    border-radius: 12px;
    padding: clamp(20px, 2.5vw, 28px);
    box-shadow: 0 2px 16px rgba(26, 38, 64, 0.05);
    border-left: 3px solid var(--ag-gold, #c29d66);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ag-awards__item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(26, 38, 64, 0.1);
  }

  .ag-awards__item--featured {
    background: var(--ag-bg-dark, #1a2640);
    border-left: 3px solid var(--ag-gold, #c29d66);
    grid-column: span 1;
  }

  .ag-awards__item--featured .ag-awards__item-meta {
    color: rgba(255, 255, 255, 0.55);
  }

  .ag-awards__item--featured .ag-awards__item-title {
    color: #fff;
  }

  .ag-awards__featured-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
    margin-bottom: clamp(16px, 2.5vw, 28px);
  }

  @media (max-width: 640px) {
    .ag-awards__featured-row {
      grid-template-columns: 1fr;
    }
  }

  .ag-awards__item-meta {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ag-gold, #c29d66);
    margin-bottom: 6px;
  }

  .ag-awards__item-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--ag-heading, #1a2640);
  }

  .ag-cta__btn {
    display: inline-block;
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ag-bg-dark, #1a2640);
    background: var(--ag-gold, #c29d66);
    border-radius: 100px;
    padding: clamp(14px, 2vw, 18px) clamp(32px, 4vw, 48px);
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .ag-cta__btn:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* --- Mobile --- */
  @media (max-width: 768px) {
    .ag-awards {
      padding-left: 16px;
      padding-right: 16px;
      overflow-x: hidden;
    }
    .ag-awards__heading {
      font-size: 2rem;
    }
    .ag-awards__subtext {
      font-size: 14px;
    }
    .ag-awards__featured-row {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }
    .ag-awards__list {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .ag-cta__btn {
      width: 100%;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }
    .ag-awards img {
      max-width: 100%;
      height: auto;
    }
  }
</style>

<section class="ag-awards" id="ag-awards">
  <div class="ag-container" data-ag-reveal>
    <span class="ag-label--gold">{{ section.settings.label | default: 'Recognition' }}</span>
    <h2 class="ag-awards__heading">{{ section.settings.heading | default: '10+ International Awards.' }}</h2>
    <p class="ag-awards__subtext">{{ section.settings.subtext | default: "Recognized by governments, investors, and innovation bodies across Japan and the world." }}</p>

    {% assign all_awards = section.blocks | where: 'type', 'award_item' %}
    {% assign featured_awards = all_awards | slice: 0, 2 %}
    {% assign remaining_awards = all_awards | slice: 2, 20 %}

    <div class="ag-awards__featured-row">
      {% for block in section.blocks %}
        {% if block.type == 'award_item' and forloop.index <= 2 %}
          <div class="ag-awards__item ag-awards__item--featured" {{ block.shopify_attributes }}>
            <div class="ag-awards__item-meta">{{ block.settings.meta }}</div>
            <div class="ag-awards__item-title">{{ block.settings.title }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ag-awards__list">
      {% for block in section.blocks %}
        {% if block.type == 'award_item' and forloop.index > 2 %}
          <div class="ag-awards__item" {{ block.shopify_attributes }}>
            <div class="ag-awards__item-meta">{{ block.settings.meta }}</div>
            <div class="ag-awards__item-title">{{ block.settings.title }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_cta %}
    <div style="text-align:center; margin-top: clamp(32px,5vw,48px);">
      <a href="{{ section.settings.cta_url | default: '#ag-products' }}" class="ag-cta__btn">
        {{ section.settings.cta_text | default: 'Claim Your Spot — $398 →' }}
      </a>
    </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "AG Awards",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Recognition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10+ International Awards." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Recognized by governments, investors, and innovation bodies across Japan and the world." },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA Button", "default": true },
    { "type": "url", "id": "cta_url", "label": "CTA URL" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Claim Your Spot — $398 →" }
  ],
  "blocks": [
    {
      "type": "award_item",
      "name": "Award",
      "settings": [
        { "type": "text", "id": "meta", "label": "Award Organization" },
        { "type": "text", "id": "title", "label": "Award Title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Awards",
      "blocks": [
        { "type": "award_item", "settings": { "meta": "METI · JETRO — 2019", "title": "🏆 Silicon Valley Selection — Grand Prize" } },
