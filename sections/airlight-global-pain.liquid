{% comment %} AirLight Global LP — Pain / Empathy {% endcomment %}

<style>
  .ag-pain {
    padding: clamp(64px, 10vw, 120px) 0;
    background: var(--ag-bg-warm, #faf9f6);
    overflow: hidden;
  }
  .ag-pain__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 500;
    text-align: center;
    margin: 0 auto clamp(36px, 6vw, 56px);
    line-height: 1.35;
    color: var(--ag-text, #1a2640);
    max-width: 560px;
    padding: 0 var(--ag-pad, 24px);
  }
  .ag-pain__items {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 560px;
    margin: 0 auto clamp(36px, 6vw, 56px);
    padding: 0 var(--ag-pad, 24px);
  }
  .ag-pain__item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(194,157,102,0.2);
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: 0 2px 12px rgba(26,38,64,0.04);
  }
  .ag-pain__item-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .ag-pain__item-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1rem;
    color: var(--ag-text, #1a2640);
    line-height: 1.65;
    margin: 0;
  }
  .ag-pain__bridge {
    text-align: center;
    max-width: 520px;
    margin: 0 auto;
    padding: 0 var(--ag-pad, 24px);
  }
  .ag-pain__bridge-line {
    font-size: 2rem;
    color: var(--ag-gold, #c29d66);
    margin-bottom: 20px;
    animation: ag-bounce 2s ease-in-out infinite;
  }
  @keyframes ag-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }
  .ag-pain__bridge-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.3rem, 4vw, 1.8rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ag-text, #1a2640);
    margin: 0;
  }
  .ag-pain__bridge-text strong {
    color: var(--ag-gold, #c29d66);
    display: block;
    font-size: 1.15em;
    margin-top: 6px;
  }

  @media (max-width: 768px) {
    .ag-pain { padding-left: 16px; padding-right: 16px; }
    .ag-pain__heading { font-size: 1.6rem; margin-bottom: 28px; padding: 0; }
    .ag-pain__items { padding: 0; }
    .ag-pain__item { flex-direction: row; gap: 12px; padding: 16px; }
    .ag-pain__item-icon { font-size: 1.3rem; min-width: 28px; }
    .ag-pain__item-text { font-size: 14px; }
    .ag-pain__bridge { padding: 0; margin-top: 8px; }
    .ag-pain__bridge-text { font-size: 1.1rem; }
  }
</style>

<section class="ag-pain" id="ag-pain">
  <div class="ag-container" data-ag-reveal>
    <h2 class="ag-pain__heading">{{ section.settings.heading | default: 'Sound familiar?' }}</h2>

    <div class="ag-pain__items">
      {% for block in section.blocks %}
        {% if block.type == 'pain_item' %}
          <div class="ag-pain__item" {{ block.shopify_attributes }} data-ag-reveal>
            <span class="ag-pain__item-icon">{{ block.settings.emoji }}</span>
            <p class="ag-pain__item-text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ag-pain__bridge">
      <div class="ag-pain__bridge-line">↓</div>
      <p class="ag-pain__bridge-text">
        {{ section.settings.bridge_text | default: "There's a better answer. And it grows on trees." }}
        {% if section.settings.bridge_strong != blank %}
          <strong>{{ section.settings.bridge_strong }}</strong>
        {% endif %}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AG Pain Points",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sound familiar?" },
    { "type": "text", "id": "bridge_text", "label": "Bridge Text", "default": "There's a better answer. And it grows on trees." },
    { "type": "text", "id": "bridge_strong", "label": "Bridge Strong Text" }
  ],
  "blocks": [
    {
      "type": "pain_item",
      "name": "Pain Point",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🦆" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Pain Points",
      "blocks": [
        { "type": "pain_item", "settings": { "emoji": "🏋️", "text": "Your down jacket weighs as much as a wine bottle — a constant burden on your shoulders." } },
        { "type": "pain_item", "settings": { "emoji": "🌧️", "text": "One rain shower and it's ruined for days. Down collapses the moment it gets wet." } },
        { "type": "pain_item", "settings": { "emoji": "🦆", "text": "You've thought about where those feathers came from — and it doesn't feel great." } },
        { "type": "pain_item", "settings": { "emoji": "🧺", "text": "Dry-clean only. Every. Single. Time." } }
      ]
    }
  ]
}
{% endschema %}
