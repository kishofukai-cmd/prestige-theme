{% comment %} AirLight Global LP — Pain / Empathy {% endcomment %}

<section class="ag-pain" id="ag-pain">
  <div class="ag-container" data-ag-reveal>
    <h2 class="ag-pain__heading">{{ section.settings.heading | default: 'Still Wearing Down?' }}</h2>

    <div class="ag-pain__items">
      {% for block in section.blocks %}
        {% if block.type == 'pain_item' %}
          <div class="ag-pain__item" {{ block.shopify_attributes }} data-ag-reveal>
            <span class="ag-pain__item-icon">{{ block.settings.emoji }}</span>
            <p class="ag-pain__item-text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ag-pain__bridge">
      <div class="ag-pain__bridge-line">↓</div>
      <p class="ag-pain__bridge-text">
        {{ section.settings.bridge_text | default: "There's a better answer. And it grows on trees." }}
        {% if section.settings.bridge_strong != blank %}
          <strong>{{ section.settings.bridge_strong }}</strong>
        {% endif %}
      </p>
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  .ag-pain {
    padding-left: 16px;
    padding-right: 16px;
  }
  .ag-pain__heading {
    font-size: 1.8rem;
    margin-bottom: 28px;
  }
  .ag-pain__items {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .ag-pain__item {
    flex-direction: row;
    gap: 12px;
    align-items: flex-start;
  }
  .ag-pain__item-icon {
    font-size: 1.5rem;
    min-width: 32px;
  }
  .ag-pain__bridge {
    margin-top: 32px;
  }
  .ag-pain__bridge-text {
    font-size: 1rem;
    padding: 0 8px;
  }
}
</style>

{% schema %}
{
  "name": "AG Pain Points",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still Wearing Down?" },
    { "type": "text", "id": "bridge_text", "label": "Bridge Text", "default": "There's a better answer. And it grows on trees." },
    { "type": "text", "id": "bridge_strong", "label": "Bridge Strong" }
  ],
  "blocks": [
    {
      "type": "pain_item",
      "name": "Pain Point",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🦆" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Pain Points",
      "blocks": [
        { "type": "pain_item", "settings": { "emoji": "🦆", "text": "You know those feathers came from somewhere. And it doesn't sit right." } },
        { "type": "pain_item", "settings": { "emoji": "🤧", "text": "Down allergies make every morning a sneezing battle — and you've just been tolerating it." } },
        { "type": "pain_item", "settings": { "emoji": "⚖️", "text": "Heavier than it needs to be. Bulkier than it looks. A trade-off you've accepted for too long." } }
      ]
    }
  ]
}
{% endschema %}
