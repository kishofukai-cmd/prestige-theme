{% comment %}
  AirLight 2026 — 表地の軽さ「1㎡で74g」を 3D の布で見せる
  - canvas 2D で 1m×1m の布（10cm グリッド）を奥行きのある構図に投影し、風で波打たせる
  - セクションが画面に入ると布が舞い降り、中央の数字が 0 → 74 にカウントアップ
  - PC はカーソルを重ねる／スマホは触れている間、布がくしゃっと縮んで手のひらサイズに
  - ライブラリ不要。prefers-reduced-motion では静止画、画面外では描画を止める
{% endcomment %}

{%- assign sid = section.settings.section_id | default: section.id -%}
{%- assign accent = section.settings.accent_color | default: '#c29d66' -%}
{%- assign weight = section.settings.weight | default: 74 -%}

<style>
  #{{ sid }}.a26-fab {
    background: {{ section.settings.bg_color | default: '#faf7f2' }};
    color: {{ section.settings.text_color | default: '#1a1a1a' }};
    padding: clamp(48px, 8vw, 96px) 0;
    overflow: hidden;
  }
  #{{ sid }} .a26-fab__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
    text-align: center;
  }
  #{{ sid }} .a26-fab__kicker {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: {{ accent }};
    margin: 0 0 14px;
  }
  #{{ sid }} .a26-fab__heading {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.5;
    letter-spacing: 0.04em;
    margin: 0 0 14px;
  }
  #{{ sid }} .a26-fab__lead {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 2;
    color: {{ section.settings.body_color | default: '#4a4540' }};
    max-width: 640px;
    margin: 0 auto;
  }
  #{{ sid }} .a26-fab__stage {
    position: relative;
    width: min(100%, 880px);
    height: {{ section.settings.stage_height_pc | default: 520 }}px;
    margin: clamp(20px, 3vw, 36px) auto 0;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: pointer;
  }
  #{{ sid }} .a26-fab__stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  #{{ sid }} .a26-fab__num {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -54%);
    font-family: 'Cormorant Garamond', 'Noto Serif JP', serif;
    font-weight: 500;
    line-height: 1;
    color: #1a1a1a;
    text-shadow: 0 0 22px rgba(255,255,255,.95), 0 0 8px rgba(255,255,255,.9);
    pointer-events: none;
    white-space: nowrap;
    transition: transform .6s cubic-bezier(.2,.7,.2,1), opacity .4s;
  }
  #{{ sid }} .a26-fab__num [data-count] {
    font-size: clamp(72px, 11vw, 132px);
    letter-spacing: -0.02em;
  }
  #{{ sid }} .a26-fab__g {
    font-size: clamp(28px, 4vw, 48px);
    margin-left: 4px;
  }
  #{{ sid }} .a26-fab__per {
    display: block;
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #5a5550;
    margin-top: 6px;
  }
  #{{ sid }} .a26-fab__stage.is-crumpled .a26-fab__num {
    transform: translate(-50%, -54%) scale(.86);
  }
  #{{ sid }} .a26-fab__caption,
  #{{ sid }} .a26-fab__hint {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0;
    font-family: 'Noto Sans JP', sans-serif;
    pointer-events: none;
    transition: opacity .45s ease;
  }
  #{{ sid }} .a26-fab__caption {
    bottom: 14px;
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(16px, 2vw, 22px);
    letter-spacing: 0.06em;
    color: #1a1a1a;
    opacity: 0;
  }
  #{{ sid }} .a26-fab__stage.is-crumpled .a26-fab__caption { opacity: 1; }
  #{{ sid }} .a26-fab__hint {
    bottom: 16px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #8a8178;
    opacity: 1;
  }
  #{{ sid }} .a26-fab__hint span { display: none; }
  @media (hover: hover) and (pointer: fine) {
    #{{ sid }} .a26-fab__hint .a26-fab__hint--pc { display: inline; }
  }
  @media not all and (hover: hover) and (pointer: fine) {
    #{{ sid }} .a26-fab__hint .a26-fab__hint--sp { display: inline; }
  }
  #{{ sid }} .a26-fab__stage.is-crumpled .a26-fab__hint,
  #{{ sid }} .a26-fab__stage.was-crumpled .a26-fab__hint { opacity: 0; }
  #{{ sid }} .a26-fab__chips {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 0;
    margin: clamp(16px, 2.5vw, 28px) 0 0;
  }
  #{{ sid }} .a26-fab__chip {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #e8e0cf;
    border-radius: 999px;
    padding: 10px 20px 10px 14px;
    text-align: left;
  }
  #{{ sid }} .a26-fab__chip svg {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    stroke: {{ accent }};
    fill: none;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #{{ sid }} .a26-fab__chip b {
    display: block;
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #1a1a1a;
  }
  #{{ sid }} .a26-fab__chip small {
    display: block;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 11.5px;
    color: #6b655d;
    margin-top: 2px;
  }
  #{{ sid }} .a26-fab__eq {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    color: #8a8178;
    align-self: center;
  }
  #{{ sid }} .a26-fab__note {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 11px;
    line-height: 1.8;
    color: #8a8178;
    max-width: 720px;
    margin: 18px auto 0;
  }
  @media (max-width: 749px) {
    #{{ sid }} .a26-fab__stage { height: {{ section.settings.stage_height_sp | default: 380 }}px; }
    #{{ sid }} .a26-fab__chips { flex-direction: column; align-items: stretch; gap: 10px; }
    #{{ sid }} .a26-fab__chip { border-radius: 14px; }
    #{{ sid }} .a26-fab__eq { display: none; }
    #{{ sid }} .a26-fab__lead { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ sid }} .a26-fab__num, #{{ sid }} .a26-fab__caption, #{{ sid }} .a26-fab__hint { transition: none; }
  }
</style>

<section id="{{ sid }}" class="a26-fab" data-a26-fabric data-weight="{{ weight }}" data-fabric-color="{{ section.settings.fabric_color | default: '#d8cfc1' }}" aria-label="{{ section.settings.heading | strip_html | escape }}">
  <div class="a26-fab__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="a26-fab__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="a26-fab__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="a26-fab__lead">{{ section.settings.lead }}</p>
    {%- endif -%}

    <div class="a26-fab__stage" data-stage>
      <canvas data-canvas aria-hidden="true"></canvas>
      <div class="a26-fab__num" aria-live="polite">
        <span data-count>0</span><span class="a26-fab__g">g</span>
        <span class="a26-fab__per">{{ section.settings.per_label | default: '1m × 1m の表地' | escape }}</span>
      </div>
      <p class="a26-fab__caption" data-caption>{{ section.settings.crumple_caption | default: '手のひらに、収まる。' | escape }}</p>
      <p class="a26-fab__hint" data-hint>
        <span class="a26-fab__hint--pc">{{ section.settings.hint_pc | default: 'カーソルを重ねると、布が縮みます' | escape }}</span>
        <span class="a26-fab__hint--sp">{{ section.settings.hint_sp | default: '布に触れている間、縮みます' | escape }}</span>
      </p>
    </div>

    <ul class="a26-fab__chips">
      <li class="a26-fab__chip">
        <svg viewBox="0 0 34 34" aria-hidden="true"><path d="M17 4.5c5.2 0 10 7.2 10 14.3 0 6-4.5 10.7-10 10.7S7 24.8 7 18.8C7 11.7 11.8 4.5 17 4.5z"/><path d="M12.6 14.2c.6-2.4 2-4.6 3.6-6"/></svg>
        <span><b>{{ section.settings.chip1_title | default: '鶏卵 1個 とほぼ同じ' | escape }}</b><small>{{ section.settings.chip1_sub | default: 'LLサイズ 70〜76g' | escape }}</small></span>
      </li>
      <li class="a26-fab__eq" aria-hidden="true">=</li>
      <li class="a26-fab__chip">
        <svg viewBox="0 0 34 34" aria-hidden="true"><path d="M9 11.5l14-3.2 2.4 15.4-14 3.2z"/><path d="M7.2 14.2l14-3.2M5.4 17l14-3.2"/><path d="M13.4 15.8l8-1.8M14.3 19.4l8-1.8M15.2 23l5-1.1"/></svg>
        <span><b>{{ section.settings.chip2_title | default: 'A4コピー用紙 15枚分' | escape }}</b><small>{{ section.settings.chip2_sub | default: '80g/㎡の紙で換算' | escape }}</small></span>
      </li>
    </ul>

    {%- if section.settings.note != blank -%}
      <p class="a26-fab__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('{{ sid }}');
  if (!root || root.dataset.a26FabricReady) return;
  root.dataset.a26FabricReady = '1';

  var stage = root.querySelector('[data-stage]');
  var canvas = root.querySelector('[data-canvas]');
  var countEl = root.querySelector('[data-count]');
  var ctx = canvas.getContext('2d');
  var TARGET = parseInt(root.dataset.weight, 10) || 74;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- 色（生成りの布・チャコールの線） ----
  function hexToRgb(h) {
    h = (h || '#d8cfc1').replace('#', '');
    if (h.length === 3) h = h.split('').map(function (c) { return c + c; }).join('');
    var n = parseInt(h, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  var base = hexToRgb(root.dataset.fabricColor);
  function shade(k) { // k: 0.7〜1.15
    var r = Math.min(255, Math.round(base[0] * k)), g = Math.min(255, Math.round(base[1] * k)), b = Math.min(255, Math.round(base[2] * k));
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }

  // ---- 布のメッシュ ----
  var N = 30;                     // 30分割 = 10cm グリッドが3セルごと
  var V = (N + 1) * (N + 1);
  var px = new Float32Array(V), py = new Float32Array(V), pz = new Float32Array(V);
  var sx = new Float32Array(V), sy = new Float32Array(V), sz = new Float32Array(V); // 投影後
  var noiseX = new Float32Array(V), noiseY = new Float32Array(V), noiseZ = new Float32Array(V);
  var seed = 7;
  function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  for (var i = 0; i < V; i++) {
    noiseX[i] = (rnd() - 0.5) * 0.22;
    noiseY[i] = (rnd() - 0.5) * 0.30;
    noiseZ[i] = (rnd() - 0.5) * 0.22;
  }

  var W = 0, H = 0, DPR = 1;
  function resize() {
    var r = stage.getBoundingClientRect();
    DPR = Math.min(2, window.devicePixelRatio || 1);
    W = Math.max(1, Math.round(r.width)); H = Math.max(1, Math.round(r.height));
    canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  var t0 = null, enterAt = null, visible = false, raf = 0;
  var crumpleTarget = 0, crumple = 0;
  var landed = false;

  function easeOut(x) { return 1 - Math.pow(1 - x, 3); }
  function easeInOut(x) { return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; }

  function frame(now) {
    raf = 0;
    if (t0 === null) t0 = now;
    var t = (now - t0) / 1000;
    var enter = enterAt === null ? 0 : Math.min(1, (now - enterAt) / 1900);
    var land = easeOut(enter);                  // 0 → 1 舞い降り
    if (enter >= 1 && !landed) { landed = true; }

    // くしゃ（ホバー／タッチ）
    crumple += (crumpleTarget - crumple) * (reduced ? 1 : 0.12);
    var c = easeInOut(Math.max(0, Math.min(1, crumple)));
    stage.classList.toggle('is-crumpled', c > 0.5);

    // ---- 頂点 ----
    var amp = (reduced ? 0 : 0.055) * (1 + 1.6 * (1 - land)) * (1 - 0.9 * c);
    var lift = 0.95 * (1 - land) + 0.06 * c;      // 落ちてくる高さ／縮むと少し浮く
    var tiltX = 1.05 - 0.42 * land;               // 俯瞰角（rad）: 上から → 斜め
    var swayY = (reduced ? 0 : 0.22) * (1 - land) * Math.sin(t * 1.3);
    var scaleC = 1 - 0.68 * c;
    var cosX = Math.cos(tiltX), sinX = Math.sin(tiltX);
    var cosY = Math.cos(swayY), sinY = Math.sin(swayY);
    var d = 2.35, f = 1.55;
    var S = Math.min(W * 0.92, H * 1.35);
    var cx = W / 2, cy = H / 2 + H * 0.03;

    for (var j = 0; j <= N; j++) {
      for (var i = 0; i <= N; i++) {
        var k = j * (N + 1) + i;
        var x = i / N - 0.5, z = j / N - 0.5;
        var y = amp * (Math.sin(x * 6.9 + t * 1.15 + z * 2.0) * 0.6 + Math.sin(z * 9.7 - t * 0.85) * 0.4 + Math.sin((x + z) * 4.2 + t * 1.7) * 0.28);
        // 縮む: 中心へ引き寄せ＋皺
        x = x * scaleC + noiseX[k] * c;
        z = z * scaleC + noiseZ[k] * c;
        y = y + noiseY[k] * c + lift;
        // Y 回転（揺れ）→ X 回転（俯瞰）
        var x1 = x * cosY + z * sinY, z1 = -x * sinY + z * cosY;
        var y2 = y * cosX - z1 * sinX, z2 = y * sinX + z1 * cosX;
        var pr = f / (z2 + d);
        sx[k] = cx + x1 * pr * S;
        sy[k] = cy - y2 * pr * S;
        sz[k] = z2;
        px[k] = x1; py[k] = y2; pz[k] = z2;
      }
    }

    // ---- 描画 ----
    ctx.clearRect(0, 0, W, H);

    // 影（床に落ちる薄い影）
    var shAlpha = 0.16 * land * (1 - 0.5 * c);
    if (shAlpha > 0.005) {
      ctx.save();
      ctx.globalAlpha = shAlpha;
      ctx.fillStyle = '#6a625a';
      ctx.beginPath();
      ctx.ellipse(cx, cy + S * 0.36 * (1 - 0.55 * c) + lift * 0, S * 0.42 * scaleC, S * 0.1 * scaleC, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // 面（奥から手前へ）
    var lx = 0.35, ly = 0.85, lz = -0.4, ll = Math.sqrt(lx * lx + ly * ly + lz * lz); lx /= ll; ly /= ll; lz /= ll;
    for (var jj = N - 1; jj >= 0; jj--) {
      for (var ii = 0; ii < N; ii++) {
        var a = jj * (N + 1) + ii, b = a + 1, cc = a + N + 1, dd = cc + 1;
        // 法線（回転後の座標で）
        var ux = px[b] - px[a], uy = py[b] - py[a], uz = pz[b] - pz[a];
        var vx = px[cc] - px[a], vy = py[cc] - py[a], vz = pz[cc] - pz[a];
        var nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx;
        var nl = Math.sqrt(nx * nx + ny * ny + nz * nz) || 1;
        var lum = (nx * lx + ny * ly + nz * lz) / nl;
        if (lum < 0) lum = -lum * 0.6;
        var k2 = 0.84 + 0.26 * lum;
        ctx.fillStyle = shade(k2);
        ctx.beginPath();
        ctx.moveTo(sx[a], sy[a]); ctx.lineTo(sx[b], sy[b]); ctx.lineTo(sx[dd], sy[dd]); ctx.lineTo(sx[cc], sy[cc]);
        ctx.closePath();
        ctx.fill();
      }
    }

    // グリッド（10cm 刻み）: 縮むと薄く
    var gridA = 0.42 * (1 - 0.85 * c);
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(58,52,46,' + gridA.toFixed(3) + ')';
    for (var g = 0; g <= N; g += 3) {
      ctx.beginPath();
      for (var q = 0; q <= N; q++) { var k3 = g * (N + 1) + q; if (q === 0) ctx.moveTo(sx[k3], sy[k3]); else ctx.lineTo(sx[k3], sy[k3]); }
      ctx.stroke();
      ctx.beginPath();
      for (var q2 = 0; q2 <= N; q2++) { var k4 = q2 * (N + 1) + g; if (q2 === 0) ctx.moveTo(sx[k4], sy[k4]); else ctx.lineTo(sx[k4], sy[k4]); }
      ctx.stroke();
    }
    // 縁
    ctx.lineWidth = 1.4;
    ctx.strokeStyle = 'rgba(40,36,32,' + (0.75 * (1 - 0.4 * c)).toFixed(3) + ')';
    ctx.beginPath();
    for (var e = 0; e <= N; e++) { var ke = e; if (e === 0) ctx.moveTo(sx[ke], sy[ke]); else ctx.lineTo(sx[ke], sy[ke]); }
    for (var e2 = 1; e2 <= N; e2++) { var ke2 = e2 * (N + 1) + N; ctx.lineTo(sx[ke2], sy[ke2]); }
    for (var e3 = N - 1; e3 >= 0; e3--) { var ke3 = N * (N + 1) + e3; ctx.lineTo(sx[ke3], sy[ke3]); }
    for (var e4 = N - 1; e4 >= 0; e4--) { var ke4 = e4 * (N + 1); ctx.lineTo(sx[ke4], sy[ke4]); }
    ctx.closePath();
    ctx.stroke();

    // 寸法「1 m」: 手前の辺と左の辺に添える（縮むと消える）
    var dimA = land * (1 - c * 2);
    if (dimA > 0.02) {
      ctx.save();
      ctx.globalAlpha = Math.min(1, dimA);
      ctx.font = '600 12px Outfit, "Noto Sans JP", sans-serif';
      ctx.fillStyle = '#5a5550';
      ctx.strokeStyle = 'rgba(90,85,80,.7)';
      ctx.lineWidth = 1;
      var bl = N * (N + 1), br = bl + N;          // 手前の辺（j = N）
      var mx = (sx[bl] + sx[br]) / 2, my = (sy[bl] + sy[br]) / 2 + 16;
      ctx.beginPath(); ctx.moveTo(sx[bl], my); ctx.lineTo(sx[br], my); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(sx[bl], my - 5); ctx.lineTo(sx[bl], my + 5); ctx.moveTo(sx[br], my - 5); ctx.lineTo(sx[br], my + 5); ctx.stroke();
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText('1 m', mx, my + 5);
      var tl = 0, ll2 = bl;                         // 左の辺（i = 0）
      var lxm = Math.min(sx[tl], sx[ll2]) - 14, lym = (sy[tl] + sy[ll2]) / 2;
      ctx.beginPath(); ctx.moveTo(lxm, sy[tl]); ctx.lineTo(lxm, sy[ll2]); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(lxm - 5, sy[tl]); ctx.lineTo(lxm + 5, sy[tl]); ctx.moveTo(lxm - 5, sy[ll2]); ctx.lineTo(lxm + 5, sy[ll2]); ctx.stroke();
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText('1 m', lxm - 6, lym);
      ctx.restore();
    }

    // カウントアップ（舞い降りと同時）
    var n = Math.round(TARGET * easeOut(Math.min(1, enter * 1.25)));
    if (countEl.textContent !== String(n)) countEl.textContent = String(n);

    var moving = !reduced && (visible || Math.abs(crumpleTarget - crumple) > 0.002);
    if (moving) raf = requestAnimationFrame(frame);
  }

  function start() {
    if (raf) return;
    raf = requestAnimationFrame(frame);
  }

  // ---- 可視判定（入ったら舞い降り、出たら止める） ----
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        visible = en.isIntersecting && en.intersectionRatio > 0.25;
        if (visible && enterAt === null) enterAt = performance.now();
        if (visible) start();
      });
    }, { threshold: [0, 0.25, 0.5] });
    io.observe(stage);
  } else {
    visible = true; enterAt = performance.now(); start();
  }

  // ---- くしゃ（ホバー／タッチ） ----
  function setCrumple(v) {
    crumpleTarget = v ? 1 : 0;
    if (v) stage.classList.add('was-crumpled');
    start();
  }
  stage.addEventListener('pointerenter', function (ev) { if (ev.pointerType === 'mouse') setCrumple(true); });
  stage.addEventListener('pointerleave', function (ev) { if (ev.pointerType === 'mouse') setCrumple(false); });
  stage.addEventListener('pointerdown', function (ev) { if (ev.pointerType !== 'mouse') setCrumple(true); });
  ['pointerup', 'pointercancel'].forEach(function (evn) {
    stage.addEventListener(evn, function (ev) { if (ev.pointerType !== 'mouse') setCrumple(false); });
  });
  window.addEventListener('blur', function () { setCrumple(false); });

  // ---- サイズ ----
  resize();
  if ('ResizeObserver' in window) {
    new ResizeObserver(function () { resize(); start(); }).observe(stage);
  } else {
    window.addEventListener('resize', function () { resize(); start(); });
  }
  if (reduced) { enterAt = performance.now() - 5000; visible = true; start(); }
})();
</script>

