{% comment %}
  AirLight 2025 — Hero / KV
  KVは2モード:
  - KVビルダー (kv_use_builder=true): 写真+テキストパネルをHTML/CSSで合成。
    写真・全コピー・色・パネル幅を theme editor から編集可能（ノーコード運用向け）
  - 一枚画像モード (kv_use_builder=false): 従来どおり kv_image / kv_image_url を表示
{% endcomment %}

<style>
  .a25-hero {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: 0 0 clamp(24px, 5vw, 56px);
    overflow: hidden;
  }

  .a25-hero__kv-wrap {
    width: 100%;
    margin: 0 auto clamp(24px, 4vw, 48px);
  }

  .a25-hero__kv {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: auto;
  }

  /* ===== KV Builder ===== */
  .a25-kvb {
    display: flex;
    width: 100%;
    min-height: clamp(460px, 42vw, 640px);
  }

  .a25-kvb__panel {
    box-sizing: border-box;
    flex: 0 0 {{ section.settings.kv_panel_width | default: 44 }}%;
    background: {{ section.settings.kv_panel_bg | default: '#182238' }};
    color: {{ section.settings.kv_text_color | default: '#ffffff' }};
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 4vw, 64px) clamp(20px, 3.5vw, 56px);
  }

  .a25-kvb__eyebrow {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(10px, 1.2vw, 13px);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ section.settings.kv_accent_color | default: '#c29d66' }};
    margin: 0 0 4px;
    line-height: 1.7;
  }

  .a25-kvb__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: calc(clamp(1.9rem, 4.4vw, 3.4rem) * {{ section.settings.kv_headline_scale | default: 100 }} / 100);
    font-weight: 700;
    line-height: 1.12;
    margin: clamp(14px, 2vw, 24px) 0 0;
  }
  .a25-kvb__headline p { margin: 0; }
  .a25-kvb__headline em {
    font-style: normal;
    color: {{ section.settings.kv_accent_color | default: '#c29d66' }};
  }

  .a25-kvb__sub {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(12px, 1.4vw, 15px);
    line-height: 1.7;
    opacity: 0.85;
    margin: clamp(10px, 1.5vw, 18px) 0 0;
    max-width: 34em;
  }

  .a25-kvb__divider {
    border: 0;
    border-top: 2px solid {{ section.settings.kv_accent_color | default: '#c29d66' }};
    margin: clamp(18px, 2.5vw, 32px) 0;
    width: 100%;
  }

  .a25-kvb__stat {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 700;
    line-height: 1;
    margin: 0;
  }

  .a25-kvb__compare {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(12px, 1.8vw, 20px);
  }

  .a25-kvb__bottle {
    flex-shrink: 0;
    width: 26px;
    height: auto;
    color: {{ section.settings.kv_text_color | default: '#ffffff' }};
  }

  .a25-kvb__caption {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(12px, 1.3vw, 14px);
    line-height: 1.55;
    opacity: 0.9;
    margin: 0;
  }

  .a25-kvb__photo {
    flex: 1 1 auto;
    position: relative;
    min-height: 100%;
  }

  .a25-kvb__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.kv_photo_position | default: 'center' }} center;
  }

  /* Mobile: 写真を上、パネルを下に積む */
  @media (max-width: 820px) {
    .a25-kvb {
      flex-direction: column;
      min-height: 0;
    }
    .a25-kvb__photo {
      order: 0;
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
    .a25-kvb__panel {
      order: 1;
      flex: 0 0 auto;
      padding: 28px 20px 32px;
    }
    .a25-kvb__headline { font-size: calc(2rem * {{ section.settings.kv_headline_scale | default: 100 }} / 100); }
    .a25-kvb__stat { font-size: 2.6rem; }
  }

  /* ===== 以下、KV下のテキストブロック（既存） ===== */
  .a25-hero__inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 24px);
    text-align: center;
  }

  .a25-hero__eyebrow {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(11px, 1.5vw, 13px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#c29d66' }};
    margin: 0 0 clamp(12px, 2vw, 20px);
  }

  .a25-hero__heading {
    font-family: 'Noto Serif JP', 'Cormorant Garamond', serif;
    font-size: clamp(1.4rem, 3.8vw, 2.1rem);
    font-weight: 500;
    line-height: 1.55;
    color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    margin: 0 0 clamp(16px, 2.5vw, 24px);
    letter-spacing: 0.02em;
  }

  .a25-hero__heading p { margin: 0 0 0.4em; }
  .a25-hero__heading p:last-child { margin-bottom: 0; }
  .a25-hero__heading em {
    font-style: normal;
    font-weight: 700;
    display: inline-block;
    margin-top: 0.2em;
    font-size: 1.15em;
  }

  .a25-hero__sub {
    font-family: 'Noto Sans JP', 'Outfit', sans-serif;
    font-size: clamp(13px, 1.8vw, 15px);
    line-height: 1.8;
    color: {{ section.settings.sub_color | default: '#5a5550' }};
    margin: 0 0 clamp(20px, 3vw, 32px);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .a25-hero__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: clamp(20px, 3vw, 32px);
  }

  .a25-hero__cta {
    display: inline-block;
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: {{ section.settings.cta_text_color | default: '#ffffff' }};
    background: {{ section.settings.cta_bg_color | default: '#1a1a1a' }};
    border-radius: 100px;
    padding: 14px 40px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
    min-width: 260px;
    text-align: center;
    box-sizing: border-box;
  }

  .a25-hero__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .a25-hero__cta-note {
    font-family: 'Outfit', 'Noto Sans JP', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #8a7f6e;
    margin: 0;
  }

  @media (max-width: 768px) {
    .a25-hero__inner {
      padding: 0 16px;
    }
    .a25-hero__heading {
      font-size: clamp(1.2rem, 4.8vw, 1.6rem);
      line-height: 1.6;
    }
    .a25-hero__sub {
      font-size: 13px;
    }
    .a25-hero__cta {
      width: 100%;
      min-width: 0;
      min-height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<section class="a25-hero" id="{{ section.settings.section_id | default: 'a25-hero' }}">
  <div class="a25-hero__kv-wrap">
    {% if section.settings.kv_use_builder %}
      <div class="a25-kvb">
        <div class="a25-kvb__panel">
          {% if section.settings.kv_eyebrow_1 != blank %}
            <p class="a25-kvb__eyebrow">{{ section.settings.kv_eyebrow_1 }}{% if section.settings.kv_eyebrow_2 != blank %}<br>{{ section.settings.kv_eyebrow_2 }}{% endif %}</p>
          {% endif %}
          {% if section.settings.kv_headline != blank %}
            <div class="a25-kvb__headline">{{ section.settings.kv_headline }}</div>
          {% endif %}
          {% if section.settings.kv_sub != blank %}
            <p class="a25-kvb__sub">{{ section.settings.kv_sub }}</p>
          {% endif %}
          {% if section.settings.kv_show_divider %}
            <hr class="a25-kvb__divider">
          {% endif %}
          {% if section.settings.kv_stat != blank %}
            <p class="a25-kvb__stat">{{ section.settings.kv_stat }}</p>
          {% endif %}
          {% if section.settings.kv_stat_caption != blank %}
            <div class="a25-kvb__compare">
              {% if section.settings.kv_show_bottle %}
                <svg class="a25-kvb__bottle" viewBox="0 0 26 62" fill="currentColor" aria-hidden="true">
                  <rect x="8" y="0" width="10" height="7" rx="2"/>
                  <rect x="6" y="6" width="14" height="12" rx="3"/>
                  <rect x="0" y="16" width="26" height="46" rx="8"/>
                </svg>
              {% endif %}
              <p class="a25-kvb__caption">{{ section.settings.kv_stat_caption }}</p>
            </div>
          {% endif %}
        </div>
        <div class="a25-kvb__photo">
          {% if section.settings.kv_photo != blank %}
            <img src="{{ section.settings.kv_photo | image_url: width: 1600 }}"
                 alt="{{ section.settings.kv_image_alt }}"
                 loading="eager" fetchpriority="high">
          {% elsif section.settings.kv_photo_url != blank %}
            <img src="{{ section.settings.kv_photo_url }}"
                 alt="{{ section.settings.kv_image_alt }}"
                 loading="eager" fetchpriority="high">
          {% endif %}
        </div>
      </div>
    {% else %}
      {% if section.settings.kv_image != blank %}
        <img class="a25-hero__kv"
             src="{{ section.settings.kv_image | image_url: width: 2000 }}"
             alt="{{ section.settings.kv_image_alt }}"
             width="{{ section.settings.kv_image.width }}" height="{{ section.settings.kv_image.height }}"
             loading="eager" fetchpriority="high">
      {% elsif section.settings.kv_image_url != blank %}
        <img class="a25-hero__kv"
             src="{{ section.settings.kv_image_url }}"
             alt="{{ section.settings.kv_image_alt }}"
             loading="eager" fetchpriority="high">
      {% endif %}
    {% endif %}
  </div>

  <div class="a25-hero__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="a25-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <div class="a25-hero__heading">{{ section.settings.heading }}</div>
    {% endif %}

    {% if section.settings.sub_text != blank %}
      <p class="a25-hero__sub">{{ section.settings.sub_text }}</p>
    {% endif %}

    {% if section.settings.cta_text != blank %}
      <div class="a25-hero__cta-wrap">
        <a class="a25-hero__cta"
           href="{{ section.settings.cta_url | default: '#' }}">
          {{ section.settings.cta_text }}
        </a>
        {% if section.settings.cta_note != blank %}
          <p class="a25-hero__cta-note">{{ section.settings.cta_note }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "A2025 Hero",
  "tag": "section",
  "class": "shopify-section--a25-hero",
  "settings": [
    { "type": "header", "content": "セクション ID / 背景" },
    { "type": "text", "id": "section_id", "label": "Section ID", "default": "a25-hero" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#ffffff" },

    { "type": "header", "content": "KV ビルダー（写真+テキストを合成・編集可能モード）" },
    { "type": "checkbox", "id": "kv_use_builder", "label": "KVビルダーを使う（OFFで下の一枚画像モード）", "default": true },
    { "type": "image_picker", "id": "kv_photo", "label": "KV写真（人物・商品など）" },
    { "type": "text", "id": "kv_photo_url", "label": "KV写真 URL（画像未設定時のフォールバック）", "default": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-hero-photo-clean.jpg" },
    {
      "type": "select", "id": "kv_photo_position", "label": "写真の寄せ位置",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" },
        { "value": "right", "label": "右寄せ" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "kv_panel_bg", "label": "パネル背景色", "default": "#182238" },
    { "type": "color", "id": "kv_text_color", "label": "パネル文字色", "default": "#ffffff" },
    { "type": "color", "id": "kv_accent_color", "label": "アクセント色（アイブロー/罫線/強調）", "default": "#c29d66" },
    { "type": "range", "id": "kv_panel_width", "label": "パネル幅（PC・%）", "min": 30, "max": 55, "step": 1, "default": 44 },
    { "type": "text", "id": "kv_eyebrow_1", "label": "アイブロー1行目", "default": "KAPOK KNOT" },
    { "type": "text", "id": "kv_eyebrow_2", "label": "アイブロー2行目", "default": "TOKYO, JAPAN" },
    { "type": "richtext", "id": "kv_headline", "label": "メイン見出し（<em>で色強調）", "default": "<p>The Finest<br/>Down Alternative.<br/>From Japan.</p>" },
    { "type": "range", "id": "kv_headline_scale", "label": "見出しサイズ（%）", "min": 70, "max": 130, "step": 5, "default": 100 },
    { "type": "textarea", "id": "kv_sub", "label": "サブコピー", "default": "A sustainable breakthrough in warmth — now shipping worldwide." },
    { "type": "checkbox", "id": "kv_show_divider", "label": "区切り線を表示", "default": true },
    { "type": "text", "id": "kv_stat", "label": "数字（例: 500g）", "default": "500g" },
    { "type": "textarea", "id": "kv_stat_caption", "label": "数字の説明", "default": "Same weight as one 500ml bottle of water." },
    { "type": "checkbox", "id": "kv_show_bottle", "label": "ボトルアイコンを表示", "default": true },

    { "type": "header", "content": "一枚画像モード（ビルダーOFF時のみ使用）" },
    { "type": "image_picker", "id": "kv_image", "label": "KV 画像 (推奨 1585x1057)" },
    { "type": "text", "id": "kv_image_url", "label": "KV 画像 URL (外部フォールバック)", "default": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-hero-kv-en-v5.jpg" },
    { "type": "text", "id": "kv_image_alt", "label": "KV 画像の代替テキスト", "default": "AirLight Jacket · KAPOK KNOT" },

    { "type": "header", "content": "KV下の見出しテキスト" },
    { "type": "text", "id": "eyebrow", "label": "アイブロー (上の小さな文字)", "default": "KAPOK KNOT — AirLight Jacket 2025" },
    { "type": "color", "id": "eyebrow_color", "label": "アイブロー色", "default": "#c29d66" },
    { "type": "richtext", "id": "heading", "label": "メイン見出し", "default": "<p>今までに着ていたアウターの常識を覆す。</p><p>“空気のように軽くて暖かい”<br><em>エアーライトジャケット</em></p>" },
    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "textarea", "id": "sub_text", "label": "サブテキスト", "default": "植物由来のカポック素材で実現した、約500gの冬アウター。軽く、暖かく、動物も地球も傷つけない。" },
    { "type": "color", "id": "sub_color", "label": "サブテキスト色", "default": "#5a5550" },

    { "type": "header", "content": "CTA ボタン" },
    { "type": "text", "id": "cta_text", "label": "ボタンテキスト", "default": "商品を見る →" },
    { "type": "url", "id": "cta_url", "label": "ボタンリンク" },
    { "type": "color", "id": "cta_bg_color", "label": "ボタン背景色", "default": "#1a1a1a" },
    { "type": "color", "id": "cta_text_color", "label": "ボタン文字色", "default": "#ffffff" },
    { "type": "text", "id": "cta_note", "label": "ボタン下の注記", "default": "¥39,800〜" }
  ],
  "presets": [
    { "name": "A2025 Hero" }
  ]
}
{% endschema %}
