{% comment %} AirLight Global LP — Ethics (環境インパクト) {% endcomment %}

<style>
  .ag-ethics {
    padding: clamp(48px, 8vw, 80px) 0;
    background: var(--ag-bg-dark2, #243352);
    color: var(--ag-text-light, #faf8f5);
    overflow: hidden;
  }
  .ag-ethics__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    padding: 0 var(--ag-pad, 24px);
  }
  .ag-ethics__stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 5vw, 3rem);
    font-weight: 500;
    color: var(--ag-gold, #c29d66);
    line-height: 1;
    margin-bottom: 8px;
    display: block;
  }
  .ag-ethics__stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    color: rgba(250,248,245,0.55);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .ag-ethics__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      padding: 0 16px;
    }
    .ag-ethics__stat-num { font-size: clamp(1.8rem, 8vw, 2.5rem); }
  }
</style>

<section class="ag-ethics" id="ag-ethics">
  <div class="ag-container" data-ag-reveal>
    <div class="ag-ethics__stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat_item' %}
          <div {{ block.shopify_attributes }}>
            <span class="ag-ethics__stat-num">{{ block.settings.number }}</span>
            <span class="ag-ethics__stat-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  {% if section.settings.footnote != blank %}
    <p style="text-align:center; font-size:0.68rem; color:rgba(250,248,245,0.32); margin-top:20px; padding:0 var(--ag-pad);">{{ section.settings.footnote }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "AG Ethics Stats",
  "settings": [
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "*Based on life cycle analysis vs conventional goose down insulation." }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "97%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Less CO₂ vs Down" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Ethics Stats",
      "blocks": [
        { "type": "stat_item", "settings": { "number": "97%", "label": "Less CO₂ vs Down*" } },
        { "type": "stat_item", "settings": { "number": "0", "label": "Animals Used" } },
        { "type": "stat_item", "settings": { "number": "80%", "label": "Air — by Design" } },
        { "type": "stat_item", "settings": { "number": "1/8", "label": "Weight of Cotton" } }
      ]
    }
  ]
}
{% endschema %}
