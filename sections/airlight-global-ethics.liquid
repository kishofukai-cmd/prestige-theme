{% comment %} AirLight Global LP — Ethics (環境インパクト) {% endcomment %}

<section class="ag-ethics" id="ag-ethics">
  <div class="ag-container" data-ag-reveal>
    <div class="ag-ethics__stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat_item' %}
          <div {{ block.shopify_attributes }}>
            <div class="ag-ethics__stat-num">{{ block.settings.number }}</div>
            <div class="ag-ethics__stat-label">{{ block.settings.label }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <p style="text-align:center; font-size:0.7rem; color:rgba(250,248,245,0.35); margin-top:20px; padding:0 var(--ag-pad);">*Based on life cycle analysis vs conventional goose down insulation.</p>
</section>

<style>
@media (max-width: 768px) {
  .ag-ethics {
    padding-left: 16px;
    padding-right: 16px;
  }
  .ag-ethics__stats {
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .ag-ethics__stat-num {
    font-size: clamp(2rem, 8vw, 3rem);
  }
}
</style>

{% schema %}
{
  "name": "AG Ethics Stats",
  "settings": [],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "97%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Less CO₂ vs Down" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Ethics Stats",
      "blocks": [
        { "type": "stat_item", "settings": { "number": "97%", "label": "Less CO₂ vs Down*" } },
        { "type": "stat_item", "settings": { "number": "0", "label": "Animals Used" } },
        { "type": "stat_item", "settings": { "number": "80%", "label": "Air — by Design" } },
        { "type": "stat_item", "settings": { "number": "40%", "label": "Lighter Than Down" } }
      ]
    }
  ]
}
{% endschema %}
