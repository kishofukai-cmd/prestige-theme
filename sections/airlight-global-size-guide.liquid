{% comment %} AirLight Global LP — Size Guide {% endcomment %}

<style>
  .ag-size-guide {
    background: #faf9f6;
    padding: clamp(48px, 8vw, 96px) 20px;
  }
  .ag-size-guide__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 400;
    color: #1a2640;
    margin: 8px 0 16px;
    line-height: 1.15;
  }
  .ag-size-guide__intro {
    font-family: 'Outfit', sans-serif;
    font-size: 15px;
    color: #5a5550;
    margin: 0 0 36px;
    line-height: 1.65;
    max-width: 560px;
  }
  .ag-size-guide__models {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .ag-size-guide__model-card {
    flex: 1 1 200px;
    padding: 14px 18px;
    background: #f0ece4;
    border-left: 3px solid #c29d66;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    color: #5a5550;
    line-height: 1.6;
  }
  .ag-size-guide__model-card strong {
    display: block;
    font-weight: 600;
    color: #1a2640;
    margin-bottom: 3px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ag-size-guide__fit-tip {
    margin-top: 20px;
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    color: #8a7f6e;
    font-style: italic;
    text-align: center;
  }
  @media (max-width: 768px) {
    .ag-size-guide {
      padding-left: 16px;
      padding-right: 16px;
    }
    .ag-size-guide__heading {
      font-size: 1.7rem;
    }
    /* テーブルを横スクロール対応 */
    .ag-size-guide .ag-comparison__table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -16px;
      padding: 0 16px;
    }
    .ag-size-guide .ag-comparison__table {
      min-width: 500px;
    }
    .ag-size-guide .ag-comparison__table th,
    .ag-size-guide .ag-comparison__table td {
      font-size: 11px;
      padding: 8px 6px;
      white-space: nowrap;
    }
    .ag-size-guide__models {
      flex-direction: column;
    }
    .ag-size-guide__model-card {
      flex: 1 1 auto;
    }
  }
</style>

<section class="ag-size-guide" id="ag-size-guide">
  <div class="ag-container--narrow" data-ag-reveal>

    <span class="ag-label">{{ section.settings.label | default: 'Sizing' }}</span>
    <h2 class="ag-size-guide__heading">{{ section.settings.heading | default: 'Find your fit.' }}</h2>

    {% if section.settings.intro != blank %}
      <p class="ag-size-guide__intro">{{ section.settings.intro }}</p>
    {% endif %}

    {%- assign hl = section.settings.highlight_col | default: 'M' -%}

    <div class="ag-comparison__table-wrap">
      <table class="ag-comparison__table">
        <thead>
          <tr>
            <th></th>
            <th {% if hl == 'XS' %}class="ag-comparison__th--hero"{% endif %}>XS</th>
            <th {% if hl == 'S'  %}class="ag-comparison__th--hero"{% endif %}>S</th>
            <th {% if hl == 'M'  %}class="ag-comparison__th--hero"{% endif %}>M</th>
            <th {% if hl == 'L'  %}class="ag-comparison__th--hero"{% endif %}>L</th>
            <th {% if hl == 'XL' %}class="ag-comparison__th--hero"{% endif %}>XL</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'size_row' %}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.label }}</td>
                <td {% if hl == 'XS' %}class="ag-comparison__td--hero"{% endif %}>{{ block.settings.xs }}</td>
                <td {% if hl == 'S'  %}class="ag-comparison__td--hero"{% endif %}>{{ block.settings.s }}</td>
                <td {% if hl == 'M'  %}class="ag-comparison__td--hero"{% endif %}>{{ block.settings.m }}</td>
                <td {% if hl == 'L'  %}class="ag-comparison__td--hero"{% endif %}>{{ block.settings.l }}</td>
                <td {% if hl == 'XL' %}class="ag-comparison__td--hero"{% endif %}>{{ block.settings.xl }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    {%- assign model_blocks = section.blocks | where: "type", "model_spec" -%}
    {% if model_blocks.size > 0 %}
      <div class="ag-size-guide__models">
        {% for block in section.blocks %}
          {% if block.type == 'model_spec' %}
            <div class="ag-size-guide__model-card" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.label }}</strong>
              {{ block.settings.height }}{% if block.settings.weight != blank %} · {{ block.settings.weight }}{% endif %} — wearing size {{ block.settings.size_worn }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.fit_tip != blank %}
      <p class="ag-size-guide__fit-tip">{{ section.settings.fit_tip }}</p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "AG Size Guide",
  "settings": [
    { "type": "text",     "id": "label",         "label": "Section Label", "default": "Sizing" },
    { "type": "text",     "id": "heading",        "label": "Heading",       "default": "Find your fit." },
    { "type": "textarea", "id": "intro",          "label": "Intro Text",    "default": "AirLight fits true to North American sizing. If you're between sizes, we recommend sizing up for layering flexibility." },
    {
      "type": "select",
      "id": "highlight_col",
      "label": "Highlighted Column",
      "default": "M",
      "options": [
        { "value": "XS", "label": "XS" },
        { "value": "S",  "label": "S"  },
        { "value": "M",  "label": "M"  },
        { "value": "L",  "label": "L"  },
        { "value": "XL", "label": "XL" }
      ]
    },
    { "type": "textarea", "id": "fit_tip", "label": "Fit Tip (italic, below table)", "default": "When in doubt, size up — AirLight is designed with room to layer." }
  ],
  "blocks": [
    {
      "type": "size_row",
      "name": "Size Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row Label", "default": "US / CA Size" },
        { "type": "text", "id": "xs",    "label": "XS",        "default": "0–2"   },
        { "type": "text", "id": "s",     "label": "S",         "default": "4–6"   },
        { "type": "text", "id": "m",     "label": "M",         "default": "8–10"  },
        { "type": "text", "id": "l",     "label": "L",         "default": "12–14" },
        { "type": "text", "id": "xl",    "label": "XL",        "default": "16–18" }
      ]
    },
    {
      "type": "model_spec",
      "name": "Model Spec",
      "settings": [
        { "type": "text", "id": "label",     "label": "Label (e.g. Women's Model)", "default": "Women's Model"  },
        { "type": "text", "id": "height",    "label": "Height",                     "default": "5'7\" / 170cm" },
        { "type": "text", "id": "weight",    "label": "Weight (optional)",          "default": "125 lbs / 57kg" },
        { "type": "text", "id": "size_worn", "label": "Size Worn",                  "default": "S"             }
      ]
    }
  ],
  "presets": [
    {
      "name": "AG Size Guide",
      "blocks": [
        {
          "type": "size_row",
          "settings": {
            "label": "US / CA Size",
            "xs": "0–2", "s": "4–6", "m": "8–10", "l": "12–14", "xl": "16–18"
          }
        },
        {
          "type": "size_row",
          "settings": {
            "label": "Chest (in)",
            "xs": "32–33", "s": "34–35", "m": "36–37½", "l": "38½–40", "xl": "41½–43"
          }
        },
        {
          "type": "size_row",
          "settings": {
            "label": "Chest (cm)",
            "xs": "81–84", "s": "86–89", "m": "91–95", "l": "98–102", "xl": "105–109"
          }
        },
        {
          "type": "size_row",
          "settings": {
            "label": "Height",
            "xs": "5'1\"–5'4\" / 155–163cm",
            "s":  "5'2\"–5'5\" / 157–165cm",
            "m":  "5'3\"–5'6\" / 160–168cm",
            "l":  "5'4\"–5'7\" / 163–170cm",
            "xl": "5'5\"–5'8\" / 165–173cm"
          }
        },
        {
          "type": "size_row",
          "settings": {
            "label": "JP Size",
            "xs": "S", "s": "M", "m": "L", "l": "LL", "xl": "3L"
          }
        },
        {
          "type": "model_spec",
          "settings": {
            "label": "Women's Model",
            "height": "5'7\" / 170cm",
            "weight": "",
            "size_worn": "S"
          }
        },
        {
          "type": "model_spec",
          "settings": {
            "label": "Men's Model",
            "height": "5'11\" / 180cm",
            "weight": "",
            "size_worn": "M"
          }
        }
      ]
    }
  ]
}
{% endschema %}
