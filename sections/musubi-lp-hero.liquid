<section
  class="hero"
  id="hero"
  style="
    --hero-bg-color: {{ section.settings.hero_bg_color }};
    --hero-title-size-pc: {{ section.settings.hero_title_font_size_pc }}px;
    --hero-title-size-sp: {{ section.settings.hero_title_font_size_sp }}px;
    --hero-title-weight-pc: {{ section.settings.hero_title_font_weight_pc }};
    --hero-title-weight-sp: {{ section.settings.hero_title_font_weight_sp }};
  "
>
  <div class="hero__img-wrapper">
    <picture>
      {% if section.settings.hero_image_sp != blank %}
        <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_sp | img_url: '900x' }}">
      {% endif %}

      <img
        src="{{ section.settings.hero_image | img_url: '1600x' }}"
        alt="{{ section.settings.hero_image_alt }}"
        class="hero__img"
      >
    </picture>

    <div class="hero__title-overlay">
      <p class="hero__brand">{{ section.settings.brand_name }}</p>
      <div class="hero__title">
        {{ section.settings.hero_title }}
      </div>
    </div>
  </div>

  <div class="hero__content">

    <div
      class="hero__subtitle"
      style="
        font-size: {{ section.settings.hero_subtitle_font_size }}px;
        font-weight: {{ section.settings.hero_subtitle_font_weight }};
        color: {{ section.settings.hero_subtitle_color }};
      "
    >
      {{ section.settings.hero_subtitle }}
    </div>

    <div class="hero__cta-area">

      {% if section.settings.show_soldout and section.settings.soldout_text != blank %}
        <p class="hero__soldout">
          {{ section.settings.soldout_text }}
        </p>
      {% endif %}

      <!-- CTA① -->
      {% if section.settings.cta_url != blank %}
        <a
          href="{{ section.settings.cta_url }}"
          class="hero__cta-btn"
          style="
            background: {{ section.settings.cta1_bg_color }};
            color: {{ section.settings.cta1_text_color }};
          "
          target="_blank"
        >
          {{ section.settings.cta_text }}
        </a>
      {% endif %}

      <!-- CTA② -->
      {% if section.settings.cta_url_2 != blank %}
        <a
          href="{{ section.settings.cta_url_2 }}"
          class="hero__cta-btn hero__cta-btn--second"
          style="
            background: {{ section.settings.cta2_bg_color }};
            color: {{ section.settings.cta2_text_color }};
          "
          target="_blank"
        >
          {{ section.settings.cta_text_2 }}
        </a>
      {% endif %}

      <p class="hero__price">
        {{ section.settings.price_text }}
        <span class="hero__price-tax">{{ section.settings.price_tax }}</span>
      </p>

      <div class="hero__features">
        <span>✓ オールシーズン</span>
        <span>✓ アニマルフリー</span>
        <span>✓ 通気性</span>
        <span>✓ お手入れ簡単</span>
      </div>

    </div>
  </div>
</section>

<style>
.hero {
  display: flex;
  flex-direction: column;
}

.hero__img-wrapper {
  position: relative;
}

.hero__img {
  width: 100%;
  display: block;
}

.hero__title-overlay {
  position: absolute;
  bottom: 32px;
  left: 24px;
  right: 24px;
  text-align: center;
  color: #fff;
}

.hero__title p {
  font-size: var(--hero-title-size-pc);
  font-weight: var(--hero-title-weight-pc);
}

.hero__content {
  background: var(--hero-bg-color);
  padding: 28px 16px;
  text-align: center;
  color: #fff;
}

.hero__soldout {
  font-weight: 700;
  margin-bottom: 12px;
}

.hero__cta-btn {
  display: block;
  margin: 0 auto;
  width: 100%;
  max-width: 360px;
  padding: 14px;
  border-radius: 999px;
  text-align: center;
  text-decoration: none;
  font-weight: 700;
}

.hero__cta-btn--second {
  margin-top: 10px;
}

.hero__features {
  margin-top: 8px;
  font-size: 12px;
}

@media screen and (max-width: 767px) {
  .hero__title p {
    font-size: var(--hero-title-size-sp);
    font-weight: var(--hero-title-weight-sp);
  }
}
</style>

{% schema %}
{
  "name": "MUSUBI Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "ヒーロー画像PC" },
    { "type": "image_picker", "id": "hero_image_sp", "label": "ヒーロー画像SP" },

    { "type": "color", "id": "hero_bg_color", "label": "背景色", "default": "#1F2A44" },

    { "type": "text", "id": "brand_name", "label": "ブランド名" },

    { "type": "richtext", "id": "hero_title", "label": "タイトル" },

    { "type": "range", "id": "hero_title_font_size_pc", "label": "タイトルサイズPC", "min": 24, "max": 96, "step": 1, "default": 56 },
    { "type": "range", "id": "hero_title_font_size_sp", "label": "タイトルサイズSP", "min": 20, "max": 56, "step": 1, "default": 34 },

    { "type": "select", "id": "hero_title_font_weight_pc", "label": "タイトル太さPC", "default": "700",
      "options": [{"value":"400","label":"通常"},{"value":"700","label":"太"}] },

    { "type": "select", "id": "hero_title_font_weight_sp", "label": "タイトル太さSP", "default": "700",
      "options": [{"value":"400","label":"通常"},{"value":"700","label":"太"}] },

    { "type": "richtext", "id": "hero_subtitle", "label": "サブタイトル" },

    { "type": "range", "id": "hero_subtitle_font_size", "label": "サブタイトルサイズ", "min": 12, "max": 40, "step": 1, "default": 18 },

    { "type": "select", "id": "hero_subtitle_font_weight", "label": "サブタイトル太さ", "default": "400",
      "options": [{"value":"300","label":"細"},{"value":"400","label":"通常"},{"value":"700","label":"太"}] },

    { "type": "color", "id": "hero_subtitle_color", "label": "サブタイトル色", "default": "#ffffff" },

    { "type": "checkbox", "id": "show_soldout", "label": "完売表示", "default": true },
    { "type": "text", "id": "soldout_text", "label": "完売文言" },

    { "type": "url", "id": "cta_url", "label": "CTA1リンク" },
    { "type": "text", "id": "cta_text", "label": "CTA1テキスト" },

    { "type": "color", "id": "cta1_bg_color", "label": "CTA1背景", "default": "#ffffff" },
    { "type": "color", "id": "cta1_text_color", "label": "CTA1文字色", "default": "#1F2A44" },

    { "type": "url", "id": "cta_url_2", "label": "CTA2リンク" },
    { "type": "text", "id": "cta_text_2", "label": "CTA2テキスト" },

    { "type": "color", "id": "cta2_bg_color", "label": "CTA2背景", "default": "#1F2A44" },
    { "type": "color", "id": "cta2_text_color", "label": "CTA2文字色", "default": "#ffffff" },

    { "type": "text", "id": "price_text", "label": "価格" },
    { "type": "text", "id": "price_tax", "label": "税込表記" }
  ],
  "presets": [{ "name": "MUSUBI Hero" }]
}
{% endschema %}