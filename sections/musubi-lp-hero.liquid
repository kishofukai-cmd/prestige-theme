<section
  class="hero"
  id="hero"
  style="
    --hero-bg-color: {{ section.settings.hero_bg_color }};
    --hero-title-size-pc: {{ section.settings.hero_title_font_size_pc }}px;
    --hero-title-size-sp: {{ section.settings.hero_title_font_size_sp }}px;
    --hero-title-weight-pc: {{ section.settings.hero_title_font_weight_pc }};
    --hero-title-weight-sp: {{ section.settings.hero_title_font_weight_sp }};
    --hero-button-bg-color: {{ section.settings.hero_button_bg_color }};
    --hero-button-text-color: {{ section.settings.hero_button_text_color }};
  "
>
  <div class="hero__img-wrapper">
    <picture>
      {% if section.settings.hero_image_sp != blank %}
        <source
          media="(max-width: 767px)"
          srcset="{{ section.settings.hero_image_sp | img_url: '900x' }}">
      {% endif %}

      <img
        src="{{ section.settings.hero_image | img_url: '1600x' | default: 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1600' }}"
        alt="{{ section.settings.hero_image_alt | default: 'MUSUBIブランケットに包まれる女性' }}"
        class="hero__img">
    </picture>

    <div class="hero__title-overlay">
      <p class="hero__brand">{{ section.settings.brand_name | default: 'KAPOK KNOT HOME' }}</p>

      <div class="hero__title">
        {{ section.settings.hero_title | default: '<p>やさしい重みで、<br>休息のスイッチを入れる。</p>' }}
      </div>
    </div>
  </div>

  <div class="hero__content">
    <div
      class="hero__subtitle"
      style="
        font-size: {{ section.settings.hero_subtitle_font_size }}px;
        font-weight: {{ section.settings.hero_subtitle_font_weight }};
        color: {{ section.settings.hero_subtitle_color }};
      "
    >
      {{ section.settings.hero_subtitle }}
    </div>

    <div class="hero__cta-area">
      {% if section.settings.show_soldout and section.settings.soldout_text != blank %}
        <p class="hero__soldout">
          {{ section.settings.soldout_text }}
        </p>
      {% endif %}

      {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_url }}" class="hero__cta-btn" target="_blank" rel="noopener">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}

      {% if section.settings.cta_url_2 != blank and section.settings.cta_text_2 != blank %}
        <a href="{{ section.settings.cta_url_2 }}" class="hero__cta-btn hero__cta-btn--second" target="_blank" rel="noopener">
          {{ section.settings.cta_text_2 }}
        </a>
      {% endif %}

      <p class="hero__price">
        {{ section.settings.price_text | default: '¥29,800〜' }}
        <span class="hero__price-tax">{{ section.settings.price_tax | default: '(税込)' }}</span>
      </p>

      <div class="hero__features">
        <span>✓ オールシーズン</span>
        <span>✓ アニマルフリー</span>
        <span>✓ 通気性</span>
        <span>✓ お手入れ簡単</span>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  display: flex;
  flex-direction: column;
  position: relative;
}

.hero__img-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero__img {
  width: 100%;
  height: auto;
  display: block;
}

.hero__title-overlay {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 32px;
  z-index: 2;
  color: #fff;
  text-align: center;
}

.hero__brand {
  margin: 0 0 8px;
  font-size: 0.8rem;
  letter-spacing: 0.14em;
  font-weight: 500;
}

.hero__title p {
  margin: 0;
  font-size: var(--hero-title-size-pc);
  line-height: 1.25;
  font-weight: var(--hero-title-weight-pc);
  letter-spacing: 0.04em;
}

.hero__content {
  position: static;
  padding: 28px 16px 36px;
  text-align: center;
  background: var(--hero-bg-color);
  color: #fff;
}

.hero__subtitle p {
  margin: 0 0 20px;
  line-height: 1.7;
}

.hero__soldout {
  font-size: 1.2rem;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 12px;
  letter-spacing: 0.05em;
  font-family: inherit;
}

.hero__cta-btn {
  display: inline-block;
  width: min(100%, 360px);
  padding: 14px 24px;
  border-radius: 999px;
  background: var(--hero-button-bg-color);
  color: var(--hero-button-text-color);
  text-decoration: none;
  font-weight: 700;
  text-align: center;
}

.hero__cta-btn--second {
  margin-top: 10px;
}

.hero__price {
  margin: 14px 0 0;
  font-size: 1rem;
}

.hero__price-tax {
  font-size: 0.8em;
}

.hero__features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4px 12px;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.75);
  margin-top: 8px;
  letter-spacing: 0.03em;
}

@media screen and (max-width: 767px) {
  .hero__title-overlay {
    left: 16px;
    right: 16px;
    bottom: 24px;
  }

  .hero__title p {
    font-size: var(--hero-title-size-sp);
    font-weight: var(--hero-title-weight-sp);
  }

  .hero__content {
    padding: 24px 16px 32px;
  }
}
</style>

{% schema %}
{
  "name": "MUSUBI Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "ヒーロー画像（PC）"
    },
    {
      "type": "image_picker",
      "id": "hero_image_sp",
      "label": "ヒーロー画像（SP）"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "画像のalt属性",
      "default": "MUSUBIブランケットに包まれる女性"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "背景色",
      "default": "#1F2A44"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "ブランド名",
      "default": "KAPOK KNOT HOME"
    },
    {
      "type": "richtext",
      "id": "hero_title",
      "label": "見出し",
      "default": "<p>やさしい重みで、<br>休息のスイッチを入れる。</p>"
    },
    {
      "type": "range",
      "id": "hero_title_font_size_pc",
      "label": "見出し フォントサイズ（PC）",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "hero_title_font_size_sp",
      "label": "見出し フォントサイズ（SP）",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "hero_title_font_weight_pc",
      "label": "見出し 太さ（PC）",
      "default": "700",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "select",
      "id": "hero_title_font_weight_sp",
      "label": "見出し 太さ（SP）",
      "default": "700",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "richtext",
      "id": "hero_subtitle",
      "label": "サブタイトル",
      "default": "<p>あみあみによる通気構造<br>リカバリー加重ブランケット</p>"
    },
    {
      "type": "range",
      "id": "hero_subtitle_font_size",
      "label": "サブタイトル フォントサイズ",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "hero_subtitle_font_weight",
      "label": "サブタイトル 太さ",
      "default": "400",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "color",
      "id": "hero_subtitle_color",
      "label": "サブタイトル 色",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_soldout",
      "label": "完売表示を出す",
      "default": true
    },
    {
      "type": "text",
      "id": "soldout_text",
      "label": "完売表示テキスト",
      "default": "現在MUSUBI-en-は完売中です。"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTAリンク先 1"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTAボタンテキスト 1",
      "default": "商品ページを見る"
    },
    {
      "type": "url",
      "id": "cta_url_2",
      "label": "CTAリンク先 2"
    },
    {
      "type": "text",
      "id": "cta_text_2",
      "label": "CTAボタンテキスト 2",
      "default": "LINEで再入荷を受け取る"
    },
    {
      "type": "color",
      "id": "hero_button_bg_color",
      "label": "ボタン背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hero_button_text_color",
      "label": "ボタン文字色",
      "default": "#1F2A44"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "価格テキスト",
      "default": "¥29,800〜"
    },
    {
      "type": "text",
      "id": "price_tax",
      "label": "税表記",
      "default": "(税込)"
    }
  ],
  "presets": [
    {
      "name": "MUSUBI Hero"
    }
  ]
}
{% endschema %}