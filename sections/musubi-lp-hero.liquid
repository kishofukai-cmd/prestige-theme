{% comment %} MUSUBI LP - Hero Section {% endcomment %}
{% render 'musubi-lp-styles' %}

<section class="hero" id="hero">
  <div class="hero__img-wrapper">
    <img src="{{ section.settings.hero_image | img_url: '1600x' | default: 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1600' }}"
      alt="{{ section.settings.hero_image_alt | default: 'MUSUBIブランケットに包まれる女性' }}" class="hero__img">
  </div>
  <div class="hero__content">
    <p class="hero__brand">{{ section.settings.brand_name | default: 'KAPOK KNOT HOME' }}</p>
    <h1 class="hero__title">{{ section.settings.hero_title | default: 'やさしい重みで、<br>休息のスイッチを入れる。' }}</h1>
    <p class="hero__subtitle">{{ section.settings.hero_subtitle | default: '植物由来素材 × 通気構造の<br>リカバリー加重ブランケット' }}</p>

    <!-- ソーシャルプルーフ -->
    <div class="hero__proof">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          {% unless forloop.first %}<div class="hero__proof-divider"></div>{% endunless %}
          <div class="hero__proof-item" {{ block.shopify_attributes }}>
            <span class="hero__proof-number">{{ block.settings.number }}</span>
            <span class="hero__proof-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- ヒーローCTA -->
    <div class="hero__cta-area">
        <!-- ▼追加ここ -->
  <p class="hero__soldout">
    現在MUSUBI-en-は完売中です。
  </p>
  <!-- ▲追加ここ -->
      <a href="{{ section.settings.cta_url | default: 'https://kapok-knot.com/products/musubi-en' }}" class="hero__cta-btn" target="_blank" rel="noopener">
        {{ section.settings.cta_text | default: '今すぐMUSUBIを手に入れる' }}
      </a>
      <p class="hero__price">{{ section.settings.price_text | default: '¥29,800〜' }} <span class="hero__price-tax">{{ section.settings.price_tax | default: '(税込)' }}</span></p>
        <div style= "display:flex;flex-wrap:wrap;justify-content:center;gap:4px 12px;font-size:0.75rem;color:rgba(255,255,255,0.6);margin-top:8px;letter-spacing:0.03em;">
          <span>✓ オールシーズン</span>
          <span>✓ アニマルフリー</span>
          <span>✓ 通気性</span>
          <span>✓ お手入れ簡単</span>

        </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "ヒーロー画像"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "画像のalt属性",
      "default": "MUSUBIブランケットに包まれる女性"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "ブランド名",
      "default": "KAPOK KNOT HOME"
    },
    {
      "type": "richtext",
      "id": "hero_title",
      "label": "見出し",
      "default": "<p>やさしい重みで、<br>休息のスイッチを入れる。</p>"
    },
    {
      "type": "richtext",
      "id": "hero_subtitle",
      "label": "サブタイトル",
      "default": "<p>植物由来素材 × 通気構造の<br>リカバリー加重ブランケット</p>"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTAリンク先"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTAボタンテキスト",
      "default": "今すぐMUSUBIを手に入れる"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "価格テキスト",
      "default": "¥29,800〜"
    },
    {
      "type": "text",
      "id": "price_tax",
      "label": "税表記",
      "default": "(税込)"
    }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "実績数値",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "数値",
          "default": "2,000"
        },
        {
          "type": "text",
          "id": "label",
          "label": "ラベル",
          "default": "枚突破"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI Hero",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "2,000", "label": "枚突破" } },
        { "type": "proof_item", "settings": { "number": "408", "label": "名支援" } },
        { "type": "proof_item", "settings": { "number": "★4.1", "label": "レビュー" } }
      ]
    }
  ]
}
{% endschema %}


