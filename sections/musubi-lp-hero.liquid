<section
  class="hero"
  id="hero"
  style="
    --hero-bg-color: {{ section.settings.hero_bg_color }};
    --hero-title-size-pc: {{ section.settings.hero_title_font_size_pc }}px;
    --hero-title-size-sp: {{ section.settings.hero_title_font_size_sp }}px;
    --hero-title-weight-pc: {{ section.settings.hero_title_font_weight_pc }};
    --hero-title-weight-sp: {{ section.settings.hero_title_font_weight_sp }};
  "
>
  <div class="hero__img-wrapper">
    <picture>
      {% if section.settings.hero_image_sp != blank %}
        <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_sp | img_url: '900x' }}">
      {% endif %}

      <img
        src="{{ section.settings.hero_image | img_url: '1600x' }}"
        alt="{{ section.settings.hero_image_alt }}"
        class="hero__img"
      >
    </picture>

    <div class="hero__title-overlay">
      <p class="hero__brand">{{ section.settings.brand_name }}</p>
      <div class="hero__title">
        {{ section.settings.hero_title }}
      </div>
    </div>
  </div>

  <div class="hero__content">
    <div
      class="hero__subtitle"
      style="
        font-size: {{ section.settings.hero_subtitle_font_size }}px;
        font-weight: {{ section.settings.hero_subtitle_font_weight }};
        color: {{ section.settings.hero_subtitle_color }};
      "
    >
      {{ section.settings.hero_subtitle }}
    </div>

    <div class="hero__cta-area">
      {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
        <a
          href="{{ section.settings.cta_url }}"
          class="hero__cta-btn"
          style="
            background: {{ section.settings.cta1_bg_color }};
            color: {{ section.settings.cta1_text_color }};
            margin-top: {{ section.settings.cta1_margin_top }}px;
            margin-bottom: {{ section.settings.cta1_margin_bottom }}px;
          "
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.cta_text }}
        </a>
      {% endif %}

      {% if section.settings.cta_url_2 != blank and section.settings.cta_text_2 != blank %}
        <a
          href="{{ section.settings.cta_url_2 }}"
          class="hero__cta-btn"
          style="
            background: {{ section.settings.cta2_bg_color }};
            color: {{ section.settings.cta2_text_color }};
            margin-top: {{ section.settings.cta2_margin_top }}px;
            margin-bottom: {{ section.settings.cta2_margin_bottom }}px;
          "
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.cta_text_2 }}
        </a>
      {% endif %}

      {% if section.settings.show_soldout and section.settings.soldout_text != blank %}
        <p
          class="hero__soldout"
          style="
            margin-top: {{ section.settings.soldout_margin_top }}px;
            margin-bottom: {{ section.settings.soldout_margin_bottom }}px;
            font-size: {{ section.settings.soldout_font_size }}px;
            color: {{ section.settings.soldout_text_color }};
          "
        >
          {{ section.settings.soldout_text | newline_to_br }}
        </p>
      {% endif %}

      {% if section.settings.price_text != blank %}
        <p
          class="hero__price"
          style="
            margin-top: {{ section.settings.price_margin_top }}px;
            margin-bottom: {{ section.settings.price_margin_bottom }}px;
          "
        >
          {{ section.settings.price_text }}
          <span class="hero__price-tax">{{ section.settings.price_tax }}</span>
        </p>
      {% endif %}

      <div class="hero__features">
        <span>✓ オールシーズン</span>
        <span>✓ アニマルフリー</span>
        <span>✓ 通気性</span>
        <span>✓ お手入れ簡単</span>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  display: flex;
  flex-direction: column;
}

.hero__img-wrapper {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.hero__img {
  width: 100%;
  height: auto;
  display: block;
}

.hero__title-overlay {
  position: absolute;
  bottom: 32px;
  left: 24px;
  right: 24px;
  text-align: center;
  color: #fff;
}

.hero__brand {
  margin: 0 0 8px;
  font-size: 0.8rem;
  letter-spacing: 0.14em;
  font-weight: 500;
}

.hero__title p {
  margin: 0;
  font-size: var(--hero-title-size-pc);
  font-weight: var(--hero-title-weight-pc);
  line-height: 1.25;
  letter-spacing: 0.04em;
}

.hero__content {
  background: var(--hero-bg-color) !important;
  padding: 28px 16px 36px;
  text-align: center;
  color: #fff;
}

.hero__subtitle p {
  margin: 0 0 20px;
  line-height: 1.7;
}

.hero__soldout {
  font-weight: 700;
  text-align: center;
  letter-spacing: 0.05em;
  font-family: inherit;
  line-height: 1.6;
}

.hero__cta-btn {
  display: block;
  width: min(100%, 360px);
  padding: 14px 24px;
  border-radius: 999px;
  text-align: center;
  text-decoration: none;
  font-weight: 700;
  line-height: 1.4;
  margin-left: auto;
  margin-right: auto;
}

.hero__price {
  font-size: 1rem;
}

.hero__price-tax {
  font-size: 0.8em;
}

.hero__features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 4px 12px;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.75);
  margin-top: 8px;
  letter-spacing: 0.03em;
}

@media screen and (max-width: 767px) {
  .hero__title-overlay {
    left: 16px;
    right: 16px;
    bottom: 24px;
  }

  .hero__title p {
    font-size: var(--hero-title-size-sp);
    font-weight: var(--hero-title-weight-sp);
  }

  .hero__content {
    padding: 24px 16px 32px;
  }
}
</style>

{% schema %}
{
  "name": "MUSUBI Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "ヒーロー画像PC"
    },
    {
      "type": "image_picker",
      "id": "hero_image_sp",
      "label": "ヒーロー画像SP"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "画像のalt属性",
      "default": "MUSUBIブランケットに包まれる女性"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "背景色",
      "default": "#1F2A44"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "ブランド名",
      "default": "KAPOK KNOT HOME"
    },
    {
      "type": "richtext",
      "id": "hero_title",
      "label": "タイトル",
      "default": "<p>やさしい重みで、<br>休息のスイッチを入れる。</p>"
    },
    {
      "type": "range",
      "id": "hero_title_font_size_pc",
      "label": "タイトルサイズPC",
      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "hero_title_font_size_sp",
      "label": "タイトルサイズSP",
      "min": 20,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "hero_title_font_weight_pc",
      "label": "タイトル太さPC",
      "default": "700",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "select",
      "id": "hero_title_font_weight_sp",
      "label": "タイトル太さSP",
      "default": "700",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "richtext",
      "id": "hero_subtitle",
      "label": "サブタイトル",
      "default": "<p>あみあみによる通気構造<br>リカバリー加重ブランケット</p>"
    },
    {
      "type": "range",
      "id": "hero_subtitle_font_size",
      "label": "サブタイトルサイズ",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "hero_subtitle_font_weight",
      "label": "サブタイトル太さ",
      "default": "400",
      "options": [
        { "value": "300", "label": "細め" },
        { "value": "400", "label": "通常" },
        { "value": "500", "label": "中太" },
        { "value": "600", "label": "太め" },
        { "value": "700", "label": "かなり太め" }
      ]
    },
    {
      "type": "color",
      "id": "hero_subtitle_color",
      "label": "サブタイトル色",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_soldout",
      "label": "完売表示を出す",
      "default": true
    },
    {
      "type": "textarea",
      "id": "soldout_text",
      "label": "完売文言",
      "default": "現在MUSUBI-en-は完売中です。"
    },
    {
      "type": "range",
      "id": "soldout_font_size",
      "label": "完売文言 フォントサイズ",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "soldout_text_color",
      "label": "完売文言 文字色",
      "default": "#ffffff"
    },
    {
      "type": "url",
