  background: linear-gradient(135deg, var(--color-gold), #c9a56c);
  border-radius: 100px;
  text-decoration: none;
  box-shadow: 0 4px 20px rgba(183, 155, 105, 0.4);
  transition: all 0.3s ease;
}

.hero__cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(183, 155, 105, 0.5);
}

.hero__price {
  margin-top: 12px;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 0.05em;
}

.hero__price-tax {
  font-size: 0.75rem;
  color: rgba(255, 255, 255, 0.6);
}

/* ============================================================
   VIDEO LOOP (パララックス)
   ============================================================ */
.video-loop {
  position: relative;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--color-bg-dark);
}

.video-loop__bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.video-loop__bg img,
.video-loop__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.6;
}

.video-loop__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(18, 18, 18, 0.3), rgba(18, 18, 18, 0.8));
}

.video-loop__content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: #fff;
  padding: 0 var(--side-pad);
}

.video-loop__content h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 8vw, 3.5rem);
  font-weight: 400;
  line-height: 1.6;
  letter-spacing: 0.1em;
}

/* ============================================================
   WHY - 強烈なスクロール演出 (Edge to Edge)
   ============================================================ */
.why {
  padding: var(--section-gap) 0;
  background: var(--color-bg);
}

.why .section-title {
  max-width: var(--container-max);
  margin: 0 auto clamp(48px, 10vw, 80px);
  padding: 0 var(--side-pad);
}

.why__cards {
  display: flex;
  flex-direction: column;
  gap: var(--section-gap);
  /* セクションごとの間隔を大きく */
}

/* カードの枠を外し、画面端まで画像をデカデカと配置 */
.why__card {
  display: flex;
  flex-direction: column;
  background: transparent;
  border: none;
  border-radius: 0;
  overflow: visible;
}

.why__card-img {
  width: 100%;
  aspect-ratio: 4/5;
  /* 縦長で迫力を */
  overflow: hidden;
  margin-bottom: 32px;
}

.why__card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 画像端まで広げる */
}

.why__card-content {
  padding: 0 var(--side-pad);
  max-width: var(--container-narrow);
  margin: 0 auto;
}

.why__card-num {
  font-family: var(--font-display);
  font-size: clamp(3rem, 10vw, 5rem);
  /* 巨大な数字 */
  line-height: 1;
  color: var(--color-accent);
  opacity: 0.3;
  /* 透かして背景化 */
  display: block;
  margin-bottom: 0px;
  margin-left: -4px;
}

.why__card-title {
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 6vw, 2.25rem);
  font-weight: 500;
  margin-top: -24px;
  /* 数字と少し重ねる */
  position: relative;
  z-index: 2;
  margin-bottom: 24px;
  line-height: 1.4;
}

.why__card-desc {
  font-size: 1rem;
  color: var(--color-text-sub);
  line-height: 2;
}

@media (min-width: 768px) {
  .why__card {
    flex-direction: row;
    align-items: center;
    gap: 64px;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--side-pad);
  }

  .why__card:nth-child(even) {
    flex-direction: row-reverse;
  }

  .why__card-img {
    flex: 1;
    aspect-ratio: 1/1;
    border-radius: 16px;
    margin-bottom: 0;
  }

  .why__card-content {
    flex: 1;
    padding: 0;
  }
}

/* ============================================================
   EMPATHY - 没入感強化 (The Problem)
   ============================================================ */
.empathy {
  padding: var(--section-gap) 0;
  background: var(--color-bg-dark);
  /* ダーク反転で画面を一変 */
  color: var(--color-text-light);
}

.empathy__title {
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 6vw, 2.5rem);
  font-weight: 500;
  text-align: center;
  margin-bottom: 48px;
  letter-spacing: 0.02em;
}

.empathy__list {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 480px;
  margin: 0 auto 40px;
}

.empathy__item {
  display: flex;
  align-items: center;
  gap: 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 16px;
  /* 丸み強化 */
  padding: 24px;
}

.empathy__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-gold);
}

.empathy__item p {
  font-size: 1.05rem;
  font-weight: 400;
  color: #fff;
}

.empathy__arrow {
  text-align: center;
  font-size: 2rem;
  color: var(--color-gold);
  margin-bottom: 48px;
  line-height: 1;
  animation: bounce 2s infinite;
}

@keyframes bounce {

  0%,
  20%,
  50%,
  80%,
  100% {
    transform: translateY(0);
  }

  40% {
    transform: translateY(-10px);
  }

  60% {
    transform: translateY(-5px);
  }
}

.empathy__solution {
  text-align: center;
  position: relative;
  /* 画像を両端ギリギリまで広げる */
  margin-left: calc(-1 * var(--side-pad));
  margin-right: calc(-1 * var(--side-pad));
}

.empathy__solution-img {
  width: 100%;
  aspect-ratio: 4/5;
  margin-bottom: 0;
}

@media (min-width: 768px) {
  .empathy__solution {
    margin-left: 0;
    margin-right: 0;
  }

  .empathy__solution-img {
    border-radius: 16px;
    aspect-ratio: 16/9;
  }
}

.empathy__solution-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 画像に重ねてテキストをドカンと出す */
.empathy__solution-text {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 80px 20px 40px;
  background: linear-gradient(to top, rgba(18, 18, 18, 0.9), transparent);
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 7vw, 2.5rem);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.05em;
  color: #fff;
}

.empathy__solution-text strong {
  color: var(--color-gold);
  font-weight: 600;
  display: block;
  font-size: 1.2em;
  /* 強調部分はさらに大きく */
  margin-top: 8px;
}

/* ============================================================
   STORY - ストーリーテリング
   ============================================================ */
.story {
  padding: var(--section-gap) 0;
  background: var(--color-bg);
  text-align: center;
}

.story__title {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 6vw, 2.25rem);
  font-weight: 500;
  margin-bottom: 48px;
  letter-spacing: 0.05em;
}

.story__content {
  max-width: 600px;
  margin: 0 auto;
}

.story__lead {
  font-size: clamp(1.1rem, 4vw, 1.25rem);
  font-weight: 500;
  color: var(--color-accent);
  margin-bottom: 32px;
  line-height: 1.8;
}

.story__content p {
  font-size: 0.9375rem;
  color: var(--color-text-sub);
  line-height: 2;
  margin-bottom: 24px;
}

.story__content strong {
  font-weight: 600;
  color: var(--color-text);
  font-size: 1.05rem;
}

/* ============================================================
   SCIENCE
   ============================================================ */
.science {
  padding: var(--section-gap) 0;
  background: var(--color-bg-dark);
  color: var(--color-text-light);
}

.science__diagram {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.science__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 0 12px;
}

.science__step-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.02);
  color: #fff;
}

.science__step-label {
  font-size: 0.8125rem;
  text-align: center;
  line-height: 1.5;
  color: rgba(243, 239, 232, 0.8);
}

.science__step-label small {
  font-family: var(--font-display);
  font-size: 0.65rem;
  color: rgba(243, 239, 232, 0.5);
  letter-spacing: 0.05em;
}

.science__connector {
  width: 40px;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  margin-bottom: 24px;
}

@media (max-width: 480px) {
  .science__diagram {
    flex-direction: column;
    gap: 8px;
  }

  .science__connector {
    width: 2px;
    height: 24px;
    background: linear-gradient(180deg, transparent, var(--color-gold), transparent);
    margin-bottom: 0;
  }
}

.science__img {
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 32px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.science__text {
  max-width: 560px;
  margin: 0 auto 40px;
  text-align: center;
}

.science__text p {
  font-size: 0.9375rem;
  line-height: 2;
  color: rgba(243, 239, 232, 0.75);
}

.science__text strong {
  color: var(--color-gold);
  font-weight: 500;
}

/* Papers */
.science__papers {
  max-width: 560px;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 24px;
}

.science__papers-title {
  font-size: 0.8125rem;
  font-weight: 500;
  margin-bottom: 12px;
  color: rgba(243, 239, 232, 0.9);
}

.science__papers-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.science__papers-list li a {
  font-size: 0.75rem;
  color: var(--color-gold);
  text-decoration: underline;
  text-underline-offset: 3px;
  line-height: 1.6;
  display: block;
  transition: opacity 0.3s ease;
}

.science__papers-list li a:hover {
  opacity: 0.7;
}

.science__papers-note {
  font-size: 0.7rem;
  color: rgba(243, 239, 232, 0.4);
}

/* ============================================================
   SIZES
   ============================================================ */
.sizes {
  padding: var(--section-gap) 0;
  background: var(--color-bg);
  /* 白背景にして前後のDarkと明暗を分ける */
}

/* Tabs: スマホで指が届く超巨大タブに */
.sizes__tabs {
  display: flex;
  gap: 8px;
  max-width: 500px;
  margin: 0 auto 40px;
}

.sizes__tab {
  flex: 1;
  padding: 18px 0;
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  background: transparent;
  border: 2px solid var(--color-border);
  border-radius: 16px;
  cursor: pointer;
  color: var(--color-text-sub);
  transition: all 0.3s ease;
}

.sizes__tab--active {
  background: var(--color-bg-dark);
  color: #fff;
  border-color: var(--color-bg-dark);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

/* Panel - カードの枠を外し画像フルサイズ */
.sizes__panel {
  display: none;
  margin-bottom: 24px;
  /* full bleed on mobile */
  margin-left: calc(-1 * var(--side-pad));
  margin-right: calc(-1 * var(--side-pad));
}

.sizes__panel--active {
  display: block;
}

.sizes__panel-img {
  aspect-ratio: 1/1;
  overflow: hidden;
}

@media (min-width: 768px) {
  .sizes__panel {
    margin-left: 0;
    margin-right: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-card);
  }
}

.sizes__panel-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sizes__panel-content {
  padding: 40px var(--side-pad);
  background: var(--color-card);
}

.sizes__panel-badge {
  display: inline-block;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  background: var(--color-tag);
  color: var(--color-accent);
  padding: 4px 14px;
  border-radius: 100px;
  margin-bottom: 12px;
}

.sizes__panel-badge--featured {
  background: var(--color-accent);
  color: #fff;
}

.sizes__panel-name {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 400;
  letter-spacing: 0.05em;
  margin-bottom: 6px;
}

.sizes__panel-price {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--color-accent);
  letter-spacing: 0.03em;
  margin-bottom: 8px;
}

.sizes__panel-price span {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--color-text-sub);
}

.sizes__panel-dim {
  font-family: var(--font-display);
  font-size: 1rem;
  color: var(--color-text-sub);
  letter-spacing: 0.03em;
  margin-bottom: 16px;
}

.sizes__panel-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.sizes__panel-features li {
  font-size: 0.875rem;
  color: var(--color-text);
  padding-left: 18px;
  position: relative;
}

.sizes__panel-features li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-accent);
  font-weight: 600;
}

.sizes__panel-note {
  font-size: 0.8125rem;
  color: var(--color-text-sub);
  line-height: 1.8;
}

/* Compare */
.sizes__compare {
  border-radius: 12px;
  overflow: hidden;
  margin-top: 8px;
}

@media (min-width: 640px) {
  .sizes__panel {
    display: none;
  }

  .sizes__panel--active {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .sizes__panel-img {
    aspect-ratio: auto;
    min-height: 360px;
  }
}

/* ============================================================
   COLORS - ダーク反転 & エッジ拡張
   ============================================================ */
.colors {
  padding: var(--section-gap) 0;
  background: var(--color-bg-dark);
  color: var(--color-text-light);
}

.colors__showcase {
  margin-left: calc(-1 * var(--side-pad));
  margin-right: calc(-1 * var(--side-pad));
  margin-bottom: 16px;
}

@media (min-width: 768px) {
  .colors__showcase {
    margin-left: auto;
    margin-right: auto;
    border-radius: 16px;
    overflow: hidden;
    max-width: 600px;
  }
}

.colors__showcase img {
  width: 100%;
  height: auto;
  transition: opacity 0.4s ease;
}

.colors__name {
  text-align: center;
  font-family: var(--font-display);
  font-size: 0.9rem;
  letter-spacing: 0.15em;
  color: rgba(243, 239, 232, 0.7);
  margin-bottom: 20px;
}

.colors__swatches {
  display: flex;
  justify-content: center;
  gap: 14px;
  margin-bottom: 40px;
}

.colors__swatch {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.colors__swatch:hover {
  transform: scale(1.15);
}

.colors__swatch--active {
  border-color: var(--color-gold);
  box-shadow: 0 0 0 3px var(--color-bg-dark), 0 0 0 5px var(--color-gold);
}

/* カラー別カルーセル */
.colors__carousel {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 600px;
  margin: 0 auto;
}

.colors__carousel-track {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -ms-overflow-style: none;
  scrollbar-width: none;
  padding: 8px 0;
}

.colors__carousel-track::-webkit-scrollbar {
  display: none;
}

.colors__carousel-item {
  flex: 0 0 calc(33.333% - 8px);
  scroll-snap-align: start;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.3s ease;
  background: rgba(255, 255, 255, 0.05);
}

.colors__carousel-item:hover {
  border-color: rgba(255, 255, 255, 0.3);
}

.colors__carousel-item--active {
  border-color: var(--color-gold);
}

.colors__carousel-item img {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  display: block;
}

.colors__carousel-item span {
  display: block;
  text-align: center;
  font-family: var(--font-display);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  color: rgba(243, 239, 232, 0.8);
  padding: 10px 4px;
}

.colors__carousel-arrow {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 1.4rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.colors__carousel-arrow:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: var(--color-gold);
}

/* ============================================================
   CARE - 日常のケア
   ============================================================ */
.care {
  padding: var(--section-gap) 0;
  background: var(--color-bg);
}

.care__layout {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.care__img {
  width: 100%;
  aspect-ratio: 4/5;
  border-radius: 16px;
  overflow: hidden;
}

.care__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.care__content {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.care__point {
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 32px 24px;
}

.care__icon {
  font-size: 2rem;
  display: block;
  margin-bottom: 16px;
}

.care__point h3 {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 12px;
}

.care__point p {
  font-size: 0.9375rem;
  color: var(--color-text-sub);
  line-height: 1.8;
}

@media (min-width: 768px) {
  .care__layout {
    flex-direction: row;
    align-items: center;
  }

  .care__img {
    flex: 1;
    margin-bottom: 0;
    aspect-ratio: 3/4;
  }

  .care__content {
    flex: 1;
  }
}

/* ============================================================
   REVIEWS
   ============================================================ */
.reviews {
  padding: var(--section-gap) 0;
  background: var(--color-bg-warm);
}

/* Star Graph */
.reviews__graph {
  display: flex;
  gap: 32px;
  align-items: center;
  background: var(--color-card);
  border: 1px solid var(--color-border);
  border-radius: 16px;
  padding: 28px;
  margin-bottom: 32px;
  flex-wrap: wrap;
}

.reviews__graph-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100px;
}

.reviews__graph-score {
  font-family: var(--font-display);
  font-size: clamp(4rem, 12vw, 5rem);
  /* 極端に巨大化 */
  font-weight: 300;
  color: var(--color-text);
  line-height: 1;
}

.reviews__graph-stars {
  color: var(--color-gold);
  font-size: 1rem;
  margin: 6px 0 4px;
  letter-spacing: 2px;
}

.reviews__graph-count {
  font-size: 0.7rem;
  color: var(--color-text-sub);
}

.reviews__graph-bars {
  flex: 1;
  min-width: 200px;
}

.reviews__graph-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.reviews__graph-label {
  font-size: 0.75rem;
  color: var(--color-text-sub);
  width: 24px;
}

.reviews__graph-bar {
  flex: 1;
  height: 8px;
  background: var(--color-bg-warm);
  border-radius: 4px;
  overflow: hidden;
}

.reviews__graph-fill {
  height: 100%;
  width: 0%;
  background: var(--color-gold);
  border-radius: 4px;
  transition: width 1.2s var(--ease);
}

.reviews__graph-fill.animated {
  /* JSによる幅のアニメーション用（幅はインラインスタイルで動的に指定） */
  min-width: 1%;
}

.reviews__graph-pct {
  font-size: 0.7rem;
  color: var(--color-text-sub);
  width: 30px;
  text-align: right;
}

