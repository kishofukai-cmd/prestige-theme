/* ============================================================
   KAPOK KNOT MUSUBI -en- | Rich LP Stylesheet
   モバイルファースト設計 / 1スクロール1メッセージ
   ============================================================ */

:root {
  /* Colors - 強いコントラストのカラーパレット */
  --color-bg: #ffffff;
  --color-bg-warm: #f7f5f0;
  --color-bg-dark: #121212;
  --color-bg-dark-soft: #232220;
  --color-text: #1a1a1a;
  --color-text-sub: #555555;
  --color-text-light: #f7f5f0;
  --color-accent: #a88a64;
  --color-accent-light: #d4c2ab;
  --color-gold: #c29d66;
  --color-border: #e0dcd1;
  --color-tag: #ece7da;

  /* Typography */
  --font-serif: 'Noto Serif JP', 'YuMincho', serif;
  --font-sans: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
  --font-display: 'Cormorant Garamond', var(--font-serif);

  /* Spacing - ワンノバ風の極端な余白とエッジなし */
  --section-gap: clamp(80px, 15vw, 160px);
  --section-gap-tight: clamp(40px, 8vw, 80px);
  --container-max: 960px;
  --container-narrow: 680px;
  --side-pad: clamp(16px, 5vw, 40px);

  /* Transition */
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --dur: 0.7s;
}

/* === Reset === */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  font-size: 16px;
  overflow-x: hidden;
}

body {
  font-family: var(--font-sans);
  color: var(--color-text);
  background: var(--color-bg);
  line-height: 1.85;
  overflow-x: hidden;
  max-width: 100vw;
  width: 100%;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
}

/* === Scrollbar === */
::-webkit-scrollbar {
  width: 4px;
}

::-webkit-scrollbar-thumb {
  background: var(--color-accent-light);
  border-radius: 2px;
}

/* === Container === */
.container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--side-pad);
}

.container--narrow {
  max-width: var(--container-narrow);
  margin: 0 auto;
  padding: 0 var(--side-pad);
}

/* === Reveal === */
[data-reveal] {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
}

[data-reveal].revealed {
  opacity: 1;
  transform: translateY(0);
}

/* === Section Title === */
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(1.75rem, 6vw, 2.5rem);
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  letter-spacing: 0.05em;
  margin-bottom: clamp(48px, 8vw, 72px);
}

.section-title--light {
  color: var(--color-text-light);
}

/* ============================================================
   HEADER
   ============================================================ */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(250, 249, 246, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.4s ease;
  width: 100%;
  max-width: 100vw;
}

.header.scrolled {
  border-color: var(--color-border);
}

.header__inner {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--side-pad);
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
}

.header__logo-img {
  height: 20px;
  width: auto;
}

.header__nav {
  display: flex;
  gap: 24px;
}

.header__nav a {
  font-size: 0.75rem;
  font-weight: 400;
  letter-spacing: 0.08em;
  color: var(--color-text-sub);
  transition: color 0.3s ease;
}

.header__nav a:hover {
  color: var(--color-text);
}

.header__hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  z-index: 1001;
}

.header__hamburger span {
  width: 22px;
  height: 1.5px;
  background: var(--color-text);
  transition: all 0.3s ease;
  display: block;
}

.header__hamburger.active span:nth-child(1) {
  transform: rotate(45deg) translate(4px, 4px);
}

.header__hamburger.active span:nth-child(2) {
  opacity: 0;
}

.header__hamburger.active span:nth-child(3) {
  transform: rotate(-45deg) translate(4px, -4px);
}

@media (max-width: 768px) {
  .header__nav {
    display: none;
  }

