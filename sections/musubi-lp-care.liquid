<style>
  .care {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .care__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .care__header {
    text-align: center;
    margin-bottom: 38px;
  }

  .care__label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 8px 15px;
    border-radius: 999px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .care__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .care__heading p {
    margin: 0;
  }

  .care__layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
    align-items: stretch;
  }

  .care__img {
    min-height: {{ section.settings.image_height_pc }}px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #f4eee6;
    box-shadow: 0 16px 44px rgba(0,0,0,0.08);
  }

  .care__img img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .care__content {
    display: grid;
    gap: 16px;
  }

  .care__point {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 16px;
    align-items: flex-start;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 24px;
    box-shadow: 0 12px 34px rgba(0,0,0,0.05);
  }

  .care__icon {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: {{ section.settings.icon_bg_color }};
    font-size: 22px;
    line-height: 1;
  }

  .care__point h3 {
    margin: 0 0 8px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .care__point p {
    grid-column: 2;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .care {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .care__header {
      margin-bottom: 28px;
    }

    .care__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .care__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .care__layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .care__img {
      min-height: {{ section.settings.image_height_sp }}px;
      border-radius: {{ section.settings.image_radius_sp }}px;
    }

    .care__point {
      grid-template-columns: 1fr;
      padding: 22px 18px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .care__point p {
      grid-column: auto;
      font-size: {{ section.settings.text_size_sp }}px;
    }

    .care__point h3 {
      font-size: {{ section.settings.title_size_sp }}px;
    }

    .care__icon {
      width: 40px;
      height: 40px;
    }
  }
</style>

<section class="care" id="care">
  <div class="care__inner">

    <div class="care__header">
      {% if section.settings.label != blank %}
        <div class="care__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="care__heading">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="care__layout">
      <div class="care__img">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '1200x' }}" alt="{{ section.settings.image_alt }}" loading="lazy">
        {% elsif section.settings.image_url != blank %}
          <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt }}" loading="lazy">
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_0022_6ef7fc29-e9d4-4668-9aa7-326c2a86ab98.jpg?v=1771395913&width=1200" alt="日常のケア" loading="lazy">
        {% endif %}
      </div>

      <div class="care__content">
        {% for block in section.blocks %}
          <div class="care__point" {{ block.shopify_attributes }}>
            <span class="care__icon">{{ block.settings.icon }}</span>

            <div>
              <h3>{{ block.settings.title }}</h3>
            </div>

            <p>{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

