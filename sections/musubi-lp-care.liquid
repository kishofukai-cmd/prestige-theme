<style>
  .care {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .care__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .care__header {
    text-align: center;
    margin-bottom: 38px;
  }

  .care__label,
  .care-reviews__label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 8px 15px;
    border-radius: 999px;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .care__heading,
  .care-reviews__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .care__heading p,
  .care-reviews__heading p {
    margin: 0;
  }

  .care__layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 28px;
    align-items: stretch;
  }

  .care__img {
    min-height: {{ section.settings.image_height_pc }}px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #f4eee6;
    box-shadow: 0 16px 44px rgba(0,0,0,0.08);
  }

  .care__img img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .care__content {
    display: grid;
    gap: 16px;
  }

  .care__point {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 16px;
    align-items: flex-start;
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 24px;
    box-shadow: 0 12px 34px rgba(0,0,0,0.05);
  }

  .care__icon {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: {{ section.settings.icon_bg_color }};
    font-size: 22px;
    line-height: 1;
  }

  .care__point h3 {
    margin: 0 0 8px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .care__point p {
    grid-column: 2;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_pc }}px;
    line-height: 1.9;
    letter-spacing: 0.04em;
  }

  .care-reviews {
    margin-top: {{ section.settings.review_margin_top_pc }}px;
    background: {{ section.settings.review_bg_color }};
    border: 1px solid {{ section.settings.review_border_color }};
    border-radius: {{ section.settings.review_radius }}px;
    padding: 38px 32px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
  }

  .care-reviews__header {
    text-align: center;
    margin-bottom: 26px;
  }

  .care-reviews__summary {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
    color: {{ section.settings.review_text_color }};
  }

  .care-reviews__score {
    font-size: {{ section.settings.review_score_size_pc }}px;
    font-weight: 800;
    color: {{ section.settings.review_accent_color }};
    line-height: 1;
  }

  .care-reviews__stars {
    color: {{ section.settings.review_star_color }};
    font-size: {{ section.settings.review_star_size_pc }}px;
    letter-spacing: 0.06em;
  }

  .care-reviews__count {
    font-size: {{ section.settings.review_count_size_pc }}px;
    color: {{ section.settings.review_text_color }};
    font-weight: 600;
  }

  .care-reviews__carousel {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .care-reviews__arrow {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.review_border_color }};
    background: #fff;
    color: {{ section.settings.review_accent_color }};
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .care-reviews__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
    padding: 4px 2px 8px;
  }

  .care-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .care-reviews__card {
    flex: 0 0 {{ section.settings.review_card_width_pc }}px;
    scroll-snap-align: center;
    background: {{ section.settings.review_card_bg_color }};
    border: 1px solid {{ section.settings.review_border_color }};
    border-radius: 20px;
    padding: 22px;
    text-align: left;
    box-shadow: 0 10px 28px rgba(0,0,0,0.05);
  }

  .care-reviews__card-stars {
    color: {{ section.settings.review_star_color }};
    font-size: 14px;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .care-reviews__card-title {
    margin: 0 0 10px;
    color: {{ section.settings.review_title_color }};
    font-size: {{ section.settings.review_title_size_pc }}px;
    font-weight: 700;
    line-height: 1.55;
  }

  .care-reviews__card-text {
    margin: 0 0 14px;
    color: {{ section.settings.review_text_color }};
    font-size: {{ section.settings.review_body_size_pc }}px;
    line-height: 1.8;
    letter-spacing: 0.03em;
  }

  .care-reviews__card-meta {
    font-size: 12px;
    color: #777;
    margin-bottom: 12px;
  }

  .care-reviews__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .care-reviews__tag {
    display: inline-flex;
    background: {{ section.settings.review_tag_bg_color }};
    color: {{ section.settings.review_tag_color }};
    border-radius: 999px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .care {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .care__header {
      margin-bottom: 28px;
    }

    .care__label,
    .care-reviews__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .care__heading,
    .care-reviews__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .care__layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .care__img {
      min-height: {{ section.settings.image_height_sp }}px;
      border-radius: {{ section.settings.image_radius_sp }}px;
    }

    .care__point {
      grid-template-columns: 1fr;
      padding: 22px 18px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .care__point p {
      grid-column: auto;
      font-size: {{ section.settings.text_size_sp }}px;
    }

    .care__point h3 {
      font-size: {{ section.settings.title_size_sp }}px;
    }

    .care-reviews {
      margin-top: {{ section.settings.review_margin_top_sp }}px;
      padding: 30px 16px;
      border-radius: {{ section.settings.review_radius_sp }}px;
    }

    .care-reviews__score {
      font-size: {{ section.settings.review_score_size_sp }}px;
    }

    .care-reviews__stars {
      font-size: {{ section.settings.review_star_size_sp }}px;
    }

    .care-reviews__count {
      font-size: {{ section.settings.review_count_size_sp }}px;
    }

    .care-reviews__arrow {
      width: 34px;
      height: 34px;
      font-size: 22px;
    }

    .care-reviews__card {
      flex-basis: {{ section.settings.review_card_width_sp }}px;
      padding: 20px;
    }

    .care-reviews__card-title {
      font-size: {{ section.settings.review_title_size_sp }}px;
    }

    .care-reviews__card-text {
      font-size: {{ section.settings.review_body_size_sp }}px;
    }
  }
</style>

<section class="care" id="care-{{ section.id }}">
  <div class="care__inner">

    <div class="care__header">
      {% if section.settings.label != blank %}
        <div class="care__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="care__heading">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="care__layout">
      <div class="care__img">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '1200x' }}" alt="{{ section.settings.image_alt }}" loading="lazy">
        {% elsif section.settings.image_url != blank %}
          <img src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt }}" loading="lazy">
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_0022_6ef7fc29-e9d4-4668-9aa7-326c2a86ab98.jpg?v=1771395913&width=1200" alt="日常のケア" loading="lazy">
        {% endif %}
      </div>

      <div class="care__content">
        {% for block in section.blocks %}
          {% if block.type == 'care_point' %}
            <div class="care__point" {{ block.shopify_attributes }}>
              <span class="care__icon">{{ block.settings.icon }}</span>
              <div>
                <h3>{{ block.settings.title }}</h3>
              </div>
              <p>{{ block.settings.description }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.settings.show_reviews %}
      <div class="care-reviews">
        <div class="care-reviews__header">
          {% if section.settings.review_label != blank %}
            <div class="care-reviews__label">{{ section.settings.review_label }}</div>
          {% endif %}

          <h2 class="care-reviews__heading">
            {{ section.settings.review_heading }}
          </h2>

          <div class="care-reviews__summary">
            <span class="care-reviews__score">{{ section.settings.avg_score }}</span>
            <span class="care-reviews__stars">{{ section.settings.avg_stars }}</span>
            <span class="care-reviews__count">{{ section.settings.review_count }}</span>
          </div>
        </div>

        <div class="care-reviews__carousel">
          <button type="button" class="care-reviews__arrow care-reviews__arrow--left" aria-label="前へ">‹</button>

          <div class="care-reviews__track">
            {% for block in section.blocks %}
              {% if block.type == 'review_card' %}
                <div class="care-reviews__card" {{ block.shopify_attributes }}>
                  <div class="care-reviews__card-stars">{{ block.settings.stars }}</div>
                  <h4 class="care-reviews__card-title">{{ block.settings.title }}</h4>
                  <p class="care-reviews__card-text">{{ block.settings.text }}</p>

                  {% if block.settings.meta != blank %}
                    <div class="care-reviews__card-meta">{{ block.settings.meta }}</div>
                  {% endif %}

                  {% if block.settings.tags != blank %}
                    <div class="care-reviews__tags">
                      {% assign tags = block.settings.tags | split: ',' %}
                      {% for tag in tags %}
                        {% if tag != blank %}
                          <span class="care-reviews__tag">{{ tag | strip }}</span>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <button type="button" class="care-reviews__arrow care-reviews__arrow--right" aria-label="次へ">›</button>
        </div>
      </div>
    {% endif %}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('#care-{{ section.id }}');
    if (!section) return;

    var track = section.querySelector('.care-reviews__track');
    var left = section.querySelector('.care-reviews__arrow--left');
    var right = section.querySelector('.care-reviews__arrow--right');

    if (left && track) {
      left.addEventListener('click', function () {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });
    }

    if (right && track) {
      right.addEventListener('click', function () {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }
  });
</script>

