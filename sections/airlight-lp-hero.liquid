{% comment %} AirLight Jacket LP — Hero Section {% endcomment %}
{% render 'airlight-lp-styles' %}

<section class="al-hero" id="al-hero">
  <div class="al-hero__img-wrapper">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: '1600x' }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="al-hero__img" fetchpriority="high">
    {% elsif section.settings.fallback_url != blank %}
      <img src="{{ section.settings.fallback_url }}"
           alt="{{ section.settings.hero_image_alt | default: 'AirLight Jacket — KAPOK KNOT' }}"
           class="al-hero__img" fetchpriority="high">
    {% else %}
      <img src="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight_hero_placeholder.jpg?v=1"
           alt="AirLight Jacket — KAPOK KNOT" class="al-hero__img" fetchpriority="high">
    {% endif %}
  </div>

  <div class="al-hero__content">
    <p class="al-hero__eyebrow">{{ section.settings.eyebrow | default: 'KAPOK KNOT — First Global Launch' }}</p>

    <h1 class="al-hero__title">
      {{ section.settings.hero_title | default: 'Down Warmth.<br><em>Without Down.</em>' }}
    </h1>

    <p class="al-hero__sub">
      {{ section.settings.hero_sub | default: '500g plant-based jacket from Japan.<br>Ethical insulation. Zero compromise.' }}
    </p>

    <!-- Proof Bar -->
    <div class="al-hero__proof">
      {% for block in section.blocks %}
        {% if block.type == 'proof_item' %}
          {% unless forloop.first %}<div class="al-hero__proof-div"></div>{% endunless %}
          <div class="al-hero__proof-item" {{ block.shopify_attributes }}>
            <span class="al-hero__proof-num">{{ block.settings.number }}</span>
            <span class="al-hero__proof-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- CTA -->
    <div class="al-hero__cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#al-cta' }}"
         class="al-hero__cta-btn">
        {{ section.settings.cta_text | default: 'Shop Now' }}
      </a>
      <p class="al-hero__cta-note">
        <strong>{{ section.settings.offer_main | default: 'Free worldwide shipping' }}</strong>
        {{ section.settings.offer_note | default: '· First 100 orders only' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AirLight Hero",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero Image" },
    { "type": "text", "id": "fallback_url", "label": "External Image URL (Fallback)" },
    { "type": "text", "id": "hero_image_alt", "label": "Image Alt", "default": "AirLight Jacket — KAPOK KNOT" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "KAPOK KNOT — First Global Launch" },
    { "type": "richtext", "id": "hero_title", "label": "Headline", "default": "<p>Down Warmth.<br><em>Without Down.</em></p>" },
    { "type": "richtext", "id": "hero_sub", "label": "Subheadline", "default": "<p>500g plant-based jacket from Japan.<br>Ethical insulation. Zero compromise.</p>" },
    { "type": "url", "id": "cta_url", "label": "CTA Link" },
    { "type": "text", "id": "cta_text", "label": "CTA Button Text", "default": "Shop Now" },
    { "type": "text", "id": "offer_main", "label": "Offer Line (Bold)", "default": "Free worldwide shipping" },
    { "type": "text", "id": "offer_note", "label": "Offer Note", "default": "· First 100 orders only" }
  ],
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "¥50M+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Crowdfunded in Japan" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AirLight Hero",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "¥50M+", "label": "Crowdfunded" } },
        { "type": "proof_item", "settings": { "number": "10+", "label": "Awards Won" } },
        { "type": "proof_item", "settings": { "number": "★ 4.8", "label": "Review Score" } }
      ]
    }
  ]
}
{% endschema %}
