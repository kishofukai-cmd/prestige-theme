<style>
  .sizes {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .sizes__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .sizes__header,
  .colors__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .sizes__label,
  .colors__label {
    display: inline-block;
    padding: 8px 15px;
    border-radius: 999px;
    background: {{ section.settings.label_bg }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }

  .sizes__heading,
  .colors__heading {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 12px;
  }

  .sizes__heading p,
  .sizes__lead p,
  .colors__heading p,
  .colors__lead p {
    margin: 0;
  }

  .sizes__lead,
  .colors__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: {{ section.settings.body_size_pc }}px;
    color: {{ section.settings.body_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .sizes__chart {
    margin: 26px auto 0;
    width: 100%;
    text-align: center;
  }

  .sizes__chart img {
    width: {{ section.settings.size_chart_width_pc }}%;
    max-width: 100%;
    height: auto;
    display: inline-block;
    border-radius: {{ section.settings.size_chart_radius_pc }}px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }

  .sizes__tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 32px auto 26px;
    background: #f4eee6;
    border-radius: 999px;
    padding: 6px;
    width: fit-content;
    max-width: 100%;
  }

  .sizes__tab {
    border: none;
    cursor: pointer;
    border-radius: 999px;
    padding: 12px 22px;
    background: transparent;
    color: #6d6258;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .sizes__tab--active {
    background: {{ section.settings.accent_color }};
    color: #fff;
    box-shadow: 0 8px 22px rgba(0,0,0,0.08);
  }

  .sizes__panel {
    display: none;
    grid-template-columns: 1.08fr 0.92fr;
    background: #fff;
    border: 1px solid #eee7dd;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.07);
  }

  .sizes__panel--active {
    display: grid;
  }

  .sizes__panel-img {
    min-height: 460px;
    background: #f4eee6;
    overflow: hidden;
  }

  .sizes__panel-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sizes__panel-content {
    padding: 42px 38px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .sizes__panel-badge {
    width: fit-content;
    background: #f4eee6;
    color: {{ section.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
    padding: 7px 13px;
    margin-bottom: 16px;
  }

  .sizes__panel-badge--featured {
    background: {{ section.settings.accent_color }};
    color: #fff;
  }

  .sizes__panel-name {
    font-size: 28px;
    color: #1a1a1a;
    font-weight: 800;
    line-height: 1.35;
    margin: 0 0 12px;
  }

  .sizes__panel-price {
    font-size: 30px;
    color: {{ section.settings.accent_color }};
    font-weight: 800;
    margin: 0 0 10px;
  }

  .sizes__panel-price span {
    font-size: 0.5em;
    color: #777;
  }

  .sizes__panel-dim {
    width: fit-content;
    background: #faf7f2;
    color: #333;
    font-size: 14px;
    font-weight: 700;
    border-radius: 12px;
    padding: 9px 13px;
    margin: 0 0 18px;
  }

  .sizes__panel-features {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: grid;
    gap: 8px;
  }

  .sizes__panel-features li {
    position: relative;
    padding-left: 1.4em;
    font-size: 14px;
    color: #333;
    line-height: 1.7;
    font-weight: 600;
  }

  .sizes__panel-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: {{ section.settings.accent_color }};
    font-weight: 800;
  }

  .sizes__panel-note {
    font-size: 13px;
    color: #666;
    line-height: 1.8;
    margin: 0;
  }

  .sizes__compare {
    margin: 34px auto 0;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
    background: #fff;
  }

  .sizes__compare img {
    width: 100%;
    display: block;
    height: auto;
  }

  .colors {
    margin-top: 72px;
  }

  .colors__box {
    background: #fff;
    border: 1px solid #eee7dd;
    border-radius: 26px;
    padding: 44px 38px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
  }

  .colors__showcase {
    max-width: 720px;
    margin: 0 auto 18px;
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
  }

  .colors__showcase img {
    width: 100%;
    height: auto;
    display: block;
  }

  .colors__name {
    text-align: center;
    font-size: 16px;
    color: #333;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0 0 22px;
  }

  .colors__swatches {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }

  .colors__swatch {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid #fff;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
  }

  .colors__swatch--active {
    outline: 2px solid {{ section.settings.accent_color }};
    outline-offset: 3px;
  }

  .colors__carousel {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .colors__carousel-arrow {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid #eee7dd;
    background: #fff;
    color: {{ section.settings.accent_color }};
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .colors__carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    padding: 4px 2px;
  }

  .colors__carousel-track::-webkit-scrollbar {
    display: none;
  }

  .colors__carousel-item {
    flex: 0 0 auto;
    width: 100px;
    cursor: pointer;
    scroll-snap-align: start;
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid transparent;
    background: #fff;
  }

  .colors__carousel-item--active {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 8px 22px rgba(0,0,0,0.10);
  }

  .colors__carousel-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .colors__carousel-item span {
    display: block;
    font-size: 11px;
    color: #555;
    padding: 8px 5px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .sizes {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .sizes__label,
    .colors__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .sizes__heading,
    .colors__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .sizes__lead,
    .colors__lead {
      font-size: {{ section.settings.body_size_sp }}px;
    }

    .sizes__chart {
      margin-top: 20px;
    }

    .sizes__chart img {
      width: {{ section.settings.size_chart_width_sp }}%;
      border-radius: {{ section.settings.size_chart_radius_sp }}px;
    }

    .sizes__tabs {
      width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 18px;
      margin-top: 28px;
    }

    .sizes__tab {
      flex: 1 0 auto;
      font-size: 13px;
      padding: 11px 16px;
    }

    .sizes__panel,
    .sizes__panel--active {
      grid-template-columns: 1fr;
      border-radius: 20px;
    }

    .sizes__panel-img {
      min-height: 320px;
    }

    .sizes__panel-content {
      padding: 28px 20px;
    }

    .sizes__panel-name {
      font-size: 24px;
    }

    .sizes__panel-price {
      font-size: 26px;
    }

    .colors {
      margin-top: 52px;
    }

    .colors__box {
      padding: 32px 16px;
      border-radius: 20px;
    }

    .colors__showcase {
      border-radius: 18px;
    }

    .colors__swatch {
      width: 36px;
      height: 36px;
    }

    .colors__carousel-arrow {
      width: 34px;
      height: 34px;
      font-size: 22px;
    }

    .colors__carousel-item {
      width: 80px;
    }
  }
</style>

<section class="sizes" id="sizes-{{ section.id }}">
  <div class="sizes__inner">

    <div class="sizes__header">
      {% if section.settings.label != blank %}
        <div class="sizes__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="sizes__heading">{{ section.settings.heading }}</h2>

      {% if section.settings.lead != blank %}
        <div class="sizes__lead">{{ section.settings.lead }}</div>
      {% endif %}

      {% if section.settings.size_chart_image != blank %}
        <div class="sizes__chart">
          <img
            src="{{ section.settings.size_chart_image | img_url: '1400x' }}"
            alt="{{ section.settings.size_chart_alt }}"
            loading="lazy"
          >
        </div>
      {% elsif section.settings.size_chart_image_url != blank %}
        <div class="sizes__chart">
          <img
            src="{{ section.settings.size_chart_image_url }}"
            alt="{{ section.settings.size_chart_alt }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>

    <div class="sizes__tabs">
      {% assign tab_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          {% assign tab_index = tab_index | plus: 1 %}
          <button
            type="button"
            class="sizes__tab{% if tab_index == 1 %} sizes__tab--active{% endif %}"
            data-tab="size-{{ section.id }}-{{ tab_index }}"
          >
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="sizes__panels">
      {% assign panel_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          {% assign panel_index = panel_index | plus: 1 %}

          <div
            class="sizes__panel{% if panel_index == 1 %} sizes__panel--active{% endif %}"
            data-panel="size-{{ section.id }}-{{ panel_index }}"
            {{ block.shopify_attributes }}
          >
            <div class="sizes__panel-img">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '1200x' }}" alt="{{ block.settings.name }}" loading="lazy">
              {% elsif block.settings.image_url != blank %}
                <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name }}" loading="lazy">
              {% else %}
                <img src="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_0250.jpg?v=1771395913&width=1200" alt="{{ block.settings.name }}" loading="lazy">
              {% endif %}
            </div>

            <div class="sizes__panel-content">
              {% if block.settings.badge != blank %}
                <div class="sizes__panel-badge{% if block.settings.featured %} sizes__panel-badge--featured{% endif %}">
                  {{ block.settings.badge }}
                </div>
              {% endif %}

              <h3 class="sizes__panel-name">{{ block.settings.name }}</h3>

              <p class="sizes__panel-price">
                {{ block.settings.price }}
                <span>{{ block.settings.price_note }}</span>
              </p>

              <p class="sizes__panel-dim">{{ block.settings.dimensions }}</p>

              <ul class="sizes__panel-features">
                {% assign features = block.settings.features | split: ',' %}
                {% for feature in features %}
                  {% if feature != blank %}
                    <li>{{ feature | strip }}</li>
                  {% endif %}
                {% endfor %}
              </ul>

              {% if block.settings.note != blank %}
                <p class="sizes__panel-note">{{ block.settings.note }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.compare_image != blank %}
      <div class="sizes__compare">
        <img src="{{ section.settings.compare_image | img_url: '1400x' }}" alt="{{ section.settings.compare_alt }}" loading="lazy">
      </div>
    {% elsif section.settings.compare_image_url != blank %}
      <div class="sizes__compare">
        <img src="{{ section.settings.compare_image_url }}" alt="{{ section.settings.compare_alt }}" loading="lazy">
      </div>
    {% endif %}

    <div class="colors" id="colors-{{ section.id }}">
      <div class="colors__box">
        <div class="colors__header">
          {% if section.settings.colors_label != blank %}
            <div class="colors__label">{{ section.settings.colors_label }}</div>
          {% endif %}

          <h2 class="colors__heading">{{ section.settings.colors_heading }}</h2>

          {% if section.settings.colors_lead != blank %}
            <div class="colors__lead">{{ section.settings.colors_lead }}</div>
          {% endif %}
        </div>

        {% assign color1_img = '' %}
        {% if section.settings.color1_image != blank %}
          {% assign color1_img = section.settings.color1_image | img_url: '1200x' %}
        {% elsif section.settings.color1_image_url != blank %}
          {% assign color1_img = section.settings.color1_image_url %}
        {% else %}
          {% assign color1_img = 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1200' %}
        {% endif %}

        <div class="colors__showcase">
          <img
            id="colors-main-img-{{ section.id }}"
            src="{{ color1_img }}"
            alt="{{ section.settings.color1_name }}"
            loading="lazy"
          >
        </div>

        <p class="colors__name" id="colors-name-{{ section.id }}">
          {{ section.settings.color1_name }}
        </p>

        <div class="colors__swatches">
          {% for i in (1..5) %}
            {% assign name_key = 'color' | append: i | append: '_name' %}
            {% assign code_key = 'color' | append: i | append: '_code' %}
            {% assign image_key = 'color' | append: i | append: '_image' %}
            {% assign url_key = 'color' | append: i | append: '_image_url' %}

            {% assign color_name = section.settings[name_key] %}
            {% assign color_code = section.settings[code_key] %}
            {% assign color_img = '' %}

            {% if section.settings[image_key] != blank %}
              {% assign color_img = section.settings[image_key] | img_url: '1200x' %}
            {% elsif section.settings[url_key] != blank %}
              {% assign color_img = section.settings[url_key] %}
            {% else %}
              {% assign color_img = color1_img %}
            {% endif %}

            {% if color_name != blank %}
              <button
                type="button"
                class="colors__swatch{% if i == 1 %} colors__swatch--active{% endif %}"
                style="background: {{ color_code }};"
                data-color="{{ color_name | escape }}"
                data-img="{{ color_img }}"
                aria-label="{{ color_name }}"
              ></button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="colors__carousel">
          <button type="button" class="colors__carousel-arrow colors__carousel-arrow--left" aria-label="前へ">‹</button>

          <div class="colors__carousel-track">
            {% for i in (1..5) %}
              {% assign name_key = 'color' | append: i | append: '_name' %}
              {% assign image_key = 'color' | append: i | append: '_image' %}
              {% assign url_key = 'color' | append: i | append: '_image_url' %}
              {% assign thumb_key = 'color' | append: i | append: '_thumbnail' %}

              {% assign color_name = section.settings[name_key] %}
              {% assign thumb_img = '' %}

              {% if section.settings[thumb_key] != blank %}
                {% assign thumb_img = section.settings[thumb_key] | img_url: '400x' %}
              {% elsif section.settings[image_key] != blank %}
                {% assign thumb_img = section.settings[image_key] | img_url: '400x' %}
              {% elsif section.settings[url_key] != blank %}
                {% assign thumb_img = section.settings[url_key] %}
              {% else %}
                {% assign thumb_img = color1_img %}
              {% endif %}

              {% if color_name != blank %}
                <div
                  class="colors__carousel-item{% if i == 1 %} colors__carousel-item--active{% endif %}"
                  data-color="{{ color_name | escape }}"
                >
                  <img src="{{ thumb_img }}" alt="{{ color_name }}" loading="lazy">
                  <span>{{ color_name }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <button type="button" class="colors__carousel-arrow colors__carousel-arrow--right" aria-label="次へ">›</button>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#sizes-{{ section.id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.sizes__tab');
    const panels = section.querySelectorAll('.sizes__panel');

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const target = tab.getAttribute('data-tab');

        tabs.forEach(function(item) {
          item.classList.remove('sizes__tab--active');
        });

        panels.forEach(function(panel) {
          panel.classList.remove('sizes__panel--active');
        });

        tab.classList.add('sizes__tab--active');

        const activePanel = section.querySelector('[data-panel="' + target + '"]');
        if (activePanel) activePanel.classList.add('sizes__panel--active');
      });
    });

    const mainImg = section.querySelector('#colors-main-img-{{ section.id }}');
    const nameEl = section.querySelector('#colors-name-{{ section.id }}');
    const swatches = section.querySelectorAll('.colors__swatch');
    const items = section.querySelectorAll('.colors__carousel-item');
    const track = section.querySelector('.colors__carousel-track');
    const left = section.querySelector('.colors__carousel-arrow--left');
    const right = section.querySelector('.colors__carousel-arrow--right');

    function setActiveColor(colorName) {
      swatches.forEach(function(swatch) {
        const isActive = swatch.dataset.color === colorName;
        swatch.classList.toggle('colors__swatch--active', isActive);

        if (isActive && swatch.dataset.img && mainImg) {
          mainImg.src = swatch.dataset.img;
          mainImg.alt = colorName;
        }
      });

      items.forEach(function(item) {
        item.classList.toggle('colors__carousel-item--active', item.dataset.color === colorName);
      });

      if (nameEl) nameEl.textContent = colorName;
    }

    swatches.forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        setActiveColor(swatch.dataset.color);
      });
    });

    items.forEach(function(item) {
      item.addEventListener('click', function() {
        setActiveColor(item.dataset.color);
      });
    });

    if (left && track) {
      left.addEventListener('click', function() {
        track.scrollBy({ left: -120, behavior: 'smooth' });
      });
    }

    if (right && track) {
      right.addEventListener('click', function() {
        track.scrollBy({ left: 120, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "MUSUBI サイズ・カラー",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "サイズラベル",
      "default": "SIZE GUIDE"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "サイズ見出し",
      "default": "<p>あなたに合うサイズは？</p>"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "サイズリード文",
      "default": "<p>使う場所や過ごし方に合わせて、MUSUBIは2つのサイズからお選びいただけます。</p>"
    },
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "サイズ表画像"
    },
    {
      "type": "text",
      "id": "size_chart_image_url",
      "label": "サイズ表画像URL"
    },
    {
      "type": "text",
      "id": "size_chart_alt",
      "label": "サイズ表alt",
      "default": "MUSUBI サイズ表"
    },
    {
      "type": "range",
      "id": "size_chart_width_pc",
      "label": "サイズ表 横幅 PC",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "size_chart_width_sp",
      "label": "サイズ表 横幅 SP",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "size_chart_radius_pc",
      "label": "サイズ表 角丸 PC",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "size_chart_radius_sp",
      "label": "サイズ表 角丸 SP",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 14
    },
    {
      "type": "image_picker",
      "id": "compare_image",
      "label": "サイズ比較画像"
    },
    {
      "type": "text",
      "id": "compare_image_url",
      "label": "サイズ比較画像URL"
    },
    {
      "type": "text",
      "id": "compare_alt",
      "label": "サイズ比較画像alt",
      "default": "MUSUBIサイズ比較"
    }
  ],
  "blocks": [
    {
      "type": "size_panel",
      "name": "サイズパネル",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "タブラベル",
          "default": "Nap Size (M)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI サイズ・カラー"
    }
  ]
}
{% endschema %}