<section class="sizes" id="sizes">
  <div class="container">
    <h2 class="section-title" data-reveal>{{ section.settings.heading | default: 'あなたに合うサイズは？' }}</h2>

    {% if section.settings.lead != blank %}
      <div class="sizes__lead">
        {{ section.settings.lead }}
      </div>
    {% endif %}

    {% if section.settings.size_chart_image != blank %}
      <div class="sizes__chart">
        <img
          src="{{ section.settings.size_chart_image | img_url: '1400x' }}"
          alt="{{ section.settings.size_chart_alt }}"
          loading="lazy"
        >
      </div>

    {% elsif section.settings.size_chart_image_url != blank %}

      <div class="sizes__chart">
        <img
          src="{{ section.settings.size_chart_image_url }}"
          alt="{{ section.settings.size_chart_alt }}"
          loading="lazy"
        >
      </div>

    {% endif %}

    <!-- タブUI -->
    <div class="sizes__tabs" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          <button class="sizes__tab{% if forloop.first %} sizes__tab--active{% endif %}" data-tab="size-{{ forloop.index }}" id="tab-size-{{ forloop.index }}">
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- パネル -->
    {% for block in section.blocks %}
      {% if block.type == 'size_panel' %}
        <div class="sizes__panel{% if forloop.first %} sizes__panel--active{% endif %}" id="panel-size-{{ forloop.index }}" data-reveal {{ block.shopify_attributes }}>
          <div class="sizes__panel-img">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.name }}" loading="lazy">
            {% elsif block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name }}" loading="lazy">
            {% endif %}
          </div>

          <div class="sizes__panel-content">
            <div class="sizes__panel-badge{% if block.settings.featured %} sizes__panel-badge--featured{% endif %}">
              {{ block.settings.badge }}
            </div>

            <h3 class="sizes__panel-name">
              {{ block.settings.name }}
            </h3>

            <p class="sizes__panel-price">
              {{ block.settings.price }}
              <span>{{ block.settings.price_note }}</span>
            </p>

            <p class="sizes__panel-dim">
              {{ block.settings.dimensions }}
            </p>

            <ul class="sizes__panel-features">
              {% assign features = block.settings.features | split: ',' %}
              {% for feature in features %}
                <li>{{ feature | strip }}</li>
              {% endfor %}
            </ul>

            <p class="sizes__panel-note">
              {{ block.settings.note }}
            </p>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <!-- 比較画像 -->
    {% if section.settings.compare_image != blank %}
      <div class="sizes__compare" data-reveal>
        <img src="{{ section.settings.compare_image | img_url: '1000x' }}" alt="サイズ比較" loading="lazy">
      </div>
    {% else %}
      <div class="sizes__compare" data-reveal>
        <img src="https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_0250.jpg?v=1771395913&width=1000" alt="M/Lサイズ比較" loading="lazy">
      </div>
    {% endif %}
  </div>
</section>

<style>
  .sizes__chart {
    margin: 26px auto 0;
    width: 100%;
    text-align: center;
  }

  .sizes__chart img {
    width: {{ section.settings.size_chart_width_pc }}%;
    max-width: 100%;
    height: auto;
    display: inline-block;
    border-radius: {{ section.settings.size_chart_radius_pc }}px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }

  @media (max-width: 768px) {
    .sizes__chart {
      margin-top: 20px;
    }

    .sizes__chart img {
      width: {{ section.settings.size_chart_width_sp }}%;
      border-radius: {{ section.settings.size_chart_radius_sp }}px;
    }
  }
</style>

{% schema %}
{
  "name": "MUSUBI サイズ選び",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "あなたに合うサイズは？"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "サイズ表画像"
    },
    {
      "type": "text",
      "id": "size_chart_image_url",
      "label": "サイズ表画像URL"
    },
    {
      "type": "text",
      "id": "size_chart_alt",
      "label": "サイズ表alt",
      "default": "MUSUBI サイズ表"
    },
    {
      "type": "range",
      "id": "size_chart_width_pc",
      "label": "サイズ表 横幅 PC",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "size_chart_width_sp",
      "label": "サイズ表 横幅 SP",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "size_chart_radius_pc",
      "label": "サイズ表 角丸 PC",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "size_chart_radius_sp",
      "label": "サイズ表 角丸 SP",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 14
    },
    {
      "type": "image_picker",
      "id": "compare_image",
      "label": "比較画像"
    }
  ],

  "blocks": [
    {
      "type": "size_panel",
      "name": "サイズパネル",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "タブラベル",
          "default": "Nap Size (M)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "画像URL（image_pickerが空の場合に使用）"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "バッジテキスト",
          "default": "ソファにおすすめ"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "強調バッジ",
          "default": false
        },
        {
          "type": "text",
          "id": "name",
          "label": "サイズ名",
          "default": "Nap Size (M)"
        },
        {
          "type": "text",
          "id": "price",
          "label": "価格",
          "default": "¥29,800"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "価格補足",
          "default": "(税込)"
        },
        {
          "type": "text",
          "id": "dimensions",
          "label": "サイズ",
          "default": "100 × 70 cm"
        },
        {
          "type": "text",
          "id": "features",
          "label": "特徴（カンマ区切り）",
          "default": "ソファ利用中心, 昼寝向き, 軽めが好みの方"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "補足テキスト",
          "default": "日本のソファの平均奥行き70cmに基づき設計。日中の束の間の休憩や仮眠に。"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "MUSUBI サイズ選び",
      "blocks": [
        {
          "type": "size_panel",
          "settings": {
            "tab_label": "Nap Size (M)",
            "badge": "ソファにおすすめ",
            "featured": false,
            "name": "Nap Size (M)",
            "price": "¥29,800",
            "price_note": "(税込)",
            "dimensions": "100 × 70 cm",
            "features": "ソファ利用中心, 昼寝向き, 軽めが好みの方",
            "note": "日本のソファの平均奥行き70cmに基づき設計。日中の束の間の休憩や仮眠に。"
          }
        },
        {
          "type": "size_panel",
          "settings": {
            "tab_label": "Sleep Size (L)",
            "badge": "ベッドにおすすめ",
            "featured": true,
            "name": "Sleep Size (L)",
            "price": "¥39,800",
            "price_note": "(税込)",
            "dimensions": "150 × 100 cm",
            "features": "ベッド利用, 重い布団が好き, 包まれたい方",
            "note": "1日の終わりに全身を包む安心感。ベッドに沈んでいくような快適さをお届けします。"
          }
        }
      ]
    }
  ]
}
{% endschema %}