{% comment %}
==============================
MUSUBI サイズ・カラーセクション
カラバリ表示修正版
==============================
{% endcomment %}

<section class="sizes-colors" id="sizes-colors">
  <div class="container">

    <!-- 見出し -->
    <div class="sizes-colors__header">
      <h2 class="section-title">
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.lead != blank %}
        <div class="sizes-colors__lead">
          {{ section.settings.lead }}
        </div>
      {% endif %}

      <!-- サイズ表 -->
      {% if section.settings.size_chart_image != blank %}
        <div class="sizes__chart">
          <img
            src="{{ section.settings.size_chart_image | img_url: '1400x' }}"
            alt="{{ section.settings.size_chart_alt }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>

    <!-- サイズタブ -->
    <div class="sizes__tabs">
      {% assign size_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          {% assign size_index = size_index | plus: 1 %}

          <button
            class="sizes__tab{% if size_index == 1 %} sizes__tab--active{% endif %}"
            data-tab="size-{{ size_index }}"
          >
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <!-- サイズパネル -->
    {% assign panel_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'size_panel' %}
        {% assign panel_index = panel_index | plus: 1 %}

        <div
          class="sizes__panel{% if panel_index == 1 %} sizes__panel--active{% endif %}"
          id="size-{{ panel_index }}"
          {{ block.shopify_attributes }}
        >

          <div class="sizes__panel-img">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | img_url: '1200x' }}"
                alt="{{ block.settings.name }}"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="sizes__panel-content">

            <div class="sizes__panel-badge{% if block.settings.featured %} sizes__panel-badge--featured{% endif %}">
              {{ block.settings.badge }}
            </div>

            <h3 class="sizes__panel-name">
              {{ block.settings.name }}
            </h3>

            <p class="sizes__panel-price">
              {{ block.settings.price }}
              <span>{{ block.settings.price_note }}</span>
            </p>

            <p class="sizes__panel-dim">
              {{ block.settings.dimensions }}
            </p>

            <ul class="sizes__panel-features">
              {% assign features = block.settings.features | split: ',' %}
              {% for feature in features %}
                <li>{{ feature | strip }}</li>
              {% endfor %}
            </ul>

            <p class="sizes__panel-note">
              {{ block.settings.note }}
            </p>

          </div>
        </div>
      {% endif %}
    {% endfor %}

    <!-- カラーバリエーション -->
    <div class="colors">

      <div class="colors__header">
        <h2 class="section-title">
          {{ section.settings.colors_heading }}
        </h2>
      </div>

      {% assign first_color = section.blocks | where: "type", "color_variant" | first %}

      {% if first_color %}

        <div class="colors__showcase">
          <img
            id="colors-main-img"
            src="{{ first_color.settings.image | img_url: '1400x' }}"
            alt="{{ first_color.settings.name }}"
            loading="lazy"
          >
        </div>

        <p class="colors__name" id="colors-name">
          {{ first_color.settings.name }}
        </p>

        <!-- スウォッチ -->
        <div class="colors__swatches">

          {% for block in section.blocks %}
            {% if block.type == 'color_variant' %}

              <button
                class="colors__swatch{% if forloop.first %} colors__swatch--active{% endif %}"
                style="background: {{ block.settings.color_code }};"
                data-name="{{ block.settings.name }}"
                data-image="{{ block.settings.image | img_url: '1400x' }}"
                type="button"
                {{ block.shopify_attributes }}
              ></button>

            {% endif %}
          {% endfor %}

        </div>

        <!-- サムネ -->
        <div class="colors__carousel-track">

          {% for block in section.blocks %}
            {% if block.type == 'color_variant' %}

              <div
                class="colors__carousel-item{% if forloop.first %} colors__carousel-item--active{% endif %}"
                data-name="{{ block.settings.name }}"
                data-image="{{ block.settings.image | img_url: '1400x' }}"
              >

                <img
                  src="{{ block.settings.image | img_url: '400x' }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                >

                <span>{{ block.settings.name }}</span>

              </div>

            {% endif %}
          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>
</section>

<style>
  .sizes-colors {
    padding: 80px 20px;
    background: #faf7f2;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .sizes-colors__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .sizes-colors__lead {
    margin-top: 14px;
    color: #666;
    line-height: 1.8;
  }

  .sizes__chart {
    margin-top: 28px;
  }

  .sizes__chart img {
    width: {{ section.settings.size_chart_width_pc }}%;
    max-width: 100%;
    border-radius: 18px;
    display: block;
    margin: 0 auto;
  }

  .sizes__tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .sizes__tab {
    border: none;
    background: #ece6dc;
    padding: 12px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-weight: 700;
  }

  .sizes__tab--active {
    background: #1f2a44;
    color: #fff;
  }

  .sizes__panel {
    display: none;
    grid-template-columns: 1fr 1fr;
    background: #fff;
    border-radius: 26px;
    overflow: hidden;
    margin-bottom: 50px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  }

  .sizes__panel--active {
    display: grid;
  }

  .sizes__panel-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sizes__panel-content {
    padding: 42px;
  }

  .sizes__panel-badge {
    display: inline-block;
    background: #f3eee7;
    padding: 8px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 700;
  }

  .sizes__panel-badge--featured {
    background: #1f2a44;
    color: #fff;
  }

  .sizes__panel-name {
    font-size: 32px;
    margin-bottom: 14px;
  }

  .sizes__panel-price {
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .sizes__panel-price span {
    font-size: 14px;
    color: #777;
  }

  .sizes__panel-dim {
    margin-bottom: 18px;
    color: #555;
  }

  .sizes__panel-features {
    padding-left: 18px;
    margin-bottom: 18px;
  }

  .sizes__panel-features li {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .colors {
    margin-top: 70px;
  }

  .colors__header {
    text-align: center;
    margin-bottom: 30px;
  }

  .colors__showcase {
    max-width: 760px;
    margin: 0 auto 18px;
    border-radius: 24px;
    overflow: hidden;
  }

  .colors__showcase img {
    width: 100%;
    display: block;
  }

  .colors__name {
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .colors__swatches {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .colors__swatch {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid #fff;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0,0,0,0.15);
  }

  .colors__swatch--active {
    outline: 2px solid #1f2a44;
  }

  .colors__carousel-track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 6px;
  }

  .colors__carousel-item {
    min-width: 100px;
    border-radius: 16px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    background: #fff;
  }

  .colors__carousel-item--active {
    border-color: #1f2a44;
  }

  .colors__carousel-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .colors__carousel-item span {
    display: block;
    text-align: center;
    padding: 8px;
    font-size: 12px;
  }

  @media (max-width: 768px) {

    .sizes-colors {
      padding: 60px 16px;
    }

    .sizes__chart img {
      width: {{ section.settings.size_chart_width_sp }}%;
    }

    .sizes__panel {
      grid-template-columns: 1fr;
    }

    .sizes__panel-content {
      padding: 28px 22px;
    }

    .sizes__panel-name {
      font-size: 26px;
    }

    .colors__carousel-item {
      min-width: 80px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    // サイズタブ
    const tabs = document.querySelectorAll('.sizes__tab');
    const panels = document.querySelectorAll('.sizes__panel');

    tabs.forEach((tab, index) => {

      tab.addEventListener('click', function () {

        tabs.forEach(t => t.classList.remove('sizes__tab--active'));
        panels.forEach(p => p.classList.remove('sizes__panel--active'));

        tab.classList.add('sizes__tab--active');
        panels[index].classList.add('sizes__panel--active');

      });

    });

    // カラー切替
    const swatches = document.querySelectorAll('.colors__swatch');
    const items = document.querySelectorAll('.colors__carousel-item');

    const mainImg = document.getElementById('colors-main-img');
    const nameEl = document.getElementById('colors-name');

    function changeColor(name, image) {

      mainImg.src = image;
      mainImg.alt = name;

      nameEl.textContent = name;

      swatches.forEach(s => {
        s.classList.remove('colors__swatch--active');

        if (s.dataset.name === name) {
          s.classList.add('colors__swatch--active');
        }
      });

      items.forEach(i => {
        i.classList.remove('colors__carousel-item--active');

        if (i.dataset.name === name) {
          i.classList.add('colors__carousel-item--active');
        }
      });
    }

    swatches.forEach(swatch => {

      swatch.addEventListener('click', function () {

        changeColor(
          swatch.dataset.name,
          swatch.dataset.image
        );

      });

    });

    items.forEach(item => {

      item.addEventListener('click', function () {

        changeColor(
          item.dataset.name,
          item.dataset.image
        );

      });

    });

  });
</script>

{% schema %}
{
  "name": "MUSUBI サイズ・カラー",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "あなたに合うサイズは？"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "image_picker",
      "id": "size_chart_image",
      "label": "サイズ表画像"
    },
    {
      "type": "text",
      "id": "size_chart_alt",
      "label": "サイズ表alt",
      "default": "MUSUBI サイズ表"
    },
    {
      "type": "range",
      "id": "size_chart_width_pc",
      "label": "サイズ表 横幅 PC",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "size_chart_width_sp",
      "label": "サイズ表 横幅 SP",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "colors_heading",
      "label": "カラー見出し",
      "default": "カラーバリエーション"
    }
  ],

  "blocks": [
    {
      "type": "size_panel",
      "name": "サイズパネル",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "タブラベル"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "バッジ"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "強調",
          "default": false
        },
        {
          "type": "text",
          "id": "name",
          "label": "サイズ名"
        },
        {
          "type": "text",
          "id": "price",
          "label": "価格"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "価格補足"
        },
        {
          "type": "text",
          "id": "dimensions",
          "label": "サイズ"
        },
        {
          "type": "text",
          "id": "features",
          "label": "特徴"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "補足"
        }
      ]
    },
    {
      "type": "color_variant",
      "name": "カラー",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "カラー名"
        },
        {
          "type": "text",
          "id": "color_code",
          "label": "カラーコード"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "画像"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "MUSUBI サイズ・カラー",
      "blocks": [
        {
          "type": "color_variant",
          "settings": {
            "name": "Powder Beige",
            "color_code": "#d9cfc4"
          }
        },
        {
          "type": "color_variant",
          "settings": {
            "name": "Dusty Navy",
            "color_code": "#3d4259"
          }
        },
        {
          "type": "color_variant",
          "settings": {
            "name": "Calm Brown",
            "color_code": "#8b6b50"
          }
        },
        {
          "type": "color_variant",
          "settings": {
            "name": "Cloud White",
            "color_code": "#e8e4de"
          }
        },
        {
          "type": "color_variant",
          "settings": {
            "name": "Blossom Peach",
            "color_code": "#d4a5a0"
          }
        }
      ]
    }
  ]
}
{% endschema %}