<div class="colors" id="colors">
  <div class="colors__box">
    <div class="colors__header">
      {% if section.settings.colors_label != blank %}
        <div class="colors__label">{{ section.settings.colors_label }}</div>
      {% endif %}

      <h2 class="colors__heading">{{ section.settings.colors_heading }}</h2>

      {% if section.settings.colors_lead != blank %}
        <div class="colors__lead">{{ section.settings.colors_lead }}</div>
      {% endif %}
    </div>

    {% assign first_color_image = '' %}
    {% assign first_color_name = '' %}
    {% assign color_count = 0 %}

    {% for block in section.blocks %}
      {% if block.type == 'color_variant' %}
        {% assign color_count = color_count | plus: 1 %}

        {% if color_count == 1 %}
          {% assign first_color_name = block.settings.name %}

          {% if block.settings.image != blank %}
            {% assign first_color_image = block.settings.image | img_url: '1200x' %}
          {% elsif block.settings.image_url != blank %}
            {% assign first_color_image = block.settings.image_url %}
          {% else %}
            {% assign first_color_image = 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1200' %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if color_count > 0 %}
      <div class="colors__showcase">
        <img
          id="colors-main-img-{{ section.id }}"
          src="{{ first_color_image }}"
          alt="{{ first_color_name }}"
          loading="lazy"
        >
      </div>

      <p class="colors__name" id="colors-name-{{ section.id }}">
        {{ first_color_name }}
      </p>

      <div class="colors__swatches">
        {% assign color_index = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'color_variant' %}
            {% assign color_index = color_index | plus: 1 %}

            {% assign color_img = '' %}
            {% if block.settings.image != blank %}
              {% assign color_img = block.settings.image | img_url: '1200x' %}
            {% elsif block.settings.image_url != blank %}
              {% assign color_img = block.settings.image_url %}
            {% else %}
              {% assign color_img = first_color_image %}
            {% endif %}

            <button
              type="button"
              class="colors__swatch{% if color_index == 1 %} colors__swatch--active{% endif %}"
              style="background: {{ block.settings.color_code }};"
              data-color="{{ block.settings.name | escape }}"
              data-img="{{ color_img }}"
              aria-label="{{ block.settings.name }}"
              {{ block.shopify_attributes }}
            ></button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="colors__carousel">
        <button type="button" class="colors__carousel-arrow colors__carousel-arrow--left" aria-label="前へ">
          ‹
        </button>

        <div class="colors__carousel-track">
          {% assign color_item_index = 0 %}

          {% for block in section.blocks %}
            {% if block.type == 'color_variant' %}
              {% assign color_item_index = color_item_index | plus: 1 %}

              {% assign thumb_img = '' %}
              {% if block.settings.thumbnail != blank %}
                {% assign thumb_img = block.settings.thumbnail | img_url: '400x' %}
              {% elsif block.settings.image != blank %}
                {% assign thumb_img = block.settings.image | img_url: '400x' %}
              {% elsif block.settings.image_url != blank %}
                {% assign thumb_img = block.settings.image_url %}
              {% else %}
                {% assign thumb_img = first_color_image %}
              {% endif %}

              <div
                class="colors__carousel-item{% if color_item_index == 1 %} colors__carousel-item--active{% endif %}"
                data-color="{{ block.settings.name | escape }}"
              >
                <img
                  src="{{ thumb_img }}"
                  alt="{{ block.settings.name }}"
                  loading="lazy"
                >
                <span>{{ block.settings.name }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <button type="button" class="colors__carousel-arrow colors__carousel-arrow--right" aria-label="次へ">
          ›
        </button>
      </div>
    {% endif %}
  </div>
</div>
