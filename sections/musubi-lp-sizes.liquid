<style>
  .sizes {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
  }

  .sizes__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .sizes__header,
  .colors__header {
    text-align: center;
    margin-bottom: 34px;
  }

  .sizes__label,
  .colors__label {
    display: inline-block;
    background: {{ section.settings.label_bg_color }};
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 8px 15px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .sizes__heading,
  .colors__heading {
    font-size: {{ section.settings.heading_size_pc }}px;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.04em;
    margin: 0 0 12px;
  }

  .sizes__heading p,
  .sizes__lead p,
  .colors__heading p,
  .colors__lead p {
    margin: 0;
  }

  .sizes__lead,
  .colors__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: {{ section.settings.lead_size_pc }}px;
    color: {{ section.settings.lead_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
  }

  .sizes__tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 26px;
    background: {{ section.settings.tabs_bg_color }};
    border-radius: 999px;
    padding: 6px;
    width: fit-content;
    max-width: 100%;
  }

  .sizes__tab {
    appearance: none;
    border: none;
    cursor: pointer;
    border-radius: 999px;
    padding: 12px 22px;
    background: transparent;
    color: {{ section.settings.tab_color }};
    font-size: {{ section.settings.tab_size_pc }}px;
    font-weight: 700;
    letter-spacing: 0.03em;
    transition: 0.25s ease;
    white-space: nowrap;
  }

  .sizes__tab--active {
    background: {{ section.settings.tab_active_bg_color }};
    color: {{ section.settings.tab_active_color }};
    box-shadow: 0 8px 22px rgba(0,0,0,0.08);
  }

  .sizes__panel {
    display: none;
    grid-template-columns: 1.08fr 0.92fr;
    background: {{ section.settings.panel_bg_color }};
    border: 1px solid {{ section.settings.panel_border_color }};
    border-radius: {{ section.settings.panel_radius }}px;
    overflow: hidden;
    box-shadow: 0 16px 44px rgba(0,0,0,0.07);
  }

  .sizes__panel--active {
    display: grid;
  }

  .sizes__panel-img {
    background: {{ section.settings.image_bg_color }};
    min-height: {{ section.settings.image_height_pc }}px;
    overflow: hidden;
  }

  .sizes__panel-img img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .sizes__panel-content {
    padding: 42px 38px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .sizes__panel-badge {
    display: inline-flex;
    width: fit-content;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_color }};
    font-size: {{ section.settings.badge_size_pc }}px;
    font-weight: 700;
    border-radius: 999px;
    padding: 7px 13px;
    margin-bottom: 16px;
  }

  .sizes__panel-badge--featured {
    background: {{ section.settings.featured_badge_bg_color }};
    color: {{ section.settings.featured_badge_color }};
  }

  .sizes__panel-name {
    font-size: {{ section.settings.name_size_pc }}px;
    color: {{ section.settings.name_color }};
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0.03em;
    margin: 0 0 12px;
  }

  .sizes__panel-price {
    font-size: {{ section.settings.price_size_pc }}px;
    color: {{ section.settings.price_color }};
    font-weight: 800;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  .sizes__panel-price span {
    font-size: 0.5em;
    font-weight: 600;
    color: {{ section.settings.price_note_color }};
  }

  .sizes__panel-dim {
    display: inline-flex;
    width: fit-content;
    background: {{ section.settings.dim_bg_color }};
    color: {{ section.settings.dim_color }};
    font-size: {{ section.settings.dim_size_pc }}px;
    font-weight: 700;
    border-radius: 12px;
    padding: 9px 13px;
    margin: 0 0 18px;
  }

  .sizes__panel-features {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: grid;
    gap: 8px;
  }

  .sizes__panel-features li {
    position: relative;
    padding-left: 1.4em;
    font-size: {{ section.settings.feature_size_pc }}px;
    color: {{ section.settings.feature_color }};
    line-height: 1.7;
    letter-spacing: 0.03em;
    font-weight: 600;
  }

  .sizes__panel-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: {{ section.settings.check_color }};
    font-weight: 800;
  }

  .sizes__panel-note {
    font-size: {{ section.settings.note_size_pc }}px;
    color: {{ section.settings.note_color }};
    line-height: 1.8;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .sizes__compare {
    margin: 34px auto 0;
    border-radius: {{ section.settings.compare_radius }}px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
    background: #fff;
  }

  .sizes__compare img {
    width: 100%;
    display: block;
    height: auto;
  }

  .colors {
    margin-top: {{ section.settings.colors_margin_pc }}px;
  }

  .colors__box {
    background: {{ section.settings.colors_box_bg_color }};
    border: 1px solid {{ section.settings.colors_box_border_color }};
    border-radius: {{ section.settings.colors_box_radius }}px;
    padding: 44px 38px;
    box-shadow: 0 16px 44px rgba(0,0,0,0.06);
  }

  .colors__showcase {
    max-width: {{ section.settings.colors_image_width }}px;
    margin: 0 auto 18px;
    border-radius: {{ section.settings.colors_image_radius }}px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 14px 36px rgba(0,0,0,0.08);
  }

  .colors__showcase img {
    width: 100%;
    height: auto;
    display: block;
  }

  .colors__name {
    text-align: center;
    font-size: {{ section.settings.color_name_size_pc }}px;
    color: {{ section.settings.color_name_color }};
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0 0 22px;
  }

  .colors__swatches {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }

  .colors__swatch {
    width: {{ section.settings.swatch_size_pc }}px;
    height: {{ section.settings.swatch_size_pc }}px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    cursor: pointer;
    transition: 0.25s ease;
    box-shadow: 0 4px 14px rgba(0,0,0,0.12);
  }

  .colors__swatch:hover {
    transform: translateY(-2px) scale(1.06);
  }

  .colors__swatch--active {
    outline: 2px solid {{ section.settings.swatch_active_color }};
    outline-offset: 3px;
  }

  .colors__carousel {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .colors__carousel-arrow {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.arrow_border_color }};
    background: {{ section.settings.arrow_bg_color }};
    color: {{ section.settings.arrow_color }};
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
    transition: 0.25s ease;
  }

  .colors__carousel-arrow:hover {
    transform: translateY(-2px);
  }

  .colors__carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    flex: 1;
    padding: 4px 2px;
  }

  .colors__carousel-track::-webkit-scrollbar {
    display: none;
  }

  .colors__carousel-item {
    flex: 0 0 auto;
    width: {{ section.settings.thumbnail_width_pc }}px;
    cursor: pointer;
    scroll-snap-align: start;
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid transparent;
    background: #fff;
    transition: 0.25s ease;
  }

  .colors__carousel-item--active {
    border-color: {{ section.settings.swatch_active_color }};
    box-shadow: 0 8px 22px rgba(0,0,0,0.10);
  }

  .colors__carousel-item img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .colors__carousel-item span {
    display: block;
    font-size: {{ section.settings.thumbnail_text_size_pc }}px;
    color: {{ section.settings.thumbnail_text_color }};
    padding: 8px 5px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .sizes {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .sizes__header,
    .colors__header {
      margin-bottom: 26px;
    }

    .sizes__label,
    .colors__label {
      font-size: {{ section.settings.label_size_sp }}px;
    }

    .sizes__heading,
    .colors__heading {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .sizes__lead,
    .colors__lead {
      font-size: {{ section.settings.lead_size_sp }}px;
    }

    .sizes__tabs {
      width: 100%;
      overflow-x: auto;
      justify-content: flex-start;
      border-radius: 18px;
    }

    .sizes__tab {
      font-size: {{ section.settings.tab_size_sp }}px;
      padding: 11px 16px;
      flex: 1 0 auto;
    }

    .sizes__panel,
    .sizes__panel--active {
      grid-template-columns: 1fr;
      border-radius: {{ section.settings.panel_radius_sp }}px;
    }

    .sizes__panel-img {
      min-height: {{ section.settings.image_height_sp }}px;
    }

    .sizes__panel-content {
      padding: 28px 20px;
    }

    .sizes__panel-badge {
      font-size: {{ section.settings.badge_size_sp }}px;
    }

    .sizes__panel-name {
      font-size: {{ section.settings.name_size_sp }}px;
    }

    .sizes__panel-price {
      font-size: {{ section.settings.price_size_sp }}px;
    }

    .sizes__panel-dim {
      font-size: {{ section.settings.dim_size_sp }}px;
    }

    .sizes__panel-features li {
      font-size: {{ section.settings.feature_size_sp }}px;
    }

    .sizes__panel-note {
      font-size: {{ section.settings.note_size_sp }}px;
    }

    .sizes__compare {
      margin-top: 24px;
      border-radius: {{ section.settings.compare_radius_sp }}px;
    }

    .colors {
      margin-top: {{ section.settings.colors_margin_sp }}px;
    }

    .colors__box {
      padding: 32px 16px;
      border-radius: {{ section.settings.colors_box_radius_sp }}px;
    }

    .colors__showcase {
      border-radius: {{ section.settings.colors_image_radius_sp }}px;
    }

    .colors__name {
      font-size: {{ section.settings.color_name_size_sp }}px;
    }

    .colors__swatch {
      width: {{ section.settings.swatch_size_sp }}px;
      height: {{ section.settings.swatch_size_sp }}px;
    }

    .colors__carousel-arrow {
      width: 34px;
      height: 34px;
      font-size: 22px;
    }

    .colors__carousel-track {
      gap: 10px;
    }

    .colors__carousel-item {
      width: {{ section.settings.thumbnail_width_sp }}px;
    }

    .colors__carousel-item span {
      font-size: {{ section.settings.thumbnail_text_size_sp }}px;
    }
  }
</style>

<section class="sizes" id="sizes">
  <div class="sizes__inner">

    <div class="sizes__header">
      {% if section.settings.label != blank %}
        <div class="sizes__label">{{ section.settings.label }}</div>
      {% endif %}

      <h2 class="sizes__heading">{{ section.settings.heading }}</h2>

      {% if section.settings.lead != blank %}
        <div class="sizes__lead">{{ section.settings.lead }}</div>
      {% endif %}
    </div>

    <div class="sizes__tabs">
      {% assign tab_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          {% assign tab_index = tab_index | plus: 1 %}
          <button
            type="button"
            class="sizes__tab{% if tab_index == 1 %} sizes__tab--active{% endif %}"
            data-tab="size-{{ tab_index }}"
          >
            {{ block.settings.tab_label }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="sizes__panels">
      {% assign panel_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'size_panel' %}
          {% assign panel_index = panel_index | plus: 1 %}

          <div
            class="sizes__panel{% if panel_index == 1 %} sizes__panel--active{% endif %}"
            data-panel="size-{{ panel_index }}"
            {{ block.shopify_attributes }}
          >
            <div class="sizes__panel-img">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '1200x' }}" alt="{{ block.settings.name }}" loading="lazy">
              {% elsif block.settings.image_url != blank %}
                <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name }}" loading="lazy">
              {% endif %}
            </div>

            <div class="sizes__panel-content">
              {% if block.settings.badge != blank %}
                <div class="sizes__panel-badge{% if block.settings.featured %} sizes__panel-badge--featured{% endif %}">
                  {{ block.settings.badge }}
                </div>
              {% endif %}

              <h3 class="sizes__panel-name">{{ block.settings.name }}</h3>

              <p class="sizes__panel-price">
                {{ block.settings.price }}
                <span>{{ block.settings.price_note }}</span>
              </p>

              <p class="sizes__panel-dim">{{ block.settings.dimensions }}</p>

              <ul class="sizes__panel-features">
                {% assign features = block.settings.features | split: ',' %}
                {% for feature in features %}
                  {% if feature != blank %}
                    <li>{{ feature | strip }}</li>
                  {% endif %}
                {% endfor %}
              </ul>

              {% if block.settings.note != blank %}
                <p class="sizes__panel-note">{{ block.settings.note }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.compare_image != blank %}
      <div class="sizes__compare">
        <img src="{{ section.settings.compare_image | img_url: '1400x' }}" alt="{{ section.settings.compare_alt }}" loading="lazy">
      </div>
    {% elsif section.settings.compare_image_url != blank %}
      <div class="sizes__compare">
        <img src="{{ section.settings.compare_image_url }}" alt="{{ section.settings.compare_alt }}" loading="lazy">
      </div>
    {% endif %}

    <div class="colors" id="colors">
      <div class="colors__box">
        <div class="colors__header">
          {% if section.settings.colors_label != blank %}
            <div class="colors__label">{{ section.settings.colors_label }}</div>
          {% endif %}

          <h2 class="colors__heading">{{ section.settings.colors_heading }}</h2>

          {% if section.settings.colors_lead != blank %}
            <div class="colors__lead">{{ section.settings.colors_lead }}</div>
          {% endif %}
        </div>

        {% assign first_color = nil %}
        {% for block in section.blocks %}
          {% if block.type == 'color_variant' and first_color == nil %}
            {% assign first_color = block %}
          {% endif %}
        {% endfor %}

        {% if first_color != nil %}
          <div class="colors__showcase">
            <img
              id="colors-main-img-{{ section.id }}"
              src="{% if first_color.settings.image != blank %}{{ first_color.settings.image | img_url: '1200x' }}{% elsif first_color.settings.image_url != blank %}{{ first_color.settings.image_url }}{% else %}https://cdn.shopify.com/s/files/1/0407/6027/9202/files/250423_MUSUBI_1005.jpg?v=1771395913&width=1200{% endif %}"
              alt="{{ first_color.settings.name }}"
              loading="lazy"
            >
          </div>

          <p class="colors__name" id="colors-name-{{ section.id }}">
            {{ first_color.settings.name }}
          </p>
        {% endif %}

        <div class="colors__swatches">
          {% assign color_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'color_variant' %}
              {% assign color_index = color_index | plus: 1 %}
              <button
                type="button"
                class="colors__swatch{% if color_index == 1 %} colors__swatch--active{% endif %}"
                style="background: {{ block.settings.color_code }};"
                data-color="{{ block.settings.name | escape }}"
                data-img="{% if block.settings.image != blank %}{{ block.settings.image | img_url: '1200x' }}{% elsif block.settings.image_url != blank %}{{ block.settings.image_url }}{% endif %}"
                aria-label="{{ block.settings.name }}"
                {{ block.shopify_attributes }}
              ></button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="colors__carousel">
          <button type="button" class="colors__carousel-arrow colors__carousel-arrow--left" aria-label="前へ">‹</button>

          <div class="colors__carousel-track">
            {% assign color_item_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'color_variant' %}
                {% assign color_item_index = color_item_index | plus: 1 %}
                <div
                  class="colors__carousel-item{% if color_item_index == 1 %} colors__carousel-item--active{% endif %}"
                  data-color="{{ block.settings.name | escape }}"
                >
                  <img
                    src="{% if block.settings.thumbnail != blank %}{{ block.settings.thumbnail | img_url: '400x' }}{% elsif block.settings.image != blank %}{{ block.settings.image | img_url: '400x' }}{% elsif block.settings.image_url != blank %}{{ block.settings.image_url }}{% endif %}"
                    alt="{{ block.settings.name }}"
                    loading="lazy"
                  >
                  <span>{{ block.settings.name }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <button type="button" class="colors__carousel-arrow colors__carousel-arrow--right" aria-label="次へ">›</button>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.sizes').forEach(function(section) {
      const tabs = section.querySelectorAll('.sizes__tab');
      const panels = section.querySelectorAll('.sizes__panel');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          const target = tab.getAttribute('data-tab');

          tabs.forEach(function(item) {
            item.classList.remove('sizes__tab--active');
          });

          panels.forEach(function(panel) {
            panel.classList.remove('sizes__panel--active');
          });

          tab.classList.add('sizes__tab--active');

          const activePanel = section.querySelector('[data-panel="' + target + '"]');
          if (activePanel) {
            activePanel.classList.add('sizes__panel--active');
          }
        });
      });

      const mainImg = section.querySelector('#colors-main-img-{{ section.id }}');
      const nameEl = section.querySelector('#colors-name-{{ section.id }}');
      const swatches = section.querySelectorAll('.colors__swatch');
      const items = section.querySelectorAll('.colors__carousel-item');
      const track = section.querySelector('.colors__carousel-track');
      const left = section.querySelector('.colors__carousel-arrow--left');
      const right = section.querySelector('.colors__carousel-arrow--right');

      function setActiveColor(colorName) {
        swatches.forEach(function(swatch) {
          const isActive = swatch.dataset.color === colorName;
          swatch.classList.toggle('colors__swatch--active', isActive);

          if (isActive && swatch.dataset.img && mainImg) {
            mainImg.src = swatch.dataset.img;
            mainImg.alt = colorName;
          }
        });

        items.forEach(function(item) {
          item.classList.toggle('colors__carousel-item--active', item.dataset.color === colorName);
        });

        if (nameEl) {
          nameEl.textContent = colorName;
        }
      }

      swatches.forEach(function(swatch) {
        swatch.addEventListener('click', function() {
          setActiveColor(swatch.dataset.color);
        });
      });

      items.forEach(function(item) {
        item.addEventListener('click', function() {
          setActiveColor(item.dataset.color);
        });
      });

      if (left && track) {
        left.addEventListener('click', function() {
          track.scrollBy({ left: -120, behavior: 'smooth' });
        });
      }

      if (right && track) {
        right.addEventListener('click', function() {
          track.scrollBy({ left: 120, behavior: 'smooth' });
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "MUSUBI サイズ・カラー",
  "settings": [
    { "type": "header", "content": "サイズ：テキスト" },
    { "type": "text", "id": "label", "label": "ラベル", "default": "SIZE GUIDE" },
    { "type": "richtext", "id": "heading", "label": "見出し", "default": "<p>あなたに合うサイズは？</p>" },
    { "type": "richtext", "id": "lead", "label": "リード文", "default": "<p>使う場所や過ごし方に合わせて、MUSUBIは2つのサイズからお選びいただけます。</p>" },
    { "type": "image_picker", "id": "compare_image", "label": "比較画像" },
    { "type": "text", "id": "compare_image_url", "label": "比較画像URL" },
    { "type": "text", "id": "compare_alt", "label": "比較画像alt", "default": "MUSUBIサイズ比較" },

    { "type": "header", "content": "カラー：テキスト" },
    { "type": "text", "id": "colors_label", "label": "カラーラベル", "default": "COLOR VARIATION" },
    { "type": "richtext", "id": "colors_heading", "label": "カラー見出し", "default": "<p>暮らしに馴染む<br>カラーバリエーション</p>" },
    { "type": "richtext", "id": "colors_lead", "label": "カラーリード文", "default": "<p>寝室にもリビングにも馴染む、落ち着いたカラーをご用意しました。</p>" },

    { "type": "header", "content": "文字サイズ・カラー" },
    { "type": "range", "id": "label_size_pc", "label": "ラベルサイズ（PC）", "min": 10, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "label_size_sp", "label": "ラベルサイズ（SP）", "min": 10, "max": 20, "step": 1, "default": 11 },
    { "type": "color", "id": "label_color", "label": "ラベル文字カラー", "default": "#8B7355" },
