<section class="empathy" id="empathy">
  <div class="container--narrow">
    <h2 class="empathy__title" data-reveal>{{ section.settings.heading | default: 'こんな夜、ありませんか？' }}</h2>
    <div class="empathy__list" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'worry_item' %}
          <li class="empathy__item" data-reveal {{ block.shopify_attributes }}>
            <div class="empathy__icon">
              {{ block.settings.icon_svg }}
            </div>
            <p>{{ block.settings.text }}</p>
          </li>
        {% endif %}
      {% endfor %}
    </div>
    <div class="empathy__arrow" data-reveal>↓</div>
    <div class="empathy__solution" data-reveal>
      <div class="empathy__solution-img">
        {% if section.settings.solution_image != blank %}
          <img src="{{ section.settings.solution_image | img_url: '1200x' }}" alt="{{ section.settings.solution_image_alt }}" loading="lazy">
        {% else %}
          <img src="https://static.makuake.com/upload/project/41782/detail_41782_17212095920957.png" alt="毎日心から休めていますか" loading="lazy">
        {% endif %}
      </div>
      <p class="empathy__solution-text">{{ section.settings.solution_text | default: '包まれる感覚が、<br><strong>休息モードへ導く。</strong>' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 共感",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "こんな夜、ありませんか？"
    },
    {
      "type": "image_picker",
      "id": "solution_image",
      "label": "ソリューション画像"
    },
    {
      "type": "text",
      "id": "solution_image_alt",
      "label": "ソリューション画像alt",
      "default": "MUSUBIに包まれて休息"
    },
    {
      "type": "richtext",
      "id": "solution_text",
      "label": "ソリューションテキスト",
      "default": "<p>包まれる感覚が、<br><strong>休息モードへ導く。</strong></p>"
    }
  ],
  "blocks": [
    {
      "type": "worry_item",
      "name": "悩みアイテム",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "アイコンSVG"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "テキスト",
          "default": "<p>頭のなかが<br>ぐるぐる休まらない</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI 共感",
      "blocks": [
        { "type": "worry_item", "settings": { "text": "<p>頭のなかが<br>ぐるぐる休まらない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>波立つように<br>心が落ち着かない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>リラックスする<br>習慣が続かない</p>" } }
      ]
    }
  ]
}
{% endschema %}
