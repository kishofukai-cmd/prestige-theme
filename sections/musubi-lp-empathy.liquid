<style>
  .empathy {
    padding: 80px 20px;
    background: #faf9f7;
    text-align: center;
  }
  .container--narrow {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }
  .empathy__title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 40px;
    color: #1a1a1a;
    line-height: 1.5;
  }
  .empathy__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
  .empathy__item {
    background: #fff;
    border-radius: 12px;
    padding: 24px 16px;
    width: calc(33.333% - 14px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .empathy__item p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #333;
    margin: 0;
  }
  .empathy__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .empathy__icon svg {
    width: 100%;
    height: 100%;
  }
  .empathy__arrow {
    font-size: 2rem;
    color: #b8a78a;
    margin: 32px 0;
    animation: arrowBounce 1.5s ease-in-out infinite;
  }
  @keyframes arrowBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .empathy__solution {
    display: block;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
  }
  .empathy__solution-img {
    width: 100%;
    overflow: hidden;
  }
  .empathy__solution-img img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .empathy__solution-text {
    margin: 20px auto 0;
    max-width: 400px;
    width: 100%;
    padding: 20px 24px;
    font-size: 1.15rem;
    line-height: 1.8;
    color: #333;
    text-align: center;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .empathy__solution-text p {
    margin: 0;
  }
  .empathy__solution-text strong {
    color: #1a1a1a;
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .empathy {
      padding: 60px 16px;
    }
    .empathy__title {
      font-size: 1.3rem;
      margin-bottom: 28px;
    }
    .empathy__item {
      width: 100%;
      flex-direction: row;
      padding: 16px;
      text-align: left;
    }
    .empathy__icon {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }
    .empathy__solution {
      max-width: 100%;
      width: 100%;
      margin: 0 auto;
      border-radius: 12px;
    }
    .empathy__solution-text {
      font-size: 0.95rem;
      padding: 16px;
      max-width: 100%;
    }
  }
</style>

<section class="empathy" id="empathy">
  <div class="container--narrow">
    <h2 class="empathy__title" data-reveal>{{ section.settings.heading | default: 'こんな夜、ありませんか？' }}</h2>
    <ul class="empathy__list" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'worry_item' %}
          <li class="empathy__item" data-reveal {{ block.shopify_attributes }}>
            <div class="empathy__icon">
              {% if block.settings.icon_svg != blank %}
                {{ block.settings.icon_svg }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#8B7355" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="36" r="14" stroke-width="2.2"/><path d="M26 33c0 0-1-3 2-4s5 1 5 1"/><path d="M36 33c0 0 1-3-2-4s-5 1-5 1"/><line x1="29" y1="40" x2="35" y2="40" stroke-width="2"/><path d="M22 22c-2-4 0-8 4-9s6 2 6 2" stroke-width="1.8" opacity="0.7"/><path d="M32 15c1-4 5-6 8-4s3 6 1 8" stroke-width="1.8" opacity="0.7"/><path d="M41 19c3-1 6 1 6 4s-3 5-5 4" stroke-width="1.8" opacity="0.7"/><path d="M19 24c-3 0-5 3-4 6s4 3 5 2" stroke-width="1.8" opacity="0.7"/><circle cx="20" cy="18" r="1.5" fill="#8B7355" opacity="0.4"/><circle cx="42" cy="13" r="1" fill="#8B7355" opacity="0.4"/><circle cx="17" cy="28" r="1" fill="#8B7355" opacity="0.4"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#8B7355" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M32 52s-16-12-16-24c0-6 4-10 9-10 3 0 5 2 7 4 2-2 4-4 7-4 5 0 9 4 9 10 0 12-16 24-16 24z" stroke-width="2.2"/><path d="M24 30c2-2 4 0 6-2s2-3 4-1 2 3 4 1" stroke-width="1.8" opacity="0.6"/><path d="M22 36c2-2 3 0 5-2s3-2 5 0 2 2 4 0" stroke-width="1.8" opacity="0.6"/><path d="M10 28c2-1 3 1 5-1s3-2 4 0" stroke-width="1.5" opacity="0.3"/><path d="M45 28c2-1 3 1 5-1s3-2 4 0" stroke-width="1.5" opacity="0.3"/><path d="M12 34c2-1 3 1 4-1" stroke-width="1.5" opacity="0.3"/><path d="M48 34c2-1 3 1 4-1" stroke-width="1.5" opacity="0.3"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#8B7355" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="14" width="40" height="36" rx="4" stroke-width="2.2"/><line x1="12" y1="24" x2="52" y2="24" stroke-width="2"/><line x1="22" y1="14" x2="22" y2="18" stroke-width="2.5"/><line x1="42" y1="14" x2="42" y2="18" stroke-width="2.5"/><path d="M20 31l3 3 5-6" stroke-width="2" opacity="0.7"/><path d="M20 40l3 3 5-6" stroke-width="2" opacity="0.3" stroke-dasharray="2 2"/><line x1="36" y1="32" x2="46" y2="32" stroke-width="2" opacity="0.7"/><line x1="36" y1="41" x2="46" y2="41" stroke-width="2" opacity="0.3" stroke-dasharray="2 2"/><path d="M44 38l4 4m0-4l-4 4" stroke-width="2" opacity="0.5"/></svg>
                {% endcase %}
              {% endif %}
            </div>
            <p>{{ block.settings.text }}</p>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="empathy__arrow" data-reveal>↓</div>
    <div class="empathy__solution" data-reveal>
      <div class="empathy__solution-img">
        {% if section.settings.solution_image != blank %}
          <img src="{{ section.settings.solution_image | img_url: '1200x' }}" alt="{{ section.settings.solution_image_alt }}" loading="lazy">
        {% else %}
          <img src="https://static.makuake.com/upload/project/41782/detail_41782_17212095920957.png" alt="毎日心から休めていますか" loading="lazy">
        {% endif %}
      </div>
    </div>
    <div class="empathy__solution-text" data-reveal>
      {% if section.settings.solution_text != blank %}
        {{ section.settings.solution_text }}
      {% else %}
        <p>包まれる感覚が、<br><strong>休息モードへ導く。</strong></p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 共感",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "こんな夜、ありませんか？"
    },
    {
      "type": "image_picker",
      "id": "solution_image",
      "label": "ソリューション画像"
    },
    {
      "type": "text",
      "id": "solution_image_alt",
      "label": "ソリューション画像alt",
      "default": "MUSUBIに包まれて休息"
    },
    {
      "type": "richtext",
      "id": "solution_text",
      "label": "ソリューションテキスト",
      "default": "<p>包まれる感覚が、<br><strong>休息モードへ導く。</strong></p>"
    }
  ],
  "blocks": [
    {
      "type": "worry_item",
      "name": "悩みアイテム",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "アイコンSVG"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "テキスト",
          "default": "<p>頭のなかが<br>ぐるぐる休まらない</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI 共感",
      "blocks": [
        { "type": "worry_item", "settings": { "text": "<p>頭のなかが<br>ぐるぐる休まらない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>波立つように<br>心が落ち着かない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>リラックスする<br>習慣が続かない</p>" } }
      ]
    }
  ]
}
{% endschema %}
