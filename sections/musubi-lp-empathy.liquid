<style>
  .empathy {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    text-align: center;
  }

  .empathy__inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .empathy__label {
    display: inline-block;
    font-size: {{ section.settings.label_size_pc }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .empathy__title {
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    margin: 0 0 28px;
    color: {{ section.settings.heading_color }};
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .empathy__list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 760px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .empathy__item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 22px 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .empathy__item p {
    font-size: {{ section.settings.item_text_size_pc }}px;
    line-height: 1.7;
    color: {{ section.settings.item_text_color }};
    margin: 0;
    letter-spacing: 0.03em;
  }

  .empathy__icon {
    width: {{ section.settings.icon_size_pc }}px;
    height: {{ section.settings.icon_size_pc }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }

  .empathy__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  .empathy__arrow {
    font-size: {{ section.settings.arrow_size_pc }}px;
    color: {{ section.settings.arrow_color }};
    margin: 22px 0;
    line-height: 1;
    animation: arrowBounce 1.6s ease-in-out infinite;
  }

  @keyframes arrowBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .empathy__solution {
    background: #fff;
    border-radius: {{ section.settings.solution_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0,0,0,0.06);
    max-width: {{ section.settings.solution_width }}px;
    margin: 0 auto;
  }

  .empathy__solution-img {
    width: 100%;
    overflow: hidden;
  }

  .empathy__solution-img img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .empathy {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .empathy__label {
      font-size: {{ section.settings.label_size_sp }}px;
      margin-bottom: 10px;
    }

    .empathy__title {
      font-size: {{ section.settings.heading_size_sp }}px;
      margin-bottom: 22px;
    }

    .empathy__list {
      grid-template-columns: 1fr;
      gap: 10px;
      max-width: 100%;
    }

    .empathy__item {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      padding: 14px 16px;
      gap: 12px;
      border-radius: {{ section.settings.card_radius_sp }}px;
    }

    .empathy__icon {
      width: {{ section.settings.icon_size_sp }}px;
      height: {{ section.settings.icon_size_sp }}px;
      flex-shrink: 0;
    }

    .empathy__item p {
      font-size: {{ section.settings.item_text_size_sp }}px;
      line-height: 1.65;
    }

    .empathy__arrow {
      font-size: {{ section.settings.arrow_size_sp }}px;
      margin: 18px 0;
    }

    .empathy__solution {
      max-width: 100%;
      border-radius: {{ section.settings.solution_radius_sp }}px;
    }
  }
</style>

<section class="empathy" id="empathy">
  <div class="empathy__inner">

    {% if section.settings.label != blank %}
      <div class="empathy__label" data-reveal>
        {{ section.settings.label }}
      </div>
    {% endif %}

    <h2 class="empathy__title" data-reveal>
      {{ section.settings.heading }}
    </h2>

    <ul class="empathy__list" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'worry_item' %}
          <li class="empathy__item" data-reveal {{ block.shopify_attributes }}>
            <div class="empathy__icon">
              {% if block.settings.icon_svg != blank %}
                {{ block.settings.icon_svg }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="32" cy="36" r="14" stroke-width="2.2"/><path d="M26 33c0 0-1-3 2-4s5 1 5 1"/><path d="M36 33c0 0 1-3-2-4s-5 1-5 1"/><line x1="29" y1="40" x2="35" y2="40"/><path d="M22 22c-2-4 0-8 4-9s6 2 6 2" opacity="0.6"/><path d="M32 15c1-4 5-6 8-4s3 6 1 8" opacity="0.6"/></svg>
                  {% when 2 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M32 52s-16-12-16-24c0-6 4-10 9-10 3 0 5 2 7 4 2-2 4-4 7-4 5 0 9 4 9 10 0 12-16 24-16 24z" stroke-width="2.2"/><path d="M24 30c2-2 4 0 6-2s2-3 4-1 2 3 4 1" opacity="0.5"/><path d="M22 36c2-2 3 0 5-2s3-2 5 0 2 2 4 0" opacity="0.5"/></svg>
                  {% when 3 %}
                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="12" y="14" width="40" height="36" rx="4" stroke-width="2.2"/><line x1="12" y1="24" x2="52" y2="24"/><line x1="22" y1="14" x2="22" y2="18"/><line x1="42" y1="14" x2="42" y2="18"/><path d="M20 31l3 3 5-6" opacity="0.7"/><path d="M20 40l3 3 5-6" opacity="0.3" stroke-dasharray="2 2"/><line x1="36" y1="32" x2="46" y2="32" opacity="0.7"/><line x1="36" y1="41" x2="46" y2="41" opacity="0.3"/></svg>
                {% endcase %}
              {% endif %}
            </div>
            <div class="empathy__text">
              {{ block.settings.text }}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if section.settings.show_arrow %}
      <div class="empathy__arrow" data-reveal>↓</div>
    {% endif %}

    {% if section.settings.solution_image != blank %}
      <div class="empathy__solution" data-reveal>
        <div class="empathy__solution-img">
          <img src="{{ section.settings.solution_image | img_url: '1200x' }}" alt="{{ section.settings.solution_image_alt }}" loading="lazy">
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
