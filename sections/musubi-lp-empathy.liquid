<style>
  .empathy {
    padding: 80px 20px;
    background: #faf9f7;
    text-align: center;
  }
  .container--narrow {
    max-width: 720px;
    margin: 0 auto;
  }
  .empathy__title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 40px;
    color: #1a1a1a;
    line-height: 1.5;
  }
  .empathy__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }
  .empathy__item {
    background: #fff;
    border-radius: 12px;
    padding: 24px 16px;
    width: calc(33.333% - 14px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .empathy__item p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #333;
    margin: 0;
  }
  .empathy__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .empathy__icon svg {
    width: 100%;
    height: 100%;
  }
  .empathy__arrow {
    font-size: 2rem;
    color: #b8a78a;
    margin: 32px 0;
    animation: arrowBounce 1.5s ease-in-out infinite;
  }
  @keyframes arrowBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .empathy__solution {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }
  .empathy__solution-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .empathy__solution-text {
    padding: 24px 20px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #333;
    margin: 0;
  }
  .empathy__solution-text strong {
    color: #1a1a1a;
    font-size: 1.2rem;
  }

  @media (max-width: 768px) {
    .empathy {
      padding: 60px 16px;
    }
    .empathy__title {
      font-size: 1.3rem;
      margin-bottom: 28px;
    }
    .empathy__item {
      width: 100%;
      flex-direction: row;
      padding: 16px;
      text-align: left;
    }
    .empathy__icon {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }
    .empathy__solution-text {
      font-size: 1rem;
    }
  }
</style>

<section class="empathy" id="empathy">
  <div class="container--narrow">
    <h2 class="empathy__title" data-reveal>{{ section.settings.heading | default: 'こんな夜、ありませんか？' }}</h2>
    <ul class="empathy__list" data-reveal>
      {% for block in section.blocks %}
        {% if block.type == 'worry_item' %}
          <li class="empathy__item" data-reveal {{ block.shopify_attributes }}>
            <div class="empathy__icon">
              {{ block.settings.icon_svg }}
            </div>
            <p>{{ block.settings.text }}</p>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="empathy__arrow" data-reveal>↓</div>
    <div class="empathy__solution" data-reveal>
      <div class="empathy__solution-img">
        {% if section.settings.solution_image != blank %}
          <img src="{{ section.settings.solution_image | img_url: '1200x' }}" alt="{{ section.settings.solution_image_alt }}" loading="lazy">
        {% else %}
          <img src="https://static.makuake.com/upload/project/41782/detail_41782_17212095920957.png" alt="毎日心から休めていますか" loading="lazy">
        {% endif %}
      </div>
      <p class="empathy__solution-text">{{ section.settings.solution_text | default: '包まれる感覚が、<br><strong>休息モードへ導く。</strong>' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 共感",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "こんな夜、ありませんか？"
    },
    {
      "type": "image_picker",
      "id": "solution_image",
      "label": "ソリューション画像"
    },
    {
      "type": "text",
      "id": "solution_image_alt",
      "label": "ソリューション画像alt",
      "default": "MUSUBIに包まれて休息"
    },
    {
      "type": "richtext",
      "id": "solution_text",
      "label": "ソリューションテキスト",
      "default": "<p>包まれる感覚が、<br><strong>休息モードへ導く。</strong></p>"
    }
  ],
  "blocks": [
    {
      "type": "worry_item",
      "name": "悩みアイテム",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "アイコンSVG"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "テキスト",
          "default": "<p>頭のなかが<br>ぐるぐる休まらない</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI 共感",
      "blocks": [
        { "type": "worry_item", "settings": { "text": "<p>頭のなかが<br>ぐるぐる休まらない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>波立つように<br>心が落ち着かない</p>" } },
        { "type": "worry_item", "settings": { "text": "<p>リラックスする<br>習慣が続かない</p>" } }
      ]
    }
  ]
}
{% endschema %}
