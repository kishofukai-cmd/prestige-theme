<style>
  .empathy {
    padding: {{ section.settings.padding_pc }}px 20px;
    background: {{ section.settings.bg_color }};
    text-align: center;
  }

  .empathy__inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .empathy__label {
    display: inline-block;
    font-size: {{ section.settings.label_size_pc }}px;
    color: {{ section.settings.label_color }};
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .empathy__title {
    font-size: {{ section.settings.heading_size_pc }}px;
    font-weight: 700;
    margin: 0 0 20px;
    color: {{ section.settings.heading_color }};
    line-height: 1.5;
  }

  /* ★ここが今回の主役（見出し直下画像） */
  .empathy__solution {
    background: #fff;
    border-radius: {{ section.settings.solution_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgba(0,0,0,0.06);
    max-width: {{ section.settings.solution_width }}px;
    margin: 0 auto 28px;
  }

  .empathy__solution-img img {
    width: 100%;
    display: block;
  }

  .empathy__list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 760px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .empathy__item {
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 20px 14px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .empathy__item p {
    font-size: {{ section.settings.item_text_size_pc }}px;
    line-height: 1.7;
    color: {{ section.settings.item_text_color }};
    margin: 0;
  }

  .empathy__icon {
    width: {{ section.settings.icon_size_pc }}px;
    height: {{ section.settings.icon_size_pc }}px;
    color: {{ section.settings.icon_color }};
  }

  .empathy__icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }

  .empathy__arrow {
    font-size: {{ section.settings.arrow_size_pc }}px;
    color: {{ section.settings.arrow_color }};
    margin: 20px 0;
    animation: arrowBounce 1.6s infinite;
  }

  @keyframes arrowBounce {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* SP */
  @media (max-width: 768px) {
    .empathy {
      padding: {{ section.settings.padding_sp }}px 16px;
    }

    .empathy__title {
      font-size: {{ section.settings.heading_size_sp }}px;
    }

    .empathy__solution {
      border-radius: {{ section.settings.solution_radius_sp }}px;
      margin-bottom: 20px;
    }

    .empathy__list {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .empathy__item {
      flex-direction: row;
      text-align: left;
      padding: 14px;
      gap: 12px;
    }

    .empathy__icon {
      width: {{ section.settings.icon_size_sp }}px;
      height: {{ section.settings.icon_size_sp }}px;
      flex-shrink: 0;
    }

    .empathy__item p {
      font-size: {{ section.settings.item_text_size_sp }}px;
    }

    .empathy__arrow {
      font-size: {{ section.settings.arrow_size_sp }}px;
    }
  }
</style>

<section class="empathy">
  <div class="empathy__inner">

    {% if section.settings.label != blank %}
      <div class="empathy__label">
        {{ section.settings.label }}
      </div>
    {% endif %}

    <h2 class="empathy__title">
      {{ section.settings.heading }}
    </h2>

    <!-- ★見出し直下画像 -->
    {% if section.settings.solution_image != blank %}
      <div class="empathy__solution">
        <div class="empathy__solution-img">
          <img src="{{ section.settings.solution_image | img_url: '1200x' }}" alt="{{ section.settings.solution_image_alt }}">
        </div>
      </div>
    {% endif %}

    <ul class="empathy__list">
      {% for block in section.blocks %}
        <li class="empathy__item">
          <div class="empathy__icon">
            {{ block.settings.icon_svg }}
          </div>
          <p>{{ block.settings.text }}</p>
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.show_arrow %}
      <div class="empathy__arrow">↓</div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "MUSUBI 共感",
  "settings": [
    { "type": "text", "id": "label", "label": "ラベル", "default": "RESTLESS NIGHT" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "こんな夜、ありませんか？" },

    { "type": "range", "id": "heading_size_pc", "label": "見出しPC", "min": 18, "max": 44, "step": 1, "default": 26 },
    { "type": "range", "id": "heading_size_sp", "label": "見出しSP", "min": 16, "max": 32, "step": 1, "default": 22 },

    { "type": "range", "id": "item_text_size_pc", "label": "テキストPC", "min": 12, "max": 22, "step": 1, "default": 14 },
    { "type": "range", "id": "item_text_size_sp", "label": "テキストSP", "min": 12, "max": 20, "step": 1, "default": 14 },

    { "type": "color", "id": "heading_color", "label": "見出し色", "default": "#1a1a1a" },
    { "type": "color", "id": "item_text_color", "label": "テキスト色", "default": "#333" },

    { "type": "color", "id": "bg_color", "label": "背景", "default": "#faf9f7" },
    { "type": "color", "id": "card_bg_color", "label": "カード背景", "default": "#fff" },
    { "type": "color", "id": "card_border_color", "label": "枠線", "default": "#eee7dd" },

    { "type": "range", "id": "padding_pc", "label": "余白PC", "min": 40, "max": 140, "step": 4, "default": 64 },
    { "type": "range", "id": "padding_sp", "label": "余白SP", "min": 32, "max": 100, "step": 4, "default": 48 },

    { "type": "image_picker", "id": "solution_image", "label": "画像" },
    { "type": "text", "id": "solution_image_alt", "label": "alt", "default": "休息イメージ" },

    { "type": "checkbox", "id": "show_arrow", "label": "矢印表示", "default": true },

    { "type": "range", "id": "solution_width", "label": "画像幅", "min": 280, "max": 800, "step": 20, "default": 480 },
    { "type": "range", "id": "solution_radius", "label": "角丸PC", "min": 0, "max": 32, "step": 1, "default": 18 },
    { "type": "range", "id": "solution_radius_sp", "label": "角丸SP", "min": 0, "max": 28, "step": 1, "default": 14 },

    { "type": "range", "id": "icon_size_pc", "label": "アイコンPC", "min": 28, "max": 72, "step": 2, "default": 44 },
    { "type": "range", "id": "icon_size_sp", "label": "アイコンSP", "min": 24, "max": 56, "step": 2, "default": 34 },

    { "type": "range", "id": "arrow_size_pc", "label": "矢印PC", "min": 16, "max": 48, "step": 1, "default": 28 },
    { "type": "range", "id": "arrow_size_sp", "label": "矢印SP", "min": 16, "max": 40, "step": 1, "default": 24 }
  ],
  "blocks": [
    {
      "type": "worry_item",
      "name": "悩み",
      "settings": [
        { "type": "html", "id": "icon_svg", "label": "アイコン" },
        { "type": "text", "id": "text", "label": "テキスト", "default": "頭の中が休まらない" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUSUBI 共感",
      "blocks": [
        { "type": "worry_item" },
        { "type": "worry_item" },
        { "type": "worry_item" }
      ]
    }
  ]
}
{% endschema %}