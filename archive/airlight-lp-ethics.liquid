{% comment %} AirLight Jacket LP — Ethics / Animal Free Section {% endcomment %}

<section class="al-ethics" id="al-ethics">
  <div class="al-container">
    <p class="al-ethics__label" data-al-reveal>{{ section.settings.label | default: 'Ethics & Environment' }}</p>
    <h2 class="al-ethics__heading" data-al-reveal>
      {{ section.settings.heading | default: 'Kind to animals.<br>Kind to the planet.' }}
    </h2>

    <div class="al-ethics__body-wrap">
      <div class="al-ethics__img-col" data-al-reveal>
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | img_url: '800x' }}"
               alt="{{ section.settings.image_alt | default: 'Animal free — no feathers' }}"
               loading="lazy">
        {% elsif section.settings.fallback_url != blank %}
          <img src="{{ section.settings.fallback_url }}"
               alt="{{ section.settings.image_alt | default: 'Animal free — no feathers' }}"
               loading="lazy">
        {% endif %}
      </div>

      <div class="al-ethics__text-col" data-al-reveal>
        <h3 class="al-ethics__subheading">{{ section.settings.subheading | default: 'No feathers. No compromise.' }}</h3>
        <div class="al-ethics__text">
          {{ section.settings.body | default: '<p>A single down jacket uses feathers from approximately <strong>30 birds</strong>. Kapok grows inside a tree pod. No animal is touched. Full stop.</p><p>According to our in-house analysis, each AirLight Jacket saves the equivalent of <strong>30 geese</strong> and reduces CO₂ emissions by <strong>97%</strong> compared to a conventional down jacket.</p>' }}
        </div>

        <div class="al-ethics__stats">
          {% for block in section.blocks %}
            {% if block.type == 'stat_item' %}
              <div class="al-ethics__stat" {{ block.shopify_attributes }}>
                <p class="al-ethics__stat-num">{{ block.settings.number }}</p>
                <p class="al-ethics__stat-label">{{ block.settings.label }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.footnote != blank %}
          <p class="al-ethics__footnote">{{ section.settings.footnote }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AirLight Ethics",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Ethics & Environment" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Kind to animals.<br>Kind to the planet.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image Alt Text", "default": "Animal free — no feathers" },
    { "type": "text", "id": "fallback_url", "label": "Fallback Image URL", "default": "https://ucarecdn.com/7195ca1b-4376-4352-a81c-f6aad630623d/-/format/auto/-/preview/3000x3000/-/quality/lighter/image%20139.png" },
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "No feathers. No compromise." },
    { "type": "richtext", "id": "body", "label": "Body Text", "default": "<p>A single down jacket uses feathers from approximately <strong>30 birds</strong>. Kapok grows inside a tree pod. No animal is touched. Full stop.</p><p>According to our in-house analysis, each AirLight Jacket saves the equivalent of <strong>30 geese</strong> and reduces CO₂ emissions by <strong>97%</strong> compared to a conventional down jacket.</p>" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "*Source: KAPOK JAPAN internal data" }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AirLight Ethics",
      "blocks": [
        { "type": "stat_item", "settings": { "number": "97%", "label": "Less CO₂ vs Down" } },
        { "type": "stat_item", "settings": { "number": "30", "label": "Geese saved / jacket" } },
        { "type": "stat_item", "settings": { "number": "80%", "label": "Hollow fiber structure" } },
        { "type": "stat_item", "settings": { "number": "1/8", "label": "Weight of cotton" } }
      ]
    }
  ]
}
{% endschema %}
