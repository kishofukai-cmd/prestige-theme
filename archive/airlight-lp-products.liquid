{% comment %} AirLight Jacket LP — Products Section {% endcomment %}

<section class="al-products" id="al-products">
  <div class="al-container">
    <p class="al-products__label" data-al-reveal>{{ section.settings.label | default: 'The Collection' }}</p>
    <h2 class="al-products__heading" data-al-reveal>
      {{ section.settings.heading | default: 'Find your AirLight Jacket.' }}
    </h2>
  </div>

  {% for block in section.blocks %}
    {% if block.type == 'product_line' %}
      <div class="al-products__line {% cycle 'al-products__line--light', 'al-products__line--gray' %}" {{ block.shopify_attributes }}>
        <div class="al-container">
          <div class="al-products__info">
            <p class="al-products__line-label">{{ block.settings.gender_label }}</p>
            <h3 class="al-products__line-name">{{ block.settings.product_name }}</h3>
            {% if block.settings.colors != blank %}
              <p class="al-products__colors">{{ block.settings.colors }}</p>
            {% endif %}
            <p class="al-products__price">{{ block.settings.price }}</p>
            <p class="al-products__desc">{{ block.settings.description }}</p>
            <a href="{{ block.settings.cta_url }}" class="al-btn al-btn--navy" target="_blank">
              {{ block.settings.cta_text | default: 'Shop Now →' }}
            </a>
          </div>
        </div>
        {% if block.settings.image_1 != blank or block.settings.fallback_url_1 != blank %}
          <div class="al-products__carousel">
            {% assign images = 'image_1,image_2,image_3,image_4,image_5' | split: ',' %}
            {% assign labels = block.settings.color_labels | split: ',' %}
            {% for img_key in images %}
              {% assign img = block.settings[img_key] %}
              {% assign fallback_key = 'fallback_url_' | append: forloop.index %}
              {% assign fallback = block.settings[fallback_key] %}
              {% assign lbl = labels[forloop.index0] %}
              {% if img != blank or fallback != blank %}
                <div class="al-products__slide">
                  {% if img != blank %}
                    <img src="{{ img | img_url: '480x' }}" alt="{{ lbl }}" loading="lazy">
                  {% elsif fallback != blank %}
                    <img src="{{ fallback }}" alt="{{ lbl }}" loading="lazy">
                  {% endif %}
                  {% if lbl != blank %}<p>{{ lbl | strip }}</p>{% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</section>

{% schema %}
