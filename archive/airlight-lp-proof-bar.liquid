{% comment %} Air Light Jacket LP — Proof Bar + Guarantee Strip {% endcomment %}

<div class="al-proof-bar">
  <div class="al-proof-bar__inner">
    {% for block in section.blocks %}
      {% if block.type == 'proof_item' %}
        <div class="al-proof-bar__item" {{ block.shopify_attributes }}>
          <span class="al-proof-bar__num">{{ block.settings.number }}</span>
          <span class="al-proof-bar__label">{{ block.settings.label }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<div class="al-guarantee">
  <div class="al-guarantee__inner">
    {% for block in section.blocks %}
      {% if block.type == 'guarantee_item' %}
        <div class="al-guarantee__item" {{ block.shopify_attributes }}>
          <span class="al-guarantee__icon">{{ block.settings.icon }}</span>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Air Light LP Proof Bar",
  "blocks": [
    {
      "type": "proof_item",
      "name": "Proof Number",
      "settings": [
        { "type": "text", "id": "number", "label": "Number",  "default": "10,000+" },
        { "type": "text", "id": "label",  "label": "Label",   "default": "Happy Customers" }
      ]
    },
    {
      "type": "guarantee_item",
      "name": "Guarantee Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🌿" },
        { "type": "text", "id": "text", "label": "Text",         "default": "Sustainable Materials" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Air Light LP Proof Bar",
      "blocks": [
        { "type": "proof_item", "settings": { "number": "10,000+", "label": "Happy Customers" } },
        { "type": "proof_item", "settings": { "number": "30+",     "label": "Countries Shipped" } },
        { "type": "proof_item", "settings": { "number": "★ 4.8",   "label": "Average Rating" } },
        { "type": "guarantee_item", "settings": { "icon": "🌿", "text": "100% Plant-Based Fill" } },
        { "type": "guarantee_item", "settings": { "icon": "🪶", "text": "Lighter Than Down" } },
        { "type": "guarantee_item", "settings": { "icon": "🔄", "text": "30-Day Free Returns" } },
        { "type": "guarantee_item", "settings": { "icon": "✈️", "text": "Free Worldwide Shipping" } },
        { "type": "guarantee_item", "settings": { "icon": "🤝", "text": "2-Year Quality Guarantee" } }
      ]
    }
  ]
}
{% endschema %}
