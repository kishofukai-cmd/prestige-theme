{% comment %} AirLight Jacket LP — Comparison Table Section {% endcomment %}

<section class="al-comparison" id="al-comparison">
  <div class="al-container">
    <h2 class="al-comparison__heading" data-al-reveal>
      {{ section.settings.heading | default: 'How does it compare?' }}
    </h2>

    <div class="al-comparison__table-wrap" data-al-reveal>
      <table class="al-comparison__table">
        <thead>
          <tr>
            <th>Feature</th>
            <th class="al-comparison__th--hero">AirLight Jacket</th>
            <th>Down Jacket</th>
            <th>Synthetic Fill</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <td>{{ block.settings.feature }}</td>
                <td class="al-comparison__td--hero">{{ block.settings.airlight }}</td>
                <td>{{ block.settings.down }}</td>
                <td>{{ block.settings.synthetic }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AirLight Comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "How does it compare?" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature Name" },
        { "type": "text", "id": "airlight", "label": "AirLight Value" },
        { "type": "text", "id": "down", "label": "Down Value" },
        { "type": "text", "id": "synthetic", "label": "Synthetic Value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AirLight Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Weight", "airlight": "✅ ~500g", "down": "❌ 800–1000g", "synthetic": "⚠️ ~700g" } },
        { "type": "row", "settings": { "feature": "Warmth", "airlight": "✅ Down-equivalent", "down": "✅ Excellent", "synthetic": "⚠️ Good" } },
        { "type": "row", "settings": { "feature": "Wet performance", "airlight": "✅ Maintains warmth", "down": "❌ Collapses when wet", "synthetic": "⚠️ Varies" } },
        { "type": "row", "settings": { "feature": "Machine washable", "airlight": "✅ Yes", "down": "❌ Dry-clean only", "synthetic": "⚠️ Often yes" } },
        { "type": "row", "settings": { "feature": "Vegan", "airlight": "✅ 100%", "down": "❌ Bird feathers", "synthetic": "⚠️ Petroleum-based" } },
        { "type": "row", "settings": { "feature": "Sustainable", "airlight": "✅ Plant-based", "down": "❌ Animal byproduct", "synthetic": "❌ Fossil fuels" } },
        { "type": "row", "settings": { "feature": "Origin", "airlight": "✅ Japan innovation", "down": "— Various", "synthetic": "— Various" } }
      ]
    }
  ]
}
{% endschema %}
