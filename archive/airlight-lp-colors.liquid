{% comment %} Air Light Jacket LP — Color Variants Section {% endcomment %}

<section class="al-colors">
  <div class="al-colors__inner">
    <div class="al-colors__header" data-reveal>
      <p class="al-section-label">{{ section.settings.label | default: 'Color Collection' }}</p>
      <h2 class="al-section-title">{{ section.settings.heading | default: 'Find your color.' }}</h2>
    </div>

    <div class="al-colors__layout">

      <!-- Main Image -->
      <div class="al-colors__main-img-wrap" data-reveal>
        {% assign first_color = section.blocks | where: 'type', 'color_variant' | first %}
        <img
          id="al-colors-main-img"
          class="al-colors__main-img"
          src="{{ first_color.settings.image_url | default: 'https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-color-default.jpg' }}"
          alt="{{ first_color.settings.name | default: 'Air Light Jacket' }}"
          loading="lazy"
        >
        <div class="al-colors__name-badge">
          <span id="al-colors-name">{{ first_color.settings.name | default: 'Select a color' }}</span>
        </div>
      </div>

      <!-- Swatches + Carousel -->
      <div class="al-colors__swatches-section" data-reveal>
        <p class="al-colors__swatches-label">{{ section.settings.swatches_label | default: 'Available Colors' }}</p>

        <div class="al-colors__swatches">
          {% for block in section.blocks %}
            {% if block.type == 'color_variant' %}
              <button
                class="al-colors__swatch{% if forloop.first %} al-colors__swatch--active{% endif %}"
                data-color="{{ block.settings.name }}"
                data-img="{{ block.settings.image_url }}"
                style="background: {{ block.settings.color_code }};"
                title="{{ block.settings.name }}"
                aria-label="{{ block.settings.name }}"
                {{ block.shopify_attributes }}
              ></button>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Carousel -->
        <div class="al-colors__carousel-wrap">
          <div class="al-colors__carousel-track">
            {% for block in section.blocks %}
              {% if block.type == 'color_variant' %}
                <div
                  class="al-colors__carousel-item{% if forloop.first %} al-colors__carousel-item--active{% endif %}"
                  data-color="{{ block.settings.name }}"
                  {{ block.shopify_attributes }}
                >
                  <img src="{{ block.settings.image_url }}" alt="{{ block.settings.name }}" loading="lazy">
                  <p class="al-colors__carousel-item-name">{{ block.settings.name }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div style="margin-top:2rem;">
          <a href="{{ section.settings.cta_url | default: '#' }}" class="al-btn al-btn--green">
            {{ section.settings.cta_text | default: 'Shop All Colors' }}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Air Light LP Colors",
  "settings": [
    { "type": "text", "id": "label",          "label": "Section label",    "default": "Color Collection" },
    { "type": "text", "id": "heading",        "label": "Heading",          "default": "Find your color." },
    { "type": "text", "id": "swatches_label", "label": "Swatches label",   "default": "Available Colors" },
    { "type": "url",  "id": "cta_url",        "label": "CTA link" },
    { "type": "text", "id": "cta_text",       "label": "CTA text",         "default": "Shop All Colors" }
  ],
  "blocks": [
    {
      "type": "color_variant",
      "name": "Color",
      "settings": [
        { "type": "text", "id": "name",       "label": "Color name",  "default": "Forest Green" },
        { "type": "text", "id": "color_code", "label": "Hex code",    "default": "#3d5a47" },
        { "type": "text", "id": "image_url",  "label": "Product image URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Air Light LP Colors",
      "blocks": [
        { "type": "color_variant", "settings": { "name": "Forest Green",  "color_code": "#3d5a47", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-forest-green.jpg" } },
        { "type": "color_variant", "settings": { "name": "Midnight Navy", "color_code": "#1e2d45", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-midnight-navy.jpg" } },
        { "type": "color_variant", "settings": { "name": "Stone Beige",   "color_code": "#c8b89a", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-stone-beige.jpg" } },
        { "type": "color_variant", "settings": { "name": "Cloud White",   "color_code": "#e8e4de", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-cloud-white.jpg" } },
        { "type": "color_variant", "settings": { "name": "Charcoal",      "color_code": "#3a3a3a", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-charcoal.jpg" } },
        { "type": "color_variant", "settings": { "name": "Dusty Rose",    "color_code": "#c49a8c", "image_url": "https://cdn.shopify.com/s/files/1/0407/6027/9202/files/airlight-dusty-rose.jpg" } }
      ]
    }
  ]
}
{% endschema %}
