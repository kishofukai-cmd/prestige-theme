<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }} | {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Down warmth without down. 500g plant-based jacket from Japan.' }}">

  <!-- OGP -->
  <meta property="og:title" content="{{ page_title }} | {{ shop.name }}">
  <meta property="og:description" content="{{ page_description | default: 'AirLight Jacket by KAPOK KNOT — Down warmth without down. 500g plant-based jacket from Japan.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="https://ucarecdn.com/d7a640a6-76bb-47b6-8fd8-9fe27a5ce497/-/format/auto/-/preview/1200x630/-/quality/lighter/_240802_KAPOKKNOT2156-2.jpg">
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}
</head>
<body style="margin:0; padding:0;">
  {{ content_for_layout }}
</body>
</html>
